function toggleOtherReason() {
    const reasonSelect = document.getElementById('editReason');
    const otherInput = document.getElementById('editOtherReason');
    const wasteWarning = document.getElementById('wasteWarning');
    const correctionWarning = document.getElementById('correctionWarning');
    const selectedReason = reasonSelect.value;
    
    // Show/hide other reason input
    if (selectedReason === 'Other') {
        otherInput.style.display = 'block';
    } else {
        otherInput.style.display = 'none';
    }
    
    // Show appropriate warning based on reason
    const wasteReasons = ['Spoilage', 'Damage', 'Quality Issue', 'Overripe', 'Physical Count - Missing', 'Theft/Loss'];
    const correctionReasons = ['Typo Error - Correction', 'Physical Count - Excess'];
    
    if (wasteReasons.some(r => selectedReason.includes(r))) {
        wasteWarning.style.display = 'block';
        correctionWarning.style.display = 'none';
    } else if (correctionReasons.some(r => selectedReason.includes(r))) {
        wasteWarning.style.display = 'none';
        correctionWarning.style.display = 'block';
    } else {
        wasteWarning.style.display = 'none';
        correctionWarning.style.display = 'none';
    }
}

async function confirmStockAdjustment() {
    const newQuantity = parseFloat(document.getElementById('editNewQuantity').value);
    let reason = document.getElementById('editReason').value;
    const otherReason = document.getElementById('editOtherReason').value;
    const notes = document.getElementById('editNotes').value;
    
    // Validation
    if (isNaN(newQuantity) || newQuantity < 0) {
        await showAlert('Please enter a valid quantity (0 or positive number)', 'Invalid Input', '⚠️');
        return;
    }
    
    if (!reason) {
        await showAlert('Please select a reason for adjustment', 'Required', '⚠️');
        return;
    }
    
    if (reason === 'Other' && !otherReason) {
        await showAlert('Please specify the reason', 'Required', '⚠️');
        return;
    }
    
    if (reason === 'Other') {
        reason = otherReason;
    }
    
    if (newQuantity === currentEditBatchRemaining) {
        await showAlert('No changes made. Quantity is the same as current stock.', 'Notice', 'ℹ️');
        return;
    }
    
    const adjustment = Math.abs(newQuantity - currentEditBatchRemaining);
    const isDecrease = newQuantity < currentEditBatchRemaining;
    const action = isDecrease ? 'decrease' : 'increase';
    
    const confirmed = await showConfirm(
        `Confirm Stock Adjustment\n\n` +
        `Batch #${currentEditBatchId}\n` +
        `Material: ${currentEditMaterialName}\n` +
        `Current: ${currentEditBatchRemaining.toFixed(2)} ${currentEditUnit}\n` +
        `New: ${newQuantity.toFixed(2)} ${currentEditUnit}\n` +
        `${isDecrease ? `Reduction: ${adjustment.toFixed(2)} ${currentEditUnit}` : `Increase: ${adjustment.toFixed(2)} ${currentEditUnit}`}\n\n` +
        `Reason: ${reason}\n` +
        `Notes: ${notes || 'None'}\n\n` +
        `This action will be logged for audit purposes.`,
        'Confirm Adjustment'
    );
    
    if (!confirmed) return;
    
    showLoading('Processing stock adjustment...');
    
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
    
    try {
        const response = await fetch('/RawMaterial/AdjustBatchStock', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token
            },
            body: JSON.stringify({
                batchId: currentEditBatchId,
                newQuantity: newQuantity,
                reason: reason,
                notes: notes
            })
        });
        
        const result = await response.json();
        hideLoading();
        
        if (result.success) {
            await showAlert(result.message, 'Success', '✅');
            
            // Close modal
            const modal = bootstrap.Modal.getInstance(document.getElementById('editStockModal'));
            if (modal) modal.hide();
            
            // Refresh batch history
            const materialName = document.getElementById('modalBatchMaterialName').innerText;
            const materialId = currentEditBatchId; // Need to get actual materialId
            
            // Refresh the page to show updated data
            saveAndReload();
        } else {
            await showAlert('Error: ' + result.message, 'Error', '❌');
        }
    } catch (error) {
        hideLoading();
        console.error('Error:', error);
        await showAlert('Error: ' + error.message, 'Error', '❌');
    }
}

async function loadAdjustmentHistory() {
    const filterDate = document.getElementById('adjustmentFilterDate')?.value || '';
    
    showLoading('Loading adjustment history...');
    
    try {
        const response = await fetch(`/RawMaterial/GetAdjustmentHistory?date=${filterDate}`);
        const data = await response.json();
        hideLoading();
        
        const tbody = document.getElementById('adjustmentHistoryBody');
        
        if (!data.adjustments || data.adjustments.length === 0) {
            tbody.innerHTML = '<tr><td colspan="9" class="text-center text-muted">No adjustment records found</td></tr>';
            return;
        }
        
        let html = '';
        data.adjustments.forEach(adj => {
            const date = new Date(adj.adjustedAt);
            const formattedDate = date.toLocaleString();
            const diff = adj.newQuantity - adj.oldQuantity;
            const diffClass = diff > 0 ? 'text-success' : (diff < 0 ? 'text-danger' : 'text-muted');
            const diffSign = diff > 0 ? '+' : '';
            
            html += `
                <tr>
                    <td>${formattedDate}</td>
                    <td><code>#${adj.batchId}</code></td>
                    <td><strong>${escapeHtml(adj.materialName)}</strong></td>
                    <td>${adj.oldQuantity.toFixed(2)} ${adj.unit}</td>
                    <td class="${adj.newQuantity < adj.oldQuantity ? 'text-danger' : 'text-success'}">${adj.newQuantity.toFixed(2)} ${adj.unit}</td>
                    <td class="${diffClass}">${diffSign}${diff.toFixed(2)} ${adj.unit}</td>
                    <td><span class="badge ${adj.reason.includes('Typo') ? 'bg-info' : (adj.reason.includes('Spoilage') || adj.reason.includes('Damage') ? 'bg-warning' : 'bg-secondary')}">${escapeHtml(adj.reason)}</span></td>
                    <td>${escapeHtml(adj.adjustedByName || 'System')}</td>
                    <td>${escapeHtml(adj.notes || '-')}</td>
                </tr>
            `;
        });
        tbody.innerHTML = html;
        
    } catch (error) {
        hideLoading();
        console.error('Error loading adjustment history:', error);
        document.getElementById('adjustmentHistoryBody').innerHTML = '<tr><td colspan="9" class="text-center text-danger">Error loading adjustment history</td></tr>';
    }
}

