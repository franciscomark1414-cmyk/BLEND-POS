    <form id="addRawMaterialForm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="RawMaterialId" id="RawMaterialId">

        <div class="mb-3">
            <label class="form-label fw-bold">Name <span class="text-danger">*</span></label>
            <input type="text" name="Name" id="Name" class="form-control" required placeholder="e.g., Apple, Mango, Flour">
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Category <span class="text-danger">*</span></label>
            <select name="Category" id="Category" class="form-control" required>
                @foreach (var cat in Enum.GetValues(typeof(Infoman.Models.RawMaterialCategory)))
                {
                    var intValue = (int)cat;
                    <option value="@intValue">@cat</option>
                }
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Unit <span class="text-danger">*</span></label>
            <select name="Unit" id="Unit" class="form-control" required>
                <option value="">-- Select Unit --</option>
                <option value="kg"> kilogram (kg)</option>
                <option value="g"> gram (g)</option>
                <option value="L"> liter (L)</option>
                <option value="mL"> milliliter (mL)</option>
                <option value="pcs"> pieces (pcs)</option>
            </select>
            <small class="text-muted">Select measurement unit for this raw material</small>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Critical Stock Level <span class="text-danger">*</span></label>
            <input type="number" name="MinQty" id="MinQty" class="form-control" required value="0" step="0.1" min="0" oninput="validateMinQty(this)">
            <small class="text-muted text-danger">⚠️ Must be 0 or positive (cannot be negative)</small>
        </div>

        <hr>
        <div class="alert alert-info py-2 small">
            <i class="fas fa-truck"></i> <strong>Note:</strong> After saving this raw material,
            go to <strong>"ADD DELIVERY (BATCH)"</strong> to add stock with price and expiry date.
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-success" id="saveButton">
                <i class="fas fa-save"></i> Save Material
            </button>
            <button type="button" class="btn btn-secondary" onclick="toggleRawMaterialForm()">
                <i class="fas fa-times"></i> Cancel
            </button>
        </div>
    </form>
</div>
