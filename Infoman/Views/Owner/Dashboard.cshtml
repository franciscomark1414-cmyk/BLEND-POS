    // ✅ 1. CHECK KUNG MAY KAPAREHONG PANGALAN SA TABLE (Kung bagong add lang, hindi edit)
    if (!id || id === '0') {
        let isDuplicate = false;
        const rows = document.querySelectorAll('#rawMaterialTable2 tbody tr');
        
        for (let row of rows) {
            // Kunin ang pangalan sa ika-2 column (index 1)
            const rowName = row.cells[1]?.innerText.trim().toLowerCase();
            if (rowName === name.toLowerCase()) {
                isDuplicate = true;
                break;
            }
        }

        if (isDuplicate) {
            const confirmed = await showConfirm(
                `⚠️ Warning: A raw material named "${name}" already exists.\n\nDo you still want to proceed and save this as a separate record? (It will generate a new unique SKU).`, 
                'Duplicate Name Detected'
            );
            
            if (!confirmed) {
                return; // Stop kung pinindot ang Cancel
            }
        }
    }

    // ✅ I-DISABLE ANG BUTTON PARA HINDI MAKA-DOUBLE CLICK
    const form = this;
    const submitBtn = form.querySelector('button[type="submit"]');
    const originalText = submitBtn.innerHTML;
    submitBtn.disabled = true;
    submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving...';

    var formData = new FormData();
    formData.append('RawMaterialId', id || '0');
    formData.append('Name', name);
    formData.append('CategoryId', categoryId);
    formData.append('MinQty', minQty);
    formData.append('Unit', unit);

    var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
    var url = id ? '@Url.Action("Edit", "RawMaterial")' : '@Url.Action("Create", "RawMaterial")';
    if (id) { url = url + '/' + id; }

    fetch(url, {
        method: 'POST',
        headers: { 'RequestVerificationToken': token },
        body: formData
    })
    .then(res => res.json())
    .then(async (data) => {
        submitBtn.disabled = false;
        submitBtn.innerHTML = originalText;

        if (data.success) {
            await showAlert('Raw material saved! Now add stock using "ADD DELIVERY (BATCH)".', 'Success');
            saveAndReload();
        }
        else { 
            await showAlert('Error: ' + (data.errors ? data.errors.join(', ') : (data.message || 'Unknown error')), 'Error'); 
        }
    })
    .catch(async (err) => { 
        submitBtn.disabled = false;
        submitBtn.innerHTML = originalText;
        await showAlert('An error occurred. Please try again.', 'Error'); 
    });
});

        async function adjustBatchStock(batchId, currentRemaining, materialName) {
    const newQuantity = prompt(`Adjust stock for ${materialName}\n\nCurrent remaining: ${currentRemaining} kg\nEnter new quantity:`, currentRemaining);
    
    if (newQuantity === null) return;
    
    const newQty = parseFloat(newQuantity);
    if (isNaN(newQty) || newQty < 0) {
        await showAlert('Please enter a valid quantity (0 or positive number)', 'Invalid');
        return;
    }
    
    if (newQty === currentRemaining) {
        await showAlert('No changes made', 'Notice');
        return;
    }
    
    const confirmed = await showConfirm(`Adjust stock from ${currentRemaining} kg to ${newQty} kg?\n\nThis will create a waste log if stock is reduced.`, 'Confirm Adjustment');
    if (!confirmed) return;
    
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
    
    try {
        const response = await fetch('/RawMaterial/AdjustBatchStock', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token
            },
            body: JSON.stringify({
                batchId: batchId,
                newQuantity: newQuantityInDisplayUnit, 
                reason: 'Manual adjustment',
                notes: notes
            })
        });
        
        const result = await response.json();
        
        if (result.success) {
            await showAlert(' Stock adjusted successfully', 'Success');
            saveAndReload();
        } else {
            await showAlert(' Error: ' + result.message, 'Error');
        }
    } catch (error) {
        await showAlert(' Error: ' + error.message, 'Error');
    }
}

