 function renderCategoryPieChart(categories) {
    var canvas = document.getElementById('categoryPieChart');
    if (!canvas) return;
    
    var existingChart = Chart.getChart('categoryPieChart');
    if (existingChart) existingChart.destroy();
    
    var ctx = canvas.getContext('2d');
    
    var labels = (categories && categories.length) ? categories.map(function(c) { return c.category; }) : ['No Data'];
    var values = (categories && categories.length) ? categories.map(function(c) { return c.revenue; }) : [1];
    
    // ✅ COLORS MULA SA GRADIENT MO (Green → Yellow → Orange)
    var colors = ['#00B533', '#8AAE12', '#D4B000', '#FF8A00', '#E8A317'];
    
    new Chart(ctx, {
        type: 'pie',
        data: { 
            labels: labels, 
            datasets: [{ 
                data: values, 
                backgroundColor: colors.slice(0, labels.length),
                borderWidth: 0,
                hoverOffset: 8
            }] 
        },
        options: { 
            responsive: true, 
            maintainAspectRatio: true, 
            plugins: { 
                legend: { 
                    position: 'bottom', 
                    labels: { 
                        font: { size: 11 },
                        usePointStyle: true,
                        boxWidth: 10
                    } 
                }, 
                tooltip: { 
                    callbacks: { 
                        label: function(context) { 
                            var label = context.label || ''; 
                            var value = context.raw || 0; 
                            var total = context.dataset.data.reduce(function(a, b) { return a + b; }, 0); 
                            var percentage = total > 0 ? ((value / total) * 100).toFixed(1) : 0; 
                            return label + ': ₱' + value.toFixed(2) + ' (' + percentage + '%)'; 
                        } 
                    } 
                } 
            } 
        } 
    });
}


// ========== EMPLOYEE MODULE FUNCTIONS ==========

function loadEmployees() {
    Promise.all([
        fetch('/Employee/GetAllEmployees').then(res => res.json()),
        fetch('/Owner/GetEmployeeOnlineStatus').then(res => res.json())
    ])
    .then(function ([employees, statusData]) {
        var container = document.getElementById('employeesContainer');

        if (!employees || employees.length === 0) {
            container.innerHTML = '<div class="text-center py-5"><i class="fas fa-users fa-3x text-muted mb-3"></i><h5>No Employees Yet</h5><p class="text-muted">Click "Add Employee" to get started.</p></div>';
            return;
        }

        var statusMap = {};
        (statusData.online || []).forEach(function (e) { statusMap[e.employeeId] = e; });
        (statusData.offline || []).forEach(function (e) { if (!statusMap[e.employeeId]) statusMap[e.employeeId] = e; });

        // safe para sa data-attribute (may quotes)
        function attr(s) { return escapeHtml(s || '').replace(/"/g, '&quot;'); }

        function initials(name) {
            var parts = (name || '?').trim().split(/\s+/);
            var first = parts[0] ? parts[0][0] : '';
            var last = parts.length > 1 ? parts[parts.length - 1][0] : '';
            return (first + last).toUpperCase();
        }

        function row(label, value) {
            return '<div class="emp-row"><span>' + label + '</span><strong>' + value + '</strong></div>';
        }

        var html = '';
        employees.forEach(function (emp) {
            var info = statusMap[emp.id] || {};
            var isOnline = info.status === 'Online';
            var rows = '';

            if (isOnline) {
                rows += row('Time in', info.checkInTime || '--:--');
                rows += row('Hours worked', (info.hoursWorked || 0).toFixed(1) + ' hrs');
                if (info.lastLoginTime) rows += row('Last login', info.lastLoginTime);
            } else {
                if (info.checkInTime || info.checkOutTime) {
                    rows += row('Time in', info.checkInTime || '--:--');
                    rows += row('Time out', info.checkOutTime || '--:--');
                    rows += row('Hours worked', (info.hoursWorked || 0).toFixed(1) + ' hrs');
                } else {
                    rows += row('Attendance', 'None today');
                }
                if (info.lastLoginTime)  rows += row('Last login', info.lastLoginTime);
                if (info.lastLogoutTime) rows += row('Last logout', info.lastLogoutTime);
            }

            html += `
            <div class="col-md-6 col-xl-4">
                <div class="emp-card">
                    <div class="emp-head">
                        <div class="emp-avatar">${escapeHtml(initials(emp.fullName))}</div>
                        <div class="emp-id">
                            <div class="emp-name" title="${attr(emp.fullName)}">${escapeHtml(emp.fullName)}</div>
                            <div class="emp-user">@@${escapeHtml(emp.username)}</div>
                        </div>
                        <span class="emp-status ${isOnline ? 'online' : 'offline'}">
                            <span class="dot"></span>${isOnline ? 'Online' : 'Offline'}
                        </span>
                    </div>

                    <ul class="emp-contact">
                        <li><i class="fas fa-envelope"></i><span>${escapeHtml(emp.email || 'No email')}</span></li>
                        <li><i class="fas fa-phone"></i><span>${escapeHtml(emp.phone || 'No phone')}</span></li>
                        <li><i class="fas fa-calendar"></i><span>Joined ${escapeHtml(emp.dateJoined)}</span></li>
                    </ul>

                    <div class="emp-rows">${rows}</div>

                    <div class="emp-actions">
                        <button class="emp-btn" onclick="editEmployee(${emp.id})">Edit</button>
                        <button class="emp-btn danger" data-name="${attr(emp.fullName)}"
                                onclick="deleteEmployee(${emp.id}, this.dataset.name)">Delete</button>
                    </div>
                </div>
            </div>`;
        });

        container.innerHTML = html;
    })
    .catch(function (err) {
        console.error('Error loading employees:', err);
        document.getElementById('employeesContainer').innerHTML =
            '<div class="alert alert-danger">Error loading employees: ' + err.message + '</div>';
    });
}

// Function to refresh employee status
function refreshEmployeeStatus() {
    console.log('Refreshing employee status...');
    loadEmployees();
}

// Auto-refresh employee status every 30 seconds
var employeeStatusInterval = null;

function startEmployeeStatusAutoRefresh() {
    if (employeeStatusInterval) {
        clearInterval(employeeStatusInterval);
    }
    employeeStatusInterval = setInterval(function() {
        var employeesModule = document.getElementById('employeesModule');
        if (employeesModule && employeesModule.classList.contains('active')) {
            refreshEmployeeStatus();
        }
    }, 30000);
}

// Call this when DOM is ready or when switching to employees module
function initEmployeeModule() {
    loadEmployees();
    startEmployeeStatusAutoRefresh();
}


    function switchEmployeeTab(tab) {
    var listTab = document.getElementById('employeeListTab');
    var perfTab = document.getElementById('employeePerformanceTab');
    var attendTab = document.getElementById('employeeAttendanceTab');
    var tabs = document.querySelectorAll('#employeesModule .nav-link');

    for (var i = 0; i < tabs.length; i++) {
        tabs[i].classList.remove('active');
    }

    if (tab === 'list') {
        if (tabs[0]) tabs[0].classList.add('active');
        if (listTab) listTab.style.display = 'block';
        if (perfTab) perfTab.style.display = 'none';
        if (attendTab) attendTab.style.display = 'none';
        loadEmployees();  // Load when switching to list tab
        startEmployeeStatusAutoRefresh();  // Start auto-refresh
    }
   else if (tab === 'performance') {
    if (tabs[1]) tabs[1].classList.add('active');
    if (listTab) listTab.style.display = 'none';
    if (perfTab) perfTab.style.display = 'block';
    if (attendTab) attendTab.style.display = 'none';
    
    if (employeeStatusInterval) {
        clearInterval(employeeStatusInterval);
        employeeStatusInterval = null;
    }
    
    fetch('/Employee/GetAllEmployees')
        .then(response => response.json())
        .then(employees => {
            const perfSelect = document.getElementById('perfEmployeeSelect');
            if (perfSelect) {
                let options = '<option value="">-- Select Employee --</option>';
                employees.forEach(emp => {
                    options += `<option value="${emp.id}">${escapeHtml(emp.fullName)}</option>`;
                });
                perfSelect.innerHTML = options;
                
                // ✅ I-RESTORE ang dating napiling employee (kung meron)
                const oldValue = sessionStorage.getItem('selectedEmployeeId');
                if (oldValue) {
                    perfSelect.value = oldValue;
                }
            }
        });
}

    else if (tab === 'attendance') {
        if (tabs[2]) tabs[2].classList.add('active');
        if (listTab) listTab.style.display = 'none';
        if (perfTab) perfTab.style.display = 'none';
        if (attendTab) attendTab.style.display = 'block';
        // Stop auto-refresh when not on list tab
        if (employeeStatusInterval) {
            clearInterval(employeeStatusInterval);
            employeeStatusInterval = null;
        }
        // Load employees into attendance dropdown
        fetch('/Employee/GetAllEmployees')
            .then(response => response.json())
            .then(employees => {
                const attSelect = document.getElementById('attEmployeeSelect');
                if (attSelect) {
                    attSelect.innerHTML = '<option value="">-- Select Employee --</option>';
                    employees.forEach(emp => {
                        attSelect.innerHTML += `<option value="${emp.id}">${emp.fullName}</option>`;
                    });
                }
            });
    }
}

async function handleLogout() {
    const confirmed = await showConfirm('Are you sure you want to logout?', 'Logout');
    if (!confirmed) return;
    
    showLoading('Logging out...');
    
    try {
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        
        const response = await fetch('/Account/Logout', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token
            }
        });
        
        const data = await response.json();
        hideLoading();
        
        if (data.success) {
             sessionStorage.removeItem('activeModule');
    sessionStorage.removeItem('pendingPaymentOrderId');
    sessionStorage.removeItem('pendingPaymentAmount');
            window.location.href = '/Account/Login';
        } else {
            await showAlert('Error: ' + data.message, 'Logout Failed', '❌');
        }
    } catch (error) {
        hideLoading();
        await showAlert('Error: ' + error.message, 'Error', '❌');
    }
}

// ========== LOAD EMPLOYEE DAILY ORDERS ==========
async function loadEmployeeDailyOrders() {
    const employeeSelect = document.getElementById('perfEmployeeSelect');
    const employeeId = employeeSelect.value;
    
    if (!employeeId) {
        document.getElementById('perfTotalSales').innerHTML = '₱0.00';
        document.getElementById('perfTotalOrders').innerHTML = '0';
        document.getElementById('perfVoidedAmount').innerHTML = '₱0.00';
        document.getElementById('perfVoidedCount').innerHTML = '0 orders';
        document.getElementById('perfRefundedAmount').innerHTML = '₱0.00';
        document.getElementById('perfRefundedCount').innerHTML = '0 orders';

        document.getElementById('performanceTableBody').innerHTML = `
            <tr><td colspan="5" class="text-center text-muted">Select an employee to view performance</td></tr>
        `;
        return;
    }
    
    showLoading('Loading employee orders...');
    
    try {
        const response = await fetch(`/Employee/GetEmployeeDailyOrders?employeeId=${employeeId}&days=30`);
        const data = await response.json();
        
        if (data.success) {
            let totalSales = 0;
            let totalOrders = 0;
            let html = '';
                                             // ✅ ITO ANG TAMANG LOOP PARA SA TABLE (KASAMA ANG VOIDED/REFUNDED)
                                                            data.allDailyOrders.forEach(day => {
                                                                // I-compute ang valid sales lang (para sa Total Sales card)
                                                                let daySales = 0;
                                                                let validOrderCount = 0;

                                                              day.orders.forEach(order => {
    // ✅ IDINAGDAG NATIN YUNG EXCHANGED
    if (order.status !== "VOIDED" && order.status !== "REFUNDED" && order.status !== "EXCHANGED" && order.returnStatus !== "EXCHANGED") {
        daySales += order.totalAmount;
        validOrderCount++;
    }
});

                                                                totalSales += daySales;
                                                                totalOrders += validOrderCount;

                                                                // Format date
                                                                let formattedDate;
                                                                if (typeof day.date === 'string') {
                                                                    const datePart = day.date.split('T')[0];
                                                                    const [year, month, dayNum] = datePart.split('-').map(Number);
                                                                    const localDate = new Date(year, month - 1, dayNum);
                                                                    formattedDate = localDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
                                                                } else {
                                                                    const dateObj = new Date(day.date);
                                                                    formattedDate = dateObj.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
                                                                }

                                                                const ordersToPass = day.orders || [];

                                                                // ✅ IPAPAKITA ANG ROW KAHIT VOIDED LANG (Para may ma-click na View Orders)
                                                                html += `
                                                        <tr>
                                                            <td class="fw-bold">${formattedDate}</td>
                                                            <td class="text-primary fw-bold">₱${daySales.toFixed(2)}</td>
                                                            <td>${validOrderCount}</td>
                                                            <td>-</td>
                                                            <td>
                                                                <button class="btn btn-sm btn-info" onclick='showDailyOrdersModal(${JSON.stringify(ordersToPass)}, "${formattedDate}")'>
                                                                    <i class="fas fa-eye me-1"></i> View Orders
                                                                </button>
                                                            </td>
                                                        </tr>
                                                    `;
                                                            });
            
            // I-update ang cards
            document.getElementById('perfTotalSales').innerHTML = `₱${totalSales.toFixed(2)}`;
            document.getElementById('perfTotalOrders').innerHTML = totalOrders;
            
            const voidAmount = data.totalVoidedAmount || 0;
            const voidCount = data.voidedCount || 0;
            const refundAmount = data.totalRefundedAmount || 0;
            const refundCount = data.refundedCount || 0;

            document.getElementById('perfVoidedAmount').innerHTML = `₱${voidAmount.toFixed(2)}`;
            document.getElementById('perfVoidedCount').innerHTML = `${voidCount} order(s)`;

            document.getElementById('perfRefundedAmount').innerHTML = `₱${refundAmount.toFixed(2)}`;
            document.getElementById('perfRefundedCount').innerHTML = `${refundCount} order(s)`;

            document.getElementById('performanceTableBody').innerHTML = html || `<tr><td colspan="5" class="text-center text-muted">No valid orders found for the last 30 days.</td></tr>`;
        }
    } catch (error) {
        console.error('Error:', error);
        await showAlert('Error loading employee orders', 'Error', '❌');
