            totalCostEl.innerHTML = '₱' + totalCost.toFixed(2);
        } else {
            // Kung walang ID, hanapin sa card
            var cards = document.querySelectorAll('.card');
            for (var i = 0; i < cards.length; i++) {
                if (cards[i].innerText.includes('Total Waste Cost')) {
                    var h2Elements = cards[i].querySelectorAll('h2');
                    if (h2Elements.length > 0) {
                        h2Elements[0].innerHTML = '₱' + totalCost.toFixed(2);
                        break;
                    }
                }
            }
        }

        // Update table
        var body = document.getElementById('wasteSummaryBody');
        if (!body) return;

        if (!wasteLogs || wasteLogs.length === 0) {
            body.innerHTML = '<tr><td colspan="4" class="text-center text-muted">No waste records</td></tr>';
            return;
        }

        var html = '';
        for (var i = 0; i < Math.min(wasteLogs.length, 5); i++) {
            var w = wasteLogs[i];
            html += '<tr>' +
                '<td><strong>' + escapeHtml(w.materialName) + '</strong></td>' +
                '<td>' + (w.quantity || 0).toFixed(2) + ' ' + escapeHtml(w.unit || '') + '</td>' +
                '<td><span class="badge bg-secondary">' + escapeHtml(w.reason || 'Other') + '</span></td>' +
                '<td class="text-danger">₱' + (w.totalCost || 0).toFixed(2) + '</td>' +
            '</tr>';
        }
        body.innerHTML = html;
    }
            function updateDiscountRecords(records) {
                var body = document.getElementById('discountRecordsBody');
                if (!body) return;
                if (!records || records.length === 0) {
                    body.innerHTML = '<tr><td colspan="7" class="text-center text-muted">No discount records found</td></tr>';
                    return;
                }
                var html = '';
                for (var i = 0; i < records.length; i++) {
                    var r = records[i];
                    html += '<tr><td>' + new Date(r.date).toLocaleDateString() + '</td>' +
                        '<td>' + escapeHtml(r.orderNumber || 'N/A') + '</td>' +
                        '<td>' + escapeHtml(r.productName) + '</td>' +
                        '<td>₱' + (r.originalPrice || 0).toFixed(2) + '</td>' +
                        '<td><span class="badge bg-info">' + (r.discountPercent || 0) + '%</span></td>' +
                        '<td>₱' + (r.discountedPrice || 0).toFixed(2) + '</td>' +
                        '<td class="text-success">₱' + (r.savings || 0).toFixed(2) + '</td></tr>';
                }
                body.innerHTML = html;
            }

            function updateCategoryRevenue(categories) {
                var body = document.getElementById('categoryRevenueBody');
                if (!body) return;
                if (!categories || categories.length === 0) {
                    body.innerHTML = '<tr><td colspan="4" class="text-center text-muted">No data available</td></tr>';
                    return;
                }
                var totalRevenue = 0;
                for (var i = 0; i < categories.length; i++) totalRevenue += categories[i].revenue || 0;
                var html = '';
                for (var i = 0; i < categories.length; i++) {
                    var c = categories[i];
                    var percent = totalRevenue > 0 ? ((c.revenue || 0) / totalRevenue * 100) : 0;
                    html += '<tr><td><i class="fas fa-folder-open me-2"></i> ' + escapeHtml(c.category) + '</td>' +
                        '<td class="fw-bold text-primary">₱' + (c.revenue || 0).toFixed(2) + '</td>' +
                        '<td>' + (c.orders || 0) + ' orders</td>' +
                        '<td><div class="progress" style="height: 8px;"><div class="progress-bar bg-success" style="width: ' + percent + '%"></div></div>' +
                        '<small>' + percent.toFixed(1) + '%</small></td></tr>';
                }
                body.innerHTML = html;
            }

            function renderSalesChart(data) {
                var canvas = document.getElementById('salesPerformanceChart');
                if (!canvas) return;
                var existingChart = Chart.getChart('salesPerformanceChart');
                if (existingChart) existingChart.destroy();
                var ctx = canvas.getContext('2d');
                var labels = (data && data.labels) ? data.labels : ['No Data'];
                var revenueData = (data && data.revenue) ? data.revenue : [0];
                var ordersData = (data && data.orders) ? data.orders : [0];
                new Chart(ctx, {
                    type: 'bar',
                    data: { labels: labels, datasets: [
                        { label: 'Revenue (₱)', data: revenueData, backgroundColor: 'rgba(54, 162, 235, 0.7)', borderColor: 'rgba(54, 162, 235, 1)', borderWidth: 1, yAxisID: 'y', borderRadius: 4 },
                        { label: 'Orders', data: ordersData, type: 'line', backgroundColor: 'rgba(255, 159, 64, 0.2)', borderColor: 'rgba(255, 159, 64, 1)', borderWidth: 2, fill: false, tension: 0.3, pointRadius: 4, pointBackgroundColor: 'rgba(255, 159, 64, 1)', yAxisID: 'y1' }
                    ] },
                    options: { responsive: true, maintainAspectRatio: true, plugins: { legend: { position: 'top', labels: { usePointStyle: true, boxWidth: 10 } }, tooltip: { mode: 'index', intersect: false } }, scales: { y: { title: { display: true, text: 'Revenue (₱)', color: '#3b82f6' }, beginAtZero: true }, y1: { position: 'right', title: { display: true, text: 'Orders', color: '#f59e0b' }, beginAtZero: true, grid: { drawOnChartArea: false } } } }
                });
            }

            function renderCategoryPieChart(categories) {
                var canvas = document.getElementById('categoryPieChart');
                if (!canvas) return;
                var existingChart = Chart.getChart('categoryPieChart');
                if (existingChart) existingChart.destroy();
                var ctx = canvas.getContext('2d');
                var labels = (categories && categories.length) ? categories.map(function(c) { return c.category; }) : ['No Data'];
                var values = (categories && categories.length) ? categories.map(function(c) { return c.revenue; }) : [1];
                var colors = ['#FF6384', '#36A2EB', '#FFCE56', '#4BC0C0', '#9966FF', '#FF9F40', '#66BB6A', '#EC407A'];
                new Chart(ctx, {
                    type: 'pie',
                    data: { labels: labels, datasets: [{ data: values, backgroundColor: colors.slice(0, labels.length), borderWidth: 0, hoverOffset: 8 }] },
                    options: { responsive: true, maintainAspectRatio: true, plugins: { legend: { position: 'bottom', labels: { font: { size: 11 } } }, tooltip: { callbacks: { label: function(context) { var label = context.label || ''; var value = context.raw || 0; var total = context.dataset.data.reduce(function(a, b) { return a + b; }, 0); var percentage = total > 0 ? ((value / total) * 100).toFixed(1) : 0; return label + ': ₱' + value.toFixed(2) + ' (' + percentage + '%)'; } } } } }
                });
            }


// ========== EMPLOYEE MODULE FUNCTIONS ==========

function loadEmployees() {
    console.log("Loading employees...");
    
    fetch('/Employee/GetAllEmployees')
        .then(function(res) { 
            console.log("Response status:", res.status);
            return res.json(); 
        })
        .then(function(data) {
            console.log("Raw data received:", data);
            console.log("Data type:", typeof data);
            console.log("Is array?", Array.isArray(data));
            
            var container = document.getElementById('employeesContainer');
            if (!container) {
                console.error("Container not found!");
                return;
            }
            
            // ✅ Handle the data - it should be an array directly
            var employees = data;
            
            // If it's not an array, try to extract it
            if (!Array.isArray(employees)) {
                if (employees && employees.$values) {
                    employees = employees.$values;
                } else if (employees && employees.data) {
                    employees = employees.data;
                } else if (employees && typeof employees === 'object') {
                    // Check if it's a single object with employee properties
                    if (employees.id !== undefined || employees.username !== undefined) {
                        employees = [employees];
                    } else {
                        employees = [];
                    }
                } else {
                    employees = [];
                }
            }
            
            console.log("Processed employees:", employees);
            console.log("Employee count:", employees.length);
            
            if (!employees || employees.length === 0) {
                console.log("No employees found");
                container.innerHTML = '<div class="text-center py-5"><i class="fas fa-users fa-4x text-muted mb-3"></i><h5>No Employees Yet</h5><p class="text-muted">Click "Add Employee" to get started.</p></div>';
                return;
            }
            
            var html = '';
            for (var i = 0; i < employees.length; i++) {
                var emp = employees[i];
                console.log("Employee " + i + ":", emp);
                
                // Get values with fallbacks
                var empId = emp.id || emp.Id;
                var empUsername = emp.username || emp.Username || '';
                var empFullName = emp.fullName || emp.FullName || 'No Name';
                var empEmail = emp.email || emp.Email || 'No email';
                var empPhone = emp.phone || emp.Phone || 'No phone';
                var empStatus = emp.status || emp.Status || 'Active';
                var empDateJoined = emp.dateJoined || emp.DateJoined || 'Unknown';
                
                html += '<div class="employee-card">' +
                    '<div class="d-flex">' +
                    '<div class="employee-avatar">' +
                    '<i class="fas fa-user"></i>' +
                    '</div>' +
                    '<div class="flex-grow-1">' +
                    '<div class="d-flex justify-content-between align-items-start">' +
                    '<div>' +
                    '<div class="employee-name">' + escapeHtml(empFullName) + '</div>' +
                        '<div class="employee-username">\u0040' + escapeHtml(empUsername) + '</div>' +
                    '</div>' +
                    '<button class="btn btn-sm btn-outline-warning" onclick="editEmployee(' + empId + ')">' +
                    '<i class="fas fa-edit"></i> Edit' +
                    '</button>' +
                    '</div>' +
                    '<div class="row mt-2">' +
                    '<div class="col-md-6">' +
                    '<div class="employee-detail">' +
                    '<i class="fas fa-envelope"></i> ' + escapeHtml(empEmail) +
                    '</div>' +
                    '<div class="employee-detail">' +
                    '<i class="fas fa-phone"></i> ' + escapeHtml(empPhone) +
                    '</div>' +
                    '</div>' +
                    '<div class="col-md-6">' +
                    '<div class="employee-detail">' +
                    '<i class="fas fa-calendar-alt"></i> Joined: ' + escapeHtml(empDateJoined) +
                    '</div>' +
                    '<div class="employee-detail">' +
                    '<span class="status-badge ' + (empStatus === 'Active' ? 'status-active' : 'status-inactive') + '">' +
                    escapeHtml(empStatus) +
                    '</span>' +
                    '</div>' +
                    '</div>' +
                    '</div>' +
                    '</div>' +
                    '</div>' +
                    '</div>';
            }
            container.innerHTML = html;
            console.log("HTML rendered successfully");
        })
        .catch(function(err) {
            console.error('Error loading employees:', err);
            var container = document.getElementById('employeesContainer');
            if (container) {
                container.innerHTML = '<div class="alert alert-danger">Error loading employees: ' + err.message + '</div>';
            }
        });
}


    function switchEmployeeTab(tab) {
        var listTab = document.getElementById('employeeListTab');
        var perfTab = document.getElementById('employeePerformanceTab');
        var attendTab = document.getElementById('employeeAttendanceTab');
        var tabs = document.querySelectorAll('#employeesModule .nav-link');

        for (var i = 0; i < tabs.length; i++) {
            tabs[i].classList.remove('active');
        }

        if (tab === 'list') {
            if (tabs[0]) tabs[0].classList.add('active');
            if (listTab) listTab.style.display = 'block';
            if (perfTab) perfTab.style.display = 'none';
            if (attendTab) attendTab.style.display = 'none';
            loadEmployees();
        }
        else if (tab === 'performance') {
            if (tabs[1]) tabs[1].classList.add('active');
            if (listTab) listTab.style.display = 'none';
            if (perfTab) perfTab.style.display = 'block';
            if (attendTab) attendTab.style.display = 'none';

            // Load employees into performance dropdown
            fetch('/Employee/GetAllEmployees')
                .then(response => response.json())
                .then(employees => {
                    const perfSelect = document.getElementById('perfEmployeeSelect');
                    if (perfSelect) {
                        perfSelect.innerHTML = '<option value="">-- Select Employee --</option>';
                        employees.forEach(emp => {
                            perfSelect.innerHTML += `<option value="${emp.id}">${emp.fullName}</option>`;
                        });
                    }
                });
        }
        else if (tab === 'attendance') {
            if (tabs[2]) tabs[2].classList.add('active');
            if (listTab) listTab.style.display = 'none';
            if (perfTab) perfTab.style.display = 'none';
            if (attendTab) attendTab.style.display = 'block';

            // Load employees into attendance dropdown
            fetch('/Employee/GetAllEmployees')
                .then(response => response.json())
                .then(employees => {
                    const attSelect = document.getElementById('attEmployeeSelect');
                    if (attSelect) {
                        attSelect.innerHTML = '<option value="">-- Select Employee --</option>';
                        employees.forEach(emp => {
                            attSelect.innerHTML += `<option value="${emp.id}">${emp.fullName}</option>`;
                        });
                    }
                });
        }
    }
    function showEmployeeAddModal() {
        console.log("Opening add employee modal");
        document.getElementById('employeeModalTitle').innerText = 'Add Employee';
        document.getElementById('employeeForm').reset();
        document.getElementById('employeeId').value = 0;
        document.getElementById('empPasswordField').style.display = 'block';
        document.getElementById('empPassword').required = true;
        document.getElementById('empUsername').readOnly = false;
        document.getElementById('empUsername').value = '';
        document.getElementById('empFullName').value = '';
        document.getElementById('empPhone').value = '';
        document.getElementById('empEmail').value = '';
        document.getElementById('empStatus').value = 'Active';

        // Make sure modal exists
        var modalElement = document.getElementById('employeeModal');
        if (modalElement) {
            var modal = new bootstrap.Modal(modalElement);
            modal.show();
        } else {
            console.error("Modal element not found!");
            alert("Error: Modal not found");
        }
    }

function editEmployee(id) {
    fetch('/Employee/GetEmployee/' + id)
        .then(function(res) { return res.json(); })
        .then(function(data) {
            if (data.success) {
                document.getElementById('employeeModalTitle').innerText = 'Edit Employee';
                document.getElementById('employeeId').value = data.id;
                document.getElementById('empUsername').value = data.username;
                document.getElementById('empUsername').readOnly = true;
                document.getElementById('empFullName').value = data.fullName;
                document.getElementById('empPhone').value = data.phone || '';
                document.getElementById('empEmail').value = data.email || '';
                document.getElementById('empStatus').value = data.status;
                document.getElementById('empPassword').value = '';
                document.getElementById('empPassword').required = false;
                document.getElementById('empPasswordField').style.display = 'block';
                var modal = new bootstrap.Modal(document.getElementById('employeeModal'));
                modal.show();
            } else {
                alert('Error loading employee');
            }
        })
        .catch(function(err) { alert('Error: ' + err.message); });
}

    function saveEmployee() {
        var id = parseInt(document.getElementById('employeeId').value);
        var username = document.getElementById('empUsername').value.trim();
        var password = document.getElementById('empPassword').value;
        var fullName = document.getElementById('empFullName').value.trim();
        var phone = document.getElementById('empPhone').value.trim();
        var email = document.getElementById('empEmail').value.trim();
        var status = document.getElementById('empStatus').value;

        console.log("Saving employee:", {id, username, fullName, phone, email, status});

        if (!fullName) {
            alert('Please enter full name');
            return;
        }

        if (id === 0 && !username) {
            alert('Please enter username');
            return;
        }

        if (id === 0 && !password) {
            alert('Please enter password');
            return;
        }

        var url = id === 0 ? '/Employee/Create' : '/Employee/Edit';
        var data = id === 0 ? {
            username: username,
            password: password,
            fullName: fullName,
            phone: phone,
            email: email,
            status: status
        } : {
            id: id,
            fullName: fullName,
            phone: phone,
            email: email,
            status: status,
            password: password || null
        };

        fetch(url, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(data)
        })
        .then(function(res) { return res.json(); })
        .then(function(result) {
            console.log("Save result:", result);
            if (result.success) {
                alert(result.message);
                var modal = bootstrap.Modal.getInstance(document.getElementById('employeeModal'));
                if (modal) modal.hide();
                loadEmployees(); // Refresh the list
            } else {
                alert('Error: ' + result.message);
            }
        })
        .catch(function(err) {
            console.error("Save error:", err);
            alert('Error: ' + err.message);
        });
    }

    function loadSimpleAttendanceData() {
    const employeeSelect = document.getElementById('attEmployeeSelect');
    const userId = employeeSelect.value;
    
    if (!userId) {
        document.getElementById('attendanceTableBody').innerHTML = `
            <tr><td colspan="5" class="text-center text-muted">Select an employee to view attendance</td></tr>
        `;
        return;
    }
    
    // Get current month attendance (or all recent)
    const now = new Date();
    const year = now.getFullYear();
    const month = now.getMonth() + 1;
    
    fetch(`/Employee/GetAttendance?userId=${userId}&year=${year}&month=${month}`)
        .then(response => response.json())
        .then(data => {
            if (data.success && data.attendances && data.attendances.length > 0) {
                let rows = '';
                data.attendances.forEach(att => {
                    // Format date
                    const dateObj = new Date(att.date);
                    const formattedDate = `${dateObj.getMonth() + 1}/${dateObj.getDate()}/${dateObj.getFullYear()}`;
                    
                    // Format check-in time
                    const checkIn = att.checkInTime ? att.checkInTime.substring(0, 5) : '--:--';
                    const checkOut = att.checkOutTime ? att.checkOutTime.substring(0, 5) : '--:--';
                    
                    rows += `
                        <tr>
                            <td>${data.employeeName || 'N/A'}</td>
                            <td>${formattedDate}</td>
                            <td>${checkIn}</td>
                            <td>${checkOut}</td>
                            <td>${att.hoursWorked || 0}</td>
                        </tr>
                    `;
                });
                document.getElementById('attendanceTableBody').innerHTML = rows;
            } else {
                document.getElementById('attendanceTableBody').innerHTML = `
                    <tr><td colspan="5" class="text-center text-muted">No attendance records found for this employee</td></tr>
                `;
            }
        })
        .catch(error => {
            console.error('Error loading attendance:', error);
            document.getElementById('attendanceTableBody').innerHTML = `
                <tr><td colspan="5" class="text-center text-danger">Error loading attendance data</td></tr>
            `;
        });
}
     
        
       
