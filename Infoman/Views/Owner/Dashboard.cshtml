    }

    const now = new Date(receipt.date);
    
    // Build items HTML
    let itemsHtml = '';
    if (receipt.items && receipt.items.length > 0) {
        receipt.items.forEach(item => {
            itemsHtml += `
                <div style="display: flex; justify-content: space-between; margin-bottom: 8px; padding-bottom: 5px; border-bottom: 1px dotted #eee;">
                    <div>
                        <strong>${escapeHtml(item.name)}</strong><br>
                        <small>${item.size} × ${item.quantity}</small>
                    </div>
                    <div>₱${item.subtotal.toFixed(2)}</div>
                </div>
            `;
        });
    }
    
    // Build discount HTML
    let discountHtml = '';
    if (receipt.discountPercent > 0) {
        discountHtml = `
            <div style="display: flex; justify-content: space-between; font-size: 12px; color: #dc3545; margin-top: 5px;">
                <span>${receipt.discountType} (${receipt.discountPercent * 100}% OFF)</span>
                <span>-₱${receipt.discountAmount.toFixed(2)}</span>
