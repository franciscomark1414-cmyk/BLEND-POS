function renderSalesChart(data) {
    var canvas = document.getElementById('salesPerformanceChart');
    if (!canvas) return;
    
    var existingChart = Chart.getChart('salesPerformanceChart');
    if (existingChart) existingChart.destroy();
    
    var ctx = canvas.getContext('2d');
    var labels = (data && data.labels) ? data.labels : ['No Data'];
    var revenueData = (data && data.revenue) ? data.revenue : [0];
    var ordersData = (data && data.orders) ? data.orders : [0];
    
    new Chart(ctx, {
        type: 'bar',
        data: { 
            labels: labels, 
            datasets: [
                { 
                    label: 'Revenue (₱)', 
                    data: revenueData, 
                    backgroundColor: '#D4B000',  // Golden yellow
                    borderColor: '#B8960A', 
                    borderWidth: 1, 
                    borderRadius: 4,
                    yAxisID: 'y' 
                },
                { 
                    label: 'Orders', 
                    data: ordersData, 
                    type: 'line', 
                    backgroundColor: 'rgba(0, 181, 51, 0.1)', 
                    borderColor: '#00B533',  // Green
                    borderWidth: 2, 
                    fill: false, 
                    tension: 0.3, 
                    pointRadius: 4, 
                    pointBackgroundColor: '#00B533',
                    pointBorderColor: '#00B533',
                    yAxisID: 'y1' 
                }
            ] 
        },
        options: { 
            responsive: true, 
            maintainAspectRatio: true, 
            plugins: { 
                legend: { 
                    position: 'top', 
                    labels: { usePointStyle: true, boxWidth: 10 } 
                }, 
                tooltip: { mode: 'index', intersect: false } 
            }, 
            scales: { 
                y: { 
                    title: { display: true, text: 'Revenue (₱)', color: '#D4B000' }, 
                    beginAtZero: true,
                    grid: { color: '#e9ecef' }
                }, 
                y1: { 
                    position: 'right', 
                    title: { display: true, text: 'Orders', color: '#00B533' }, 
                    beginAtZero: true, 
                    grid: { drawOnChartArea: false } 
                } 
            } 
        }
    });
}

 function renderCategoryPieChart(categories) {
    var canvas = document.getElementById('categoryPieChart');
    if (!canvas) return;
    
    var existingChart = Chart.getChart('categoryPieChart');
    if (existingChart) existingChart.destroy();
    
    var ctx = canvas.getContext('2d');
    
    var labels = (categories && categories.length) ? categories.map(function(c) { return c.category; }) : ['No Data'];
    var values = (categories && categories.length) ? categories.map(function(c) { return c.revenue; }) : [1];
    
    // ✅ COLORS MULA SA GRADIENT MO (Green → Yellow → Orange)
    var colors = ['#00B533', '#8AAE12', '#D4B000', '#FF8A00', '#E8A317'];
    
    new Chart(ctx, {
        type: 'pie',
        data: { 
            labels: labels, 
            datasets: [{ 
                data: values, 
                backgroundColor: colors.slice(0, labels.length),
                borderWidth: 0,
                hoverOffset: 8
            }] 
        },
        options: { 
            responsive: true, 
            maintainAspectRatio: true, 
            plugins: { 
                legend: { 
                    position: 'bottom', 
                    labels: { 
                        font: { size: 11 },
                        usePointStyle: true,
                        boxWidth: 10
                    } 
                }, 
                tooltip: { 
                    callbacks: { 
                        label: function(context) { 
                            var label = context.label || ''; 
                            var value = context.raw || 0; 
                            var total = context.dataset.data.reduce(function(a, b) { return a + b; }, 0); 
                            var percentage = total > 0 ? ((value / total) * 100).toFixed(1) : 0; 
                            return label + ': ₱' + value.toFixed(2) + ' (' + percentage + '%)'; 
                        } 
                    } 
                } 
            } 
        } 
    });
}


// ========== EMPLOYEE MODULE FUNCTIONS ==========

function loadEmployees() {
    // Load both employees and their online status
    Promise.all([
        fetch('/Employee/GetAllEmployees').then(res => res.json()),
        fetch('/Owner/GetEmployeeOnlineStatus').then(res => res.json())
    ])
    .then(function([employees, statusData]) {
        var container = document.getElementById('employeesContainer');
        
        if (!employees || employees.length === 0) {
            container.innerHTML = '<div class="text-center py-5"><i class="fas fa-users fa-4x text-muted mb-3"></i><h5>No Employees Yet</h5><p class="text-muted">Click "Add Employee" to get started.</p></div>';
            return;
        }
        
        // Create maps for quick status lookup
        var onlineMap = {};
        var offlineMap = {};
        
        if (statusData.online) {
            for (var i = 0; i < statusData.online.length; i++) {
                var emp = statusData.online[i];
                onlineMap[emp.employeeId] = emp;
            }
        }
        
        if (statusData.offline) {
            for (var i = 0; i < statusData.offline.length; i++) {
                var emp = statusData.offline[i];
                offlineMap[emp.employeeId] = emp;
            }
        }
        
        var html = '';
        for (var i = 0; i < employees.length; i++) {
            var emp = employees[i];
            var statusInfo = onlineMap[emp.id] || offlineMap[emp.id];
            
            var statusBadge = '';
            var statusText = '';
            var statusIcon = '';
            var extraInfo = '';
            
            if (statusInfo && statusInfo.status === 'Online') {
                statusBadge = 'bg-success';
                statusIcon = '<i class="fas fa-circle" style="font-size: 10px; color: #10b981;"></i>';
                statusText = 'ONLINE 🟢';
                extraInfo = `
                    <div class="mt-2 pt-2 border-top">
                        <small><i class="fas fa-clock"></i> Time in: ${statusInfo.checkInTime || '--:--'}</small><br>
                        <small><i class="fas fa-hourglass-half"></i> Hours: ${(statusInfo.hoursWorked || 0).toFixed(1)} hrs</small>
                        <small class="d-block"><i class="fas fa-sign-in-alt"></i> Last login: ${statusInfo.lastLoginTime || '--:--'}</small>
                    </div>
                `;
            } else {
                statusBadge = 'bg-secondary';
                statusIcon = '<i class="fas fa-circle" style="font-size: 10px; color: #6b7280;"></i>';
                statusText = 'OFFLINE 🔴';
                
                if (statusInfo && (statusInfo.checkInTime || statusInfo.checkOutTime)) {
                    extraInfo = `
                        <div class="mt-2 pt-2 border-top">
                            <small><i class="fas fa-clock"></i> Time in: ${statusInfo.checkInTime || '--:--'}</small><br>
                            <small><i class="fas fa-sign-out-alt"></i> Time out: ${statusInfo.checkOutTime || '--:--'}</small><br>
                            <small><i class="fas fa-hourglass-half"></i> Hours: ${(statusInfo.hoursWorked || 0).toFixed(1)} hrs</small>
                        </div>
                    `;
                } else {
                    extraInfo = `
                        <div class="mt-2 pt-2 border-top">
                            <small class="text-muted"><i class="fas fa-clock"></i> No attendance today</small>
                        </div>
                    `;
                }
            }
            
            // Add last login info for offline employees
            if (!statusInfo || statusInfo.status !== 'Online') {
                if (statusInfo && statusInfo.lastLoginTime) {
                    extraInfo += `<small class="d-block mt-1"><i class="fas fa-sign-in-alt"></i> Last login: ${statusInfo.lastLoginTime}</small>`;
                }
                if (statusInfo && statusInfo.lastLogoutTime) {
                    extraInfo += `<small class="d-block"><i class="fas fa-sign-out-alt"></i> Last logout: ${statusInfo.lastLogoutTime}</small>`;
                }
            }
            
            html += '<div class="col-md-6 col-lg-4 mb-3">' +
                '<div class="employee-card">' +
                '<div class="d-flex align-items-start">' +
                '<div class="employee-avatar">' +
                '<i class="fas fa-user"></i>' +
                '</div>' +
                '<div class="flex-grow-1 ms-3">' +
                '<div class="d-flex justify-content-between align-items-start">' +
                '<div>' +
                '<div class="employee-name">' + escapeHtml(emp.fullName) + '</div>' +
                '<div class="employee-username">@@' + escapeHtml(emp.username) + '</div>' +
                '</div>' +
                '<div>' +
                '<span class="badge ' + statusBadge + ' px-2 py-1">' + statusIcon + ' ' + statusText + '</span>' +
                '</div>' +
                '</div>' +
                '<div class="row mt-2">' +
                '<div class="col-12">' +
                '<div class="employee-detail">' +
                '<i class="fas fa-envelope"></i> ' + escapeHtml(emp.email || 'No email') +
                '</div>' +
                '<div class="employee-detail">' +
                '<i class="fas fa-phone"></i> ' + escapeHtml(emp.phone || 'No phone') +
                '</div>' +
                '<div class="employee-detail">' +
                '<i class="fas fa-calendar-alt"></i> Joined: ' + escapeHtml(emp.dateJoined) +
                '</div>' +
                extraInfo +
                '</div>' +
                '</div>' +
                '<div class="mt-2">' +
                '<button class="btn btn-sm btn-outline-warning me-1" onclick="editEmployee(' + emp.id + ')">' +
                '<i class="fas fa-edit"></i> Edit' +
                '</button>' +
                '<button class="btn btn-sm btn-outline-danger" onclick="deleteEmployee(' + emp.id + ', \'' + escapeHtml(emp.fullName) + '\')">' +
                '<i class="fas fa-trash"></i> Delete' +
                '</button>' +
                '</div>' +
                '</div>' +
                '</div>' +
                '</div>' +
                '</div>';
        }
        container.innerHTML = html;
    })
    .catch(function(err) {
        console.error('Error loading employees:', err);
        document.getElementById('employeesContainer').innerHTML = '<div class="alert alert-danger">Error loading employees: ' + err.message + '</div>';
    });
}

// Function to refresh employee status
function refreshEmployeeStatus() {
    console.log('Refreshing employee status...');
    loadEmployees();
}

// Auto-refresh employee status every 30 seconds
var employeeStatusInterval = null;

function startEmployeeStatusAutoRefresh() {
    if (employeeStatusInterval) {
        clearInterval(employeeStatusInterval);
    }
    employeeStatusInterval = setInterval(function() {
        var employeesModule = document.getElementById('employeesModule');
        if (employeesModule && employeesModule.classList.contains('active')) {
            refreshEmployeeStatus();
        }
    }, 30000);
}

// Call this when DOM is ready or when switching to employees module
function initEmployeeModule() {
    loadEmployees();
    startEmployeeStatusAutoRefresh();
}


    function switchEmployeeTab(tab) {
    var listTab = document.getElementById('employeeListTab');
    var perfTab = document.getElementById('employeePerformanceTab');
    var attendTab = document.getElementById('employeeAttendanceTab');
    var tabs = document.querySelectorAll('#employeesModule .nav-link');

    for (var i = 0; i < tabs.length; i++) {
        tabs[i].classList.remove('active');
    }

    if (tab === 'list') {
        if (tabs[0]) tabs[0].classList.add('active');
        if (listTab) listTab.style.display = 'block';
        if (perfTab) perfTab.style.display = 'none';
        if (attendTab) attendTab.style.display = 'none';
        loadEmployees();  // Load when switching to list tab
        startEmployeeStatusAutoRefresh();  // Start auto-refresh
    }
   else if (tab === 'performance') {
    if (tabs[1]) tabs[1].classList.add('active');
    if (listTab) listTab.style.display = 'none';
    if (perfTab) perfTab.style.display = 'block';
    if (attendTab) attendTab.style.display = 'none';
    
    if (employeeStatusInterval) {
        clearInterval(employeeStatusInterval);
        employeeStatusInterval = null;
    }
    
    fetch('/Employee/GetAllEmployees')
        .then(response => response.json())
        .then(employees => {
            const perfSelect = document.getElementById('perfEmployeeSelect');
            if (perfSelect) {
                let options = '<option value="">-- Select Employee --</option>';
                employees.forEach(emp => {
                    options += `<option value="${emp.id}">${escapeHtml(emp.fullName)}</option>`;
                });
                perfSelect.innerHTML = options;
                
                // ✅ I-RESTORE ang dating napiling employee (kung meron)
                const oldValue = sessionStorage.getItem('selectedEmployeeId');
                if (oldValue) {
                    perfSelect.value = oldValue;
                }
            }
        });
}

    else if (tab === 'attendance') {
        if (tabs[2]) tabs[2].classList.add('active');
        if (listTab) listTab.style.display = 'none';
        if (perfTab) perfTab.style.display = 'none';
        if (attendTab) attendTab.style.display = 'block';
        // Stop auto-refresh when not on list tab
        if (employeeStatusInterval) {
            clearInterval(employeeStatusInterval);
            employeeStatusInterval = null;
        }
        // Load employees into attendance dropdown
        fetch('/Employee/GetAllEmployees')
            .then(response => response.json())
            .then(employees => {
                const attSelect = document.getElementById('attEmployeeSelect');
                if (attSelect) {
                    attSelect.innerHTML = '<option value="">-- Select Employee --</option>';
                    employees.forEach(emp => {
                        attSelect.innerHTML += `<option value="${emp.id}">${emp.fullName}</option>`;
                    });
                }
            });
    }
}

// ========== LOAD EMPLOYEE DAILY ORDERS ==========
async function loadEmployeeDailyOrders() {
    const employeeSelect = document.getElementById('perfEmployeeSelect');
    const employeeId = employeeSelect.value;
    
    if (!employeeId) {
        document.getElementById('perfTotalSales').innerHTML = '₱0.00';
        document.getElementById('perfTotalOrders').innerHTML = '0';
        document.getElementById('dailyOrdersBody').innerHTML = `
            <tr><td colspan="4" class="text-center text-muted">Select an employee to view orders</td><\/tr>
        `;
        return;
    }
    
    showLoading('Loading employee orders...');
    
    try {
        const response = await fetch(`/Employee/GetEmployeeDailyOrders?employeeId=${employeeId}&days=30`);
        const data = await response.json();
        
        if (data.success) {
            let totalSales = 0;
            let totalOrders = 0;
            let html = '';
            
            data.dailyOrders.forEach(day => {
                totalSales += day.totalSales;
                totalOrders += day.orderCount;
                
                const formattedDate = new Date(day.date).toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric'
                });
                
                html += `
                    <tr>
                        <td class="fw-bold">${formattedDate}<\/td>
                        <td>${day.orderCount} order(s)<\/td>
                        <td class="text-primary fw-bold">₱${day.totalSales.toFixed(2)}<\/td>
                        <td>
                            <button class="btn btn-sm btn-info" onclick='showDailyOrdersModal(${JSON.stringify(day.orders)}, "${formattedDate}")'>
                                <i class="fas fa-eye me-1"></i> View All (${day.orderCount})
                            </button>
                        <\/td>
                    <\/tr>
                `;
            });
            
            document.getElementById('perfTotalSales').innerHTML = `₱${totalSales.toFixed(2)}`;
            document.getElementById('perfTotalOrders').innerHTML = totalOrders;
            document.getElementById('dailyOrdersBody').innerHTML = html;
        }
    } catch (error) {
        console.error('Error:', error);
        await showAlert('Error loading employee orders', 'Error', '❌');
    } finally {
        hideLoading();
    }
}

// ========== SHOW DAILY ORDERS MODAL ==========
function showDailyOrdersModal(orders, dateString) {
    const modal = new bootstrap.Modal(document.getElementById('dailyOrdersModal'));
    const title = document.getElementById('dailyOrdersModalTitle');
    const container = document.getElementById('dailyOrdersList');
    
    title.innerHTML = `<i class="fas fa-calendar-day me-2"></i> Orders for ${dateString}`;
    
    if (!orders || orders.length === 0) {
        container.innerHTML = '<div class="text-center text-muted py-4">No orders found for this date</div>';
        modal.show();
        return;
    }
    
    let html = '';
    orders.forEach(order => {
        // Determine status badge
        let statusBadge = '';
        let statusIcon = '';
        
        if (order.status === 'COMPLETED') {
            statusBadge = '<span class="badge bg-success">✅ COMPLETED</span>';
            statusIcon = '✅';
        } else if (order.status === 'VOIDED') {
            statusBadge = '<span class="badge bg-danger">⚠️ VOIDED</span>';
            statusIcon = '⚠️';
        } else if (order.status === 'REFUNDED') {
            statusBadge = '<span class="badge bg-warning text-dark">💰 REFUNDED</span>';
            statusIcon = '💰';
        } else if (order.status === 'PENDING_BLENDING') {
            statusBadge = '<span class="badge bg-info">⏳ PENDING BLENDING</span>';
            statusIcon = '⏳';
        } else {
            statusBadge = `<span class="badge bg-secondary">${order.status}</span>`;
            statusIcon = '📋';
        }
        
        // Check for exchange
        if (order.returnStatus === 'EXCHANGED') {
            statusBadge = '<span class="badge bg-warning text-dark">🔄 EXCHANGED</span>';
            statusIcon = '🔄';
        }
        
        // Add warning flag for problematic orders
        let warningFlag = '';
        if (order.status === 'VOIDED') {
            warningFlag = '<span class="text-danger ms-2"><i class="fas fa-ban"></i> VOID</span>';
        } else if (order.status === 'REFUNDED') {
            warningFlag = '<span class="text-warning ms-2"><i class="fas fa-money-bill-wave"></i> REFUND</span>';
        } else if (order.returnStatus === 'EXCHANGED') {
            warningFlag = '<span class="text-warning ms-2"><i class="fas fa-exchange-alt"></i> EXCHANGE</span>';
        }
        
        const orderTime = new Date(order.date).toLocaleTimeString();
        
        // Determine border color based on order status
        let borderColor = '#28a745';
        if (order.status === 'VOIDED') borderColor = '#dc3545';
        else if (order.status === 'REFUNDED') borderColor = '#ffc107';
        else if (order.returnStatus === 'EXCHANGED') borderColor = '#fd7e14';
        
        html += `
            <div class="list-group-item d-flex justify-content-between align-items-center" style="border-left: 4px solid ${borderColor};">
                <div>
                    <div class="fw-bold">
                        ${statusIcon} Order #${order.orderNumber}
                        ${warningFlag}
                    </div>
                    <small class="text-muted">${orderTime}</small>
                    <div class="mt-1">
                        ${statusBadge}
                        ${order.discountType && order.discountAmount > 0 ? `<span class="badge bg-secondary ms-1">${order.discountType} -₱${order.discountAmount.toFixed(2)}</span>` : ''}
                    </div>
                </div>
                <div class="text-end">
                    <div class="fw-bold text-primary fs-5">₱${order.totalAmount.toFixed(2)}</div>
                    <button class="btn btn-sm btn-outline-info mt-2" onclick="viewReceiptDetail(${order.orderId})">
                        <i class="fas fa-receipt"></i> View Receipt
                    </button>
                </div>
            </div>
        `;
    });
    
    container.innerHTML = html;
    modal.show();
}

    async function deleteEmployee(employeeId, employeeName) {
    const confirmed = await showConfirm(
        `Delete employee "${employeeName}"?\n\nThis action cannot be undone.`,
        'Delete Employee'
    );
    
    if (!confirmed) return;
    
    showLoading('Deleting employee...');
    
    try {
        const response = await fetch(`/Employee/Delete?id=${employeeId}`, {
            method: 'POST',
            headers: {
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
            }
        });
        
        const result = await response.json();
        hideLoading();
        
        if (result.success) {
            await showAlert( result.message, 'Success');
            loadEmployees(); // Refresh the list
        } else {
            await showAlert('Error: ' + result.message, 'Error');
        }
    } catch (error) {
        hideLoading();
        await showAlert(' Error: ' + error.message, 'Error');
    }
}

