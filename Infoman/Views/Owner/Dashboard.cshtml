        exchangeInfoHtml = `
            <div id="exchangeInfoContainer" style="background: #e8f5e9; padding: 12px; border-radius: 8px; margin: 10px 0; font-size: 12px; border-left: 4px solid #28a745;">
                <div style="font-weight: bold; margin-bottom: 8px;">
                    <i class="fas fa-exchange-alt"></i> REPLACEMENT ORDER
                </div>
