                    </button>
                `;
            } else {
                statusBadge = '<span class="badge bg-secondary">❌ Cancelled</span>';
                statusActions = '';
            }
            
            const returnDate = new Date(r.returnDate);
            const formattedDate = `${returnDate.getMonth()+1}/${returnDate.getDate()}/${returnDate.getFullYear()}`;
            
            html += `
                <tr>
                    <td><code>${escapeHtml(r.returnNumber)}</code></td>
                    <td>${formattedDate}</td>
                    <td>${escapeHtml(r.drNumber)}<\/td>
                    <td><strong>${escapeHtml(r.supplierName)}<\/strong></td>
