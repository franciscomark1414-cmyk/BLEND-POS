                            <span class="badge bg-info me-1">⏰ @ViewBag.ExpiringCount</span>
                        }
                        @if (ViewBag.ExpiredCount > 0)
                        {
                            <span class="badge bg-danger me-1">❌ @ViewBag.ExpiredCount</span>
                        }
                        @if (ViewBag.WasteCount > 0)
                        {
                            <span class="badge bg-secondary">🗑️ @ViewBag.WasteCount</span>
                        }
                    </div>
                }
            </div>
        </a>
    </div>

    <div class="dash-grid">
