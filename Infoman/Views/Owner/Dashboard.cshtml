   // ========== LOAD PERFORMANCE DATA FUNCTION (WITH VIEW BUTTON) ==========
function loadPerformanceData() {
    const employeeSelect = document.getElementById('perfEmployeeSelect');
    const userId = employeeSelect.value;

    if (!userId) {
        document.getElementById('perfTotalSales').innerHTML = '₱0.00';
        document.getElementById('perfTotalOrders').innerHTML = '0';
        document.getElementById('performanceTableBody').innerHTML = `
            <tr><td colspan="5" class="text-center text-muted">Select an employee to view performance<\/td><\/tr>
        `;
        return;
    }

    // Get last 30 days by default
    const endDate = new Date();
    const startDate = new Date();
    startDate.setDate(startDate.getDate() - 30);

    const startDateStr = startDate.toISOString().split('T')[0];
    const endDateStr = endDate.toISOString().split('T')[0];

    showLoading('Loading performance data...');

    fetch(`/Employee/GetPerformance?userId=${userId}&startDate=${startDateStr}&endDate=${endDateStr}`)
        .then(response => response.json())
        .then(async (data) => {
            hideLoading();
            if (data.success) {
                document.getElementById('perfTotalSales').innerHTML = `₱${(data.summary.totalSales || 0).toFixed(2)}`;
                document.getElementById('perfTotalOrders').innerHTML = data.summary.totalOrders || 0;

                let rows = '';
                if (data.performances && data.performances.length > 0) {
                    for (const perf of data.performances) {
                        const dateObj = new Date(perf.date);
                        const formattedDate = `${dateObj.getMonth() + 1}/${dateObj.getDate()}/${dateObj.getFullYear()}`;
                        const dateString = perf.date.split('T')[0];
                        
                        // Fetch orders for this specific date
                        let ordersForDate = [];
                        try {
                            const ordersResponse = await fetch(`/Employee/GetEmployeeOrdersByDate?employeeId=${userId}&date=${dateString}`);
                            const ordersData = await ordersResponse.json();
                            if (ordersData.success) {
                                ordersForDate = ordersData.orders;
                            }
                        } catch (err) {
                            console.error('Error fetching orders for date:', err);
                        }
                        
                        rows += `
                            <tr>
                                <td>${formattedDate}</td>
                                <td>₱${(perf.totalSales || 0).toFixed(2)}</td>
                                <td>${perf.ordersProcessed || 0}</td>
                                <td>${perf.notes || '-'}</td>
                                <td>
                                    <button class="btn btn-sm btn-info" onclick='showDailyOrdersModal(${JSON.stringify(ordersForDate)}, "${formattedDate}")'>
                                        <i class="fas fa-eye"></i> View (${perf.ordersProcessed})
                                    </button>
                                </td>
                            </tr>
                        `;
                    }
                } else {
                    rows = `<tr><td colspan="5" class="text-center text-muted">No performance records found for this employee<\/td><\/tr>`;
                }
                document.getElementById('performanceTableBody').innerHTML = rows;
            }
        })
        .catch(error => {
            hideLoading();
            console.error('Error loading performance:', error);
            document.getElementById('performanceTableBody').innerHTML = `<tr><td colspan="5" class="text-center text-danger">Error loading performance data<\/td><\/tr>`;
        });
}

