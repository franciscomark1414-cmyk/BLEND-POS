function onAddOnMaterialChange(selectEl) {
    const row = selectEl.closest('.ingredient-row');
    const unitSelect = row.querySelector('.addon-ing-unit');
    const selectedOpt = selectEl.options[selectEl.selectedIndex];
    const matUnit = selectedOpt.getAttribute('data-unit');

    if (!matUnit) {
        unitSelect.value = 'g';
        return;
    }

    // Enable/disable units based on material type
    const weight = ['kg', 'g'];
    const volume = ['L', 'mL'];
    const count = ['pcs'];

    let allowed = [];
    if (weight.includes(matUnit)) allowed = weight;
    else if (volume.includes(matUnit)) allowed = volume;
    else if (count.includes(matUnit)) allowed = count;

    for (let opt of unitSelect.options) {
        opt.disabled = !allowed.includes(opt.value);
    }

    // Auto-select first valid
    if (!allowed.includes(unitSelect.value)) {
        unitSelect.value = allowed[0] || 'g';
    }
}

function recalcAddOnRecipeCost() {
    const rows = document.querySelectorAll('#addOnIngredientsBody .ingredient-row');
    let totalCost = 0;

    rows.forEach(row => {
        const matSelect = row.querySelector('.addon-ing-material');
        const qtyInput = row.querySelector('.addon-ing-qty');
        const unitSelect = row.querySelector('.addon-ing-unit');

        const matId = parseInt(matSelect.value);
        const qty = parseFloat(qtyInput.value) || 0;
        const unit = unitSelect.value;

        if (!matId || qty <= 0) return;

        const mat = addOnRawMaterialsList.find(m => m.id === matId);
        if (!mat) return;

        // Get price per base/cost unit
        const price = mat.latestBatchPrice > 0 ? mat.latestBatchPrice : (mat.defaultPrice || 0);

        // Convert qty to cost unit (kg / L / pcs)
        let qtyForCost = qty;
        if (unit === 'g' && mat.unit === 'kg') qtyForCost = qty / 1000;
        else if (unit === 'kg' && mat.unit === 'g') qtyForCost = qty * 1000;
        else if (unit === 'mL' && mat.unit === 'L') qtyForCost = qty / 1000;
        else if (unit === 'L' && mat.unit === 'mL') qtyForCost = qty * 1000;

        totalCost += qtyForCost * price;
    });

    document.getElementById('addOnRecipeCost').innerText = '₱' + totalCost.toFixed(2);

    // Update auto-price display if in auto mode
    if (document.getElementById('addOnPriceAuto').checked) {
        updateAddOnAutoPrice();
    }
}

// ============ FORM: SAVE ============
async function saveAddOn(e) {
    e.preventDefault();

    const addOnId = parseInt(document.getElementById('addOnEditId').value) || 0;
    const name = document.getElementById('addOnName').value.trim();
    const category = document.getElementById('addOnCategory').value;
    const maxPerOrder = parseInt(document.getElementById('addOnMaxPerOrder').value) || 1;
    const isManualPrice = document.getElementById('addOnPriceManual').checked;
    const isActive = document.getElementById('addOnIsActive').checked;

    if (!name) {
        await showAlert('Please enter add-on name.', 'Required');
        return;
    }

    if (!category || category.trim() === '') {
        await showAlert('Please select a category.', 'Required', '⚠️');
        return;
    }

    const ingredients = [];
    const rows = document.querySelectorAll('#addOnIngredientsBody .ingredient-row');
    for (const row of rows) {
        const matId = parseInt(row.querySelector('.addon-ing-material').value);
        const qty = parseFloat(row.querySelector('.addon-ing-qty').value);
        const unit = row.querySelector('.addon-ing-unit').value;

        if (!matId) continue;
        if (!qty || qty <= 0) {
            await showAlert('Please enter valid quantity.', 'Invalid');
            return;
        }
        ingredients.push({ rawMaterialId: matId, quantity: qty, unitUsed: unit });
    }

    if (ingredients.length === 0) {
        await showAlert('Please add at least one ingredient.', 'Required');
        return;
    }

    let price = 0;
    let margin = 0.3;

    if (isManualPrice) {
        price = parseFloat(document.getElementById('addOnPrice').value) || 0;
        if (price <= 0) {
            await showAlert('Please enter a valid price.', 'Required');
            return;
        }
    } else {
        // ✅ FIX: I-check kung 0 ang recipe cost bago mag-compute
        margin = parseFloat(document.getElementById('addOnMargin').value) || 0.3;
        
        recalcAddOnRecipeCost();
        
        const recipeCost = parseFloat(
            document.getElementById('addOnRecipeCost').innerText.replace('₱', '')
        ) || 0;
        
        if (recipeCost <= 0) {
            await showAlert(
                'Recipe cost is 0.00. This means your ingredients have NO BATCH PRICE (UnitPrice = 0).\n\nPlease go to "Receive Delivery" to add stock with a valid price for these ingredients first.',
                'Cannot Compute Price', 
                '⚠️'
            );
            return;
        }
        
        price = roundToEnding9(recipeCost / (1 - margin));
    }

    if (price <= 0) {
        await showAlert('Computed price is invalid. Please check your recipe and margin.', 'Invalid Price', '⚠️');
        return;
    }

    const payload = {
        addOnId: addOnId,
        name: name,
        category: category,
        price: price,
        margin: margin,
        isManualPrice: isManualPrice,
        maxPerOrder: maxPerOrder,
        isActive: isActive,
        ingredients: ingredients
    };

    showLoading('Saving add-on...');
    try {
        const url = addOnId === 0 ? '/Owner/CreateAddOn' : '/Owner/UpdateAddOn';
        const res = await fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getAddOnToken() },
            body: JSON.stringify(payload)
        });
        const data = await res.json();
        hideLoading();

        if (data.success) {
            await showAlert(data.message, 'Success', '✅');
            resetAddOnForm();
            await loadAddOns();
        } else {
            await showAlert(data.message, 'Error', '❌');
        }
    } catch (err) {
        hideLoading();
        await showAlert('Error: ' + err.message, 'Error', '❌');
    }
}

// ============ FORM: EDIT ============
async function editAddOn(addOnId) {
    const addOn = addOnCache.find(a => a.addOnId === addOnId);
    if (!addOn) return;

    document.getElementById('addOnEditId').value = addOn.addOnId;
    document.getElementById('addOnName').value = addOn.name;
    document.getElementById('addOnMaxPerOrder').value = addOn.maxPerOrder;
    document.getElementById('addOnIsActive').checked = addOn.isActive;
    document.getElementById('addOnIsActive').disabled = false;

    // ✅ I-LOAD ANG CATEGORY SA DROPDOWN
    await loadCategoryDropdown('addOnCategory', 'AddOn', {
        valueKey: 'name',
        selected: addOn.category || null,
        placeholder: '-- No Category --'
    });

    if (addOn.isManualPrice) {
        document.getElementById('addOnPriceManual').checked = true;
        document.getElementById('addOnPrice').value = addOn.price.toFixed(2);
    } else {
        document.getElementById('addOnPriceAuto').checked = true;
        document.getElementById('addOnMargin').value = addOn.margin.toString();
    }

    // Populate ingredients
    document.getElementById('addOnIngredientsBody').innerHTML = '';
    addOnIngredientCounter = 0;

    if (addOn.ingredients && addOn.ingredients.length > 0) {
        for (const ing of addOn.ingredients) {
            await addAddOnIngredientRow({
                rawMaterialId: ing.rawMaterialId,
                quantity: ing.quantity,
                unitUsed: ing.unitUsed
            });
        }
    }

    document.getElementById('addOnFormTitle').innerHTML = '<i class="fas fa-edit me-2"></i>Edit Add-on';
    document.getElementById('addOnCancelBtn').style.display = 'inline-block';
    document.getElementById('addOnActiveSection').style.display = 'block';

    toggleAddOnPriceMode();
}

// ============ TOGGLE ACTIVE ============
async function toggleAddOn(addOnId, currentActive) {
    const confirmed = await showConfirm(
        `Mark this add-on as ${currentActive ? 'Inactive' : 'Active'}?`,
        'Toggle Status'
    );
    if (!confirmed) return;

    showLoading('Updating...');
    try {
        const res = await fetch('/Owner/ToggleAddOnActive', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': getAddOnToken()
            },
            body: JSON.stringify({ addOnId, isActive: !currentActive })
        });
        const data = await res.json();
        hideLoading();

        if (data.success) {
            await showAlert(data.message, 'Success', '✅');
            await loadAddOns();
        } else {
            await showAlert(data.message, 'Error', '❌');
        }
    } catch (err) {
        hideLoading();
        await showAlert('Error: ' + err.message, 'Error', '❌');
    }
}

// ============ DELETE ============
async function deleteAddOn(addOnId) {
    const addOn = addOnCache.find(a => a.addOnId === addOnId);
    if (!addOn) return;

    const confirmed = await showConfirm(
        `Delete add-on "${addOn.name}"?\n\nThis will hide it from POS.\nHistorical orders will not be affected.`,
        'Delete Add-on'
    );
    if (!confirmed) return;

    showLoading('Deleting...');
    try {
        const res = await fetch(`/Owner/DeleteAddOn?id=${addOnId}`, {
            method: 'POST',
