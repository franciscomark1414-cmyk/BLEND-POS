function createSupplierReturn(receivingItemId, maxQty, itemName, unitPrice) {
    // Store data for later use
    currentReturnData = {
        receivingItemId: receivingItemId,
        maxQty: maxQty,
        itemName: itemName,
        unitPrice: unitPrice
    };
    
    // ✅ CLOSE THE DELIVERY DETAILS MODAL FIRST
    const deliveryModal = document.getElementById('deliveryDetailsModal');
    if (deliveryModal) {
        deliveryModal.remove();
    }
    
    // ✅ CLOSE any existing supplier return modal
    const existingModal = document.getElementById('supplierReturnModal');
    if (existingModal) {
        existingModal.style.display = 'none';
    }
    
    // ✅ SMALL DELAY para magsara muna ang delivery modal bago lumabas ang return modal
    setTimeout(function() {
        // Show modal
        const modal = document.getElementById('supplierReturnModal');
        const itemInfo = document.getElementById('supplierReturnItemInfo');
        const qtyInput = document.getElementById('returnQuantity');
        const maxHint = document.getElementById('returnMaxQtyHint');
        const reasonSelect = document.getElementById('returnReason');
        const otherReason = document.getElementById('returnOtherReason');
        
        // Reset form
        qtyInput.value = maxQty;
        qtyInput.max = maxQty;
        reasonSelect.value = 'Damaged Packaging';
        otherReason.style.display = 'none';
        otherReason.value = '';
        
        // Set item info
        itemInfo.innerHTML = `
            <strong>Item:</strong> ${escapeHtml(itemName)}<br>
            <strong>Unit Price:</strong> ₱${unitPrice.toFixed(2)}<br>
            <strong>Max Quantity:</strong> ${maxQty}
        `;
        maxHint.innerHTML = `Max: ${maxQty}`;
        
        // Set onchange handlers
        qtyInput.onchange = async function() {
            let val = parseFloat(this.value);
            if (isNaN(val)) val = 0;
            if (val > maxQty) {
                this.value = maxQty;
                await showAlert(`Maximum quantity is ${maxQty}`, 'Limit Reached', '⚠️');
            }
            if (val < 0) this.value = 0;
        };
        
        reasonSelect.onchange = function() {
            const otherInput = document.getElementById('returnOtherReason');
            if (this.value === 'Other') {
                otherInput.style.display = 'block';
            } else {
                otherInput.style.display = 'none';
                otherInput.value = '';
            }
        };
        
        // Make sure modal is on top
        modal.style.display = 'flex';
        modal.style.zIndex = '10006';
    }, 100); // 100ms delay para magsara muna ang delivery modal
}

function closeSupplierReturnModal() {
