async function loadPendingRequests() {
    try {
        const response = await fetch('/Owner/GetPendingRequests');
        const requests = await response.json();
        
        const tbody = document.getElementById('pendingRequestsTableBody');
        const badge = document.getElementById('pendingTabBadge');
        
        if (!tbody) {
            console.warn('pendingRequestsTableBody not found');
            return;
        }
        
        if (!requests || requests.length === 0) {
            tbody.innerHTML = '</table><td colspan="6" class="text-center text-muted">No pending requests</td><\/tr>';
            if (badge) badge.innerText = '0';
            return;
        }
        
        if (badge) badge.innerText = requests.length;
        
        let html = '';
        requests.forEach(req => {
            const typeBadge = req.requestType === 'VOID' ?
                '<span class="badge bg-danger">VOID</span>' :
                '<span class="badge bg-warning">REFUND</span>';
            
            const date = new Date(req.requestedAt);
            const formattedDate = `${date.getMonth()+1}/${date.getDate()}/${date.getFullYear()}, ${date.toLocaleTimeString()}`;
            
            // ✅ CORRECTED ORDER NG COLUMNS
            html += `
                <tr>
                    <td style="white-space: nowrap;">${formattedDate}</td>
                    <td><strong>${escapeHtml(req.orderNumber)}</strong><br>${typeBadge}</td>
                    <td>${escapeHtml(req.reason)}</td>
                    <td>${escapeHtml(req.requesterName)}</td>
                    <td class="text-danger fw-bold text-end">₱${(req.orderTotal || 0).toFixed(2)}</td>
                    <td class="text-center" style="white-space: nowrap;">
                        <button class="btn btn-sm btn-success me-1" onclick="approveRequest(${req.id})">
                            <i class="fas fa-check"></i> Approve
                        </button>
                        <button class="btn btn-sm btn-danger" onclick="rejectRequest(${req.id})">
                            <i class="fas fa-times"></i> Reject
                        </button>
                    </td>
                </table>
            `;
        });
        tbody.innerHTML = html;
    } catch (error) {
        console.error('Error loading pending:', error);
        const tbody = document.getElementById('pendingRequestsTableBody');
        if (tbody) {
            tbody.innerHTML = '<tr><td colspan="6" class="text-center text-danger">Error loading requests</td><\/tr>';
        }
    }
}


async function loadApprovedReturns() {
    try {
        const response = await fetch('/Owner/GetApprovedReturns');
        const data = await response.json();
        
        const tbody = document.getElementById('approvedReturnsTableBody');
        const badge = document.getElementById('approvedTabBadge');
        
        if (!tbody) {
            console.warn('approvedReturnsTableBody not found');
            return;
        }
        
        let returns = [];
        if (data && data.$values) returns = data.$values;
        else if (data && Array.isArray(data)) returns = data;
        else returns = [];
        
        if (badge) badge.innerText = returns.length;
        
        if (returns.length === 0) {
            tbody.innerHTML = '<tr><td colspan="7" class="text-center text-muted">No approved records</td></tr>';
            return;
        }
        
        let html = '';
        for (let i = 0; i < returns.length; i++) {
            const r = returns[i];
            const date = new Date(r.recordedAt);
            const formattedDate = `${date.getMonth()+1}/${date.getDate()}/${date.getFullYear()}`;
            
            let typeBadge = '';
            let displayType = '';
            if (r.requestType === 'VOID') {
                typeBadge = '<span class="badge bg-danger">VOID</span>';
                displayType = 'VOID';
            } else {
                typeBadge = '<span class="badge bg-warning">REFUND</span>';
                displayType = 'REFUND';
            }
            
            // ✅ Check if this is a direct void (has Source = 'DIRECT')
            const isPendingRequest = r.source !== 'DIRECT';  // Direct voids are NOT in PendingRequests
            
            html += `
                <tr>
                    <td>${formattedDate}</td>
                    <td><strong>${escapeHtml(r.orderNumber)}</strong><br>${typeBadge}</td>
                    <td>${displayType}</td>
                    <td>${escapeHtml(r.reason)}</td>
                    <td class="text-danger fw-bold">₱${Math.abs(r.amount || 0).toFixed(2)}</td>
                    <td>${escapeHtml(r.requesterName)}</td>
                    <td>
                        <button class="btn btn-sm btn-info" onclick="viewReturnDetails(${r.id}, ${!isPendingRequest})">
                            <i class="fas fa-eye"></i> View
                        </button>
                    </td>
                </tr>
            `;
        }
        tbody.innerHTML = html;
    } catch (error) {
        console.error('Error loading approved:', error);
        const tbody = document.getElementById('approvedReturnsTableBody');
        if (tbody) {
            tbody.innerHTML = '<tr><td colspan="7" class="text-center text-danger">Error loading records</td></tr>';
        }
    }
}

async function loadSupplierReturns() {
    try {
        const response = await fetch('/Owner/GetSupplierReturns');
        const data = await response.json();
        
        const tbody = document.getElementById('supplierReturnsTableBody');
        
        if (!data.returns || data.returns.length === 0) {
            if (tbody) tbody.innerHTML = '<tr><td colspan="9" class="text-center text-muted">No supplier returns yet<\/td><\/tr>';
            updateSupplierSummary({ pendingCount: 0, completedCount: 0, cancelledCount: 0 });
            return;
        }
        
        updateSupplierSummary(data.summary);
        
        let html = '';
        data.returns.forEach(r => {
            let statusBadge = '';
            let statusActions = '';
            
            if (r.status === 'Pending Return') {
                statusBadge = '<span class="badge bg-warning">⏳ Pending Return</span>';
                statusActions = `
                    <button class="btn btn-sm btn-success me-1" onclick="markReturnCompleted(${r.returnId})">
