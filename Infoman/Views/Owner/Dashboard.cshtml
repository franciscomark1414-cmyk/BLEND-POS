    // ✅ SINGLE TITLE LANG
    receiptDiv.innerHTML = `
        <div style="text-align: center; margin-bottom: 15px;">
            <div><strong>${now.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' })}</strong></div>
            <div>${now.toLocaleTimeString()}</div>
            <div><small>Receipt #: ${escapeHtml(receipt.receiptNumber)}</small></div>
            <div><small class="fw-bold">Order #: ${receipt.orderId}</small></div>
        </div>
        ${exchangeInfoHtml}
        <hr>
        <div style="margin-bottom: 10px;">
            <strong>Order Summary</strong>
        </div>
        ${itemsHtml}
        <hr>
        <div style="display: flex; justify-content: space-between; margin-top: 8px;">
            <span>Subtotal</span>
            <span>₱${receipt.subtotal.toFixed(2)}</span>
        </div>
        ${discountHtml}
        <div style="display: flex; justify-content: space-between; font-weight: bold; font-size: 16px; border-top: 2px solid #333; margin-top: 10px; padding-top: 10px;">
            <span>TOTAL</span>
            <span>₱${receipt.total.toFixed(2)}</span>
        </div>
        <div style="margin-top: 15px; text-align: center; padding-top: 10px; border-top: 1px dashed #ccc;">
            <div>Payment: <strong>${escapeHtml(receipt.paymentMethod)}</strong></div>
            <div style="margin-top: 5px;">✅ Order ${receipt.returnStatus === 'EXCHANGED' ? 'Exchanged' : 'Completed'}</div>
        </div>
        <hr>
        <div style="text-align: center; font-size: 11px; color: #aaa;">
            Thank you for your purchase!
        </div>
    `;
    
    // ✅ Load exchange details kung meron
    if (receipt.returnStatus === 'EXCHANGED' || (receipt.originalOrderId && receipt.originalOrderId > 0)) {
        loadExchangeDetailsForReceipt(receipt.orderId, receipt.originalOrderId);
    }
    
    const receiptModal = document.getElementById('receiptModalForReports');
    if (receiptModal) {
        receiptModal.style.display = 'flex';
    }
}

// ✅ BAGONG FUNCTION: Load exchange details
async function loadExchangeDetailsForReceipt(orderId, originalOrderId) {
    try {
        const response = await fetch(`/Owner/GetExchangeDetails?orderId=${orderId}`);
        const data = await response.json();
        
        const exchangeDiv = document.getElementById('exchangeDetailsContent');
        if (!exchangeDiv) return;
        
        if (data.success && data.exchange) {
            const ex = data.exchange;
            let html = '';
            
            if (ex.originalOrderId) {
                // ITO AY EXCHANGED ORDER (Order #23 ay pinalitan)
                html = `
                    <div>This order has been exchanged to <strong>Order #${ex.newOrderId}</strong></div>
                    <div>Reason: <strong>${escapeHtml(ex.reason)}</strong></div>
                    <div class="mt-2"><strong>Items returned:</strong></div>
                    ${ex.returnedItems.map(i => `<div>• ${i.quantity}x ${escapeHtml(i.productName)} (${i.sizeName}) - ₱${(i.price * i.quantity).toFixed(2)}</div>`).join('')}
                    <div class="mt-2"><strong>Replacement items:</strong></div>
                    ${ex.replacementItems.map(i => `<div>• ${i.quantity}x ${escapeHtml(i.productName)} (${i.sizeName}) - ₱${(i.price * i.quantity).toFixed(2)}</div>`).join('')}
                    <div class="mt-2 pt-2 border-top">
                        <div>Return value: -₱${ex.originalAmount.toFixed(2)}</div>
                        <div>Replacement value: +₱${ex.replacementAmount.toFixed(2)}</div>
                        <div class="fw-bold">${ex.adjustmentAmount > 0 ? `Customer paid additional: +₱${ex.adjustmentAmount.toFixed(2)}` : (ex.adjustmentAmount < 0 ? `Store credit applied: -₱${Math.abs(ex.adjustmentAmount).toFixed(2)}` : 'No price difference')}</div>
                    </div>
                `;
            } else if (ex.newOrderId === orderId) {
                // ITO AY REPLACEMENT ORDER (Order #24 ay pumalit kay #23)
                html = `
                    <div>This order replaces <strong>Order #${ex.originalOrderId}</strong></div>
                    <div>Reason: <strong>${escapeHtml(ex.reason)}</strong></div>
                    <div class="mt-2"><strong>Replacement items:</strong></div>
                    ${ex.replacementItems.map(i => `<div>• ${i.quantity}x ${escapeHtml(i.productName)} (${i.sizeName}) - ₱${(i.price * i.quantity).toFixed(2)}</div>`).join('')}
                    <div class="mt-2 pt-2 border-top">
                        <div>Store credit applied: -₱${ex.originalAmount.toFixed(2)}</div>
                        <div>Additional payment: +₱${ex.adjustmentAmount > 0 ? ex.adjustmentAmount.toFixed(2) : '0'}</div>
                    </div>
                `;
            }
            
            exchangeDiv.innerHTML = html;
        } else {
            exchangeDiv.innerHTML = '<div class="text-muted">No exchange details available</div>';
        }
    } catch (error) {
        console.error('Error loading exchange details:', error);
        const exchangeDiv = document.getElementById('exchangeDetailsContent');
        if (exchangeDiv) {
            exchangeDiv.innerHTML = '<div class="text-danger">Error loading exchange details</div>';
        }
    }
}

