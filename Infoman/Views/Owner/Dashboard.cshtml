function updateNewIngredientUnitDropdown(selectElement) {
    // ✅ FIX: Hanapin ang .ingredient-row o tr
    const row = selectElement.closest('.ingredient-row') || selectElement.closest('tr');
    if (!row) return;

    const unitSelect = row.querySelector('.unit-select');
    const selectedOption = selectElement.options[selectElement.selectedIndex];
    const materialUnit = selectedOption.getAttribute('data-unit');
    
    if (!materialUnit) {
        // Kung walang napiling ingredient, i-reset sa default
        unitSelect.value = "";
        return;
    }
    
    const weightUnits = ['kg', 'g'];
    const volumeUnits = ['L', 'mL'];
    let allowedUnits = [];
    
    if (weightUnits.includes(materialUnit)) allowedUnits = ['kg', 'g'];
    else if (volumeUnits.includes(materialUnit)) allowedUnits = ['L', 'mL'];
    else allowedUnits = ['pcs'];
    
    for (let i = 0; i < unitSelect.options.length; i++) {
        const opt = unitSelect.options[i];
        if (allowedUnits.includes(opt.value)) {
            opt.disabled = false;
        } else {
            opt.disabled = true;
        }
    }

    // ✅ Auto-select sa unang valid na unit (e.g., 'kg' kung weight)
    if (!allowedUnits.includes(unitSelect.value)) {
        unitSelect.value = allowedUnits[0]; 
    }
}

