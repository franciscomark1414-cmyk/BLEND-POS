                                    <td>${formattedDate}</td>
                                    <td>₱${(perf.totalSales || 0).toFixed(2)}</td>
                                    <td>${perf.ordersProcessed || 0}</td>
                                    <td>${(perf.rating || 0).toFixed(1)}</td>
                                    <td>${perf.notes || '-'}</td>
                                </tr>
                            `;
                        });
                    } else {
                        rows = `<tr><td colspan="5" class="text-center text-muted">No performance records found for this employee</td></tr>`;
                    }
                    document.getElementById('performanceTableBody').innerHTML = rows;
                } else {
                    console.error('Error loading performance:', data);
                    document.getElementById('performanceTableBody').innerHTML = `<tr><td colspan="5" class="text-center text-danger">Error loading data</td></tr>`;
                }
            })
            .catch(error => {
                console.error('Error loading performance:', error);
                document.getElementById('performanceTableBody').innerHTML = `<tr><td colspan="5" class="text-center text-danger">Error loading performance data</td></tr>`;
            });
