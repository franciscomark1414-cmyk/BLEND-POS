                <span class="kpi-value">₱@ViewBag.AllTimeRevenue.ToString("N2")</span>
                <span class="kpi-sub">All time sales</span>
            </div>
        </div>

        <a href="#" class="kpi-card critical" onclick="showModule('inventoryAlerts'); return false;">
            <div class="kpi-icon danger"><i class="fas fa-exclamation-triangle"></i></div>
            <div class="kpi-body">
                <span class="kpi-label">Critical Stock</span>
                <span class="kpi-value">@ViewBag.CriticalStockCount</span>
