    <h5 id="formHeader">
        <i class="fas fa-box"></i> Add Raw Material
    </h5>
    <p class="text-muted small mb-3">
        <i class="fas fa-info-circle"></i> This only creates a product record.
        To add stock, use <strong>"ADD DELIVERY (BATCH)"</strong> after saving.
    </p>

    <form id="addRawMaterialForm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="RawMaterialId" id="RawMaterialId">

        <div class="mb-3">
            <label class="form-label fw-bold">Name <span class="text-danger">*</span></label>
            <input type="text" name="Name" id="Name" class="form-control" required placeholder="e.g., Apple, Mango, Flour">
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Category <span class="text-danger">*</span></label>
            <select name="Category" id="Category" class="form-control" required>
                @foreach (var cat in Enum.GetValues(typeof(Infoman.Models.RawMaterialCategory)))
                {
                    var intValue = (int)cat;
                    <option value="@intValue">@cat</option>
                }
