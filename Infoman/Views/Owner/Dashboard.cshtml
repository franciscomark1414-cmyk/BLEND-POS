                      function updateWasteSummary(wasteLogs) {
    let totalQty = 0, totalCost = 0;
    if (wasteLogs) {
        for (let i = 0; i < wasteLogs.length; i++) {
            totalQty += wasteLogs[i].quantity || 0;
            totalCost += wasteLogs[i].totalCost || 0;
        }
    }
    
    // Update displays
    const totalQtyEl = document.getElementById('totalWasteQty');
    if (totalQtyEl) totalQtyEl.innerText = totalQty.toFixed(2);
    
    const totalCostEl2 = document.getElementById('totalWasteCostDisplay2');
    if (totalCostEl2) totalCostEl2.innerHTML = '₱' + totalCost.toFixed(2);
    
    const totalCostEl = document.getElementById('totalWasteCostDisplay');
    if (totalCostEl) totalCostEl.innerHTML = '₱' + totalCost.toFixed(2);
    
    // Update table
    const body = document.getElementById('wasteSummaryBody');
    if (!body) return;
    
    if (!wasteLogs || wasteLogs.length === 0) {
        body.innerHTML = '<tr><td colspan="4" class="text-center text-muted">No waste records</td></tr>';
        return;
    }
    
    let html = '';
    for (let i = 0; i < wasteLogs.length; i++) {
        const w = wasteLogs[i];
        let reasonText = '';
        switch(w.reason) {
            case 0: reasonText = '🔄 Exchange'; break;
            case 1: reasonText = '📦 Expired'; break;
            case 2: reasonText = '💔 Damaged'; break;
            case 3: reasonText = '💧 Spilled'; break;
            case 4: reasonText = '🍳 Overprepared'; break;
            case 5: reasonText = '⚠️ Quality Issue'; break;
            case 6: reasonText = '❌ Customer Cancel'; break;
            default: reasonText = w.reasonText || 'Other';
        }
        html += `
            <tr>
                <td><strong>${escapeHtml(w.materialName)}</strong></td>
                <td>${(w.quantity || 0).toFixed(2)} ${escapeHtml(w.unit || '')}</td>
                <td><span class="badge bg-secondary">${reasonText}</span></td>
                <td class="text-danger">₱${(w.totalCost || 0).toFixed(2)}</td>
            </tr>
        `;
    }
    body.innerHTML = html;
}
