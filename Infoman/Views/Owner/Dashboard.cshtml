            deleteButton.disabled = false;
        }
    })
    .catch(async err => {
        await showAlert(' Error deleting material: ' + err.message, 'Error');
        deleteButton.innerText = originalText;
        deleteButton.disabled = false;
    });
}

      document.getElementById('addRawMaterialForm')?.addEventListener('submit', async function(e) {
    e.preventDefault();

    var id = document.getElementById('RawMaterialId').value;
    var name = document.getElementById('Name').value.trim();
