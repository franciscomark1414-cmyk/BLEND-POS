async function saveNewSize() {
    // ✅ I-CHECK MUNA KUNG EXIST ANG MGA ELEMENTS
    const productIdInput = document.getElementById('addSizeProductId');
    const sizeNameInput = document.getElementById('newSizeName');
    const priceInput = document.getElementById('newSizePrice');
    
    if (!productIdInput) {
        console.error('addSizeProductId element not found');
        await showAlert('Form error. Please refresh and try again.', 'Error', '❌');
        return;
    }
    
    const productId = productIdInput.value;
    let sizeName = sizeNameInput ? sizeNameInput.value : '';
    const price = priceInput ? parseFloat(priceInput.value) || 0 : 0;
    
    if (!productId) {
        await showAlert('Product ID not found', 'Error', '❌');
        return;
    }
    
    if (!sizeName) {
        await showAlert('Please enter a size name', 'Required', '⚠️');
        return;
    }
    
    // Collect ingredients
    const ingredients = [];
    const rows = document.querySelectorAll('#newSizeIngredientsBody tr');
    
    for (let row of rows) {
        const select = row.querySelector('.ingredient-select');
        const quantity = row.querySelector('.quantity-input');
        const unitSelect = row.querySelector('.unit-select');
        
        if (select && select.value && quantity && quantity.value) {
            ingredients.push({
                rawMaterialId: parseInt(select.value),
                quantity: parseFloat(quantity.value),
                unitUsed: unitSelect ? unitSelect.value : 'g'
            });
        }
    }
    
    if (ingredients.length === 0) {
        await showAlert('Please add at least one ingredient', 'Required', '⚠️');
        return;
    }
    
    showLoading('Adding size...');
    
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
    
    try {
        const response = await fetch('/Owner/AddProductSize', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token
            },
            body: JSON.stringify({
                productId: parseInt(productId),
                sizeName: sizeName,
                price: price,
                margin: 0.3,
                ingredients: ingredients
            })
        });
        
        const result = await response.json();
        hideLoading();
        
       if (result.success) {
        await showAlert('Size added successfully!', 'Success', '✅');
        const modal = bootstrap.Modal.getInstance(document.getElementById('addSizeModal'));
        if (modal) modal.hide();
        
        // If we came from edit modal, return to it
        if (window.returnToEditModal) {
            window.returnToEditModal = false;
            const productId = document.getElementById('addSizeProductId').value;
            await refreshProductSizes(productId);
            const editModal = new bootstrap.Modal(document.getElementById('editProductModal'));
            editModal.show();
        } else {
            saveAndReload();
        }
    }
    } catch (error) {
        hideLoading();
        console.error('Error:', error);
        await showAlert('Error: ' + error.message, 'Error', '❌');
    }
}


       
// ========== HELPER FUNCTION ==========
function escapeHtml(str) {
    if (!str) return '';
    return String(str).replace(/[&<>]/g, function(m) {
        if (m === '&') return '&amp;';
        if (m === '<') return '&lt;';
        if (m === '>') return '&gt;';
        return m;
    });
}

document.addEventListener('DOMContentLoaded', function() {
    // ✅ I-CLEAR muna ang localStorage (cleanup ng dati)
    localStorage.removeItem('activeModule');
    
    var urlParams = new URLSearchParams(window.location.search);
    var fromProductSave = urlParams.get('fromProductSave');
    
    // sessionStorage ONLY
    var savedModule = sessionStorage.getItem('activeModule');
    sessionStorage.removeItem('activeModule'); // clear agad after reading
    
    if (fromProductSave === 'true') {
        showModule('products');
        window.history.replaceState({}, document.title, window.location.pathname);
    } else if (savedModule) {
        showModule(savedModule); // reload lang ito within same session
    } else {
        showModule('dashboard'); // ✅ bagong login = laging dashboard
    }
});

