// ========== EXPENSES (LIST / ADD / DELETE) ==========

function getToken() {
    return document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
}

// Local date (YYYY-MM-DD) — hindi UTC, para tama sa Philippines
function todayLocalString() {
    const d = new Date();
    return new Date(d.getTime() - d.getTimezoneOffset() * 60000).toISOString().split('T')[0];
}

// 1. Load table
async function loadExpenses() {
    const tbody = document.getElementById('expenseTableBody');
    if (!tbody) return;

    tbody.innerHTML = '<tr><td colspan="6" class="text-center py-3">Loading...</td></tr>';

    try {
        const res = await fetch('/Finance/GetExpenses');
        const expenses = await res.json();

        if (!expenses || expenses.length === 0) {
            tbody.innerHTML = '<tr><td colspan="6" class="text-center text-muted py-3">No expenses found.</td></tr>';
            return;
        }

        tbody.innerHTML = expenses.map(exp => {
            const dateStr = new Date(exp.expenseDate).toLocaleDateString('en-PH');
            const amountStr = '₱' + Number(exp.amount).toLocaleString('en-PH', {
                minimumFractionDigits: 2, maximumFractionDigits: 2
            });
            return `
                <tr>
                    <td>${dateStr}</td>
                    <td>${escapeHtml(exp.category)}</td>
                    <td>${escapeHtml(exp.description || '-')}</td>
                    <td class="text-danger fw-bold">${amountStr}</td>
                    <td>${escapeHtml(exp.recordedBy || 'Owner')}</td>
                    <td>
                        <button class="btn btn-sm btn-outline-danger" onclick="deleteExpense(${exp.expenseId})">
                            <i class="fas fa-trash"></i>
                        </button>
                    </td>
                </tr>`;
        }).join('');
    } catch (err) {
        console.error('Error loading expenses:', err);
        tbody.innerHTML = '<tr><td colspan="6" class="text-center text-danger py-3">Error loading data.</td></tr>';
    }
}

// 2. Open modal
function openAddExpenseModal() {
    document.getElementById('expenseForm').reset();
    document.getElementById('expenseDate').value = todayLocalString();
    new bootstrap.Modal(document.getElementById('addExpenseModal')).show();
}

// 3. Save (called from <form onsubmit="saveExpense(event)">)
async function saveExpense(event) {
    event.preventDefault();

    const payload = {
        expenseDate: document.getElementById('expenseDate').value,
        category: document.getElementById('expenseCategory').value,
        amount: parseFloat(document.getElementById('expenseAmount').value),
        description: document.getElementById('expenseDescription').value.trim(),
        recordedBy: 'Owner'
    };

    if (!payload.expenseDate || !payload.category || !(payload.amount > 0)) {
        await showAlert('Please fill in all required fields properly.', 'Required', '⚠️');
        return;
    }

    try {
        const res = await fetch('/Finance/AddExpense', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': getToken()
            },
            body: JSON.stringify(payload)
        });
        const result = await res.json();

        if (result.success) {
            bootstrap.Modal.getInstance(document.getElementById('addExpenseModal'))?.hide();
            document.getElementById('expenseForm').reset();
            await showAlert('Expense added successfully!', 'Success', '✅');
            loadExpenses();
            loadFinancials();
        } else {
            await showAlert(result.message || 'Failed to add expense.', 'Error', '❌');
        }
    } catch (err) {
        await showAlert('Error: ' + err.message, 'Error', '❌');
    }
}

// 4. Delete
async function deleteExpense(id) {
    const confirmed = await showConfirm('Delete this expense?', 'Delete Expense');
    if (!confirmed) return;

    try {
        const res = await fetch('/Finance/DeleteExpense?id=' + id, {
            method: 'POST',
            headers: { 'RequestVerificationToken': getToken() }
        });
        const result = await res.json();

        if (result.success) {
            loadExpenses();
            loadFinancials();
        } else {
            await showAlert(result.message || 'Failed to delete.', 'Error', '❌');
        }
    } catch (err) {
        await showAlert('Error: ' + err.message, 'Error', '❌');
    }
}

