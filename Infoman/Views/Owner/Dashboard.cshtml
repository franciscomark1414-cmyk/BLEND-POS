// ========== SESSION TIMEOUT LOGIC ==========
const SESSION_TIMEOUT_MS = 1 * 60 * 1000; // 5 minutes
const LOCK_FLAG_KEY = 'sessionLocked';
const LAST_ACTIVITY_KEY = 'lastActivityAt';
let timeoutId;

function isTimeoutEnabled() {
    return sessionStorage.getItem('enableSessionTimeout') === 'true';
}

function markActivity() {
    sessionStorage.setItem(LAST_ACTIVITY_KEY, Date.now().toString());
}

function toggleSessionTimeout(element) {
    const isEnabled = element.checked;
    sessionStorage.setItem('enableSessionTimeout', isEnabled);

    if (isEnabled) {
        resetSessionTimer();
        showAlert('Session timeout is now ON (5 minutes).', 'Settings Updated', '✅');
    } else {
        clearTimeout(timeoutId);
        sessionStorage.removeItem(LOCK_FLAG_KEY);
        sessionStorage.removeItem(LAST_ACTIVITY_KEY);
        showAlert('Session timeout is now OFF.', 'Settings Updated', 'ℹ️');
    }
}

function showLockScreen() {
    sessionStorage.setItem(LOCK_FLAG_KEY, 'true');
    clearTimeout(timeoutId);
    document.getElementById('unlockPasswordInput').value = '';
    document.getElementById('unlockError').style.display = 'none';
    new bootstrap.Modal(document.getElementById('sessionLockModal')).show();
    setTimeout(() => document.getElementById('unlockPasswordInput').focus(), 300);
}

function resetSessionTimer() {
    if (!isTimeoutEnabled()) return;
    if (sessionStorage.getItem(LOCK_FLAG_KEY) === 'true') return;
    if (document.getElementById('sessionLockModal').classList.contains('show')) return;

    markActivity();
    clearTimeout(timeoutId);
    timeoutId = setTimeout(showLockScreen, SESSION_TIMEOUT_MS);
}

// Tinatawag pagka-load ng page para hindi ma-bypass ang lock sa pag-refresh
function restoreSessionLock() {
    if (!isTimeoutEnabled()) return;

    // 1. Naka-lock na bago mag-refresh → lock ulit agad
    if (sessionStorage.getItem(LOCK_FLAG_KEY) === 'true') {
        showLockScreen();
        return;
    }

    // 2. Ituloy ang natitirang oras mula sa huling galaw ng user
    const last = parseInt(sessionStorage.getItem(LAST_ACTIVITY_KEY) || '0', 10);

    if (!last) {
        markActivity();
        timeoutId = setTimeout(showLockScreen, SESSION_TIMEOUT_MS);
        return;
    }

    const elapsed = Date.now() - last;
    if (elapsed >= SESSION_TIMEOUT_MS) {
        showLockScreen();
    } else {
        timeoutId = setTimeout(showLockScreen, SESSION_TIMEOUT_MS - elapsed);
    }
}

// ✅ BAGONG FUNCTION: Para mag-unlock
async function unlockSession() {
    const password = document.getElementById('unlockPasswordInput').value;
    const errorEl = document.getElementById('unlockError');
    const btn = event.target;

    if (!password) {
        errorEl.innerText = "Please enter your password.";
        errorEl.style.display = 'block';
        return;
    }

    const originalText = btn.innerHTML;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i> Verifying...';
    btn.disabled = true;

    try {
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        
        const response = await fetch('/Owner/VerifySessionPassword', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token
            },
            body: JSON.stringify({ password: password })
        });

        const result = await response.json();

        if (result.success) {
            // ✅ Tama ang password — i-close ang modal at i-reset ang timer
            const lockModal = bootstrap.Modal.getInstance(document.getElementById('sessionLockModal'));
            lockModal.hide();
            
            document.getElementById('unlockPasswordInput').value = '';
            errorEl.style.display = 'none';

            sessionStorage.removeItem(LOCK_FLAG_KEY);
            
            // Reset timer ulit
            resetSessionTimer();
        } else {
            errorEl.innerText = result.message || 'Incorrect password.';
            errorEl.style.display = 'block';
            document.getElementById('unlockPasswordInput').value = '';
            document.getElementById('unlockPasswordInput').focus();
        }
    } catch (err) {
        errorEl.innerText = 'Error: ' + err.message;
        errorEl.style.display = 'block';
    } finally {
        btn.innerHTML = originalText;
        btn.disabled = false;
    }
}

// Support Enter key para mabilis mag-unlock
document.addEventListener('DOMContentLoaded', function() {
    const unlockInput = document.getElementById('unlockPasswordInput');
    if (unlockInput) {
        unlockInput.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                unlockSession();
            }
        });
    }
});

// I-check ang setting pagka-load ng page
document.addEventListener('DOMContentLoaded', function() {
    const toggle = document.getElementById('sessionTimeoutToggle');
    if (toggle) {
        toggle.checked = isTimeoutEnabled();
    }
    
    // Simulan ang timer kung naka-enable
    restoreSessionLock();

    // Mag-add ng event listeners para ma-detect ang user activity
    ['mousemove', 'keydown', 'click', 'scroll', 'touchstart'].forEach(evt => {
        document.addEventListener(evt, resetSessionTimer, { passive: true });
    });
});


function getUnitCategory(unit) {
    const weightUnits = ['kg', 'g'];
    const volumeUnits = ['L', 'mL'];
    const countUnits = ['pcs'];
    
    if (weightUnits.includes(unit)) return 'weight';
    if (volumeUnits.includes(unit)) return 'volume';
    if (countUnits.includes(unit)) return 'count';
    return null;
}

function isUnitCompatible(materialUnit, recipeUnit) {
    const materialCategory = getUnitCategory(materialUnit);
    const recipeCategory = getUnitCategory(recipeUnit);
    
    if (!materialCategory || !recipeCategory) return false;
    return materialCategory === recipeCategory;
}

function updateUnitDropdown(selectElement) {
    const trElement = selectElement.closest('tr');
    if (!trElement) return;
    
    const unitSelect = trElement.querySelector('.unit-select');
    if (!unitSelect) return;
    
    const selectedOption = selectElement.options[selectElement.selectedIndex];
    const materialUnit = selectedOption.getAttribute('data-unit');
    
    if (!materialUnit) return;
    
    // I-enable lahat muna
    for (let i = 0; i < unitSelect.options.length; i++) {
        unitSelect.options[i].disabled = false;
    }

    // I-disable ang mga hindi tugma
    if (materialUnit === 'g' || materialUnit === 'kg') {
        Array.from(unitSelect.options).forEach(opt => {
            if (opt.value === 'L' || opt.value === 'mL' || opt.value === 'pcs') opt.disabled = true;
        });
    } 
    else if (materialUnit === 'mL' || materialUnit === 'L') {
        Array.from(unitSelect.options).forEach(opt => {
            if (opt.value === 'kg' || opt.value === 'g' || opt.value === 'pcs') opt.disabled = true;
        });
    }

    // Kung ang napili ay disabled, auto-select sa unang valid
    if (unitSelect.options[unitSelect.selectedIndex].disabled) {
        for (let i = 0; i < unitSelect.options.length; i++) {
            if (!unitSelect.options[i].disabled && unitSelect.options[i].value !== "") {
                unitSelect.selectedIndex = i;
                break;
            }
        }
    }
    
    // Tawagin ang calculate para mag-update agad
    calculateIngredientTotal(unitSelect);
}

