<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>

<script>
    let sizeCounter = 0;
    let currentProductSizeId = null;
    let currentViewProductSizeId = null;
    let ingredientCounter = 0;

    // Chart
    var labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.SalesLabels ?? new List<string>()));
    var data = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.SalesValues ?? new List<decimal>()));
    var ctx = document.getElementById('salesChart')?.getContext('2d');
    if (ctx) {
        new Chart(ctx, {
            type: 'line',
            data: { labels: labels, datasets: [{ label: 'Sales (₱)', data: data, borderWidth: 2, fill: false, tension: 0.3 }] },
            options: { responsive: true }
        });
    }

    function showModule(module) {
        var modules = ['dashboard', 'inventory', 'products', 'inventoryAlerts', 'reports', 'employees', 'settings'];
        modules.forEach(m => {
            var el = document.getElementById(m + 'Module');
            if (el) el.classList.remove('active');
        });
        document.getElementById(module + 'Module').classList.add('active');
        if (module === 'inventoryAlerts') {
            loadInventoryAlerts();
        }
    }
        // Add Delivery Form Functions
    function showAddDeliveryForm() {
        document.getElementById('addDeliveryBox').style.display = 'block';
        document.getElementById('addDeliveryForm').reset();
        // Scroll to the form
        document.getElementById('addDeliveryBox').scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    function closeAddDeliveryForm() {
        document.getElementById('addDeliveryBox').style.display = 'none';
    }

        function updateDeliveryMaterialId() {
        const select = document.getElementById('deliveryMaterialSelect');
        const selectedOption = select.options[select.selectedIndex];
        const hiddenField = document.getElementById('deliveryRawMaterialId');

        if (selectedOption && selectedOption.value) {
            hiddenField.value = selectedOption.value;
            console.log('Selected material ID:', hiddenField.value); // For debugging
        } else {
            hiddenField.value = '';
        }
    }

    // Submit delivery form
        // Submit delivery form - FIXED VERSION
    document.getElementById('addDeliveryForm')?.addEventListener('submit', async function(e) {
        e.preventDefault();

        // Kunin ang values diretso mula sa select, hindi sa hidden field
        const selectElement = document.getElementById('deliveryMaterialSelect');
        const rawMaterialId = selectElement.value;
        const quantity = document.getElementById('deliveryQuantity').value;
        const unitPrice = document.getElementById('deliveryUnitPrice').value;
        const expiryDate = document.getElementById('deliveryExpiryDate').value;

        // Debug: I-print ang values
        console.log('Raw Material ID:', rawMaterialId);
        console.log('Quantity:', quantity);
        console.log('Unit Price:', unitPrice);
        console.log('Expiry Date:', expiryDate);

        if (!rawMaterialId || rawMaterialId === '') {
            alert('Please select a raw material');
            return;
        }

        if (!quantity || quantity <= 0) {
            alert('Please enter a valid quantity');
            return;
        }

        if (!unitPrice || unitPrice <= 0) {
            alert('Please enter a valid unit price');
            return;
        }

        const submitBtn = this.querySelector('button[type="submit"]');
        const originalText = submitBtn.innerHTML;
        submitBtn.innerHTML = 'Saving...';
        submitBtn.disabled = true;

        try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

            const requestBody = {
                rawMaterialId: parseInt(rawMaterialId),
                quantity: parseFloat(quantity),
                unitPrice: parseFloat(unitPrice),
                expiryDate: expiryDate || null
            };

            console.log('Sending request:', requestBody);

            const response = await fetch('/RawMaterial/AddDelivery', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify(requestBody)
            });

            const result = await response.json();
            console.log('Response:', result);

            if (result.success) {
                alert('✅ ' + result.message);
                closeAddDeliveryForm();
                location.reload();
            } else {
                alert('❌ Error: ' + result.message);
            }
        } catch (error) {
            console.error('Error details:', error);
            alert('❌ Error adding delivery: ' + error.message);
        } finally {
            submitBtn.innerHTML = originalText;
            submitBtn.disabled = false;
        }
    });

    // Inventory Functions
    function toggleAddForm() {
        var box = document.getElementById('addRawMaterialBox');
        if (box.style.display === 'none') {
            box.style.display = 'block';
            document.getElementById('formHeader').innerText = 'Add Raw Material';
            document.getElementById('addRawMaterialForm').reset();
            document.getElementById('RawMaterialId').value = '';
            document.getElementById('ExpirationDate').value = '';
        } else {
            box.style.display = 'none';
        }
    }

    function filterTable() {
        var input = document.getElementById("searchRawMaterial").value.toLowerCase();
        var rows = document.getElementById("rawMaterialTable").getElementsByTagName("tbody")[0].getElementsByTagName("tr");
        for (var i = 0; i < rows.length; i++) {
            rows[i].style.display = rows[i].innerText.toLowerCase().includes(input) ? "" : "none";
        }
    }

    function editMaterial(id) {
        var row = document.querySelector('tr[data-id="' + id + '"]');
        if (!row) { alert('Material not found'); return; }
        var categoryInt = row.children[1].getAttribute('data-value');
        var stockCell = row.children[2];
        var stock = parseFloat(stockCell.getAttribute('data-stock'));
        var unit = stockCell.getAttribute('data-unit');
        var minQtyCell = row.children[3];
        var minQtyText = minQtyCell.innerText;
        var minQty = parseFloat(minQtyText.split(' ')[0]);
        var priceText = row.children[4].innerText;
        var priceValue = parseFloat(priceText.replace('₱', '').replace(',', ''));
        var expiryDate = row.children[5].innerText;
        document.getElementById('RawMaterialId').value = id;
        document.getElementById('Name').value = row.children[0].innerText;
        document.getElementById('Category').value = categoryInt;
        document.getElementById('Stock').value = isNaN(stock) ? 0 : stock;
        document.getElementById('MinQty').value = isNaN(minQty) ? 0 : minQty;
        document.getElementById('Unit').value = unit;
        document.getElementById('Price').value = isNaN(priceValue) ? 0 : priceValue;
        document.getElementById('ExpirationDate').value = expiryDate && expiryDate !== '—' ? expiryDate : '';
        document.getElementById('formHeader').innerText = 'Edit Raw Material';
        document.getElementById('addRawMaterialBox').style.display = 'block';
    }

    function deleteMaterial(id, clickEvent) {
        if (confirm("Are you sure you want to delete this raw material?")) {
            const deleteButton = clickEvent ? clickEvent.target : event.target;
            const originalText = deleteButton.innerText;
            deleteButton.innerText = 'Deleting...';
            deleteButton.disabled = true;
            const token = document.querySelector('input[name="__RequestVerificationToken"]');
            if (!token) {
                alert('Security token missing. Please refresh the page.');
                deleteButton.innerText = originalText;
                deleteButton.disabled = false;
                return;
            }
            const formData = new FormData();
            formData.append('__RequestVerificationToken', token.value);
            formData.append('id', id);
            fetch('@Url.Action("DeleteConfirmed", "RawMaterial")', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert(data.message);
                    location.reload();
                } else {
                    alert('Error: ' + (data.message || 'Unknown error occurred'));
                    deleteButton.innerText = originalText;
                    deleteButton.disabled = false;
                }
            })
            .catch(err => {
                alert('Error deleting material: ' + err.message);
                deleteButton.innerText = originalText;
                deleteButton.disabled = false;
            });
        }
    }

    document.getElementById('addRawMaterialForm')?.addEventListener('submit', function(e) {
        e.preventDefault();
        var id = document.getElementById('RawMaterialId').value;
        var name = document.getElementById('Name').value.trim();
        var category = parseInt(document.getElementById('Category').value);
        if (isNaN(category) || category < 0 || category > 4) { alert('Please select a valid category'); return; }
        var stock = parseFloat(document.getElementById('Stock').value) || 0;
        var minQty = parseFloat(document.getElementById('MinQty').value) || 0;
        var price = parseFloat(document.getElementById('Price').value) || 0;
        var unit = document.getElementById('Unit').value.trim();
        var expiration = document.getElementById('ExpirationDate').value;
        if (!name) { alert('Please enter a name'); return; }
        if (!unit) { alert('Please enter a unit'); return; }
        var expirationValue = expiration ? expiration : null;
        var formData = new FormData();
        formData.append('RawMaterialId', id || '0');
        formData.append('Name', name);
        formData.append('Category', category);
        formData.append('Stock', stock);
        formData.append('MinQty', minQty);
        formData.append('Unit', unit);
        formData.append('Price', price);
        formData.append('ExpirationDate', expirationValue);
        var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
        var url = id ? '@Url.Action("Edit", "RawMaterial")' : '@Url.Action("Create", "RawMaterial")';
        if (id) { url = url + '/' + id; }
        fetch(url, {
            method: 'POST',
            headers: { 'RequestVerificationToken': token },
            body: formData
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) { location.reload(); }
            else { alert('Error: ' + (data.errors ? data.errors.join(', ') : (data.message || 'Unknown error'))); }
        })
        .catch(err => { alert('An error occurred. Please try again.'); });
    });

    // Products Functions
    function showAddProductModal() {
        const form = document.getElementById('addProductForm');
        form.reset();
        document.getElementById('sizesContainer').innerHTML = '';
        sizeCounter = 0;
        addSizeRow('Small');
        addSizeRow('Medium');
        addSizeRow('Large');
        form.onsubmit = async function(e) {
            e.preventDefault();
            const submitBtn = form.querySelector('button[type="submit"]');
            const originalText = submitBtn.innerHTML;
            submitBtn.innerHTML = 'Saving...';
            submitBtn.disabled = true;
            try {
                const formData = new FormData(form);
                const response = await fetch('/Owner/AddProduct', {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value },
                    body: formData
                });
                const result = await response.json();
                if (result.success) {
                    alert(result.message);
                    bootstrap.Modal.getInstance(document.getElementById('addProductModal')).hide();
                    location.reload();
                } else {
                    let errorMsg = result.message || 'Please check all fields';
                    if (result.errors && typeof result.errors === 'object') errorMsg = Object.values(result.errors).flat().join('\n');
                    alert('Error:\n' + errorMsg);
                }
            } catch (error) {
                alert('An error occurred. Please try again.');
            } finally {
                submitBtn.innerHTML = originalText;
                submitBtn.disabled = false;
            }
        };
        new bootstrap.Modal(document.getElementById('addProductModal')).show();
    }

    function addSizeRow(predefinedName = null) {
        const container = document.getElementById('sizesContainer');
        const sizeId = sizeCounter++;
        const sizeName = predefinedName || '';
        const sizeHtml = `<div class="size-row border p-3 mb-3 rounded" data-size-id="${sizeId}">
            <button type="button" class="btn btn-sm btn-danger float-end" onclick="removeSizeRow(${sizeId})">✕</button>
            <div class="row">
                <div class="col-md-3"><label class="form-label">Size Name</label><input type="text" name="Sizes[${sizeId}].SizeName" class="form-control" value="${sizeName}" required></div>
                <div class="col-md-2"><label class="form-label">Stock</label><input type="number" name="Sizes[${sizeId}].Stock" class="form-control" value="0" min="0" required></div>
                <div class="col-md-2"><label class="form-label">Price</label><input type="number" name="Sizes[${sizeId}].Price" class="form-control" step="0.01" value="0"></div>
                <div class="col-md-5"><label class="form-label">Recipe</label>
                    <div class="recipe-items" id="recipe-items-${sizeId}">
                        <div class="row mb-2">
                            <div class="col-md-8"><select name="Sizes[${sizeId}].RecipeItems[0].RawMaterialId" class="form-control" required><option value="">Select Ingredient</option>@if(ViewBag.RawMaterials != null){ foreach(var item in ViewBag.RawMaterials){
                            <option value="@item.RawMaterialId">@item.Name (@item.Unit - ₱@item.Price)</option>
                                                        }}
</select></div>
                            <div class="col-md-4"><input type="number" name="Sizes[${sizeId}].RecipeItems[0].Quantity" class="form-control" placeholder="Quantity" step="0.01" min="0.01" value="1" required></div>
                        </div>
                    </div>
                    <button type="button" class="btn btn-sm btn-link" onclick="addRecipeItem(${sizeId})">+ Add Ingredient</button>
                </div>
            </div>
        </div>`;
        container.insertAdjacentHTML('beforeend', sizeHtml);
    }

    function removeSizeRow(sizeId) { document.querySelector(`.size-row[data-size-id="${sizeId}"]`).remove(); }
    function addRecipeItem(sizeId) {
        const container = document.getElementById(`recipe-items-${sizeId}`);
        const itemCount = container.children.length;
        const html = `<div class="row mb-2"><div class="col-md-8"><select name="Sizes[${sizeId}].RecipeItems[${itemCount}].RawMaterialId" class="form-control" required><option value="">Select Ingredient</option>@if(ViewBag.RawMaterials != null){ foreach(var item in ViewBag.RawMaterials){
        <option value="@item.RawMaterialId">@item.Name (@item.Unit)</option>
                }}
</select></div><div class="col-md-4"><input type="number" name="Sizes[${sizeId}].RecipeItems[${itemCount}].Quantity" class="form-control" placeholder="Quantity" required></div></div>`;
        container.insertAdjacentHTML('beforeend', html);
    }

    function filterProducts() {
        const searchTerm = document.getElementById('searchProduct').value.toLowerCase();
        const categoryFilter = document.getElementById('filterCategory').value;
        const products = document.querySelectorAll('.product-card');
        products.forEach(product => {
            const name = product.querySelector('h4')?.innerText.toLowerCase() || '';
            const category = product.getAttribute('data-category') || '';
            product.style.display = (name.includes(searchTerm) && (!categoryFilter || category === categoryFilter)) ? '' : 'none';
        });
    }

    function refreshProducts() { location.reload(); }
    function editProduct(productId) { alert('Edit product feature - implement based on your needs'); }
    function archiveProduct(productId) {
        if (confirm('Are you sure you want to archive this product?')) {
            fetch(`/Owner/ArchiveProduct/${productId}`, {
                method: 'POST',
                headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value }
            }).then(response => response.json()).then(data => { if (data.success) { alert('Product archived successfully'); location.reload(); } else { alert('Error archiving product'); } });
        }
    }
    function addSize(productId) { showAddProductModal(); }

    // Recipe Functions
    function viewRecipe(productSizeId) {
        const modal = new bootstrap.Modal(document.getElementById('viewRecipeModal'));
        document.getElementById('viewIngredientsBody').innerHTML = '<tr><td colspan="5" class="text-center">Loading recipe details...</td></tr>';
        modal.show();
        fetch(`/Owner/GetRecipe/${productSizeId}`).then(response => response.json()).then(data => {
            if (data.error) { alert(data.error); modal.hide(); return; }
            document.getElementById('viewProductName').innerText = data.productName;
            document.getElementById('viewSizeName').innerText = data.sizeName;
            document.getElementById('viewProductSKU').innerText = data.productSKU || 'N/A';
            document.getElementById('viewProductCategory').innerText = data.productCategory || 'N/A';
            document.getElementById('viewStock').innerText = data.stock + ' pcs';
            document.getElementById('viewSellingPrice').innerHTML = `₱${data.sellingPrice.toFixed(2)}`;
            document.getElementById('viewTotalCost').innerHTML = `₱${data.totalCost.toFixed(2)}`;
            document.getElementById('viewProfit').innerHTML = `₱${data.profit.toFixed(2)}`;
            document.getElementById('viewMargin').innerText = (data.margin * 100).toFixed(0);
            const markupPercent = ((data.sellingPrice - data.totalCost) / data.totalCost * 100).toFixed(0);
            document.getElementById('viewMarkup').innerHTML = markupPercent;
            const tbody = document.getElementById('viewIngredientsBody');
            tbody.innerHTML = '';
            if (data.ingredients && data.ingredients.length > 0) {
                data.ingredients.forEach(ing => { tbody.insertAdjacentHTML('beforeend', `<tr><td><strong>${ing.name}</strong></td><td>${ing.quantity}</td><td>${ing.unit}</td><td>₱${ing.price.toFixed(2)}</td><td class="text-end">₱${ing.total.toFixed(2)}</td></tr>`); });
                document.getElementById('viewGrandTotal').innerHTML = `₱${data.totalCost.toFixed(2)}`;
            } else { tbody.innerHTML = '<tr><td colspan="5" class="text-center text-muted">No ingredients added yet</td></tr>'; document.getElementById('viewGrandTotal').innerHTML = '₱0.00'; }
            currentViewProductSizeId = productSizeId;
        }).catch(error => { document.getElementById('viewIngredientsBody').innerHTML = '<tr><td colspan="5" class="text-center text-danger">Error loading recipe.</td></tr>'; });
    }

    function editRecipeFromView() { if (currentViewProductSizeId) { bootstrap.Modal.getInstance(document.getElementById('viewRecipeModal')).hide(); editRecipe(currentViewProductSizeId); } }
    function editRecipe(productSizeId) {
        currentProductSizeId = productSizeId;
        fetch(`/Owner/GetRecipe/${productSizeId}`).then(response => response.json()).then(data => {
            document.getElementById('recipeProductName').innerText = data.productName;
            document.getElementById('recipeSizeName').innerText = data.sizeName;
            document.getElementById('recipeProductDisplay').value = data.productName;
            document.getElementById('recipeSizeDisplay').value = data.sizeName;
            document.getElementById('recipeSellingPrice').value = `₱${data.sellingPrice.toFixed(2)}`;
            document.getElementById('recipeTotalCost').value = `₱${data.totalCost.toFixed(2)}`;
            const marginPercent = (data.margin * 100).toFixed(0);
            if (marginPercent === "30") document.getElementById('marginSelect').value = "0.3";
            else if (marginPercent === "40") document.getElementById('marginSelect').value = "0.4";
            else if (marginPercent === "50") document.getElementById('marginSelect').value = "0.5";
            const percentage = (data.totalCost / data.sellingPrice * 100).toFixed(1);
            document.getElementById('costPercentage').innerText = `${percentage}% of selling price`;
            const tbody = document.getElementById('ingredientsBody');
            tbody.innerHTML = '';
            data.ingredients.forEach((ing, index) => addIngredientRowToTable(ing, index));
            updateTotals();
            new bootstrap.Modal(document.getElementById('editRecipeModal')).show();
        });
    }

    function addIngredientRow() { addIngredientRowToTable(null, ingredientCounter++); }
    function addIngredientRowToTable(ingredient, index) {
        const tbody = document.getElementById('ingredientsBody');
        const row = `<tr data-ingredient-index="${index}">
            <td><select class="form-control ingredient-select" onchange="calculateIngredientTotal(this)"><option value="">Select Ingredient</option>@if(ViewBag.RawMaterials != null){ foreach(var item in ViewBag.RawMaterials){
            <option value="@item.RawMaterialId" data-price="@item.Price" data-unit="@item.Unit">@item.Name (@item.Unit - ₱@item.Price)</option>
                        }}
</select></td>
            <td><input type="number" class="form-control quantity-input" onchange="calculateIngredientTotal(this)" placeholder="Quantity"></td>
            <td class="unit-display">-</td><td class="cost-per-unit">-</td><td class="total-cost">₱0.00</td>
            <td><button type="button" class="btn btn-sm btn-danger" onclick="removeIngredientRow(this)">✕</button></td>
        </tr>`;
        tbody.insertAdjacentHTML('beforeend', row);
        if (ingredient) {
            const rowElement = tbody.lastElementChild;
            rowElement.querySelector('.ingredient-select').value = ingredient.rawMaterialId;
            rowElement.querySelector('.quantity-input').value = ingredient.quantity;
            calculateIngredientTotal(rowElement.querySelector('.ingredient-select'));
        }
    }

    function calculateIngredientTotal(element) {
        const row = element.closest('tr');
        const select = row.querySelector('.ingredient-select');
        const selectedOption = select.options[select.selectedIndex];
        const price = parseFloat(selectedOption.getAttribute('data-price') || 0);
        const unit = selectedOption.getAttribute('data-unit') || '';
        const quantity = parseFloat(row.querySelector('.quantity-input').value || 0);
        const total = price * quantity;
        row.querySelector('.unit-display').innerText = unit;
        row.querySelector('.cost-per-unit').innerText = `₱${price.toFixed(2)}`;
        row.querySelector('.total-cost').innerText = `₱${total.toFixed(2)}`;
        updateSellingPrice();
    }

    function removeIngredientRow(button) { button.closest('tr').remove(); updateTotals(); }
    function updateSellingPrice() {
        let totalCostText = document.getElementById('totalCostDisplay').innerText;
        let totalCost = parseFloat(totalCostText.replace('₱', '')) || 0;
        let margin = parseFloat(document.getElementById('marginSelect')?.value || 0.3);
        let sellingPrice = totalCost / (1 - margin);
        document.getElementById('recipeSellingPrice').value = `₱${sellingPrice.toFixed(2)}`;
        updateTotals();
    }

    function updateTotals() {
        let totalCost = 0;
        document.querySelectorAll('#ingredientsBody tr').forEach(row => {
            const totalText = row.querySelector('.total-cost')?.innerText || '₱0.00';
            totalCost += parseFloat(totalText.replace('₱', '')) || 0;
        });
        document.getElementById('totalCostDisplay').innerHTML = `₱${totalCost.toFixed(2)}`;
        const margin = parseFloat(document.getElementById('marginSelect')?.value || 0.3);
        const sellingPrice = totalCost / (1 - margin);
        document.getElementById('sellingPriceDisplay').innerHTML = `₱${sellingPrice.toFixed(2)}`;
        document.getElementById('recipeSellingPrice').value = `₱${sellingPrice.toFixed(2)}`;
        let profitLoss = sellingPrice - totalCost;
        const profitLossDisplay = document.getElementById('profitLossDisplay');
        profitLossDisplay.innerHTML = `₱${profitLoss.toFixed(2)}`;
        profitLossDisplay.className = profitLoss >= 0 ? 'fw-bold text-success' : 'fw-bold text-danger';
    }

    function saveRecipe() {
        const ingredients = [];
        document.querySelectorAll('#ingredientsBody tr').forEach(row => {
            const select = row.querySelector('.ingredient-select');
            const quantity = row.querySelector('.quantity-input').value;
            if (select.value && quantity) ingredients.push({ rawMaterialId: parseInt(select.value), quantity: parseFloat(quantity) });
        });
        const margin = parseFloat(document.getElementById('marginSelect').value);
        fetch('/Owner/SaveRecipe', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value },
            body: JSON.stringify({ productSizeId: currentProductSizeId, margin: margin, ingredients: ingredients })
        }).then(response => response.json()).then(data => {
            if (data.success) { alert('Recipe saved successfully!'); bootstrap.Modal.getInstance(document.getElementById('editRecipeModal')).hide(); location.reload(); }
            else { alert('Error saving recipe: ' + data.message); }
        }).catch(err => { alert('An error occurred. Please try again.'); });
    }

    // Alerts Functions
    function loadInventoryAlerts() {
        fetch('/Owner/GetInventoryAlertsData').then(response => response.json()).then(data => {
            document.getElementById('statLowStock').innerText = data.lowStockCount;
            document.getElementById('statExpiring').innerText = data.expiringCount;
            document.getElementById('statExpired').innerText = data.expiredCount;
            document.getElementById('statWaste').innerText = data.wasteCount;
            document.getElementById('lowStockBadge').innerText = data.lowStockCount;
            document.getElementById('expiringBadge').innerText = data.expiringCount;
            document.getElementById('expiredBadge').innerText = data.expiredCount;
            document.getElementById('wasteBadge').innerText = data.wasteCount;
            loadLowStockTab(data.lowStockItems);
            loadExpiringTab(data.expiringItems);
            loadExpiredTab(data.expiredItems);
            loadWasteTab(data.wasteLogs);
        }).catch(error => console.error('Error loading alerts:', error));
    }

    function loadLowStockTab(items) {
        const container = document.getElementById('lowStockContent');
        if (!items || items.length === 0) container.innerHTML = '<div class="empty-state"><i class="fas fa-check-circle fa-4x text-success mb-3"></i><h4 class="text-success">✨ All Good!</h4><p class="text-muted">No low stock alerts at the moment.</p></div>';
        else container.innerHTML = `<div class="table-responsive"><table class="table table-bordered"><thead class="table-warning"><tr><th>Name</th><th>Category</th><th>Current Stock</th><th>Min Qty</th><th>Unit</th><th>Status</th><th>Action</th></tr></thead><tbody>${items.map(item => `<tr><td><strong>${escapeHtml(item.name)}</strong></td><td>${escapeHtml(item.category)}</td><td class="text-danger fw-bold">${item.stockWithUnit}</td><td>${item.minQty}</td><td>${escapeHtml(item.unit)}</td><td><span class="badge bg-warning">⚠️ Low Stock</span></td><td><button class="btn btn-sm btn-outline-primary" onclick="restockMaterial(${item.rawMaterialId})">Restock</button></td></tr>`).join('')}</tbody></table></div>`;
    }

    function loadExpiringTab(items) {
        const container = document.getElementById('expiringContent');
        if (!items || items.length === 0) container.innerHTML = '<div class="empty-state"><i class="fas fa-calendar-check fa-4x text-info mb-3"></i><h4 class="text-info">✨ All Good!</h4><p class="text-muted">No items expiring in the next 7 days.</p></div>';
        else container.innerHTML = `<div class="table-responsive"><table class="table table-bordered"><thead class="table-info"><tr><th>Name</th><th>Category</th><th>Current Stock</th><th>Expiry Date</th><th>Days Left</th><th>Status</th><th>Action</th></tr></thead><tbody>${items.map(item => `<tr><td><strong>${escapeHtml(item.name)}</strong></td><td>${escapeHtml(item.category)}</td><td>${item.stockWithUnit}</td><td class="text-danger">${item.expiryDate}</td><td class="text-danger fw-bold">${item.daysLeft} days</td><td><span class="badge bg-info">⏰ Expiring Soon</span></td><td><button class="btn btn-sm btn-outline-warning" onclick="useMaterialFirst(${item.rawMaterialId})">Use First</button></td></tr>`).join('')}</tbody></table></div>`;
    }

    function loadExpiredTab(items) {
        const container = document.getElementById('expiredContent');
        if (!items || items.length === 0) container.innerHTML = '<div class="empty-state"><i class="fas fa-leaf fa-4x text-success mb-3"></i><h4 class="text-success">✨ Clean Record!</h4><p class="text-muted">No expired items found.</p></div>';
        else container.innerHTML = `<div class="table-responsive"><table class="table table-bordered"><thead class="table-danger"><tr><th>Name</th><th>Category</th><th>Current Stock</th><th>Expiry Date</th><th>Days Overdue</th><th>Status</th><th>Action</th></tr></thead><tbody>${items.map(item => `<tr><td><strong>${escapeHtml(item.name)}</strong></td><td>${escapeHtml(item.category)}</td><td class="text-danger">${item.stockWithUnit}</td><td class="text-danger">${item.expiryDate}</td><td class="text-danger fw-bold">${item.daysOverdue} days ago</td><td><span class="badge bg-danger">❌ Expired</span></td><td><button class="btn btn-sm btn-outline-danger" onclick="logExpiredAsWaste(${item.rawMaterialId})">Log as Waste</button></td></tr>`).join('')}</tbody></table></div>`;
    }

    function loadWasteTab(wasteLogs) {
        const container = document.getElementById('wasteContent');
        if (!wasteLogs || wasteLogs.length === 0) container.innerHTML = '<div class="empty-state"><i class="fas fa-trash-alt fa-4x text-secondary mb-3"></i><h4 class="text-secondary">No Waste Logs</h4><p class="text-muted">No waste has been logged yet.</p><button class="btn btn-warning btn-sm mt-2" onclick="showAddWasteModal()">Log Your First Waste</button></div>';
        else container.innerHTML = `<div class="table-responsive"><table class="table table-bordered"><thead class="table-secondary"><tr><th>Date</th><th>Material</th><th>Quantity</th><th>Reason</th><th>Total Cost</th><th>Recorded By</th><th>Notes</th></tr></thead><tbody>${wasteLogs.map(log => `<tr><td>${log.date}</td><td><strong>${escapeHtml(log.materialName)}</strong></td><td class="text-danger">${log.quantity} ${log.unit}</td><td><span class="badge bg-secondary">${log.reason}</span></td><td class="text-danger">₱${log.totalCost}</td><td>${escapeHtml(log.recordedBy)}</td><td>${escapeHtml(log.notes) || '-'}</td></tr>`).join('')}</tbody></table></div>`;
    }

    function switchAlertTab(tabName, clickEvent) {
        document.querySelectorAll('.nav-link').forEach(btn => btn.classList.remove('active'));
        if (clickEvent && clickEvent.target) clickEvent.target.classList.add('active');
        document.querySelectorAll('.tab-pane').forEach(pane => pane.classList.remove('show', 'active'));
        document.getElementById(`${tabName}TabContent`).classList.add('show', 'active');
    }

    function showAddWasteModal() { document.getElementById('wasteForm').reset(); new bootstrap.Modal(document.getElementById('addWasteModal')).show(); }
    function restockMaterial(id) { alert(`Restock feature for material ID: ${id}`); }
    function useMaterialFirst(id) { alert(`Priority usage for material ID: ${id}`); }
    function logExpiredAsWaste(id) { if (confirm('Log this expired item as waste?')) { showAddWasteModal(); document.getElementById('wasteMaterialId').value = id; document.getElementById('wasteReason').value = 'Expired'; document.getElementById('wasteNotes').value = 'Auto-logged from expired items'; } }

    function saveWasteLog() {
        const materialId = document.getElementById('wasteMaterialId').value;
        const quantity = document.getElementById('wasteQuantity').value;
        const reason = document.getElementById('wasteReason').value;
        const notes = document.getElementById('wasteNotes').value;
        const recordedBy = document.getElementById('wasteRecordedBy').value;
        if (!materialId || !quantity || !reason) { alert('Please fill in all required fields'); return; }
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
        fetch('/Owner/AddWasteLog', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
            body: JSON.stringify({ rawMaterialId: parseInt(materialId), quantity: parseFloat(quantity), reason: reason, notes: notes, recordedBy: recordedBy })
        }).then(response => response.json()).then(data => {
            if (data.success) { bootstrap.Modal.getInstance(document.getElementById('addWasteModal')).hide(); loadInventoryAlerts(); alert('Waste logged successfully!'); }
            else { alert('Error: ' + data.message); }
        }).catch(error => { alert('An error occurred'); });
    }
        // Batch History Functions
           async function viewBatchHistory(materialId, materialName) {
        const container = document.getElementById('batchHistoryContainer');
        const materialNameSpan = document.getElementById('batchMaterialName');
        const tbody = document.getElementById('batchHistoryBody');

        if (!container) return;

        materialNameSpan.innerText = materialName;
        container.style.display = 'block';
        tbody.innerHTML = '<tr><td colspan="6" class="text-center">Loading batch history...</td></tr>';

        try {
            const response = await fetch(`/RawMaterial/BatchHistory?rawMaterialId=${materialId}`);

            if (!response.ok) {
                throw new Error(`HTTP ${response.status}`);
            }

            const batches = await response.json();

            // CHECK KUNG WALANG DATA
            if (!batches || batches.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="6" class="text-center text-muted">
                            <div class="alert alert-info">
                                <strong>ℹ️ No batches found for ${materialName}</strong><br/>
                                Click the <strong>"📦 ADD DELIVERY (BATCH)"</strong> button above to add your first delivery.
                                <br/><br/>
                                <button class="btn btn-sm btn-primary" onclick="showAddDeliveryForm()">
                                    ➕ Add First Delivery
                                </button>
                            </div>
                        </td>
                    </tr>
                `;
                return;
            }

            // Display batches (same as before)
            tbody.innerHTML = '';
            batches.forEach(batch => {
                const isActive = batch.quantityRemaining > 0;
                const status = isActive ?
                    '<span class="badge bg-success">✓ Active (Next to Use)</span>' :
                    '<span class="badge bg-secondary">Depleted</span>';

                const expiryDate = batch.expiryDate ? new Date(batch.expiryDate).toLocaleDateString() : 'N/A';
                const receivedDate = new Date(batch.receivedDate).toLocaleDateString();

                tbody.innerHTML += `
                    <tr class="${isActive ? 'table-success' : 'table-secondary'}">
                        <td>${receivedDate}</td>
                        <td>${batch.quantityReceived} kg</td>
                        <td class="fw-bold">${batch.quantityRemaining} kg</td>
                        <td>${expiryDate}</td>
                        <td>₱${batch.unitPrice.toFixed(2)}</td>
                        <td>${status}</td>
                    </tr>
                `;
            });

            const totalRemaining = batches.reduce((sum, b) => sum + b.quantityRemaining, 0);
            tbody.innerHTML += `
                <tr class="table-info fw-bold">
                    <td colspan="2" class="text-end">TOTAL REMAINING STOCK:</td>
                    <td colspan="4">${totalRemaining} kg</td>
                </tr>
            `;

        } catch (error) {
            console.error('Error:', error);
            tbody.innerHTML = `
                <tr>
                    <td colspan="6" class="text-center text-danger">
                        Error loading batch history: ${error.message}
                    </td>
                </tr>
            `;
        }
    }
    function closeBatchHistory() {
        document.getElementById('batchHistoryContainer').style.display = 'none';
    }

    function showUsageDetails(usageList) {
        if (!usageList || usageList.length === 0) return;

        let message = 'Usage History:\n';
        usageList.forEach(use => {
            message += `- ${new Date(use.dateUsed).toLocaleDateString()}: ${use.quantityUsed} kg (Ref: ${use.referenceNo || 'N/A'})\n`;
        });
        alert(message);
    }

    function escapeHtml(str) { if (!str) return ''; return str.replace(/[&<>]/g, function(m) { if (m === '&') return '&amp;'; if (m === '<') return '&lt;'; if (m === '>') return '&gt;'; return m; }); }
</script>