                                            <option value="@item.RawMaterialId" data-unit="@item.Unit" data-price="@item.Price">
                                                @item.Name (@item.StockWithUnit in stock)
                                            </option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="mb-3">
