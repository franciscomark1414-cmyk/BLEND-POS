function getUnitCategory(unit) {
    const weightUnits = ['kg', 'g'];
    const volumeUnits = ['L', 'mL'];
    const countUnits = ['pcs'];
    
    if (weightUnits.includes(unit)) return 'weight';
    if (volumeUnits.includes(unit)) return 'volume';
    if (countUnits.includes(unit)) return 'count';
    return null;
}

function isUnitCompatible(materialUnit, recipeUnit) {
    const materialCategory = getUnitCategory(materialUnit);
    const recipeCategory = getUnitCategory(recipeUnit);
    
    if (!materialCategory || !recipeCategory) return false;
    return materialCategory === recipeCategory;
}

function updateUnitDropdown(selectElement) {
    // ✅ Hanapin ang parent row (pwede tr o div)
    let row = selectElement.closest('tr');
    if (!row) {
        row = selectElement.closest('.ingredient-row');
    }
    if (!row) return;
    
    const unitSelect = row.querySelector('.unit-select');
    if (!unitSelect) return;
    
    const selectedOption = selectElement.options[selectElement.selectedIndex];
    const materialUnit = selectedOption.getAttribute('data-unit');
    
    if (!materialUnit) return;
    
    const materialCategory = getUnitCategory(materialUnit);
    
    // Enable/disable options based on compatibility
    for (let i = 0; i < unitSelect.options.length; i++) {
        const opt = unitSelect.options[i];
        const optCategory = getUnitCategory(opt.value);
        
        if (materialCategory === optCategory) {
            opt.disabled = false;
            opt.style.color = '';
            opt.style.backgroundColor = '';
        } else {
            opt.disabled = true;
            opt.style.color = '#999';
            opt.style.backgroundColor = '#f0f0f0';
        }
    }
    
    // If currently selected unit is disabled, change to first enabled option
    if (unitSelect.options[unitSelect.selectedIndex].disabled) {
        for (let i = 0; i < unitSelect.options.length; i++) {
            if (!unitSelect.options[i].disabled) {
                unitSelect.selectedIndex = i;
                break;
            }
        }
    }
    
    // Recalculate total after unit change (para sa Edit Recipe modal)
    if (typeof calculateIngredientTotal === 'function') {
        calculateIngredientTotal(unitSelect);
    }
}

// Validation bago mag-save
async function validateIngredientsUnits() {
    const ingredientRows = document.querySelectorAll('#ingredientsBody tr');
    let errors = [];
    
    ingredientRows.forEach(row => {
        const materialSelect = row.querySelector('.ingredient-select');
        const unitSelect = row.querySelector('.unit-select');
        
        if (!materialSelect || !materialSelect.value) return;
        
        const selectedOption = materialSelect.options[materialSelect.selectedIndex];
        const materialUnit = selectedOption.getAttribute('data-unit');
        const selectedUnit = unitSelect ? unitSelect.value : '';
        const materialName = selectedOption.text.split('(')[0].trim();
        
        if (!materialUnit) return;
        
        const materialCategory = getUnitCategory(materialUnit);
        const selectedCategory = getUnitCategory(selectedUnit);
        
        if (materialCategory !== selectedCategory) {
            let expectedUnits = '';
            if (materialCategory === 'weight') expectedUnits = 'kg or g';
            else if (materialCategory === 'volume') expectedUnits = 'L or mL';
            else if (materialCategory === 'count') expectedUnits = 'pcs';
            
            errors.push(`❌ "${materialName}" uses ${materialUnit}.\n   You cannot use "${selectedUnit}" in recipe. Please use ${expectedUnits}.`);
        }
    });
    
    if (errors.length > 0) {
        await showAlert('⚠️ UNIT COMPATIBILITY ERRORS:\n\n' + errors.join('\n\n'), 'Error', '⚠️');
        return false;
    }
    return true;
}


async function approveRequest(requestId) {
    const confirmed = await showConfirm('Approve this request? This action cannot be undone.', 'Approve Request');
    if (!confirmed) return;
    
    showLoading('Approving request...');
    
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
    
    try {
        const response = await fetch('/Owner/ApproveRequest', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
            body: JSON.stringify({ requestId: requestId })
        });
        
        const data = await response.json();
        hideLoading();
        
        if (data.success) {
            await showAlert('✅ ' + data.message, 'Success');
            
            // ✅✅✅ ITO ANG TAMANG PARAAN ✅✅✅
            // I-refresh ang lahat ng tabs para mag-sync ang display
            
            // 1. I-refresh ang Pending Requests tab (para mawala ang approved request)
            await loadPendingRequests();
            
            // 2. I-refresh ang Refund History tab (para lumabas ang approved request dito)
            await loadRefundHistory();
            
            // 3. I-refresh din ang Approved Returns kung meron
            await loadApprovedReturns();
            
            // 4. OPTIONAL: I-close ang modal kung bukas
            const modal = bootstrap.Modal.getInstance(document.getElementById('returnDetailModal'));
            if (modal) modal.hide();
            
            // 5. HUWAG GAMITIN ANG saveAndReload() DAHIL MAGRE-RELOAD NG PAGE
            // saveAndReload();  // ← TANGGALIN ITO!
            
        } else {
            await showAlert('❌ Error: ' + data.message, 'Error');
        }
    } catch (error) {
        hideLoading();
        await showAlert('❌ Error: ' + error.message, 'Error');
    }
}

async function rejectRequest(requestId) {
    const confirmed = await showConfirm('Reject this request?', 'Reject Request');
    if (!confirmed) return;
    
    showLoading('Rejecting request...');
    
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
    
    try {
        const response = await fetch('/Owner/RejectRequest', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
            body: JSON.stringify({ requestId: requestId })
        });
        
        const data = await response.json();
        hideLoading();
        
        if (data.success) {
            await showAlert('✅ Request rejected', 'Success', '✅');
            
            // I-refresh ang pending requests (para mawala ang rejected)
            await loadPendingRequests();
            
            // Hindi na kailangan i-refresh ang refund history kasi rejected naman
            // saveAndReload(); // ← TANGGALIN ITO!
            
        } else {
            await showAlert('❌ Error: ' + data.message, 'Error', '❌');
        }
    } catch (error) {
        hideLoading();
        await showAlert('❌ Error: ' + error.message, 'Error', '❌');
    }
}

 function showModule(module) {
    
    // Hide all modules
    var modules = ['dashboard', 'rawMaterials', 'inventory', 'products', 'inventoryAlerts', 'reports', 'employees', 'suppliers', 'receiving', 'receivingHistory', 'returns'];
    modules.forEach(function(m) {
        var el = document.getElementById(m + 'Module');
        if (el) el.classList.remove('active');
    });

    // Show selected module
    var selectedModule = document.getElementById(module + 'Module');
    if (selectedModule) selectedModule.classList.add('active');

    // Update sidebar active state
    var navItems = document.querySelectorAll('.sidebar .nav-item');
    navItems.forEach(function(item) {
        item.classList.remove('active');
    });

    var activeNavItem = document.querySelector('.sidebar .nav-item[onclick*="showModule(\'' + module + '\')"]');
    if (activeNavItem) {
        activeNavItem.classList.add('active');
    } else {
        var allNavItems = document.querySelectorAll('.sidebar .nav-item');
        for (var i = 0; i < allNavItems.length; i++) {
            var item = allNavItems[i];
            var onclickAttr = item.getAttribute('onclick');
            if (onclickAttr && onclickAttr.includes(module)) {
                item.classList.add('active');
                break;
            }
        }
    }

    // Load module-specific data
    if (module === 'inventoryAlerts') {
        loadInventoryAlerts();  
    }
    if (module === 'reports') {
        reportsDataLoaded = false;
        setTimeout(function() { loadReportsData(); }, 150);
    }
    if (module === 'employees') {
        setTimeout(function() { loadEmployees(); }, 100);
    }
    if (module === 'suppliers') {
        loadSuppliers();
    }
    if (module === 'receiving') {
        console.log('Loading receiving data...');
        loadReceivingFormData();
        setTimeout(function() {
            if (document.getElementById('receivingItemsBody').children.length === 0) {
                addReceivingRow();
            }
        }, 200);
    }
    if (module === 'receivingHistory') {
        loadDeliveryHistory();
    }
    if (module === 'returns') {
        loadPendingRequests();
        loadApprovedReturns();
        loadSupplierReturns();
    }
}
