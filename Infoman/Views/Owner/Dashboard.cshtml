                submitBtn.disabled = false;
                return;
            }
            
            // Validate na may ingredients ang bawat size
            let hasValidIngredients = true;
            for (let i = 0; i < sizeRows.length; i++) {
                const sizeRow = sizeRows[i];
                const sizeName = sizeRow.querySelector('input[name*="SizeName"]')?.value || `Size ${i+1}`;
                const ingredientSelects = sizeRow.querySelectorAll('select[name*="RawMaterialId"]');
                let hasIngredient = false;
                
                for (let j = 0; j < ingredientSelects.length; j++) {
                    if (ingredientSelects[j].value && ingredientSelects[j].value !== '') {
                        hasIngredient = true;
                        break;
                    }
                }
                
                if (!hasIngredient) {
                    await showAlert(`Please add at least one ingredient for "${sizeName}"`, 'Error');
                    hasValidIngredients = false;
                    break;
                }
            }
            
            if (!hasValidIngredients) {
                submitBtn.innerHTML = originalText;
                submitBtn.disabled = false;
                return;
            }
            
            const formData = new FormData(form);

            console.log("=== FORM DATA DEBUG ===");
for (let pair of formData.entries()) {
    console.log(pair[0] + ': ' + pair[1]);
}
            
            const response = await fetch('/Owner/AddProduct', {
                method: 'POST',
                headers: { 
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value 
                },
                body: formData
            });
            
            const result = await response.json();
            
            if (result.success) {
                // Save that we want to stay in products module
                sessionStorage.setItem('activeModule', 'products');
                
                // Show success message
                await showAlert(result.message, 'Success', '✅');
                
                // Close modal
                const modal = bootstrap.Modal.getInstance(document.getElementById('addProductModal'));
                if (modal) modal.hide();
                
                // Reload with flag to stay in products module
                window.location.href = window.location.pathname + '?fromProductSave=true';
                
            } else {
                let errorMsg = result.message || 'Please check all fields';
                if (result.errors && typeof result.errors === 'object') {
                    errorMsg = Object.values(result.errors).flat().join('\n');
                }
                await showAlert(' Error:\n' + errorMsg, 'Error');
            }
        } catch (error) {
            console.error('Error:', error);
            await showAlert(' An error occurred: ' + error.message, 'Error');
        } finally {
            submitBtn.innerHTML = originalText;
            submitBtn.disabled = false;
        }
    };
    
    // Show the modal
    const modalElement = document.getElementById('addProductModal');
    if (modalElement) {
        const modal = new bootstrap.Modal(modalElement);
        modal.show();
    } else {
        console.error('addProductModal not found');
        showAlert('Modal not found. Please refresh the page.', 'Error', '❌');
    }
}

// Function to reindex all size rows para mag-match sa model binding
function reindexSizeRows() {
    const sizeRows = document.querySelectorAll('#sizesContainer .size-row');
    
    sizeRows.forEach((row, newIndex) => {
        // Update data-size-id attribute
        row.setAttribute('data-size-id', newIndex);
        
        // Update all input names
        const inputs = row.querySelectorAll('input, select');
        inputs.forEach(input => {
            const name = input.getAttribute('name');
            if (name) {
                // Replace Sizes[oldIndex] with Sizes[newIndex]
                const newName = name.replace(/Sizes\[\d+\]/, `Sizes[${newIndex}]`);
                input.setAttribute('name', newName);
            }
        });
        
        // Update recipe-items div id
        const recipeDiv = row.querySelector('.recipe-items');
        if (recipeDiv) {
            const oldId = recipeDiv.id;
            const newId = oldId.replace(/\d+/, newIndex);
            recipeDiv.id = newId;
        }
    });
}

// I-update ang removeSizeRow function
function removeSizeRow(sizeId) {
    const row = document.querySelector(`.size-row[data-size-id="${sizeId}"]`);
    if (row) row.remove();
    
    // Re-index all remaining size rows
    reindexSizeRows();
}

