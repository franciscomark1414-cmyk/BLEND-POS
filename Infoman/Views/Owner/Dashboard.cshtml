    // ✅ WARNING KUNG WALANG EXPIRY DATE (hindi hard block)
const noExpiryItems = [];
for (let row of document.querySelectorAll('#receivingItemsBody tr')) {
    const rowId = row.id.split('-').pop();
    const mat = document.querySelector(`.material-select[data-row="${rowId}"]`);
