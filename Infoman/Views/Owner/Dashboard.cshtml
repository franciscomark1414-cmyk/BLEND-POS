// ========== HELPER FUNCTION ==========
function escapeHtml(str) {
    if (!str) return '';
    return String(str).replace(/[&<>]/g, function(m) {
        if (m === '&') return '&amp;';
        if (m === '<') return '&lt;';
        if (m === '>') return '&gt;';
        return m;
    });
}

document.addEventListener('DOMContentLoaded', function() {
    // ✅ I-CLEAR muna ang localStorage (cleanup ng dati)
    localStorage.removeItem('activeModule');
    
    var urlParams = new URLSearchParams(window.location.search);
    var fromProductSave = urlParams.get('fromProductSave');
    
    // sessionStorage ONLY
    var savedModule = sessionStorage.getItem('activeModule');
    sessionStorage.removeItem('activeModule'); // clear agad after reading
    
    if (fromProductSave === 'true') {
        showModule('products');
        window.history.replaceState({}, document.title, window.location.pathname);
    } else if (savedModule) {
        showModule(savedModule); // reload lang ito within same session
    } else {
        showModule('dashboard'); // ✅ bagong login = laging dashboard
    }
});

