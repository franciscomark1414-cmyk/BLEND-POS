function editCategory(id) {
    const c = categoryCache.find(x => x.id === id);
    if (!c) return;

    document.getElementById('catEditId').value = c.id;
    document.getElementById('catName').value = c.name;
    
    // ✅ I-SET ANG VALUE (AddOn, Product, o RawMaterial)
    document.getElementById('catType').value = c.type; 
    
    document.getElementById('catType').disabled = true;
    document.getElementById('catIsActive').checked = c.isActive;
    document.getElementById('catTypeHint').innerText = 'Type cannot be changed once created.';
    document.getElementById('categoryFormTitle').innerHTML = '<i class="fas fa-edit me-2"></i>Edit Category';
    document.getElementById('catCancelBtn').style.display = 'inline-block';
    document.getElementById('catName').focus();
}

// ---- Create / Update ----
                                                async function saveCategory(e) {
                                                    e.preventDefault();

                                                    const id = parseInt(document.getElementById('catEditId').value) || 0;
                                                    const payload = {
                                                        categoryId: id,
                                                        name: document.getElementById('catName').value.trim(),
                                                        type: document.getElementById('catType').value, // <--- Makukuha na nito ang "AddOn"
                                                        isActive: document.getElementById('catIsActive').checked
                                                    };

                                                    if (!payload.name) {
                                                        await showAlert('Please enter a category name.', 'Required');
                                                        return;
                                                    }

                                                    showLoading('Saving category...');
                                                    try {
                                                        const res = await fetch(id === 0 ? '/Category/Create' : '/Category/Update', {
                                                            method: 'POST',
                                                            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getCategoryToken() },
                                                            body: JSON.stringify(payload)
                                                        });
                                                        const data = await res.json();
                                                        hideLoading();

                                                        if (data.success) {
                                                            await showAlert(data.message, 'Success', '✅');
                                                            resetCategoryForm();
                                                            await loadCategories();
                                                            await refreshAllCategoryDropdowns();
                                                        } else {
                                                            await showAlert(data.message, 'Cannot Save', '❌');
                                                        }
                                                    } catch (err) {
                                                        hideLoading();
                                                        await showAlert('Error: ' + err.message, 'Error', '❌');
                                                    }
                                                }

// ---- Delete (may in-use blocking modal) ----
async function deleteCategory(id) {
    const c = categoryCache.find(x => x.id === id);
    if (!c) return;

    const confirmed = await showConfirm(`Delete category "${c.name}"?`, 'Delete Category');
    if (!confirmed) return;

    showLoading('Deleting category...');
    try {
        const res = await fetch(`/Category/Delete?id=${id}`, {
            method: 'POST',
            headers: { 'RequestVerificationToken': getCategoryToken() }
        });
        const data = await res.json();
        hideLoading();

        if (data.success) {
            await showAlert(data.message, 'Deleted', '✅');
            resetCategoryForm();
            await loadCategories();

            await refreshInventoryTable();
            await refreshRawMaterialsTable(); 
    await refreshAllCategoryDropdowns();
        } else if (data.inUse) {
            // Blocking error: ipakita ang message + bilang ng apektado
            await showAlert(data.message, 'Cannot Delete Category', '🚫');
        } else {
            await showAlert(data.message, 'Error', '❌');
        }
    } catch (err) {
        hideLoading();
        await showAlert('Error: ' + err.message, 'Error', '❌');
    }
}

