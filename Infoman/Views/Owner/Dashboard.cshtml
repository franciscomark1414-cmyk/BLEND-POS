// Mirrors OwnerController.RoundToPriceEnding
function roundToPriceEnding(price) {
    const rounded = Math.round(price);
    if (rounded <= 0) return 0;
    if (rounded < 10) return 9;

    const base = Math.floor(rounded / 10) * 10;
    let result = base + 9;
    if (result < rounded) result = base + 19;
    return result;
}


