// Function to reindex all size rows para mag-match sa model binding
function reindexSizeRows() {
    const sizeRows = document.querySelectorAll('#sizesContainer .size-row');
    
    sizeRows.forEach((row, newIndex) => {
        // Update data-size-id attribute
        row.setAttribute('data-size-id', newIndex);
        
        // Update all input names
        const inputs = row.querySelectorAll('input, select');
        inputs.forEach(input => {
            const name = input.getAttribute('name');
            if (name) {
                // Replace Sizes[oldIndex] with Sizes[newIndex]
                const newName = name.replace(/Sizes\[\d+\]/, `Sizes[${newIndex}]`);
                input.setAttribute('name', newName);
            }
        });
        
        // Update recipe-items div id
        const recipeDiv = row.querySelector('.recipe-items');
        if (recipeDiv) {
            const oldId = recipeDiv.id;
            const newId = oldId.replace(/\d+/, newIndex);
            recipeDiv.id = newId;
        }
    });
}

// I-update ang removeSizeRow function
function removeSizeRow(sizeId) {
    const row = document.querySelector(`.size-row[data-size-id="${sizeId}"]`);
    if (row) row.remove();
    
    // Re-index all remaining size rows
    reindexSizeRows();
}

