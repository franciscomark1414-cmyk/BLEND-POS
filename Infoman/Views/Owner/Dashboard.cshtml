        async function adjustBatchStock(batchId, currentRemaining, materialName) {
    const newQuantity = prompt(`Adjust stock for ${materialName}\n\nCurrent remaining: ${currentRemaining} kg\nEnter new quantity:`, currentRemaining);
    
    if (newQuantity === null) return;
    
    const newQty = parseFloat(newQuantity);
    if (isNaN(newQty) || newQty < 0) {
        await showAlert('Please enter a valid quantity (0 or positive number)', 'Invalid');
        return;
    }
    
    if (newQty === currentRemaining) {
        await showAlert('No changes made', 'Notice');
        return;
    }
    
    const confirmed = await showConfirm(`Adjust stock from ${currentRemaining} kg to ${newQty} kg?\n\nThis will create a waste log if stock is reduced.`, 'Confirm Adjustment');
    if (!confirmed) return;
    
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
    
    try {
        const response = await fetch('/RawMaterial/AdjustBatchStock', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token
            },
            body: JSON.stringify({
                batchId: batchId,
                newQuantity: newQty,
                reason: 'Manual adjustment'
            })
        });
        
        const result = await response.json();
        
        if (result.success) {
            await showAlert(' Stock adjusted successfully', 'Success');
            saveAndReload();
        } else {
            await showAlert(' Error: ' + result.message, 'Error');
        }
    } catch (error) {
        await showAlert(' Error: ' + error.message, 'Error');
    }
}

