            document.getElementById('receiptHistoryBody').innerHTML = 
                '<tr><td colspan="10" class="text-center text-danger">Error loading receipts</td></tr>';
        });
}

   function displayReceiptHistory(receipts) {
    const tbody = document.getElementById('receiptHistoryBody');

    if (!receipts || receipts.length === 0) {
        tbody.innerHTML = `
            <tr>
                <td colspan="10" class="text-center text-muted">
                    📋 No receipts found yet.<br>
                    <small>Make a sale in POS to generate receipts.</small>
                 </td>
            </tr>
        `;
        return;
    }

    let html = '';
    receipts.forEach(receipt => {
        // ✅ Determine status badge based on returnStatus
        let statusBadge = '';
        let isExchanged = false;
        
        if (receipt.returnStatus === 'EXCHANGED') {
            statusBadge = '<span class="badge bg-warning text-dark">🔄 EXCHANGED</span>';
            isExchanged = true;
        } else if (receipt.returnStatus === 'RETURNED') {
            statusBadge = '<span class="badge bg-danger">↩️ RETURNED</span>';
        } else if (receipt.returnStatus === 'REFUNDED') {
            statusBadge = '<span class="badge bg-info">💰 REFUNDED</span>';
        } else {
            statusBadge = '<span class="badge bg-success">✅ ACTIVE</span>';
        }
        
        // ✅ Get order number (use OrderId, not receipt number)
        const orderDisplay = receipt.orderId ? `#${receipt.orderId}` : '#N/A';
        
        // ✅ Add exchange indicator if applicable
        let exchangeIndicator = '';
        if (isExchanged && receipt.originalOrderId) {
            exchangeIndicator = `<small class="text-muted">(replaces #${receipt.originalOrderId})</small>`;
        } else if (receipt.originalOrderId) {
            exchangeIndicator = `<small class="text-muted">(exchange replacement)</small>`;
        }
        
        // ✅ Format discount display
        let discountDisplay = 'None';
        if (receipt.discountPercent > 0) {
            discountDisplay = `${receipt.discountType} (${receipt.discountPercent * 100}%)<br>-₱${receipt.discountAmount.toFixed(2)}`;
        }
        
        html += `
            <tr>
                <td><code>${escapeHtml(receipt.receiptNumber)}</code></td>
                <td class="fw-bold">${orderDisplay}<br>${exchangeIndicator}</td>
                <td>${receipt.date}</td>
                <td>${receipt.itemCount} item(s)</td>
                <td>₱${receipt.subtotal.toFixed(2)}</td>
                <td>${discountDisplay}</td>
                <td class="fw-bold text-primary">₱${receipt.total.toFixed(2)}</td>
                <td><span class="badge bg-success">${escapeHtml(receipt.paymentMethod)}</span></td>
                <td>${statusBadge}</td>
                <td>
                    <button class="btn btn-sm btn-info" onclick="viewReceiptDetail(${receipt.orderId})">
                        <i class="fas fa-eye"></i> View
                    </button>
                    <button class="btn btn-sm btn-secondary" onclick="printReceipt(${receipt.orderId})">
                        <i class="fas fa-print"></i>
                    </button>
                 </td>
            </tr>
        `;
    });
    tbody.innerHTML = html;
}

function viewReceiptDetail(orderId) {
    console.log("Viewing receipt for orderId:", orderId);

    fetch(`/Owner/GetReceiptDetail?orderId=${orderId}`)
        .then(response => response.json())
        .then(async (data) => {
            console.log("Receipt data received:", data);
            if (data.success) {
                showReceiptModalFromData(data.receipt);
            } else {
                showAlert('Error loading receipt details: ' + (data.message || 'Unknown error'), 'Error');
            }
        })
        .catch(async (error) => {
            console.error('Error:', error);
            showAlert('Error loading receipt details: ' + error.message, 'Error');
        });
}

    function showReceiptModalFromData(receipt) {
