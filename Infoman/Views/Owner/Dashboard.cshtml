function getVoucherStatus(v) {
    // 1. Check kung Used na
    if (v.isUsed) return { text: 'Used', cls: 'bg-danger' };
    
    // 2. Check kung Inactive (pinasadya)
    if (!v.isActive) return { text: 'Inactive', cls: 'bg-secondary' };

    // 3. ✅ Check kung Expired na (Nalampasan na ang ExpiryDate)
    if (v.expiryDate) {
        const expiry = new Date(v.expiryDate);
        const today = new Date();
        today.setHours(0, 0, 0, 0); // I-reset ang oras para fair ang comparison
        
        if (expiry < today) {
            return { text: 'Expired', cls: 'bg-dark' }; // Kulay itim o gray
        }
    }

    // 4. Kung pasado sa lahat, Active
    return { text: 'Active', cls: 'bg-success' };
}

function renderVoucherTable(vouchers) {
    const tbody = document.getElementById('voucherTableBody');

    if (vouchers.length === 0) {
        const isSearching = document.getElementById('voucherSearchInput').value.trim() !== '';
        tbody.innerHTML = `
            <tr>
                <td colspan="6" class="text-center text-muted py-4">
                    ${isSearching ? 'No vouchers match your search.' : 'No vouchers found. Generate one above.'}
                </td>
            </tr>`;
        return;
    }

    tbody.innerHTML = vouchers.map(v => {
        const expiry = v.expiryDate ? new Date(v.expiryDate).toLocaleDateString() : 'No Expiry';
        const status = getVoucherStatus(v);
        return `
            <tr>
                <td class="fw-bold">${escapeHtml(v.code)}</td>
                <td>${Number(v.discountPercent).toFixed(2)}% OFF</td>
                <td>${escapeHtml(v.eventName || '-')}</td>
                <td>${expiry}</td>
                <td><span class="badge ${status.cls}">${status.text}</span></td>
                <td class="text-end">
                    <button class="btn btn-sm btn-outline-danger" onclick="deleteVoucher(${v.voucherId})">Delete</button>
                </td>
            </tr>`;
    }).join('');
}

