 document.getElementById('receivingForm')?.addEventListener('submit', async function(e) {
    e.preventDefault();

    const items = [];
    const rows = document.querySelectorAll('#receivingItemsBody tr');
    let hasZeroPriceWarning = false;
    let zeroPriceItems = [];

    for (let row of rows) {
        const rowId = row.id.split('-').pop();
        const materialSelect = document.querySelector(`.material-select[data-row="${rowId}"]`);

        if (!materialSelect || !materialSelect.value) continue;

        const receivedQty = parseFloat(document.querySelector(`.received-qty[data-row="${rowId}"]`).value) || 0;
        const acceptedQty = parseFloat(document.querySelector(`.accepted-qty[data-row="${rowId}"]`).value) || 0;
        const rejectedQty = parseFloat(document.querySelector(`.rejected-qty[data-row="${rowId}"]`).value) || 0;
        const unitPrice = parseFloat(document.querySelector(`.unit-price[data-row="${rowId}"]`).value) || 0;
        
        // ✅ WARNING LANG PAG ₱0 (hindi required)
        if (unitPrice === 0 && acceptedQty > 0) {
            hasZeroPriceWarning = true;
            const materialName = materialSelect.options[materialSelect.selectedIndex]?.text.split('(')[0].trim() || 'Unknown';
            zeroPriceItems.push(materialName);
        }
        
        let disposition = '';
        let rejectionReason = '';
        
        if (rejectedQty > 0) {
            const dispositionSelect = document.querySelector(`.disposition-select[data-row="${rowId}"]`);
            disposition = dispositionSelect ? dispositionSelect.value : '';
            
            const reasonSelect = document.querySelector(`.rejection-reason[data-row="${rowId}"]`);
            rejectionReason = reasonSelect ? reasonSelect.value : '';
            
            if (rejectionReason === 'Other') {
                const otherReason = document.querySelector(`.other-reason[data-row="${rowId}"]`);
                rejectionReason = otherReason ? otherReason.value : 'Other (no details)';
            }
            
            if (!disposition) {
                await showAlert(`Please select disposition (Return or Waste) for ${materialSelect.options[materialSelect.selectedIndex].text}`, 'Required', '⚠️');
                return;
            }
            
            if (!rejectionReason || rejectionReason === '') {
                rejectionReason = 'No reason provided';
            }
        }

        items.push({
            rawMaterialId: parseInt(materialSelect.value),
            rawMaterialName: materialSelect.options[materialSelect.selectedIndex].text.split('(')[0].trim(),
            receivedQty: receivedQty,
            acceptedQty: acceptedQty,
            rejectedQty: rejectedQty,
            disposition: disposition,
            rejectionReason: rejectionReason,
            unitPrice: unitPrice,
            expiryDate: document.querySelector(`.expiry-date[data-row="${rowId}"]`).value || null
        });
    }

    if (items.length === 0) {
        await showAlert('Please add at least one item', 'Required');
        return;
    }

    // ✅ WARNING LANG PAG ₱0, HINDI REQUIRED
    if (hasZeroPriceWarning) {
        const confirmed = await showConfirm(
            `⚠️ PRICE WARNING\n\nThe following items have ₱0.00 unit price:\n• ${zeroPriceItems.join('\n• ')}\n\nThis means they are FREE items.\n\nDo you want to continue saving this delivery?`,
            'Zero Price Warning'
        );
        if (!confirmed) return;
    }

    const data = {
        supplierId: parseInt(document.getElementById('supplierId').value),
        drNumber: document.getElementById('drNumber').value,
        invoiceNumber: document.getElementById('invoiceNumber').value,
        dateReceived: document.getElementById('dateReceived').value,
        remarks: document.getElementById('remarks').value,
        items: items
    };

    if (!data.supplierId || !data.drNumber) {
        await showAlert('Please select supplier and enter DR Number', 'Required');
        return;
    }

    const submitBtn = this.querySelector('button[type="submit"]');
    const originalText = submitBtn.innerHTML;
    submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving...';
    submitBtn.disabled = true;

    fetch('/Owner/ReceiveDelivery', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
        },
        body: JSON.stringify(data)
    })
    .then(r => r.json())
    .then(async (result) => {
        if (result.success) {
            await showAlert(result.message, 'Success', '✅');
            
            // ✅ RESET FORM ONLY (no redirect, no page reload)
            document.getElementById('receivingForm').reset();
            document.getElementById('receivingItemsBody').innerHTML = '';
            receivingRowCount = 0;
            addReceivingRow();
            document.getElementById('drNumber').value = generateDRNumber();
            document.getElementById('invoiceNumber').value = generateInvoiceNumber();
            
            // ✅ REFRESH INVENTORY TABLE DATA (without reloading page)
            await refreshInventoryTableData();
            
        } else {
            await showAlert(' Error: ' + result.message, 'Error', '❌');
        }
    })
    .catch(async (error) => {
        await showAlert(' Error: ' + error.message, 'Error', '❌');
    })
    .finally(() => {
        submitBtn.innerHTML = originalText;
        submitBtn.disabled = false;
    });
});

// ✅ BAGONG FUNCTION: Refresh inventory table without page reload
async function refreshInventoryTableData() {
    try {
        const response = await fetch('/Owner/GetInventoryData');
        const data = await response.json();
        
        if (data.success && data.rawMaterials) {
            updateInventoryTable(data.rawMaterials);
            
            // ✅ Also refresh the delivery history
            loadDeliveryHistory();
        }
    } catch (error) {
        console.error('Error refreshing inventory:', error);
    }
}

// ✅ BAGONG FUNCTION: Update inventory table with new data
function updateInventoryTable(rawMaterials) {
    const tbody = document.querySelector('#rawMaterialTable tbody');
    if (!tbody) return;
    
    if (!rawMaterials || rawMaterials.length === 0) {
        tbody.innerHTML = '<tr><td colspan="9" class="text-center">No raw materials yet.您</td><\/tr>';
        return;
    }
    
    let html = '';
    rawMaterials.forEach(item => {
        const status = item.status || (item.stock <= item.minQty ? (item.stock === 0 ? 'No Stock' : 'Low Stock') : 'In Stock');
        
        html += `
            <tr data-id="${item.rawMaterialId}">
                <td class="sku-column">${item.sku || '—'}</td>
                <td>${escapeHtml(item.name)}</td>
                <td data-value="${item.category}">${escapeHtml(item.category)}</td>
                <td data-stock="${item.stock}" data-unit="${item.unit}">${item.stock.toFixed(2)} ${item.unit}</td>
                <td data-minqty="${item.minQty}" data-unit="${item.unit}">${item.minQty.toFixed(2)} ${item.unit}</td>
                <td>${status}</td>
                <td>
                    <button class="btn btn-sm btn-info" onclick="viewBatchHistory(${item.rawMaterialId}, '${escapeHtml(item.name)}')">Batches</button>
                    <button class="btn btn-sm btn-primary" onclick="editMaterialFromInventory(${item.rawMaterialId}, '${escapeHtml(item.name)}')">Edit</button>
                    <button class="btn btn-sm btn-danger" onclick="deleteMaterialFromInventory(${item.rawMaterialId}, '${escapeHtml(item.name)}')">Delete</button>
                </td>
            </tr>
        `;
    });
    tbody.innerHTML = html;
}

function validateMinQty(input) {
