async function autoDisplayProductInPOS() {
    // Kunin ang productId mula sa URL
    var urlParams = new URLSearchParams(window.location.search);
    var highlightProductId = urlParams.get('highlightProduct');
    
    if (!highlightProductId) return; // Walang productId, skip
    
    console.log('Auto-displaying product in POS:', highlightProductId);
    
    // ✅ Mag-antay ng konti para naka-render na ang lahat ng cards
    await new Promise(resolve => setTimeout(resolve, 500));
    
    // Hanapin ang specific na product card
    var productCards = document.querySelectorAll('.product-card');
    var targetCard = null;
    
    for (var i = 0; i < productCards.length; i++) {
        if (productCards[i].getAttribute('data-product-id') === highlightProductId) {
            targetCard = productCards[i];
            break;
        }
    }
    
    if (!targetCard) {
        console.warn('Product card not found:', highlightProductId);
        return;
    }
    
    // ✅ I-expand ang card
    var cardBody = targetCard.querySelector('.product-card-body');
    if (cardBody && cardBody.style.display === 'none') {
        cardBody.style.display = 'block';
        var icon = targetCard.querySelector('.toggle-icon');
        if (icon) {
            icon.style.transform = 'rotate(0deg)';
            icon.classList.remove('fa-chevron-right');
            icon.classList.add('fa-chevron-down');
        }
    }
    
    // ✅ Kunin lahat ng "Display in POS" buttons
    var displayButtons = [];
    var allButtons = targetCard.querySelectorAll('button');
    for (var j = 0; j < allButtons.length; j++) {
        if (allButtons[j].innerText.includes('Display in POS')) {
            displayButtons.push(allButtons[j]);
        }
    }
    
    if (displayButtons.length === 0) {
        console.log('All sizes already displayed in POS');
        window.history.replaceState({}, document.title, window.location.pathname);
        return;
    }
    
    console.log(`Found ${displayButtons.length} sizes to display`);
    
    // ✅ Ipakita ang CUSTOM modal para sa "Display ALL" decision
    const shouldDisplayAll = await showConfirm(
        `This product has ${displayButtons.length} size(s) that are hidden from POS.\n\nDo you want to display ALL of them in the POS menu?`,
        'Display Product in POS'
    );
    
    if (shouldDisplayAll) {
        // ✅ I-display lahat nang paisa-isa (walang confirm modal para mabilis)
        showLoading('Displaying sizes in POS...');
        
        for (var k = 0; k < displayButtons.length; k++) {
            try {
                // Kunin ang productSizeId mula sa onclick attribute
                var onclickAttr = displayButtons[k].getAttribute('onclick');
                // Format: displayInPOS(123, 'Name', 'Size')
                var match = onclickAttr.match(/displayInPOS\((\d+)/);
                if (match && match[1]) {
                    var productSizeId = parseInt(match[1]);
                    
                    // ✅ Directly call ang backend API (skip ang UI confirm)
                    var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                    var response = await fetch('/Owner/TogglePOSVisibility', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': token
                        },
                        body: JSON.stringify({
                            productSizeId: productSizeId,
                            isAvailable: true
                        })
                    });
                    
                    var result = await response.json();
                    if (!result.success) {
                        console.error('Failed to display size:', result.message);
                    }
                }
            } catch (err) {
                console.error('Error displaying size:', err);
            }
        }
        
        hideLoading();
        await showAlert('✅ All sizes are now displayed in the POS menu!', 'Success', '✅');
        
        // ✅ I-reload para makita ang updated status
        sessionStorage.setItem('activeModule', 'products');
        window.location.href = window.location.pathname;
        
    } else {
        // ✅ Kung "No", hayaan ang user na mag-click manually
        await showAlert('You can manually click "Display in POS" for each size you want to show.', 'Info', 'ℹ️');
        window.history.replaceState({}, document.title, window.location.pathname);
    }
}

    // ✅ Tawagin ang function pagka-load ng page
    document.addEventListener('DOMContentLoaded', function() {
        autoDisplayProductInPOS();
    });

