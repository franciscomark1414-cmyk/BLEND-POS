                <ul class="rank-list">
                    @if (Model.BestSellingProducts.Any())
                    {
                        foreach (var item in Model.BestSellingProducts)
                        {
                            <li class="rank-item">
                                <span class="rank-badge @(item.Rank == 1 ? "gold" : item.Rank == 2 ? "silver" : item.Rank == 3 ? "bronze" : "")">#@item.Rank</span>
                                <div class="rank-thumb">
                                    @if (!string.IsNullOrEmpty(item.ImagePath))
                                    {
                                        <img src="@item.ImagePath" alt="@item.Name" loading="lazy" onerror="this.remove()" />
                                    }
                                    <i class="fas fa-mug-hot rank-thumb-fallback"></i>
                                </div>
