// 1. Load Shifts (para sa table)
async function loadShifts() {
    const tbody = document.getElementById('shiftsTableBody');
    if (!tbody) return;

    tbody.innerHTML = '<tr><td colspan="9" class="text-center"><div class="spinner-border spinner-border-sm me-2"></div> Loading...</td></tr>';

    const from = document.getElementById('shiftFilterFrom')?.value || '';
    const to = document.getElementById('shiftFilterTo')?.value || '';

    try {
        const response = await fetch(`/Owner/GetShifts?from=${from}&to=${to}`);
        const data = await response.json();

        if (!data.success || !data.shifts || data.shifts.length === 0) {
            tbody.innerHTML = '<tr><td colspan="9" class="text-center text-muted py-4">No shifts found for this period.</td></tr>';
            return;
        }

        let html = '';
        data.shifts.forEach(shift => {
            // Status badge
            let statusBadge = '';
            if (shift.status === 'OPEN') {
                statusBadge = '<span class="badge bg-info">🟢 OPEN</span>';
            } else if (shift.status === 'CLOSED') {
                statusBadge = '<span class="badge bg-success">✅ CLOSED</span>';
            } else if (shift.status === 'FORCE_CLOSED') {
                statusBadge = '<span class="badge bg-warning text-dark">⚠️ FORCE CLOSED</span>';
            }

            // Variance color
            let varianceHtml = '<span class="text-muted">—</span>';
            if (shift.variance !== null && shift.variance !== undefined) {
                if (shift.variance === 0) {
                    varianceHtml = '<span class="text-success fw-bold">₱0.00 ✅</span>';
                } else if (shift.variance > 0) {
                    varianceHtml = `<span class="text-info fw-bold">+₱${shift.variance.toFixed(2)} 🔵</span>`;
                } else {
                    varianceHtml = `<span class="text-danger fw-bold">-₱${Math.abs(shift.variance).toFixed(2)} 🔴</span>`;
                }
            }

            const expectedHtml = shift.expectedCash !== null ? `₱${shift.expectedCash.toFixed(2)}` : '<span class="text-muted">—</span>';
            const physicalHtml = shift.physicalCashCounted !== null ? `₱${shift.physicalCashCounted.toFixed(2)}` : '<span class="text-muted">—</span>';

            html += `
                <tr>
                    <td><strong>#${shift.shiftId}</strong></td>
                    <td>${shift.startTime}</td>
                    <td>${escapeHtml(shift.staffName)}</td>
                    <td>${statusBadge}</td>
                    <td class="text-end">₱${shift.openingFloat.toFixed(2)}</td>
                    <td class="text-end">${expectedHtml}</td>
                    <td class="text-end">${physicalHtml}</td>
                    <td class="text-end">${varianceHtml}</td>
                    <td class="text-center">
                        <button class="btn btn-sm btn-primary" onclick="viewShiftDetails(${shift.shiftId})">
                            <i class="fas fa-eye"></i> View Details
                        </button>
                    </td>
                </tr>
            `;
        });
        tbody.innerHTML = html;
    } catch (error) {
        console.error('Error loading shifts:', error);
        tbody.innerHTML = '<tr><td colspan="9" class="text-center text-danger">Error loading shifts: ' + error.message + '</td></tr>';
    }
}

function shiftPeso(n) {
    const v = Math.abs(Number(n || 0));
    return '₱' + v.toLocaleString('en-PH', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}

function shiftSigned(n) {
    const v = Number(n || 0);
    return (v < 0 ? '−' : (v > 0 ? '+' : '')) + shiftPeso(v);
}

function shiftDate(value) {
    if (!value) return '—';
    return new Date(value).toLocaleString('en-PH', {
        month: 'short', day: 'numeric', year: 'numeric',
        hour: 'numeric', minute: '2-digit'
    });
}

function varianceLabel(v) {
    if (Math.abs(v) < 0.005) return '<span class="sr-badge sr-ok">Balanced</span>';
    return v > 0
        ? '<span class="sr-badge sr-over">Over</span>'
        : '<span class="sr-badge sr-short">Short</span>';
}

function varianceTextClass(v) {
    if (Math.abs(v) < 0.005) return 'sr-ok-text';
    return v > 0 ? 'sr-over-text' : 'sr-short-text';
}

async function viewShiftDetails(shiftId) {
    showLoading('Loading shift details...');
    try {
        const res = await fetch(`/Owner/GetShiftDetails?shiftId=${shiftId}`);
        const data = await res.json();
        hideLoading();

        if (!data.success) {
            await showAlert(data.message || 'Unable to load shift details.', 'Error', '❌');
            return;
        }
        renderShiftReport(data);
    } catch (err) {
        hideLoading();
        await showAlert('Error loading shift details: ' + err.message, 'Error', '❌');
    }
}

function renderShiftReport(data) {
    const s = data.shift;
    const physical = data.physicalCash || 0;
    const variance = data.cashVariance || 0;
    const gcashVar = data.gcashVariance || 0;
    const hasGcash = (data.gcashExpected || 0) > 0 || s.gcashCounted != null;

    const denomRows = (data.denominations && data.denominations.length)
        ? data.denominations.map(d => `
            <tr>
                <td>${shiftPeso(d.denomination)}</td>
                <td class="num">× ${d.quantity}</td>
                <td class="num">${shiftPeso(d.subtotal)}</td>
            </tr>`).join('')
        : `<tr><td colspan="3" class="sr-empty">No denomination breakdown recorded.</td></tr>`;

    const expenseRows = (data.expenses && data.expenses.length)
        ? data.expenses.map(e => `
            <tr>
                <td>${shiftDate(e.expenseDate)}</td>
                <td>${escapeHtml(e.category)}</td>
                <td>${escapeHtml(e.description || '—')}</td>
                <td class="num sr-short-text">−${shiftPeso(e.amount)}</td>
            </tr>`).join('')
        : `<tr><td colspan="4" class="sr-empty">No expenses during this shift.</td></tr>`;

    const gcashBlock = hasGcash ? `
        <div class="sr-row"><span>Expected GCash sales</span>
            <span class="num">${shiftPeso(data.gcashExpected)}</span></div>
        <div class="sr-row"><span>Actual GCash counted</span>
            <span class="num">${s.gcashCounted == null ? '<em>Not recorded</em>' : shiftPeso(s.gcashCounted)}</span></div>
        <div class="sr-row sr-total"><span>GCash variance ${s.gcashCounted == null ? '' : varianceLabel(gcashVar)}</span>
            <span class="num ${varianceTextClass(gcashVar)}">${s.gcashCounted == null ? '—' : shiftSigned(gcashVar)}</span></div>`
        : `<div class="sr-empty">No GCash transactions in this shift.</div>`;

    const html = `
    <div class="sr-overlay" id="shiftDetailsModal">
        <div class="sr-card">
            <div class="sr-head">
                <div>
                    <div class="sr-eyebrow">End of Day Reconciliation</div>
                    <div class="sr-title">Shift #${s.shiftId}</div>
                </div>
                <button class="sr-close" onclick="closeShiftDetailsModal()" aria-label="Close">&times;</button>
            </div>

            <div class="sr-body">
                <div class="sr-section wide sr-meta">
                    <div><span>Cashier</span><strong>${escapeHtml(s.staffName)}</strong></div>
                    <div><span>Closed by</span><strong>${escapeHtml(s.closedByName || '—')}</strong></div>
                    <div><span>Time in</span><strong>${shiftDate(s.startTime)}</strong></div>
                    <div><span>Time out</span><strong>${shiftDate(s.endTime)}</strong></div>
                    <div><span>Status</span><strong>${escapeHtml((s.status || '').replace('_', ' '))}</strong></div>
                </div>

                <div class="sr-section">
                    <h4>Physical Cash Count</h4>
                    <table class="sr-table">
                        <thead><tr><th>Denomination</th><th class="num">Qty</th><th class="num">Subtotal</th></tr></thead>
                        <tbody>${denomRows}</tbody>
                        <tfoot><tr><td colspan="2">Total physical cash</td><td class="num">${shiftPeso(physical)}</td></tr></tfoot>
                    </table>
                </div>

                <div class="sr-section">
                    <h4>Cash Reconciliation</h4>
                    <div class="sr-row"><span>Opening float</span><span class="num">${shiftPeso(data.openingFloat)}</span></div>
                    <div class="sr-row"><span>Cash sales</span><span class="num sr-ok-text">+${shiftPeso(data.cashSales)}</span></div>
                    <div class="sr-row"><span>Cash expenses</span><span class="num sr-short-text">−${shiftPeso(data.cashExpenses)}</span></div>
                    <div class="sr-row sr-total"><span>Expected cash in drawer</span><span class="num">${shiftPeso(data.expectedCash)}</span></div>
                    <div class="sr-row"><span>Physical cash counted</span><span class="num">${shiftPeso(physical)}</span></div>
                    <div class="sr-row sr-total"><span>Cash variance ${varianceLabel(variance)}</span><span class="num ${varianceTextClass(variance)}">${shiftSigned(variance)}</span></div>
                </div>

                <div class="sr-section">
                    <h4>GCash Reconciliation</h4>
                    ${gcashBlock}
                </div>

               <div class="sr-section">
    <h4>Shift Remarks</h4>
    <div style="margin-bottom:10px;">
        <span style="display:block;font-size:11px;text-transform:uppercase;color:#64748b;letter-spacing:.05em;">Opening notes</span>
        <div>${s.openingNotes ? escapeHtml(s.openingNotes) : '<span class="sr-empty">No opening notes.</span>'}</div>
    </div>
    <div>
        <span style="display:block;font-size:11px;text-transform:uppercase;color:#64748b;letter-spacing:.05em;">Closing remarks</span>
        <div>${s.closingNotes ? escapeHtml(s.closingNotes) : '<span class="sr-empty">No remarks.</span>'}</div>
    </div>
</div>

                <div class="sr-section wide">
                    <h4>Expenses During Shift</h4>
                    <table class="sr-table">
                        <thead><tr><th>Date</th><th>Category</th><th>Description</th><th class="num">Amount</th></tr></thead>
                        <tbody>${expenseRows}</tbody>
                    </table>
                </div>
            </div>

            <div class="sr-foot">
                <button class="sr-btn" onclick="closeShiftDetailsModal()">Close</button>
            </div>
        </div>
    </div>`;

    closeShiftDetailsModal();
    document.body.insertAdjacentHTML('beforeend', html);
}

