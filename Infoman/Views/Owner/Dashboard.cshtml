<div id="inventoryModule" class="module">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h3>STOCK IN (Add Delivery Batch)</h3>
        <button class="btn btn-primary" onclick="toggleAddDeliveryPanel()" style="margin-left: 10px;">
            <i class="fas fa-plus"></i> ADD DELIVERY (BATCH)
        </button>
    </div>

    <div class="mb-3">
        <input type="text" id="searchRawMaterial" class="form-control" placeholder="Search raw materials..." onkeyup="filterTable()">
    </div>

    <div class="d-flex gap-3">

        <div style="flex: 2;">
            <table class="table table-bordered" id="rawMaterialTable">
                <thead>
                    <tr>
                        <th>SKU</th>
                        <th>Name</th>
                        <th>Category</th>
                        <th>Stock</th>
                        <th>Min Qty</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (ViewBag.RawMaterials != null)
                    {
                        foreach (var item in ViewBag.RawMaterials)
                        {
                            <tr data-id="@item.RawMaterialId">
                                <td class="sku-column">@(string.IsNullOrEmpty(item.SKU) ? "—" : item.SKU)</td>
                                <td>@item.Name</td>
                                <td data-value="@((int)item.Category)">@item.Category</td>
                                <td data-stock="@item.Stock" data-unit="@item.Unit">@($"{item.Stock:F2} {item.Unit}")</td>
                                <td data-minqty="@item.MinQty" data-unit="@item.Unit">@($"{item.MinQty:F2} {item.Unit}")</td>
                                <td>@item.Status</td>
                                <td>
                                    <button class="btn btn-sm btn-info" onclick="viewBatchHistory(@item.RawMaterialId, '@item.Name')"> Batches</button>
                                    <button class="btn btn-sm btn-primary" onclick="editMaterialFromInventory(@item.RawMaterialId, '@item.Name')"> Edit</button>
                                    <button class="btn btn-sm btn-danger" onclick="deleteMaterialFromInventory(@item.RawMaterialId, '@item.Name')"> Delete</button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="9" class="text-center">No raw materials yet.</td></tr>
                    }
                </tbody>
            </table>
        </div>

        <div id="addDeliveryPanel" style="flex: 1; display: none; border: 2px solid #28a745; padding: 15px; border-radius: 10px; background-color: #f0fff0; height: fit-content;">
            <h5 style="color: #28a745;">
                <i class="fas fa-truck-loading"></i> Add New Delivery (Stock Batch)
            </h5>
            <p class="text-muted small mb-3">
                <i class="fas fa-info-circle"></i> Each delivery creates a separate batch for FEFO tracking.
            </p>

            <form id="addDeliveryForm">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label fw-bold">Raw Material <span class="text-danger">*</span></label>
                    <select id="deliveryMaterialSelect" name="RawMaterialId" class="form-control" required>
                        <option value="">-- Select Raw Material --</option>
                        @if (ViewBag.RawMaterials != null)
                        {
                            foreach (var item in ViewBag.RawMaterials)
                            {
                                <option value="@item.RawMaterialId" data-unit="@item.Unit">
                                    @item.Name (@item.Unit) - Current Stock: @($"{item.Stock:F2} {item.Unit}")
                                </option>
                            }
                        }
                    </select>
                    <small class="text-muted">Select the raw material you're receiving</small>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Quantity <span class="text-danger">*</span></label>
                    <input type="number" id="deliveryQuantity" name="Quantity" class="form-control" step="0.01" min="0.01" required placeholder="0.00">
                    <small class="text-muted">Enter quantity</small>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Unit Price (₱) <span class="text-danger">*</span></label>
                    <input type="number" id="deliveryUnitPrice" name="UnitPrice" class="form-control" step="0.01" min="0" required placeholder="0.00">
                    <small class="text-muted">Price per unit</small>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Expiry Date <span class="text-muted">(Optional)</span></label>
                    <input type="date" id="deliveryExpiryDate" name="ExpiryDate" class="form-control">
                    <small class="text-muted">
                        <i class="fas fa-calendar-alt"></i> FEFO: Earliest expiry will be used first.
                    </small>
                </div>

                <div class="alert alert-warning py-2 small">
                    <i class="fas fa-lightbulb"></i> <strong>FEFO Note:</strong> Batches with the earliest expiry date will be consumed first.
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success flex-grow-1">
                        <i class="fas fa-check-circle"></i> Save Delivery
                    </button>
                    <button type="button" class="btn btn-secondary" onclick="toggleAddDeliveryPanel()">
                        <i class="fas fa-times"></i> Cancel
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

