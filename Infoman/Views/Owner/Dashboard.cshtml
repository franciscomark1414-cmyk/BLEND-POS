    function loadPerformanceData() {
        const employeeSelect = document.getElementById('perfEmployeeSelect');
        const userId = employeeSelect.value;

        if (!userId) {
            document.getElementById('perfTotalSales').innerHTML = '₱0.00';
            document.getElementById('perfTotalOrders').innerHTML = '0';
            document.getElementById('perfAvgRating').innerHTML = '0.0';
            document.getElementById('performanceTableBody').innerHTML = `
                <tr><td colspan="5" class="text-center text-muted">Select an employee to view performance</td></tr>
            `;
            return;
        }

        // Get last 30 days by default
        const endDate = new Date();
        const startDate = new Date();
        startDate.setDate(startDate.getDate() - 30);

        const startDateStr = startDate.toISOString().split('T')[0];
        const endDateStr = endDate.toISOString().split('T')[0];

        fetch(`/Employee/GetPerformance?userId=${userId}&startDate=${startDateStr}&endDate=${endDateStr}`)
