   async function deleteMaterial(id, clickEvent) {
    const deleteButton = clickEvent ? clickEvent.target : event.target;
    const originalText = deleteButton.innerText;

    // Mag-prompt para sa confirmation
    const confirmed = await showConfirm("Are you sure you want to delete this raw material?\n\nThis action cannot be undone.", "Delete Raw Material");
    if (!confirmed) return;

    deleteButton.innerText = 'Checking...';
    deleteButton.disabled = true;

    const token = document.querySelector('input[name="__RequestVerificationToken"]');
    if (!token) {
        await showAlert('Security token missing. Please refresh the page.', 'Error', '❌');
        deleteButton.innerText = originalText;
        deleteButton.disabled = false;
        return;
    }

    const formData = new FormData();
    formData.append('__RequestVerificationToken', token.value);
    formData.append('id', id);

    fetch('@Url.Action("DeleteConfirmed", "RawMaterial")', {
        method: 'POST',
        body: formData
    })
    .then(response => response.json())
    .then(async data => {
        if (data.success) {
            await showAlert( data.message, 'Success');
            saveAndReload();
        } else {
            if (data.hasAffectedProducts && data.affectedProducts) {
                const productListHtml = data.affectedProducts.map(p => `
                    <div class="list-group-item">
                        <div class="d-flex w-100 justify-content-between">
