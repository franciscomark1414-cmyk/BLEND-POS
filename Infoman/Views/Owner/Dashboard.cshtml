                                <div class="recipe-items" id="recipe-items-${sizeId}">
                                    
                                    <!-- ✅ UNANG ROW (FLEXBOX) -->
                                    <div class="ingredient-row">
                                        <select name="Sizes[${sizeId}].RecipeItems[0].RawMaterialId" class="form-control form-control-sm" required onchange="updateUnitDropdown(this)" style="flex: 1;">
                                            ${materialOptions}
                                        </select>
                                        <input type="number" name="Sizes[${sizeId}].RecipeItems[0].Quantity" class="form-control form-control-sm" placeholder="Qty" step="0.01" min="0.01" value="1" required style="width: 70px; flex-shrink: 0;">
                                        <select name="Sizes[${sizeId}].RecipeItems[0].UnitUsed" class="form-control form-control-sm unit-select" required style="width: 110px; flex-shrink: 0;">
                                        <option value="" disabled selected>-- Select Unit --</option>
                                            <option value="kg">📦 kg</option>
                                            <option value="g">⚖️ g</option>
                                            <option value="L">💧 L</option>
                                            <option value="mL">🧪 mL</option>
                                            <option value="pcs">🔢 pcs</option>
                                        </select>
                                        <div style="width: 28px; flex-shrink: 0;"></div> <!-- Spacer para pantay sa may X button -->
                                    </div>

                                </div>
                              <button type="button" class="btn btn-sm btn-link text-success mt-1" onclick="addRecipeItem(this)">
                                    <i class="fas fa-plus"></i> Add Ingredient
                                </button>
                            </div>
                        </div>
                    </div>
                `;
                container.insertAdjacentHTML('beforeend', sizeHtml);
                resolve();
            })
            .catch(err => {
                console.error('Error loading materials:', err);
                reject(err);
            });
    });
}









