// ---- Load + render table ----
async function loadCategories() {
    const tbody = document.getElementById('categoryTableBody');
    const type = document.getElementById('categoryTypeFilter').value;
    tbody.innerHTML = '<tr><td colspan="4" class="text-center text-muted">Loading...</td></tr>';

    try {
        const res = await fetch('/Category/GetAll' + (type ? '?type=' + encodeURIComponent(type) : ''));
        const data = await res.json();
        categoryCache = data.categories || [];
        renderCategoryTable();
    } catch (err) {
        console.error(err);
        tbody.innerHTML = '<tr><td colspan="4" class="text-center text-danger">Error loading categories (session expired?)</td></tr>';
    }
}

function renderCategoryTable() {
    const tbody = document.getElementById('categoryTableBody');

    if (categoryCache.length === 0) {
        tbody.innerHTML = '<tr><td colspan="4" class="text-center text-muted py-4">No categories yet. Add one on the right.</td></tr>';
        return;
    }

    tbody.innerHTML = categoryCache.map(c => `
        <tr>
            <td>
                <div class="fw-bold text-dark">${escapeHtml(c.name)}</div>
                <div class="small text-muted">Used by ${c.usageCount} item(s)</div>
