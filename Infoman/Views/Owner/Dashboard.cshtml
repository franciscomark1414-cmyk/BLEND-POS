 function loadWasteTab(wasteLogs) {
    const container = document.getElementById('wasteContent');
    
    if (!wasteLogs || wasteLogs.length === 0) {
        container.innerHTML = `
            <div class="empty-state text-center py-5">
                <i class="fas fa-trash-alt fa-4x text-muted mb-3"></i>
                <h5 class="text-muted">No Waste Logs Yet</h5>
                <button class="btn btn-warning btn-sm mt-2" onclick="showAddWasteModal()">
                    <i class="fas fa-plus"></i> Log Waste
                </button>
            </div>
        `;
        return;
    }
    
    let html = `
        <div class="table-responsive">
            <table class="table table-bordered table-hover">
                <thead class="table-danger">
                    <tr>
                        <th>Date</th>
                        <th>Material</th>
                        <th>Quantity</th>
                        <th>Reason</th>
                        <th>Total Cost</th>
                        <th>Recorded By</th>
                        <th>Notes</th>
                    </tr>
                </thead>
                <tbody>
    `;
    
    for (const log of wasteLogs) {
        // Format date
        const dateLogged = log.date ? new Date(log.date).toLocaleString() : 'N/A';
        
        // Format quantity - ITO ANG IMPORTANTE
        // Dapat ang quantity galing sa server ay display unit na (kg/L)
        let quantityDisplay = '0';
        if (typeof log.quantity === 'number') {
            quantityDisplay = log.quantity.toFixed(2);
        } else if (log.quantity) {
            quantityDisplay = parseFloat(log.quantity).toFixed(2);
        }
        
        // Format total cost
        let totalCostDisplay = '₱0.00';
        if (log.totalCost && !isNaN(parseFloat(log.totalCost))) {
            totalCostDisplay = `₱${parseFloat(log.totalCost).toFixed(2)}`;
        }
        
        // Get reason text
        let reasonText = log.reason || 'Unknown';
        let reasonBadge = 'bg-secondary';
        if (reasonText === 'Spoilage' || reasonText === 'Damaged') {
            reasonBadge = 'bg-warning text-dark';
        } else if (reasonText === 'Expired') {
            reasonBadge = 'bg-danger';
        }
        
        html += `
            <tr>
                <td>${dateLogged}</td>
                <td><strong>${escapeHtml(log.materialName || 'Unknown')}</strong></td>
                <td class="text-danger fw-bold">${quantityDisplay} ${escapeHtml(log.unit || '')}</td>
                <td><span class="badge ${reasonBadge}">${escapeHtml(reasonText)}</span></td>
                <td class="text-danger">${totalCostDisplay}</td>
                <td>${escapeHtml(log.recordedBy) || 'System'}</td>
                <td>${escapeHtml(log.notes) || '-'}</td>
            </tr>
        `;
    }
    
    html += `</tbody></div>`;
    container.innerHTML = html;
}

  function switchAlertTab(tabName, clickEvent) {
    console.log('Switching to tab:', tabName);
    
    // I-update ang active class sa buttons
    document.querySelectorAll('#inventoryAlertsModule .nav-link').forEach(btn => {
        btn.classList.remove('active');
    });
    if (clickEvent && clickEvent.target) {
        clickEvent.target.classList.add('active');
    }
    
    // I-hide lahat ng tab content
    const lowstockTab = document.getElementById('lowstockTabContent');
    const expiringTab = document.getElementById('expiringTabContent');
    const wasteTab = document.getElementById('wasteTabContent');
    
    if (lowstockTab) lowstockTab.style.display = 'none';
    if (expiringTab) expiringTab.style.display = 'none';
    if (wasteTab) wasteTab.style.display = 'none';
    
    // Ipakita ang napiling tab at i-refresh ang content
    if (tabName === 'lowstock') {
        if (lowstockTab) lowstockTab.style.display = 'block';
        // Refresh low stock data
        fetch('/Owner/GetInventoryAlertsData')
            .then(r => r.json())
            .then(data => loadLowStockTab(data.lowStockItems));
    } else if (tabName === 'expiring') {
        if (expiringTab) expiringTab.style.display = 'block';
        // Refresh expiring data
        fetch('/Owner/GetInventoryAlertsData')
            .then(r => r.json())
            .then(data => loadExpiringTab(data.expiringItems));
    } else if (tabName === 'waste') {
        if (wasteTab) wasteTab.style.display = 'block';
        console.log('Waste tab selected, loading waste logs...');
        // Refresh waste data
        fetch('/Owner/GetInventoryAlertsData')
            .then(r => r.json())
            .then(data => {
                console.log('Waste logs received:', data.wasteLogs.length);
                loadWasteTab(data.wasteLogs);
            })
            .catch(err => console.error('Error refreshing waste:', err));
    }
}

