        function extractUnit(stockWithUnit) {
        if (!stockWithUnit) return '';
        // Halimbawa: "10 kg" -> "kg", "5 pcs" -> "pcs"
        var parts = stockWithUnit.trim().split(' ');
        return parts.length > 1 ? parts[1] : '';
