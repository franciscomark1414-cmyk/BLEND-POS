function calculateIngredientTotal(element) {
    const trElement = element.closest('tr');
    if (!trElement) return;

    const select = trElement.querySelector('.ingredient-select');
    if (!select) return;
    
    const selectedOption = select.options[select.selectedIndex];
    let price = parseFloat(selectedOption?.getAttribute('data-price') || 0);
    
    const unitSelect = trElement.querySelector('.unit-select');
    const selectedUnit = unitSelect ? unitSelect.value : ''; 
    
    const quantityInput = trElement.querySelector('.quantity-input');
    const quantity = parseFloat(quantityInput ? quantityInput.value : 0);
    const materialUnit = selectedOption?.getAttribute('data-unit') || ''; 

    if (!select.value || quantity <= 0) {
        if (trElement.querySelector('.cost-per-unit')) trElement.querySelector('.cost-per-unit').innerText = `₱0.00`;
        if (trElement.querySelector('.total-cost')) trElement.querySelector('.total-cost').innerText = `₱0.00`;
        updateTotals();
        return;
    }

    let quantityForCost = quantity;

    // ✅ Tamang conversion para sa grams at mL
    if (materialUnit === 'g' || materialUnit === 'kg') {
        if (selectedUnit === 'kg') quantityForCost = quantity;           
        else if (selectedUnit === 'g') quantityForCost = quantity / 1000; 
    } 
    else if (materialUnit === 'mL' || materialUnit === 'L') {
        if (selectedUnit === 'L') quantityForCost = quantity;           
        else if (selectedUnit === 'mL') quantityForCost = quantity / 1000; 
    }

    const total = price * quantityForCost;
    
    if (trElement.querySelector('.cost-per-unit')) trElement.querySelector('.cost-per-unit').innerText = `₱${price.toFixed(2)}`;
    if (trElement.querySelector('.total-cost')) trElement.querySelector('.total-cost').innerText = `₱${total.toFixed(2)}`;
    
    updateTotals();
}
    function removeIngredientRow(button) { button.closest('tr').remove(); updateTotals(); }

      function updateTotals() {
    let totalCost = 0;
    document.querySelectorAll('#ingredientsBody tr').forEach(row => {
        const totalText = row.querySelector('.total-cost')?.innerText || '₱0.00';
        const totalValue = parseFloat(totalText.replace('₱', '')) || 0;
        totalCost += totalValue;
    });

    document.getElementById('totalCostDisplay').innerHTML = `₱${totalCost.toFixed(2)}`;
    document.getElementById('recipeTotalCost').value = `₱${totalCost.toFixed(2)}`;

    const margin = parseFloat(document.getElementById('marginSelect')?.value || 0.3);
    const autoPrice = roundToPriceEnding(totalCost / (1 - margin));

    // ✅ NEW: check the checkbox FIRST
    const isManual = document.getElementById('manualPriceCheckbox')?.checked === true;
    const priceInput = document.getElementById('recipeSellingPriceInput');

    // Always show the auto-computed value as reference
    document.getElementById('sellingPriceDisplay').innerHTML = `₱${autoPrice.toFixed(2)}`;

    // Only overwrite the input if NOT manual
    if (!isManual) {
        priceInput.value = autoPrice.toFixed(2);
    }

    // Profit/Loss — use whatever is in the input (manual or auto)
    const effectivePrice = parseFloat(priceInput.value) || autoPrice;
    const profitLoss = effectivePrice - totalCost;
    const profitLossDisplay = document.getElementById('profitLossDisplay');
    profitLossDisplay.innerHTML = `₱${profitLoss.toFixed(2)}`;
    profitLossDisplay.className = profitLoss >= 0 ? 'fw-bold text-success' : 'fw-bold text-danger';
}
   async function saveRecipe() { // ✅ Dapat may async
    const ingredients = [];
    
    // ✅ ITO YUNG CHECK NA DAPAT NANDITO
    const unitSelects = document.querySelectorAll('#ingredientsBody .unit-select');
    for (let select of unitSelects) {
        if (select.value === "") {
            await showAlert('Please select a unit for all ingredients.', 'Missing Unit', '⚠️');
            return;
        }
    }

    document.querySelectorAll('#ingredientsBody tr').forEach(row => {
        const select = row.querySelector('.ingredient-select');
        const unitSelect = row.querySelector('.unit-select');
        const quantity = row.querySelector('.quantity-input').value;
        
        if (select.value && quantity) {
            ingredients.push({
                rawMaterialId: parseInt(select.value),
                quantity: parseFloat(quantity),
                unitUsed: unitSelect ? unitSelect.value : 'g'
            });
        }
    });
    
    const margin = parseFloat(document.getElementById('marginSelect').value);
    const isManualPrice = document.getElementById('manualPriceCheckbox').checked;
    const manualPriceValue = parseFloat(document.getElementById('recipeSellingPriceInput').value) || 0;
    
    fetch('/Owner/SaveRecipe', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
        },
        body: JSON.stringify({
            productSizeId: currentProductSizeId,
            margin: margin,
            ingredients: ingredients,
            isManualPrice: isManualPrice,
            manualPrice: manualPriceValue
        })
    })
    .then(response => response.json())
    .then(async (data) => {
        if (data.success) {
            await showAlert('Recipe saved successfully!', 'Success');
            bootstrap.Modal.getInstance(document.getElementById('editRecipeModal')).hide();
            saveAndReload();
        } else {
            await showAlert('Error saving recipe: ' + data.message, 'Error');
        }
    })
    .catch(async (err) => {
        await showAlert('An error occurred. Please try again.', 'Error');
    });
}

