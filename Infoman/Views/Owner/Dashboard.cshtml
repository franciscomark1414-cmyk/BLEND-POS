               function editRecipe(productSizeId) {
        // Una, i-check kung pwedeng i-edit
        fetch(`/Owner/CanEditRecipe/${productSizeId}`)
            .then(response => response.json())
            .then(async (data) => {
                if (!data.canEdit) {
                    await showAlert(data.message, 'Cannot Edit');
                    return;
                }

                // Kung pwede, i-load ang recipe para i-edit
                fetch(`/Owner/EditRecipe/${productSizeId}`)
                    .then(response => response.json())
                    .then(async (recipeData) => {
                        if (!recipeData.success || recipeData.error) {
                            await showAlert(recipeData.error || 'Error loading recipe');
                            return;
                        }

                        // I-set ang currentProductSizeId
                        currentProductSizeId = recipeData.productSizeId;

                        // I-fill ang modal fields
                        document.getElementById('recipeProductName').innerText = recipeData.productName;
                        document.getElementById('recipeSizeName').innerText = recipeData.sizeName;
                        document.getElementById('recipeSellingPrice').value = `₱${recipeData.sellingPrice.toFixed(2)}`;
                        document.getElementById('recipeTotalCost').value = `₱${recipeData.totalCost.toFixed(2)}`;

                        // I-set ang margin select
                        const marginSelect = document.getElementById('marginSelect');
                        const marginValue = recipeData.margin || 0.3;
                        if (marginValue === 0.3) marginSelect.value = '0.3';
                        else if (marginValue === 0.4) marginSelect.value = '0.4';
                        else if (marginValue === 0.5) marginSelect.value = '0.5';
                        else marginSelect.value = '0.3';

                        // I-load ang ingredients
                        const tbody = document.getElementById('ingredientsBody');
                        tbody.innerHTML = '';

                        if (recipeData.ingredients && recipeData.ingredients.length > 0) {
                            ingredientCounter = 0;
                            recipeData.ingredients.forEach(ing => {
                                addIngredientRowToTable(ing, ingredientCounter++);
                            });
                        } else {
                            addIngredientRowToTable(null, 0);
                        }

                        updateTotals();

                        // Ipakita ang modal
                        new bootstrap.Modal(document.getElementById('editRecipeModal')).show();
                    })
                    .catch(async (err) => {
                        console.error('Error:', err);
                        await showAlert('Error loading recipe: ' + err.message, 'Error', '❌');
                    });
            })
            .catch(async (err) => {
                console.error('Error checking edit permission:', err);
                await showAlert('Error: ' + err.message);
            });
    }

