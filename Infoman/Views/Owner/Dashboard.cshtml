   // Submit receiving form
document.getElementById('receivingForm')?.addEventListener('submit', async function(e) {
    e.preventDefault();

    const items = [];
    const rows = document.querySelectorAll('#receivingItemsBody tr');

    for (let row of rows) {
        const rowId = row.id.split('-').pop();
        const materialSelect = document.querySelector(`.material-select[data-row="${rowId}"]`);

        if (!materialSelect || !materialSelect.value) continue;

        const receivedQty = parseFloat(document.querySelector(`.received-qty[data-row="${rowId}"]`).value) || 0;
        const acceptedQty = parseFloat(document.querySelector(`.accepted-qty[data-row="${rowId}"]`).value) || 0;
        const rejectedQty = parseFloat(document.querySelector(`.rejected-qty[data-row="${rowId}"]`).value) || 0;
        
        let disposition = '';
        let rejectionReason = '';
        
        if (rejectedQty > 0) {
            // Kunin ang disposition
            const dispositionSelect = document.querySelector(`.disposition-select[data-row="${rowId}"]`);
            disposition = dispositionSelect ? dispositionSelect.value : '';
            
            // Kunin ang rejection reason
            const reasonSelect = document.querySelector(`.rejection-reason[data-row="${rowId}"]`);
            rejectionReason = reasonSelect ? reasonSelect.value : '';
            
            if (rejectionReason === 'Other') {
                const otherReason = document.querySelector(`.other-reason[data-row="${rowId}"]`);
                rejectionReason = otherReason ? otherReason.value : 'Other (no details)';
            }
            
            // Validate: If rejected > 0, dapat may disposition
            if (!disposition) {
    await showAlert(`Please select disposition (Return or Waste) for ${materialSelect.options[materialSelect.selectedIndex].text}`, 'Required', '⚠️');
    return;
}
            
            // If rejected but no reason, set default
            if (!rejectionReason || rejectionReason === '') {
                rejectionReason = 'No reason provided';
            }
        }

        items.push({
            rawMaterialId: parseInt(materialSelect.value),
            rawMaterialName: materialSelect.options[materialSelect.selectedIndex].text.split('(')[0].trim(),
            receivedQty: receivedQty,
            acceptedQty: acceptedQty,
            rejectedQty: rejectedQty,
            disposition: disposition,
            rejectionReason: rejectionReason,
            unitPrice: parseFloat(document.querySelector(`.unit-price[data-row="${rowId}"]`).value) || 0,
            expiryDate: document.querySelector(`.expiry-date[data-row="${rowId}"]`).value || null
        });
    }

    if (items.length === 0) {
    await showAlert('Please add at least one item', 'Required');
    return;
}

    const data = {
        supplierId: parseInt(document.getElementById('supplierId').value),
        drNumber: document.getElementById('drNumber').value,
        invoiceNumber: document.getElementById('invoiceNumber').value,
        dateReceived: document.getElementById('dateReceived').value,
        remarks: document.getElementById('remarks').value,
        items: items
    };

    if (!data.supplierId || !data.drNumber) {
    await showAlert('Please select supplier and enter DR Number', 'Required');
    return;
}

    const submitBtn = this.querySelector('button[type="submit"]');
    const originalText = submitBtn.innerHTML;
    submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving...';
    submitBtn.disabled = true;

    fetch('/Owner/ReceiveDelivery', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
        },
        body: JSON.stringify(data)
    })
    .then(r => r.json())
    .then(result => {
        if (result.success) {
            showAlert( result.message, 'Success');
            document.getElementById('receivingForm').reset();
            document.getElementById('receivingItemsBody').innerHTML = '';
            receivingRowCount = 0;
            addReceivingRow();
            // Set new DR number
            document.getElementById('drNumber').value = generateDRNumber();
            // Set new Invoice number
            document.getElementById('invoiceNumber').value = generateInvoiceNumber();
            showModule('receivingHistory');
            loadDeliveryHistory();
        } else {
            showAlert(' Error: ' + result.message, 'Error');
        }
    })
    .finally(() => {
        submitBtn.innerHTML = originalText;
        submitBtn.disabled = false;
    });
});

