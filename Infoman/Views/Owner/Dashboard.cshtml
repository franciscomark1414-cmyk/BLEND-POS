async function saveNewSize() {
    const productIdInput = document.getElementById('addSizeProductId');
    const sizeNameInput = document.getElementById('newSizeName');
    const priceInput = document.getElementById('newSizePrice');
    
    if (!productIdInput || !productIdInput.value) {
        await showAlert('Product ID not found', 'Error', '❌');
        return;
    }
    
    const productId = productIdInput.value;
    const sizeName = sizeNameInput ? sizeNameInput.value.trim() : '';
    const price = priceInput ? parseFloat(priceInput.value) || 0 : 0;
    
    if (!sizeName) {
        await showAlert('Please enter a size name', 'Required', '⚠️');
        return;
    }
    
    const ingredients = [];
    const rows = document.querySelectorAll('#newSizeIngredientsBody tr');
    
    for (let row of rows) {
        const select = row.querySelector('.ingredient-select');
        const quantity = row.querySelector('.quantity-input');
        const unitSelect = row.querySelector('.unit-select');
        
        if (select && select.value) {
            if (!unitSelect.value) {
                await showAlert('Please select a unit for all ingredients.', 'Missing Unit', '⚠️');
                return;
            }
            if (!quantity.value || parseFloat(quantity.value) <= 0) {
                await showAlert('Please enter a valid quantity.', 'Invalid Quantity', '⚠️');
                return;
            }
            ingredients.push({
                rawMaterialId: parseInt(select.value),
                quantity: parseFloat(quantity.value),
                unitUsed: unitSelect.value
            });
        }
    }
    
    if (ingredients.length === 0) {
        await showAlert('Please add at least one ingredient', 'Required', '⚠️');
        return;
    }
    
    // Ipakita ang loading
    showLoading('Adding size...');
    
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
    const margin = parseFloat(document.getElementById('newSizeMargin').value) || 0.3;
    
    try {
        const response = await fetch('/Owner/AddProductSize', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token
            },
            body: JSON.stringify({
                productId: parseInt(productId),
                sizeName: sizeName,
                price: price,
                margin: margin,
                ingredients: ingredients
            })
        });
        
        // ✅ ITAGO MUNA ANG LOADING BAGO MAG-ALERT PARA HINDI MAGPATONG
        hideLoading(); 

        if (!response.ok) {
            const errorText = await response.text();
            throw new Error(`Server returned ${response.status}`);
        }

        const result = await response.json();
        
        if (result.success) {
            const modalElement = document.getElementById('addSizeModal');
            const modal = bootstrap.Modal.getInstance(modalElement);
            if (modal) modal.hide();
            
            await showAlert('Size added successfully!', 'Success', '✅');
            
            if (window.returnToEditModal) {
                window.returnToEditModal = false;
                const pId = document.getElementById('addSizeProductId').value;
                try {
                    await refreshProductSizes(pId);
                    const editModal = new bootstrap.Modal(document.getElementById('editProductModal'));
                    editModal.show();
                } catch (refreshError) {
                    saveAndReload();
                }
            } else {
                saveAndReload();
            }
        } else {
            // ❌ DITO LALABAS ANG DETALYADONG ERROR
            await showAlert('Error: ' + result.message, 'Error', '❌');
        }
    } catch (error) {
        // ✅ SIGURADUHING NAKA-HIDE ANG LOADING PAGKA-CRASH
        hideLoading(); 
        console.error('Critical Error in saveNewSize:', error);
        await showAlert('An error occurred: ' + error.message, 'Error', '❌');
    }
}


