    function loadReturns() {
    fetch('/Owner/GetReturns')
        .then(response => response.json())
        .then(data => {
            const tbody = document.getElementById('returnsTableBody');
            const countSpan = document.getElementById('approvedCount');
            
            // Check if elements exist
            if (!tbody) {
                console.warn('returnsTableBody not found');
                return;
            }
            
            // Handle different response formats
            let returns = [];
            if (data && data.$values) {
                returns = data.$values;
            } else if (data && Array.isArray(data)) {
                returns = data;
            } else {
                returns = [];
            }
            
            if (!returns || returns.length === 0) {
                if (tbody) tbody.innerHTML = '</table><td colspan="7" class="text-center text-muted">No void/refund records found<\/td><\/tr>';
                if (countSpan) countSpan.innerText = '0';
                return;
            }
            
            if (countSpan) countSpan.innerText = returns.length;
            
            let html = '';
            for (let i = 0; i < returns.length; i++) {
                const r = returns[i];
                
                const requestType = r.requestType || 'VOID';
                let typeBadge = '';
                if (requestType === 'VOID') {
                    typeBadge = '<span class="badge bg-danger">VOID</span>';
                    if (r.source === 'DIRECT') {
                        typeBadge = '<span class="badge bg-danger">VOID</span> <span class="badge bg-secondary">DIRECT</span>';
                    }
                } else {
                    typeBadge = '<span class="badge bg-warning">REFUND</span>';
                }
                
                const date = new Date(r.recordedAt);
                const formattedDate = `${date.getMonth()+1}/${date.getDate()}/${date.getFullYear()}`;
                const amount = Math.abs(r.amount || 0);
                const orderNumber = r.orderNumber || 'N/A';
                const reason = r.reason || 'No reason provided';
                const requesterName = r.requesterName || 'System';
                
                html += '<tr>';
                html += `<td>${formattedDate}<\/td>`;
                html += `<td><strong>${escapeHtml(orderNumber)}</strong><br>${typeBadge}<\/td>`;
                html += `<td>${requestType}<\/td>`;
                html += `<td>${escapeHtml(reason)}<\/td>`;
                html += `<td class="text-end fw-bold text-danger">₱${amount.toFixed(2)}<\/td>`;
                html += `<td>${escapeHtml(requesterName)}<\/td>`;
                html += `<td><button class="btn btn-sm btn-info" onclick="viewReturnDetails(${r.id})"><i class="fas fa-eye"></i> View<\/button><\/td>`;
                html += '<\/tr>';
            }
            if (tbody) tbody.innerHTML = html;
        })
        .catch(error => {
            console.error('Error loading returns:', error);
            const tbody = document.getElementById('returnsTableBody');
            if (tbody) {
                tbody.innerHTML = '<tr><td colspan="7" class="text-center text-danger">Error loading records: ' + error.message + '<\/td><\/tr>';
            }
        });
}

function updateReturnSummary(returns) {
    let pending = 0, returned = 0, cancelled = 0, totalValue = 0;
    let voidCount = 0, refundCount = 0;

    returns.forEach(r => {
        // ✅ GAWING POSITIVE ANG TOTAL
        const total = Math.abs(r.total || 0);
        totalValue += total;
        
        if (r.type === 'SUPPLIER_RETURN') {
            if (r.status === 'Pending Return') pending++;
            else if (r.status === 'Returned') returned++;
            else if (r.status === 'Cancelled') cancelled++;
        } else if (r.type === 'VOID') {
            voidCount++;
        } else if (r.type === 'REFUND') {
            refundCount++;
        }
    });

    document.getElementById('pendingReturnsCount').innerText = pending;
    document.getElementById('returnedCount').innerText = returned + voidCount + refundCount;
    document.getElementById('cancelledCount').innerText = cancelled;
    document.getElementById('totalReturnValue').innerHTML = `₱${totalValue.toFixed(2)}`;
}

