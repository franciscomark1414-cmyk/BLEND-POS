function checkUnitPriceWarning(rowId) {
    const priceInput = document.querySelector(`.unit-price[data-row="${rowId}"]`);
    const warningSpan = document.querySelector(`.price-warning[data-row="${rowId}"]`);
    const price = parseFloat(priceInput.value) || 0;
    
    if (price === 0 && priceInput.value !== '' && priceInput.value !== '0') {
        // Hindi zero, valid
        if (warningSpan) warningSpan.style.display = 'none';
    } else if (price === 0 && priceInput.value !== '') {
        // Zero price - show warning but allow
        if (warningSpan) warningSpan.style.display = 'inline';
    } else {
        if (warningSpan) warningSpan.style.display = 'none';
    }
}

// Helper function to update unit display when material changes
function updateUnitDisplay(rowId) {
    const select = document.querySelector(`.material-select[data-row="${rowId}"]`);
    const selectedOption = select.options[select.selectedIndex];
    const unit = selectedOption.getAttribute('data-unit') || '';
    const stockDisplay = selectedOption.getAttribute('data-stock') || '0';
    
    // Optional: Ipakita ang unit at stock sa tabi ng quantity field
