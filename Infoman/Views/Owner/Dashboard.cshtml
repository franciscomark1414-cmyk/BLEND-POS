      function filterProducts() {
        const searchTerm = document.getElementById('searchProduct').value.toLowerCase();
        const categoryFilter = document.getElementById('filterCategory').value;
        const products = document.querySelectorAll('.product-card');

        products.forEach(product => {
            const name = product.querySelector('h4')?.innerText.toLowerCase() || '';
            const category = product.getAttribute('data-category') || '';
            // Kunin ang SKU mula sa table cells
            const skuCells = product.querySelectorAll('table tbody tr td:nth-child(2) code');
            let matchesSKU = false;
            skuCells.forEach(cell => {
                if (cell.innerText.toLowerCase().includes(searchTerm)) matchesSKU = true;
            });

            const matches = (name.includes(searchTerm) || matchesSKU) &&
                            (!categoryFilter || category === categoryFilter);
            product.style.display = matches ? '' : 'none';
        });
    }

