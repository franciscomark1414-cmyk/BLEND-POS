    }

    if (!quantity || quantity <= 0) {
        await showAlert('Please enter a valid quantity', 'Required', '⚠️');
        return;
    }

    if (!unitPrice || unitPrice <= 0) {
        await showAlert('Please enter a valid unit price', 'Required', '⚠️');
        return;
    }

    const submitBtn = this.querySelector('button[type="submit"]');
    const originalText = submitBtn.innerHTML;
    submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving...';
    submitBtn.disabled = true;

    try {
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

        const requestBody = {
            rawMaterialId: parseInt(rawMaterialId),
            quantity: parseFloat(quantity),
            unit: unit,
            unitPrice: parseFloat(unitPrice),
            expiryDate: expiryDate || null
        };

        const response = await fetch('/RawMaterial/AddDelivery', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token
            },
            body: JSON.stringify(requestBody)
        });

        const result = await response.json();

        if (result.success) {
            // ✅ IBA-IBANG MESSAGE DEPENDE SA RESULT
            if (result.isExpired) {
                await showAlert(result.message, 'Expired Material Added', '⚠️');
            } else if (result.warning) {
                await showAlert(result.message, 'Warning', '⚠️');
            } else {
                await showAlert(result.message, 'Success', '✅');
            }
            
            // ✅ I-HIDE ANG PANEL
            document.getElementById('addDeliveryPanel').style.display = 'none';
            
            // ✅ RESET FORM
            document.getElementById('addDeliveryForm').reset();
            
            // ✅ SMOOTH REFRESH - UPDATE INVENTORY TABLE WITHOUT PAGE RELOAD
            await refreshInventoryTableData();
            
            // ✅ UPDATE DROPDOWN (para updated ang stock display)
            await refreshDeliveryMaterialDropdown();
            
            // ✅ I-UPDATE DIN ANG ALERTS KUNG NASA INVENTORY ALERTS MODULE
            const alertsModule = document.getElementById('inventoryAlertsModule');
            if (alertsModule && alertsModule.classList.contains('active')) {
                loadInventoryAlerts();
            }
            
        } else {
            await showAlert(' Error: ' + result.message, 'Error', '❌');
        }
    } catch (error) {
        console.error('Error details:', error);
        await showAlert(' Error adding delivery: ' + error.message, 'Error', '❌');
    } finally {
        submitBtn.innerHTML = originalText;
        submitBtn.disabled = false;
    }
});

// ✅ FUNCTION: Refresh delivery material dropdown
async function refreshDeliveryMaterialDropdown() {
