/* ========== PRINT STYLES ========== */
@@media print {
    /* Itago lahat ng elements */
    body * {
        visibility: hidden;
    }
    
    /* Ipakita lang ang printable container at mga laman nito */
    #printableFinancialReport, #printableFinancialReport * {
        visibility: visible;
    }
    
    /* I-position sa top-left */
    #printableFinancialReport {
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        display: block !important; /* I-override ang display:none */
        padding: 20px;
        font-family: 'Segoe UI', sans-serif;
    }

    /* Alisin ang background colors para makatipid sa ink */
    .no-print {
        display: none !important;
    }
}

