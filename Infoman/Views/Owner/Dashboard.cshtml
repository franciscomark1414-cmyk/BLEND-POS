    const modal = document.getElementById('shiftDetailsModal');
    if (modal) modal.remove();
}

// ========== HELPER FUNCTION ==========
function escapeHtml(str) {
    if (!str) return '';
    return String(str).replace(/[&<>]/g, function(m) {
        if (m === '&') return '&amp;';
        if (m === '<') return '&lt;';
        if (m === '>') return '&gt;';
        return m;
    });
}

