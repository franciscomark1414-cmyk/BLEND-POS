function createSupplierReturn(receivingItemId, maxQty, itemName, unitPrice) {
    // Store data for later use
    currentReturnData = {
        receivingItemId: receivingItemId,
        maxQty: maxQty,
        itemName: itemName,
        unitPrice: unitPrice
    };
    
    // ✅ CLOSE THE DELIVERY DETAILS MODAL FIRST
    const deliveryModal = document.getElementById('deliveryDetailsModal');
    if (deliveryModal) {
        deliveryModal.remove();
    }
    
    // ✅ CLOSE any existing supplier return modal
    const existingModal = document.getElementById('supplierReturnModal');
    if (existingModal) {
        existingModal.style.display = 'none';
    }
    
    // ✅ SMALL DELAY para magsara muna ang delivery modal bago lumabas ang return modal
    setTimeout(function() {
        // Show modal
        const modal = document.getElementById('supplierReturnModal');
        const itemInfo = document.getElementById('supplierReturnItemInfo');
        const qtyInput = document.getElementById('returnQuantity');
        const maxHint = document.getElementById('returnMaxQtyHint');
        const reasonSelect = document.getElementById('returnReason');
        const otherReason = document.getElementById('returnOtherReason');
        
        // Reset form
        qtyInput.value = maxQty;
        qtyInput.max = maxQty;
        reasonSelect.value = 'Damaged Packaging';
        otherReason.style.display = 'none';
        otherReason.value = '';
        
        // Set item info
        itemInfo.innerHTML = `
            <strong>Item:</strong> ${escapeHtml(itemName)}<br>
            <strong>Unit Price:</strong> ₱${unitPrice.toFixed(2)}<br>
            <strong>Max Quantity:</strong> ${maxQty}
        `;
        maxHint.innerHTML = `Max: ${maxQty}`;
        
        // Set onchange handlers
        qtyInput.onchange = async function() {
            let val = parseFloat(this.value);
            if (isNaN(val)) val = 0;
            if (val > maxQty) {
                this.value = maxQty;
                await showAlert(`Maximum quantity is ${maxQty}`, 'Limit Reached', '⚠️');
            }
            if (val < 0) this.value = 0;
        };
        
        reasonSelect.onchange = function() {
            const otherInput = document.getElementById('returnOtherReason');
            if (this.value === 'Other') {
                otherInput.style.display = 'block';
            } else {
                otherInput.style.display = 'none';
                otherInput.value = '';
            }
        };
        
        // Make sure modal is on top
        modal.style.display = 'flex';
        modal.style.zIndex = '10006';
    }, 100); // 100ms delay para magsara muna ang delivery modal
}

function closeSupplierReturnModal() {
    document.getElementById('supplierReturnModal').style.display = 'none';
}

async function confirmSupplierReturn() {
    const qty = parseFloat(document.getElementById('returnQuantity').value);
    const maxQty = currentReturnData.maxQty;
    const reasonSelect = document.getElementById('returnReason');
    let reason = reasonSelect.value;
    
    // Get other reason if selected
    if (reason === 'Other') {
        const otherReason = document.getElementById('returnOtherReason').value.trim();
        if (!otherReason) {
            await showAlert('Please specify the reason', 'Required');
            return;
        }
        reason = otherReason;
    }
    
    // Validate
    if (isNaN(qty) || qty <= 0) {
        await showAlert('Please enter a valid quantity', 'Invalid');
        return;
    }
    
    if (qty > maxQty) {
        await showAlert(`Quantity cannot exceed ${maxQty}`, 'Limit Exceeded');
        return;
    }
    
    if (!reason || reason === '') {
        await showAlert('Please select a reason', 'Required');
        return;
    }
    
    // ✅ CLOSE THE SUPPLIER RETURN MODAL FIRST
    closeSupplierReturnModal();
    
    // ✅ Use custom confirm (ito na mismo ang magpo-pop up sa unahan)
    const confirmed = await showConfirm(
        `Return ${qty} ${currentReturnData.itemName} to supplier?\n\nThis will record the return in the system.`,
        'Confirm Return'
    );
    
    if (!confirmed) return;
    
    showLoading('Processing return...');
    
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
    
    try {
        const response = await fetch('/Owner/ReturnToSupplier', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
            body: JSON.stringify({
                receivingItemId: currentReturnData.receivingItemId,
                quantity: qty,
                reason: reason,
                notes: null
            })
        });
        
        const result = await response.json();
        hideLoading();
        
        if (result.success) {
            await showAlert(result.message, 'Success', '✅');
            // Refresh the data
            loadDeliveryHistory();
            loadSupplierReturns();
        } else {
            await showAlert('Error: ' + result.message, 'Error', '❌');
        }
    } catch (error) {
        hideLoading();
        await showAlert('Error: ' + error.message, 'Error', '❌');
    }
}
