function updateAddOnAutoPrice() {
    const recipeCost = parseFloat(document.getElementById('addOnRecipeCost').innerText.replace('₱', '')) || 0;
    const margin = parseFloat(document.getElementById('addOnMargin').value) || 0.3;

    let computed = recipeCost / (1 - margin);
    computed = roundToEnding9(computed);

    document.getElementById('addOnAutoPriceDisplay').innerText = '₱' + computed.toFixed(2);
}

function roundToEnding9(price) {
    const rounded = Math.round(price);
    if (rounded <= 0) return 0;
    if (rounded < 10) return 9;
    const base = Math.floor(rounded / 10) * 10;
    let result = base + 9;
    if (result < rounded) result = base + 10 + 9;
    return result;
}

