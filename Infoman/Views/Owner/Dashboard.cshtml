async function submitGatePassword() {
    const password = document.getElementById('gatePasswordInput').value;
    const errorEl = document.getElementById('gatePasswordError');

    if (!password) {
        errorEl.style.display = 'block';
        errorEl.innerText = 'Please enter your password.';
        return;
    }

    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

    try {
        const response = await fetch('/RawMaterial/VerifyOwnerPassword', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token
            },
            body: JSON.stringify({ password: password })
        });

        const result = await response.json();

        if (result.success) {
            bootstrap.Modal.getInstance(document.getElementById('passwordGateModal')).hide();

            // Stock edit flow
            if (pendingBatchData) {
                openActualEditStockModal(
                    pendingBatchData.batchId,
                    pendingBatchData.currentRemainingInBaseUnit,
                    pendingBatchData.materialName,
                    pendingBatchData.unit,
                    pendingBatchData.materialId
                );
                pendingBatchData = null;
            }
            // Expiry edit flow
            else if (pendingExpiryData) {
                openEditExpiryModal(
                    pendingExpiryData.batchId,
                    pendingExpiryData.currentExpiry,
                    pendingExpiryData.materialName
                );
                pendingExpiryData = null;
            }
        } else {
            errorEl.style.display = 'block';
            errorEl.innerText = result.message || 'Incorrect password.';
            document.getElementById('gatePasswordInput').value = '';
            document.getElementById('gatePasswordInput').focus();
        }
    } catch (error) {
        errorEl.style.display = 'block';
        errorEl.innerText = 'Error: ' + error.message;
    }
}

