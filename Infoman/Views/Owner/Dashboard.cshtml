// Function para i-toggle ang show/hide ng password
function togglePasswordVisibility(inputId, iconId) {
    const input = document.getElementById(inputId);
    const icon = document.getElementById(iconId);
    
    if (input.type === "password") {
        input.type = "text";
        icon.classList.remove("fa-eye");
        icon.classList.add("fa-eye-slash");
    } else {
        input.type = "password";
        icon.classList.remove("fa-eye-slash");
        icon.classList.add("fa-eye");
    }
}

// ============================================================
// AUTO-GENERATE SKU PREFIX BASED ON PRODUCT NAME
// ============================================================
document.addEventListener('DOMContentLoaded', function() {
    const productNameInput = document.querySelector('input[name="Name"]');
    const skuPrefixInput = document.getElementById('skuPrefixInput');

    if (productNameInput && skuPrefixInput) {
        productNameInput.addEventListener('input', function() {
            // Kunin ang input, gawing uppercase, at tanggalin ang spaces/special chars
            let name = this.value.trim().toUpperCase().replace(/[^A-Z0-9]/g, '');
            
            let prefix = '';
            if (name.length >= 3) {
                prefix = name.substring(0, 3); // Kunin ang unang 3 letra
            } else if (name.length > 0) {
                // Kung 1 o 2 letra palang, i-pad ng 'X' (e.g., "M" -> "MXX")
                prefix = name.padEnd(3, 'X'); 
            }

            // I-set ang value sa readonly input
            skuPrefixInput.value = prefix;
        });
    }
});

function reindexRecipeItems() {
    document.querySelectorAll('#sizesContainer .size-row').forEach(sizeRow => {
        sizeRow.querySelectorAll('.ingredient-row').forEach((row, ri) => {
            row.querySelectorAll('select, input').forEach(el => {
                const name = el.getAttribute('name');
                if (name) el.setAttribute('name', name.replace(/RecipeItems\[\d+\]/, `RecipeItems[${ri}]`));
            });
        });
    });
}

