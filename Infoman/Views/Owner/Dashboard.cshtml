            if (cells.length >= 4) {
                hasExpenses = true;
                var newRow = document.createElement('tr');
                newRow.innerHTML = `
                    <td style="border: 1px solid #000; padding: 8px;">${cells[0].innerText}</td>
                    <td style="border: 1px solid #000; padding: 8px;">${cells[1].innerText}</td>
                    <td style="border: 1px solid #000; padding: 8px;">${cells[2].innerText}</td>
                    <td style="border: 1px solid #000; padding: 8px; text-align: right;">${cells[3].innerText}</td>
                `;
                expensesBody.appendChild(newRow);
            }
        });
    }

    if (!hasExpenses) {
        expensesBody.innerHTML = `
            <tr>
                <td colspan="4" style="border: 1px solid #000; padding: 8px; text-align: center; font-style: italic;">
                    No expenses found for this period.
                </td>
            </tr>
        `;
    }

    // 5. Trigger Print
    window.print();
}
function filterVouchers() {
    const term = document.getElementById('voucherSearchInput').value.trim().toLowerCase();

    const filtered = term
        ? voucherCache.filter(v =>
            (v.code || '').toLowerCase().includes(term) ||
            (v.eventName || '').toLowerCase().includes(term))
        : voucherCache;

    renderVoucherTable(filtered);
}

// ✅ ITO ANG NAWALANG FUNCTION
function openGenerateVoucherModal() {
    // ✅ Refresh dynamic events every time modal opens
    loadVoucherEventNames();

    // ✅ Reset dropdown to placeholder
    const select = document.getElementById('voucherEvent');
    if (select) select.value = '';

    // ✅ Reset the "Others" input
    const otherInput = document.getElementById('voucherEventOther');
    if (otherInput) {
        otherInput.value = '';
        otherInput.style.display = 'none';
    }

    document.getElementById('generateVoucherModal').style.display = 'flex';
}

function closeGenerateVoucherModal() {
    document.getElementById('generateVoucherModal').style.display = 'none';
}

async function loadVoucherEventNames() {
    try {
        const res = await fetch('/Voucher/GetEventNames');
        const data = await res.json();
        if (!data.success) return;

        const select = document.getElementById('voucherEvent');
        if (!select) return;

        const othersOption = select.querySelector('option[value="Others"]');
        if (!othersOption) return;

        // Remove old dynamic options
        select.querySelectorAll('option[data-dynamic="true"]').forEach(o => o.remove());

        // Insert each saved event before "Others"
        data.events.forEach(evt => {
            const alreadyExists = Array.from(select.options).some(
                o => o.value.toLowerCase() === evt.toLowerCase()
            );
            if (alreadyExists) return;

            const opt = document.createElement('option');
            opt.value = evt;
            opt.textContent = evt;
            opt.setAttribute('data-dynamic', 'true');
            select.insertBefore(opt, othersOption);
        });
    } catch (err) {
        console.error('Failed to load event names:', err);
    }
}

function toggleVoucherEventOther() {
    const select = document.getElementById('voucherEvent');
    const otherInput = document.getElementById('voucherEventOther');
    if (!select || !otherInput) return;

    if (select.value === 'Others') {
        otherInput.style.display = 'block';
        otherInput.focus();
    } else {
        otherInput.style.display = 'none';
        otherInput.value = '';
    }
}

function getVoucherEventName() {
    const select = document.getElementById('voucherEvent');
    const otherInput = document.getElementById('voucherEventOther');
    if (!select) return '';

    if (select.value === 'Others') {
        return (otherInput?.value || '').trim();
    }
    return select.value || '';
}

async function saveGeneratedVoucher(e) {
    e.preventDefault();
    const qty = parseInt(document.getElementById('voucherQty').value) || 1;
    const expiry = document.getElementById('voucherExpiry').value || null;
    const discountPercent = parseFloat(document.getElementById('voucherDiscount').value);

    // ✅ GAMITIN ANG getVoucherEventName()
    const eventName = getVoucherEventName();
    if (!eventName) {
        await showAlert('Please specify the event name.', 'Required', '⚠️');
        return;
    }

    const btn = document.getElementById('btnGenerateVoucher');
    const orig = btn.innerHTML;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Generating...';
    btn.disabled = true;

    try {
        const res = await fetch('/Voucher/Generate', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value },
            body: JSON.stringify({ 
                quantity: qty, 
                eventName: eventName, 
                expiryDate: expiry, 
                discountPercent: discountPercent
            })
        });
        const data = await res.json();
        if (data.success) {
            closeGenerateVoucherModal();
            await showAlert(`${qty} voucher(s) generated successfully!`, 'Success', '✅');
            loadVouchers();
            loadVoucherEventNames();   // ✅ Refresh dropdown para kasama na ang bagong event
        } else {
            await showAlert(data.message, 'Error', '❌');
        }
    } catch (err) {
        await showAlert('Error: ' + err.message, 'Error', '❌');
    } finally {
        btn.innerHTML = orig;
        btn.disabled = false;
    }
}

async function deleteVoucher(id) {
    const confirmed = await showConfirm('Delete this voucher?', 'Delete Voucher');
    if (!confirmed) return;
    try {
        const res = await fetch(`/Voucher/Delete?id=${id}`, { method: 'POST', headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value } });
        const data = await res.json();
        if (data.success) {
            await showAlert('Voucher deleted.', 'Success', '✅');
            loadVouchers();
        } else {
            await showAlert(data.message, 'Error', '❌');
        }
    } catch (err) {
        await showAlert('Error: ' + err.message, 'Error', '❌');
    }
}

document.addEventListener('DOMContentLoaded', function() {
    // ==========================================
    // 1. EXISTING LOGIC (MODULE LOADING)
    // ==========================================
    loadCategoryDropdown('filterCategory', 'Product', { valueKey: 'name', placeholder: 'All Categories' });
    
    // ✅ I-CLEAR muna ang localStorage (cleanup ng dati)
    localStorage.removeItem('activeModule');
    
    var urlParams = new URLSearchParams(window.location.search);
    var fromProductSave = urlParams.get('fromProductSave');
    
    // sessionStorage ONLY
    var savedModule = sessionStorage.getItem('activeModule');
    
    
    if (fromProductSave === 'true') {
        showModule('products');
        window.history.replaceState({}, document.title, window.location.pathname);
    } else if (savedModule) {
        showModule(savedModule); // reload lang ito within same session
    } else {
         showModule('dashboard'); // ✅ bagong login = laging dashboard
    }
    document.getElementById('initialModuleStyle')?.remove();

        // ==========================================
    // 2. NEW LOGIC (SUPPLIER VS STORE NAME)
    // ==========================================
    const supplierSelect = document.getElementById('supplierId'); 
    const storeNameInput = document.getElementById('globalStoreName'); 

    if (supplierSelect && storeNameInput) {
        // Pag pumili ng supplier, i-clear ang store name
        supplierSelect.addEventListener('change', function() {
            if (this.value !== "") { 
                storeNameInput.value = "";
            }
        });

        // Pag nag-type sa store name, i-reset ang supplier
        storeNameInput.addEventListener('input', function() {
            if (this.value.trim() !== "") {
                supplierSelect.value = ""; 
            }
        });
    }


     // ✅ ====== IDAGDAG ITO DITO ======
    const priceInput = document.getElementById('recipeSellingPriceInput');
    if (priceInput) {
        priceInput.addEventListener('input', function () {
            const totalCost = parseFloat(
                (document.getElementById('recipeTotalCost').value || '0').replace('₱','').replace(',','')
            ) || 0;
            const price = parseFloat(this.value) || 0;
            const profitLoss = price - totalCost;
            const el = document.getElementById('profitLossDisplay');
            if (el) {
                el.innerHTML = `₱${profitLoss.toFixed(2)}`;
                el.className = profitLoss >= 0 ? 'fw-bold text-success' : 'fw-bold text-danger';
            }
        });
    }
});

