        var minQty = parseFloat(minQtyWithUnit.split(' ')[0]);

        // Set form values
        document.getElementById('RawMaterialId').value = id;
        document.getElementById('Name').value = name;
        document.getElementById('Category').value = categoryInt;

        // ✅ IMPORTANT: Set the dropdown value for Unit
        var unitDropdown = document.getElementById('Unit');
        if (unitDropdown && unit) {
            // Check if the unit exists in dropdown options
            var optionExists = false;
            for (var i = 0; i < unitDropdown.options.length; i++) {
                if (unitDropdown.options[i].value === unit) {
                    optionExists = true;
                    break;
                }
            }
            if (optionExists) {
                unitDropdown.value = unit;
            } else {
                // If unit not in dropdown, add it temporarily or set to first option
                console.warn('Unit "' + unit + '" not found in dropdown');
                unitDropdown.value = ''; // or set to default
            }
        }

        document.getElementById('MinQty').value = isNaN(minQty) ? 0 : minQty;

        document.getElementById('formHeader').innerHTML = '<i class="fas fa-edit"></i> Edit Raw Material';
        document.getElementById('addRawMaterialBox').style.display = 'block';
