            <td>
                <span class="badge ${c.type === 'RawMaterial' ? 'bg-light text-dark border' : (c.type === 'AddOn' ? 'bg-warning text-dark' : 'bg-primary')}">
                    ${c.type === 'RawMaterial' ? 'Raw Material' : (c.type === 'AddOn' ? 'Add-on' : 'Product')}
                </span>
            </td>
            <td>
                <span class="badge ${c.isActive ? 'bg-success' : 'bg-secondary'}">${c.isActive ? 'Active' : 'Inactive'}</span>
            </td>
            <td class="text-end">
                <button class="btn btn-sm btn-outline-primary me-1" onclick="editCategory(${c.id})">Edit</button>
                <button class="btn btn-sm btn-outline-danger" onclick="deleteCategory(${c.id})">Delete</button>
            </td>
        </tr>`).join('');
}

function resetCategoryForm() {
    document.getElementById('catEditId').value = 0;
    document.getElementById('catName').value = '';
