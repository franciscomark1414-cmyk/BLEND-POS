async function saveSupplier() {
    // 1. Kunin ang values
    const id = parseInt(document.getElementById('editSupplierId').value);
    const name = document.getElementById('supplierName').value.trim();
    const phone = document.getElementById('supplierPhone').value.trim();
    const email = document.getElementById('supplierEmail').value.trim();
    const address = document.getElementById('supplierAddress').value.trim();
    const status = document.getElementById('supplierStatus').value;
    const contactPerson = document.getElementById('contactPerson').value.trim();

    // 2. I-reset muna lahat ng error
    document.getElementById('errSupplierName').classList.add('d-none');
    document.getElementById('errSupplierPhone').classList.add('d-none');
    document.getElementById('errSupplierEmail').classList.add('d-none');
    
    // Ipakita ulit ang hint
    document.getElementById('hintSupplierPhone').classList.remove('d-none');
    document.getElementById('hintSupplierEmail').classList.remove('d-none');

    let hasError = false;

    // 3. Validation Logic
    // Name: Required at min 3 chars
    if (!name || name.length < 3) {
        document.getElementById('errSupplierName').classList.remove('d-none');
        hasError = true;
    }

    // Phone: Kung may value, dapat tugma sa pattern
    if (phone) {
        // Tinatanggap ang 09123456789 o +639123456789
        const phoneRegex = /^(\+63|0)[0-9]{10}$/;
        if (!phoneRegex.test(phone)) {
            document.getElementById('errSupplierPhone').classList.remove('d-none');
            document.getElementById('hintSupplierPhone').classList.add('d-none'); // Hide hint pag may error
            hasError = true;
        }
    }

    // Email: Kung may value, dapat tamang format
    if (email) {
        const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/; 
        if (!emailRegex.test(email)) {
            document.getElementById('errSupplierEmail').classList.remove('d-none');
            document.getElementById('hintSupplierEmail').classList.add('d-none'); // Hide hint pag may error
            hasError = true;
        }
    }

    // Kung may error, itigil ang pag-save
    if (hasError) {
        return;
    }

    // 4. Ihanda ang data
    const data = {
        supplierId: id,
        name: name,
        contactPerson: contactPerson,
        phone: phone,
        email: email,
        address: address,
        status: status
    };
    
    const url = id === 0 ? '/Owner/CreateSupplier' : '/Owner/UpdateSupplier';
    
    // I-disable ang button
    const btn = event.target; 
    const originalText = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving...';

    try {
        const r = await fetch(url, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
            },
            body: JSON.stringify(data)
        });
        
        const result = await r.json();

        if (result.success) {
            bootstrap.Modal.getInstance(document.getElementById('supplierModal')).hide();
            loadSuppliers();
            await showAlert('Supplier saved successfully!', 'Success');
            document.getElementById('supplierForm').reset();
        } else {
            await showAlert('Error: ' + result.message, 'Error');
        }
    } catch (error) {
        await showAlert('Error: ' + error.message, 'Error');
    } finally {
        btn.disabled = false;
        btn.innerHTML = originalText;
    }
}

async function deleteSupplier(id) {
    const confirmed = await showConfirm('Delete this supplier?', 'Delete Supplier');
    if (!confirmed) return;
    
    showLoading('Deleting supplier...');
    
    fetch(`/Owner/DeleteSupplier?id=${id}`, {
        method: 'POST',
        headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value }
    })
    .then(r => r.json())
    .then(async result => {
        hideLoading();
