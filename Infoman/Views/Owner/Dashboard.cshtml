let unitCache = [];

function getUnitToken() {
    return document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
}

async function loadUnits() {
    const tbody = document.getElementById('unitTableBody');
    tbody.innerHTML = '<tr><td colspan="6" class="text-center text-muted">Loading...</td></tr>';

    try {
        const res = await fetch('/Unit/GetAll');
        const data = await res.json();
        unitCache = data.units || [];
        renderUnitTable();
    } catch (err) {
        console.error(err);
        tbody.innerHTML = '<tr><td colspan="6" class="text-center text-danger">Error loading units</td></tr>';
    }
}

function renderUnitTable() {
    const tbody = document.getElementById('unitTableBody');

    if (unitCache.length === 0) {
        tbody.innerHTML = '<tr><td colspan="6" class="text-center text-muted py-4">No units yet. Add one on the right.</td></tr>';
        return;
    }

    tbody.innerHTML = unitCache.map(u => `
        <tr>
            <td class="fw-bold text-dark">${escapeHtml(u.name)}</td>
            <td><code>${escapeHtml(u.symbol)}</code></td>
            <td>${escapeHtml(u.baseUnit)}</td>
            <td>${u.conversionFactor}</td>
            <td><span class="badge ${u.isActive ? 'bg-success' : 'bg-secondary'}">${u.isActive ? 'Active' : 'Inactive'}</span></td>
            <td class="text-end">
                <button class="btn btn-sm btn-outline-primary me-1" onclick="editUnit(${u.unitId})">Edit</button>
                <button class="btn btn-sm btn-outline-danger" onclick="deleteUnit(${u.unitId})">Delete</button>
            </td>
        </tr>`).join('');
}

function resetUnitForm() {
    document.getElementById('unitEditId').value = 0;
    document.getElementById('unitName').value = '';
    document.getElementById('unitSymbol').value = '';
    document.getElementById('unitBaseUnit').value = '';
    document.getElementById('unitConversionFactor').value = '1';
    document.getElementById('unitIsActive').checked = true;
    document.getElementById('unitFormTitle').innerText = '➕ Add Unit';
    document.getElementById('unitCancelBtn').style.display = 'none';
}

function editUnit(id) {
    const u = unitCache.find(x => x.unitId === id);
    if (!u) return;

    document.getElementById('unitEditId').value = u.unitId;
    document.getElementById('unitName').value = u.name;
    document.getElementById('unitSymbol').value = u.symbol;
    document.getElementById('unitBaseUnit').value = u.baseUnit;
    document.getElementById('unitConversionFactor').value = u.conversionFactor;
    document.getElementById('unitIsActive').checked = u.isActive;
    
    document.getElementById('unitFormTitle').innerText = '✏️ Edit Unit';
    document.getElementById('unitCancelBtn').style.display = 'inline-block';
    document.getElementById('unitName').focus();
}

async function saveUnit(e) {
    e.preventDefault();

    const id = parseInt(document.getElementById('unitEditId').value) || 0;
    const payload = {
        unitId: id,
        name: document.getElementById('unitName').value.trim(),
        symbol: document.getElementById('unitSymbol').value.trim(),
        baseUnit: document.getElementById('unitBaseUnit').value.trim(),
        conversionFactor: parseFloat(document.getElementById('unitConversionFactor').value),
        isActive: document.getElementById('unitIsActive').checked
    };

    if (!payload.name || !payload.symbol || !payload.baseUnit) {
        await showAlert('Please fill in all required fields.', 'Required', '⚠️');
        return;
    }

    showLoading('Saving unit...');
    try {
        const res = await fetch(id === 0 ? '/Unit/Create' : '/Unit/Update', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getUnitToken() },
            body: JSON.stringify(payload)
        });
        const data = await res.json();
        hideLoading();

        if (data.success) {
            await showAlert(data.message, 'Success', '✅');
            resetUnitForm();
            await loadUnits();
            
            // ✅ I-refresh din ang mga dropdowns kung mayroon man
            // await refreshAllUnitDropdowns(); 
        } else {
            await showAlert(data.message, 'Cannot Save', '❌');
        }
    } catch (err) {
        hideLoading();
        await showAlert('Error: ' + err.message, 'Error', '❌');
    }
}

async function deleteUnit(id) {
    const u = unitCache.find(x => x.unitId === id);
    if (!u) return;

    const confirmed = await showConfirm(`Delete unit "${u.name}"?`, 'Delete Unit');
    if (!confirmed) return;

    showLoading('Deleting unit...');
    try {
        const res = await fetch(`/Unit/Delete?id=${id}`, {
            method: 'POST',
            headers: { 'RequestVerificationToken': getUnitToken() }
        });
        const data = await res.json();
        hideLoading();

        if (data.success) {
            await showAlert(data.message, 'Deleted', '✅');
            resetUnitForm();
            await loadUnits();
        } else {
            await showAlert(data.message, 'Error', '❌');
        }
    } catch (err) {
        hideLoading();
        await showAlert('Error: ' + err.message, 'Error', '❌');
    }
}
       
