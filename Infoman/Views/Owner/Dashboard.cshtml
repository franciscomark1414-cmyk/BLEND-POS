    fetch(`/Owner/GetReceipts?date=${filterDate}`)
        .then(response => response.json())
        .then(data => {
            if (data.success && data.receipts) {
                displayReceiptHistory(data.receipts);
            } else {
                document.getElementById('receiptHistoryBody').innerHTML = 
                    '<tr><td colspan="10" class="text-center text-danger">Failed to load receipts</td></tr>';
