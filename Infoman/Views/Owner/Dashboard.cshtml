        function deleteMaterial(id, clickEvent) {
        const deleteButton = clickEvent ? clickEvent.target : event.target;
        const originalText = deleteButton.innerText;

        // Mag-prompt para sa confirmation
        if (!confirm("Are you sure you want to delete this raw material?\n\nThis action cannot be undone.")) {
            return;
        }

        deleteButton.innerText = 'Checking...';
        deleteButton.disabled = true;

        const token = document.querySelector('input[name="__RequestVerificationToken"]');
        if (!token) {
            alert('Security token missing. Please refresh the page.');
            deleteButton.innerText = originalText;
            deleteButton.disabled = false;
            return;
        }

        const formData = new FormData();
        formData.append('__RequestVerificationToken', token.value);
        formData.append('id', id);

        fetch('@Url.Action("DeleteConfirmed", "RawMaterial")', {
            method: 'POST',
            body: formData
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                alert('✅ ' + data.message);
                location.reload();
            } else {
                // ✅ KUNG MAY AFFECTED PRODUCTS, I-DISPLAY ANG DETAILS
                if (data.hasAffectedProducts && data.affectedProducts) {
                    const productListHtml = data.affectedProducts.map(p => `
                        <div class="list-group-item">
                            <div class="d-flex w-100 justify-content-between">
                                <h6 class="mb-1">${escapeHtml(p.productName)} - ${escapeHtml(p.sizeName)}</h6>
                                <small class="text-muted">Stock: ${p.stock} pcs</small>
                            </div>
                            <small class="text-muted">Price: ₱${p.price}</small>
                        </div>
                    `).join('');

                    document.getElementById('affectedProductsList').innerHTML = productListHtml;
                    new bootstrap.Modal(document.getElementById('affectedProductsModal')).show();
                } else {
                    alert('❌ ' + data.message);
                }
                deleteButton.innerText = originalText;
                deleteButton.disabled = false;
            }
        })
        .catch(err => {
            alert('❌ Error deleting material: ' + err.message);
            deleteButton.innerText = originalText;
            deleteButton.disabled = false;
        });
    }

        document.getElementById('addRawMaterialForm')?.addEventListener('submit', function(e) {
        e.preventDefault();

        var id = document.getElementById('RawMaterialId').value;
        var name = document.getElementById('Name').value.trim();
        var category = parseInt(document.getElementById('Category').value);
        var minQty = parseFloat(document.getElementById('MinQty').value) || 0;
        var unit = document.getElementById('Unit').value.trim();

        if (!name) { alert('Please enter a name'); return; }
        if (!unit) { alert('Please enter a unit'); return; }
        if (isNaN(category)) { alert('Please select a valid category'); return; }

        // ✅ Hindi na kasama ang Stock, Price, at ExpirationDate
        var formData = new FormData();
        formData.append('RawMaterialId', id || '0');
        formData.append('Name', name);
        formData.append('Category', category);
        formData.append('MinQty', minQty);
        formData.append('Unit', unit);
        // Stock at Price ay hindi na isinasama

        var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
        var url = id ? '@Url.Action("Edit", "RawMaterial")' : '@Url.Action("Create", "RawMaterial")';
        if (id) { url = url + '/' + id; }

        fetch(url, {
            method: 'POST',
            headers: { 'RequestVerificationToken': token },
            body: formData
        })
