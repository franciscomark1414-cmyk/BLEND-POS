}

// TAMA - sessionStorage ONLY
function saveAndReload() {
    let currentModule = 'dashboard';
    const modules = ['dashboard', 'rawMaterials', 'inventory', 'products', 
                     'inventoryAlerts', 'reports', 'employees', 'settings', 
                     'suppliers', 'receiving', 'receivingHistory', 'returns'];
    
    for (let i = 0; i < modules.length; i++) {
        const moduleEl = document.getElementById(modules[i] + 'Module');
        if (moduleEl && moduleEl.classList.contains('active')) {
            currentModule = modules[i];
            break;
        }
    }
    
    // sessionStorage ONLY — nawawala kapag nagsara ng tab o nag-logout
    sessionStorage.setItem('activeModule', currentModule);
    
    location.reload();
}



