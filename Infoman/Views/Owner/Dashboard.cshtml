  async function confirmRestock(event) {  
    if (event) event.preventDefault();

    const materialId = document.getElementById('restockMaterialId').value;
    const quantity = parseFloat(document.getElementById('restockQuantity').value);
    const unitPrice = document.getElementById('restockUnitPrice').value;
    const expiryDate = document.getElementById('restockExpiryDate').value;

    if (!quantity || quantity <= 0) {
        await showAlert('Please enter a valid quantity', 'Required', '⚠️');
        return;
    }

    if (!unitPrice || unitPrice <= 0) {
        await showAlert('Please enter a valid unit price', 'Required', '⚠️');
        return;
    }

    const confirmed = await showConfirm('Add this stock delivery?', 'Confirm Restock');
    if (!confirmed) return;

    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

    const submitBtn = event.target;
    const originalText = submitBtn.innerHTML;
    submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Adding...';
    submitBtn.disabled = true;

    // ✅ CONVERT TO BASE UNIT (g or mL) BAGO IPASA SA SERVER
    let quantityForBackend = quantity;
    if (typeof currentRestockUnit !== 'undefined' && (currentRestockUnit === 'kg' || currentRestockUnit === 'L')) {
        quantityForBackend = quantity * 1000; 
    }

    try {
        const response = await fetch('/RawMaterial/AddDelivery', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token
            },
            body: JSON.stringify({
                rawMaterialId: parseInt(materialId),
                quantity: quantityForBackend, // ✅ GAMITIN ANG CONVERTED VALUE
                unitPrice: parseFloat(unitPrice),
                expiryDate: expiryDate || null
            })
        });

        const data = await response.json();

        if (data.success) {
            await showAlert('✅ ' + data.message, 'Success', '✅');
            bootstrap.Modal.getInstance(document.getElementById('restockModal')).hide();
            loadInventoryAlerts();
            saveAndReload();
        } else {
            await showAlert('❌ Error: ' + data.message, 'Error', '❌');
        }
    } catch (error) {
        await showAlert('❌ Error: ' + error.message, 'Error', '❌');
    } finally {
        submitBtn.innerHTML = originalText;
        submitBtn.disabled = false;
    }
}
