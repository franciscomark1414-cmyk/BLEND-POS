    document.querySelector(`.accepted-qty[data-row="${rowId}"]`).value = '';
    document.querySelector(`.rejected-qty[data-row="${rowId}"]`).value = '';
    document.querySelector(`.converted-qty[data-row="${rowId}"]`).value = '0';

    calculateReceivingRow(rowId);
}
function toggleReasonDropdown(rowId) {
