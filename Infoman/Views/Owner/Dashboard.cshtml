async function produceProduct(productSizeId, sizeName, currentStock) {
    const quantity = prompt(` Produce ${sizeName}\n\nCurrent stock: ${currentStock} pcs\nEnter quantity to produce:`, "1");
    
    if (!quantity || quantity <= 0) return;
    
