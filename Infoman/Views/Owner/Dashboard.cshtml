        if (existingWarning) existingWarning.remove();

        modal.show();

        fetch(`/Owner/GetRecipe/${productSizeId}`)
            .then(response => response.json())
            .then(data => {
                if (data.error) {
                    alert(data.error);
                    modal.hide();
                    return;
                }

                // ✅ MAGDAGDAG NG WARNING KUNG MAY STOCK
                if (data.hasStock && data.stock > 0) {
                    const modalBody = document.getElementById('viewRecipeModal').querySelector('.modal-body');
                    const warningDiv = document.createElement('div');
                    warningDiv.id = 'viewRecipeWarning';
                    warningDiv.className = 'alert alert-warning mb-3';
                    warningDiv.innerHTML = `⚠️ <strong>Note:</strong> This product has ${data.stock} pcs in stock. Recipe cannot be edited until stock is sold or wasted.`;
                    modalBody.insertBefore(warningDiv, modalBody.firstChild);
                }

                // I-display ang recipe data
                document.getElementById('viewProductName').innerText = data.productName;
                document.getElementById('viewSizeName').innerText = data.sizeName;
                document.getElementById('viewProductSKU').innerText = data.productSKU || 'N/A';
                document.getElementById('viewProductCategory').innerText = data.productCategory || 'N/A';
                document.getElementById('viewStock').innerHTML = `${data.stock} pcs`;
                document.getElementById('viewSellingPrice').innerHTML = `₱${data.sellingPrice.toFixed(2)}`;
                document.getElementById('viewTotalCost').innerHTML = `₱${data.totalCost.toFixed(2)}`;
                document.getElementById('viewProfit').innerHTML = `₱${data.profit.toFixed(2)}`;
                document.getElementById('viewMargin').innerText = (data.margin * 100).toFixed(0);

                const markupPercent = ((data.sellingPrice - data.totalCost) / data.totalCost * 100).toFixed(0);
                document.getElementById('viewMarkup').innerHTML = markupPercent;

                const tbody = document.getElementById('viewIngredientsBody');
                tbody.innerHTML = '';

                if (data.ingredients && data.ingredients.length > 0) {
                    data.ingredients.forEach(ing => {
                        tbody.insertAdjacentHTML('beforeend', `
                            <tr>
                                <td><strong>${ing.name}</strong></td>
                                <td>${ing.quantity}</td>
                                <td>${ing.unit}</td>
                                <td>₱${ing.price.toFixed(2)}</td>
                                <td class="text-end">₱${ing.total.toFixed(2)}</td>
                            </table>
                        `);
                    });
                    document.getElementById('viewGrandTotal').innerHTML = `₱${data.totalCost.toFixed(2)}`;
                } else {
                    tbody.innerHTML = '<tr><td colspan="5" class="text-center text-muted">No ingredients added yet</td></tr>';
                    document.getElementById('viewGrandTotal').innerHTML = '₱0.00';
