    // PRODUCE FUNCTION - idagdag ito kasama ng ibang functions
async function produceProduct(productSizeId, sizeName, currentStock) {
    const quantity = prompt(` Produce ${sizeName}\n\nCurrent stock: ${currentStock} pcs\nEnter quantity to produce:`, "1");
    
    if (!quantity || quantity <= 0) return;
    
    const confirmed = await showConfirm(`Produce ${quantity} pcs of ${sizeName}?\n\nThis will deduct raw materials from inventory using FIFO.`, 'Confirm Production');
    if (!confirmed) return;
    
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
    
    const btn = event.target.closest('button');
    const originalText = btn.innerHTML;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Producing...';
    btn.disabled = true;
    
    try {
        const response = await fetch('/Owner/ProduceProduct', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token
            },
            body: JSON.stringify({
                productSizeId: productSizeId,
                quantity: parseInt(quantity),
                referenceNo: null
            })
        });
        const data = await response.json();
        
        if (data.success) {
            await showAlert( data.message, 'Success');
            saveAndReload();
        } else {
            await showAlert(' Error: ' + data.message, 'Error');
            btn.innerHTML = originalText;
            btn.disabled = false;
        }
    } catch (error) {
        await showAlert(' Network error: ' + error.message, 'Error');
        btn.innerHTML = originalText;
        btn.disabled = false;
    }
}

    async function viewBatchHistory(materialId, materialName) {
    const modal = new bootstrap.Modal(document.getElementById('batchHistoryModal'));
    const materialNameSpan = document.getElementById('modalBatchMaterialName');
    const tbody = document.getElementById('modalBatchHistoryBody');

    materialNameSpan.innerText = materialName;
    tbody.innerHTML = `<tr><td colspan="7" class="text-center"><div class="spinner-border text-primary spinner-border-sm"></div> Loading...<\/td><\/tr>`;
    
    modal.show();

    try {
        const response = await fetch(`/RawMaterial/BatchHistory?rawMaterialId=${materialId}`);
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        
        const data = await response.json();
        const batches = data.batches;
        const unit = data.unit || 'kg';

        if (!batches || batches.length === 0) {
            tbody.innerHTML = `<tr><td colspan="7" class="text-center text-muted">No batches found<\/td><\/tr>`;
            return;
        }

        tbody.innerHTML = '';
        let totalRemaining = 0;

        batches.forEach((batch, index) => {
            const quantityReceived = batch.quantityReceived;
            const quantityRemaining = batch.quantityRemaining;
            
            let status = '';
            let statusClass = '';
            if (quantityRemaining <= 0) {
                status = '<span class="badge bg-secondary">❌ Depleted</span>';
                statusClass = 'table-secondary';
            } else if (index === 0 && quantityRemaining > 0) {
                status = '<span class="badge bg-success">✅ ACTIVE (Next to Use)</span>';
                statusClass = 'table-success';
            } else if (quantityRemaining > 0) {
                status = '<span class="badge bg-info">📦 In Stock</span>';
                statusClass = 'table-info';
            }
            
            totalRemaining += quantityRemaining;
            
            const formattedReceivedDate = batch.receivedDate ? new Date(batch.receivedDate).toLocaleString() : 'N/A';
            const formattedExpiryDate = batch.expiryDate ? new Date(batch.expiryDate).toLocaleDateString() : 'No Expiry';
            
            tbody.innerHTML += `
                <tr class="${statusClass}">
                    <td>
                        <strong>Batch #${batch.batchId}</strong><br/>
                        <small class="text-muted">Received: ${formattedReceivedDate}</small>
                    </td>
                    <td>${quantityReceived.toFixed(2)} ${unit}</td>
                    <td class="${quantityRemaining === 0 ? 'text-danger' : 'text-success'} fw-bold">
                        ${quantityRemaining.toFixed(2)} ${unit}
                    </td>
                    <td>${formattedExpiryDate}</td>
                    <td>₱${batch.unitPrice.toFixed(2)}</td>
                    <td>${status}</td>
                    <td>
                        <div class="d-flex gap-1">
                            ${batch.usage?.length > 0 ? 
                                `<button class="btn btn-sm btn-outline-info" onclick='showUsageDetails(${JSON.stringify(batch.usage)})'>
                                    📋 View Usage (${batch.usage.length})
                                </button>` : 
                                '<span class="text-muted">No usage</span>'}
                            <!-- ✅ ADD EDIT STOCK BUTTON HERE -->
                            <button class="btn btn-sm btn-outline-warning" onclick="showEditStockModal(${batch.batchId}, ${quantityRemaining}, '${materialName}', '${unit}')">
                                ✏️ Edit Stock
                            </button>
                        </div>
                    </td>
                </tr>
            `;
        });

        tbody.innerHTML += `
            <tr class="table-dark fw-bold">
                <td colspan="2" class="text-end">TOTAL REMAINING STOCK:</td>
                <td colspan="5">${totalRemaining.toFixed(2)} ${unit}</td>
            </tr>
        `;

    } catch (error) {
        console.error('Error:', error);
        tbody.innerHTML = `<tr><td colspan="7" class="text-center text-danger">Error loading batches: ${error.message}<\/td><\/tr>`;
    }
}


async function displayInPOS(productSizeId, productName, sizeName) {
    const confirmed = await showConfirm(`Display "${productName} - ${sizeName}" in POS menu?`, 'Confirm');
    if (!confirmed) return;
    
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
    const btn = event.target;
    const originalText = btn.innerHTML;

    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
    btn.disabled = true;

    try {
        const response = await fetch('/Owner/TogglePOSVisibility', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token
            },
            body: JSON.stringify({
                productSizeId: productSizeId,
                isAvailable: true
            })
        });

        const data = await response.json();

        if (data.success) {
            await showAlert(` "${productName} - ${sizeName}" is now DISPLAYED in POS menu.`, 'Success');
            // ✅ Auto refresh after 1 second
            setTimeout(function() {
                saveAndReload();
            }, 1000);
        } else {
            await showAlert(' Error: ' + data.message, 'Error');
            btn.innerHTML = originalText;
            btn.disabled = false;
        }
    } catch (error) {
        await showAlert(' Error: ' + error.message, 'Error');
        btn.innerHTML = originalText;
        btn.disabled = false;
    }
}

