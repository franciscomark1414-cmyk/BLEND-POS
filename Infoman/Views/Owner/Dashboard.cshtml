function getBaseUnitForRow(rowId) {
    const sel = document.querySelector(`.material-select[data-row="${rowId}"]`);
    return sel?.options[sel.selectedIndex]?.getAttribute('data-base-unit') || 'g';
}

// g → kg (÷1000), mL → L (÷1000), pcs → pcs
function costDivisor(baseUnit) {
    return (baseUnit === 'g' || baseUnit === 'mL') ? 1000 : 1;
}

function costUnitLabel(baseUnit) {
    return baseUnit === 'g' ? 'kg' : (baseUnit === 'mL' ? 'L' : baseUnit);
}

// Stored value: laging per kg / per L / per pcs
function pricePerCostUnit(acceptedPrice, acceptedBaseQty, baseUnit) {
    const div = (baseUnit === 'g' || baseUnit === 'mL') ? 1000 : 1;
    return acceptedBaseQty > 0 ? acceptedPrice / (acceptedBaseQty / div) : 0;
}

// Display lang: per g kapag < 1000, per kg kapag >= 1000
function formatUnitPrice(acceptedPrice, acceptedBaseQty, baseUnit) {
    if (acceptedBaseQty <= 0) return { value: 0, label: '' };

    if (baseUnit === 'g' || baseUnit === 'mL') {
        if (acceptedBaseQty >= 1000) {
            return {
                value: acceptedPrice / (acceptedBaseQty / 1000),
                label: baseUnit === 'g' ? 'per kg' : 'per L'
            };
        }
        return {
            value: acceptedPrice / acceptedBaseQty,
            label: baseUnit === 'g' ? 'per g' : 'per mL'
        };
    }

    return { value: acceptedPrice / acceptedBaseQty, label: 'per pc' };
}

function calculateReceivingRow(rowId) {
    const q = (cls) => document.querySelector(`${cls}[data-row="${rowId}"]`);

    const receivedInput = q('.received-qty');
    const acceptedInput = q('.accepted-qty');
    const rejectedInput = q('.rejected-qty');
    const convertedOut = q('.converted-qty');
    const unitPriceOut = q('.unit-price');
    const priceLabel = q('.price-label');
    const convInput = q('.pkg-conversion');
    const totalPriceInput = q('.total-price');
    const acceptedPriceOut = q('.accepted-price');

    const materialSelect = q('.material-select');
    const selectedOption = materialSelect?.options[materialSelect.selectedIndex];

    if (!selectedOption || !selectedOption.value) {
        convertedOut.value = '0';
        unitPriceOut.value = '0.00';
        acceptedPriceOut.value = '0.00';
        if (priceLabel) priceLabel.textContent = 'per unit';
        return;
    }

    const displayUnit = selectedOption.getAttribute('data-unit') || '';
    const baseUnit = getBaseUnitForRow(rowId);
    const received = parseFloat(receivedInput.value) || 0;
    const conv = parseFloat(convInput.value) || 1;
    const totalPrice = parseFloat(totalPriceInput.value) || 0;

    // ✅ BAGONG CHECK: Kung blangko ang Accepted, huwag munang mag-compute ng Rejected
    if (acceptedInput.value.trim() === '') {
        rejectedInput.value = '0';
        convertedOut.value = '0.00';
        acceptedPriceOut.value = '0.00';
        unitPriceOut.value = '0.00';
        if (priceLabel) priceLabel.textContent = `per ${baseUnit}`;

        // Warning sa price kahit blangko ang accepted
        if (received > 0 && totalPrice <= 0) {
            totalPriceInput.style.borderColor = 'red';
            if (priceLabel) priceLabel.textContent = '⚠️ Missing Price';
        } else {
            totalPriceInput.style.borderColor = '';
        }

        toggleReasonDropdown(rowId);
        return;
    }

    const acceptedQty = Math.min(Math.max(parseFloat(acceptedInput.value) || 0, 0), received);
    const rejectedQty = received - acceptedQty;

    const convertedInDisplayUnit = acceptedQty * conv;
    convertedOut.value = convertedInDisplayUnit.toFixed(2);

    const safeAcceptedPrice = received > 0 ? totalPrice * (acceptedQty / received) : 0;
    acceptedPriceOut.value = safeAcceptedPrice.toFixed(2);

    const toBaseFactor = (displayUnit === 'kg' || displayUnit === 'L') ? 1000 : 1;
    const acceptedBaseQty = convertedInDisplayUnit * toBaseFactor;

    const fmt = formatUnitPrice(safeAcceptedPrice, acceptedBaseQty, baseUnit);
    unitPriceOut.value = fmt.value.toFixed(2);
    if (priceLabel) priceLabel.textContent = fmt.label || `per ${baseUnit}`;

    rejectedInput.value = rejectedQty.toFixed(2);

    if (received > 0 && totalPrice <= 0) {
        totalPriceInput.style.borderColor = 'red';
        if (priceLabel) priceLabel.textContent = '⚠️ Missing Price';
    } else {
        totalPriceInput.style.borderColor = '';
    }

    toggleReasonDropdown(rowId);
}
function removeReceivingRow(rowId) {
