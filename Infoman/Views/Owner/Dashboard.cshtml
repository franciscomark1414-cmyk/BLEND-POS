        }
    }

    // Get disposition and reason (gamitin sa submit)
    function getDispositionAndReason(rowId) {
        const dispositionCell = document.querySelector(`.disposition-cell[data-row="${rowId}"]`);
        const disposition = dispositionCell.querySelector('.disposition-select').value;
        const reasonSelect = dispositionCell.querySelector('.rejection-reason');
        let reason = reasonSelect.value;

        if (reason === 'Other') {
            reason = dispositionCell.querySelector('.other-reason').value;
            if (!reason) reason = 'Other (no details)';
        }

        return { disposition, reason };
    }

