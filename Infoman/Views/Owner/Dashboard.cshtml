            .then(response => response.json())
            .then(async (data) => {
                if (data.success) {
                    currentRestockMaterialId = materialId;
                    currentRestockUnit = data.unit; // ✅ I-SAVE ANG UNIT
                    
                    document.getElementById('restockMaterialId').value = materialId;
                    document.getElementById('restockMaterialName').value = data.name;
                    document.getElementById('restockCurrentStock').value = `${data.stock} ${data.unit}`;
                    document.getElementById('restockQuantity').value = '';
                    document.getElementById('restockUnitPrice').value = data.price;
                    document.getElementById('restockExpiryDate').value = '';

                    // ✅ I-UPDATE ANG LABEL PARA MAKITA NG USER ANG UNIT
                    const qtyLabel = document.querySelector('label[for="restockQuantity"]');
