                    function loadReportsData() {
        showReportsLoading();

        fetch('/Owner/GetReportsData')
            .then(function(response) {
                if (!response.ok) throw new Error('Network error');
                return response.json();
            })
            .then(function(data) {

                // ✅ VALIDATION (important)
                if (!data || !data.salesPerformance) {
                    console.warn('Invalid or empty data received');
                    showReportsError();
                    return;
                }

                // ✅ store safely
                lastReportsData = data;

                // ✅ update UI
                updateTopSelling(data.topSellingProducts);
                updateWasteSummary(data.wasteLogs);
                updateDiscountRecords(data.discountRecords || []);
                updateCategoryRevenue(data.categoryRevenue);
                renderSalesChart(data.salesPerformance);
                renderCategoryPieChart(data.categoryDistribution);

                reportsDataLoaded = true;
            })
            .catch(function(error) {
                console.error('Error loading reports:', error);

                // ✅ fallback if may old data
                if (lastReportsData) {
                    renderSalesChart(lastReportsData.salesPerformance);
                    renderCategoryPieChart(lastReportsData.categoryDistribution);
                } else {
                    showReportsError();
                }
            });
            }

             function loadReceiptHistory() {
