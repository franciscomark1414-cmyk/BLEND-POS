            function viewRecipe(productSizeId) {
        const modal = new bootstrap.Modal(document.getElementById('viewRecipeModal'));

        // I-reset ang modal content
        document.getElementById('viewProductName').innerText = 'Loading...';
        document.getElementById('viewSizeName').innerText = '';
        document.getElementById('viewIngredientsBody').innerHTML = '<tr><td colspan="5" class="text-center">Loading recipe details...</td></tr>';

        // I-remove ang existing warning kung meron
