            <form id="addDeliveryForm">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label fw-bold">Raw Material <span class="text-danger">*</span></label>
                    <select id="deliveryMaterialSelect" name="RawMaterialId" class="form-control" required>
                        <option value="">-- Select Raw Material --</option>
                        @if (ViewBag.RawMaterials != null)
                        {
                            foreach (var item in ViewBag.RawMaterials)
                            {
                                <option value="@item.RawMaterialId" data-unit="@item.Unit">
                                    @item.Name (@item.Unit) - Current Stock: @item.StockWithUnit
                                </option>
                            }
                        }
                    </select>
                    <small class="text-muted">Select the raw material you're receiving</small>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Quantity <span class="text-danger">*</span></label>
                    <input type="number" id="deliveryQuantity" name="Quantity" class="form-control" step="0.01" min="0.01" required placeholder="0.00">
                    <small class="text-muted">Enter quantity</small>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Unit Price (₱) <span class="text-danger">*</span></label>
                    <input type="number" id="deliveryUnitPrice" name="UnitPrice" class="form-control" step="0.01" min="0" required placeholder="0.00">
                    <small class="text-muted">Price per unit</small>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Expiry Date <span class="text-muted">(Optional)</span></label>
                    <input type="date" id="deliveryExpiryDate" name="ExpiryDate" class="form-control">
                    <small class="text-muted">
                        <i class="fas fa-calendar-alt"></i> FEFO: Earliest expiry will be used first.
                    </small>
                </div>

                <div class="alert alert-warning py-2 small">
                    <i class="fas fa-lightbulb"></i> <strong>FEFO Note:</strong> Batches with the earliest expiry date will be consumed first.
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success flex-grow-1">
                        <i class="fas fa-check-circle"></i> Save Delivery
                    </button>
                    <button type="button" class="btn btn-secondary" onclick="toggleAddDeliveryPanel()">
                        <i class="fas fa-times"></i> Cancel
                    </button>
                </div>
            </form>
        </div>
    </div>
