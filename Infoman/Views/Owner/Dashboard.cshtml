    function switchEmployeeTab(tab) {
        var listTab = document.getElementById('employeeListTab');
        var perfTab = document.getElementById('employeePerformanceTab');
        var attendTab = document.getElementById('employeeAttendanceTab');
        var tabs = document.querySelectorAll('#employeesModule .nav-link');

        for (var i = 0; i < tabs.length; i++) {
            tabs[i].classList.remove('active');
        }

        if (tab === 'list') {
            if (tabs[0]) tabs[0].classList.add('active');
            if (listTab) listTab.style.display = 'block';
            if (perfTab) perfTab.style.display = 'none';
            if (attendTab) attendTab.style.display = 'none';
            loadEmployees();
        }
           else if (tab === 'performance') {
        if (tabs[1]) tabs[1].classList.add('active');
        if (listTab) listTab.style.display = 'none';
        if (perfTab) perfTab.style.display = 'block';
        if (attendTab) attendTab.style.display = 'none';

        // Load employees into performance dropdown
        fetch('/Employee/GetAllEmployees')
            .then(response => response.json())
            .then(employees => {
                const perfSelect = document.getElementById('perfEmployeeSelect');
                if (perfSelect) {
                    let options = '<option value="">-- Select Employee --</option>';

                    // I-save ang dating selected value kung meron
                    const oldValue = perfSelect.value;

                    employees.forEach(emp => {
                        options += `<option value="${emp.id}">${emp.fullName}</option>`;
                    });
                    perfSelect.innerHTML = options;

                    // I-restore ang dating selected value
                    if (oldValue && oldValue !== "") {
                        perfSelect.value = oldValue;
                    }
                }

                // Auto-load performance kung may naunang napili
                if (perfSelect && perfSelect.value) {
                    loadPerformanceData();
                }
            });
    }
        else if (tab === 'attendance') {
            if (tabs[2]) tabs[2].classList.add('active');
            if (listTab) listTab.style.display = 'none';
            if (perfTab) perfTab.style.display = 'none';
            if (attendTab) attendTab.style.display = 'block';

            // Load employees into attendance dropdown
            fetch('/Employee/GetAllEmployees')
                .then(response => response.json())
                .then(employees => {
                    const attSelect = document.getElementById('attEmployeeSelect');
                    if (attSelect) {
                        attSelect.innerHTML = '<option value="">-- Select Employee --</option>';
                        employees.forEach(emp => {
                            attSelect.innerHTML += `<option value="${emp.id}">${emp.fullName}</option>`;
                        });
                    }
                });
        }
    }

    async function deleteEmployee(employeeId, employeeName) {
    const confirmed = await showConfirm(
        `Delete employee "${employeeName}"?\n\nThis action cannot be undone.`,
        'Delete Employee'
    );
    
    if (!confirmed) return;
    
    showLoading('Deleting employee...');
    
    try {
        const response = await fetch(`/Employee/Delete?id=${employeeId}`, {
            method: 'POST',
            headers: {
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
            }
        });
        
        const result = await response.json();
        hideLoading();
        
        if (result.success) {
            await showAlert( result.message, 'Success');
            loadEmployees(); // Refresh the list
        } else {
            await showAlert('Error: ' + result.message, 'Error');
        }
    } catch (error) {
        hideLoading();
        await showAlert(' Error: ' + error.message, 'Error');
    }
}

