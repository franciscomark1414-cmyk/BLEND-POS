<div id="editStockModal" class="modal fade" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 16px; overflow: hidden;">
            <div class="modal-header" style="background: linear-gradient(135deg, #ff6b35, #f7931e); color: white; border: none;">
                <h5 class="modal-title">
                    <i class="fas fa-edit me-2"></i> Edit Batch Stock
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" style="padding: 25px;">
                <!-- Batch Info Card -->
                <div style="background: #f8f9fa; border-radius: 12px; padding: 15px; margin-bottom: 20px;">
                    <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                        <span style="color: #666;">Batch #</span>
                        <strong id="editBatchId" style="color: #ff6b35;">-</strong>
                    </div>
                    <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                        <span style="color: #666;">Material</span>
                        <strong id="editMaterialName">-</strong>
                    </div>
                    <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                        <span style="color: #666;">Current Stock</span>
                        <strong id="editCurrentStock" class="text-danger">-</strong>
                    </div>
                    <div style="display: flex; justify-content: space-between;">
                        <span style="color: #666;">Unit</span>
                        <strong id="editUnit">-</strong>
                    </div>
                </div>

                <!-- New Quantity Input -->
                <div class="mb-4">
                    <label class="form-label fw-bold">New Stock Quantity</label>
                    <input type="number" id="editNewQuantity" class="form-control" step="0.01" min="0" max="0" style="border-radius: 10px; padding: 12px; font-size: 16px;" oninput="validateEditStockInput(this)">
                    <small class="text-muted" id="editStockHint">Enter the new remaining stock quantity</small>
                </div>

                <!-- Reason for Adjustment -->
                <div class="mb-4">
                    <label class="form-label fw-bold">Reason for Adjustment <span class="text-danger">*</span></label>
                    <select id="editReason" class="form-control" style="border-radius: 10px; padding: 10px;" onchange="toggleOtherReason()">
                        <option value="">-- Select Reason --</option>
                        <option value="Typo Error - Correction">✏️ Typo Error (Correction only - no waste log)</option>
                        <option value="Spoilage">🍂 Spoilage (will create waste log)</option>
                        <option value="Damage">💔 Damage (will create waste log)</option>
                        <option value="Quality Issue">⚠️ Quality Issue (will create waste log)</option>
                        <option value="Overripe">🍌 Overripe (will create waste log)</option>
                        <option value="Physical Count - Missing">📊 Physical Count - Missing (will create waste log)</option>
                        <option value="Physical Count - Excess">📊 Physical Count - Excess (increase stock)</option>
                        <option value="Theft/Loss">🔒 Theft/Loss (will create waste log)</option>
                        <option value="Other">📝 Other</option>
                    </select>
                    <input type="text" id="editOtherReason" class="form-control mt-2" placeholder="Please specify reason..." style="display: none; border-radius: 10px;">
                </div>

                <!-- Additional Notes -->
                <div class="mb-4">
                    <label class="form-label fw-bold">Additional Notes <span class="text-muted">(Optional)</span></label>
                    <textarea id="editNotes" class="form-control" rows="3" placeholder="e.g., Found during inventory count, etc." style="border-radius: 10px;"></textarea>
                </div>

                <!-- Warning Message -->
                <div id="wasteWarning" class="alert alert-warning" style="border-radius: 10px; display: none;">
                    <i class="fas fa-exclamation-triangle"></i>
                    <strong>Note:</strong> This adjustment will create a <strong>WASTE LOG</strong> because the reason indicates actual loss/spoilage.
                </div>
                <div id="correctionWarning" class="alert alert-info" style="border-radius: 10px; display: none;">
                    <i class="fas fa-info-circle"></i>
                    <strong>Note:</strong> This is a correction only. <strong>NO waste log</strong> will be created since this is just fixing a typo or error.
                </div>
            </div>
            <div class="modal-footer" style="border-top: none; padding: 20px;">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" style="border-radius: 10px; padding: 10px 25px;">
                    <i class="fas fa-times"></i> Cancel
                </button>
                <button type="button" class="btn btn-primary" onclick="confirmStockAdjustment()" style="border-radius: 10px; padding: 10px 25px; background: linear-gradient(135deg, #ff6b35, #f7931e); border: none;">
                    <i class="fas fa-save"></i> Apply Adjustment
                </button>
            </div>
        </div>
    </div>
</div>



