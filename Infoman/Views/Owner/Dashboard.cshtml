}

if (noExpiryItems.length > 0) {
    const proceed = await showConfirm(
    `No expiry date for:\n• ${noExpiryItems.join('\n• ')}\n\nAre you sure you want to save without expiry dates?`,
    'No Expiry Date'
);
    if (!proceed) return;   // bumalik sa form para mapunan
}

    const items = [];
    const rows = document.querySelectorAll('#receivingItemsBody tr');

    // ✅ SECOND LOOP: BUILD ITEMS WITH CONVERSION
    for (let row of rows) {
        const rowId = row.id.split('-').pop();

        const materialSelect = document.querySelector(`.material-select[data-row="${rowId}"]`);
        if (!materialSelect || !materialSelect.value) continue;

        const selectedOption = materialSelect.options[materialSelect.selectedIndex];
        const displayUnit = selectedOption.getAttribute('data-unit') || '';   // kg, L, pcs
        const baseUnit = selectedOption.getAttribute('data-base-unit') || ''; // g, mL, pcs

        const r4 = (n) => Math.round(n * 10000) / 10000;

        // ✅ LAHAT NG QTY AY NASA DISPLAY UNIT (kg, L, pcs)
        const receivedPkg = parseFloat(document.querySelector(`.received-qty[data-row="${rowId}"]`).value) || 0;
        const acceptedPkg = parseFloat(document.querySelector(`.accepted-qty[data-row="${rowId}"]`).value) || 0;
        const rejectedPkg = parseFloat(document.querySelector(`.rejected-qty[data-row="${rowId}"]`).value) || 0;
        const conv = parseFloat(document.querySelector(`.pkg-conversion[data-row="${rowId}"]`).value) || 1;
        const totalPrice = parseFloat(document.querySelector(`.total-price[data-row="${rowId}"]`).value) || 0;
        const expiryDate = document.querySelector(`.expiry-date[data-row="${rowId}"]`).value || null;
        const reason = document.querySelector(`.reason-select[data-row="${rowId}"]`)?.value || 'Damaged';

        if (Math.abs((acceptedPkg + rejectedPkg) - receivedPkg) > 0.0001) {
            await showAlert(`Row ${rowId}: Accepted + Rejected must equal Received.`, 'Validation Error', '⚠️');
            return;
        }

        // ✅ CONVERT FROM DISPLAY UNIT TO BASE UNIT
        // Halimbawa: 10 kg → 10,000 g  |  5 L → 5,000 mL  |  10 pcs → 10 pcs
        let conversionFactor = 1;
        if (displayUnit === 'kg' && baseUnit === 'g') conversionFactor = 1000;
        else if (displayUnit === 'L' && baseUnit === 'mL') conversionFactor = 1000;
        else if (displayUnit === 'g' && baseUnit === 'g') conversionFactor = 1;
        else if (displayUnit === 'mL' && baseUnit === 'mL') conversionFactor = 1;

        // ✅ RECEIVED/ACCEPTED/REJECTED in DISPLAY unit → BASE unit
        const receivedInDisplay = r4(receivedPkg * conv);   // e.g., 10 kg
        const acceptedInDisplay = r4(acceptedPkg * conv);   // e.g., 10 kg
        const rejectedInDisplay = r4(rejectedPkg * conv);   // e.g., 0 kg

        // ✅ CONVERT TO BASE UNIT FOR BACKEND
        const receivedBase = r4(receivedInDisplay * conversionFactor);  // e.g., 10,000 g
        const acceptedBase = r4(acceptedInDisplay * conversionFactor);  // e.g., 10,000 g
        const rejectedBase = r4(rejectedInDisplay * conversionFactor);  // e.g., 0 g

        if (receivedBase <= 0) continue;

        // ✅ UNIT PRICE — per DISPLAY UNIT (per kg, per L, per pcs)
        // Ito ang ipapasa sa backend — naka-standarize na per display unit
        const acceptedTotalPrice = totalPrice * (acceptedPkg / receivedPkg);
        const unitPricePerDisplay = acceptedInDisplay > 0
            ? r4(acceptedTotalPrice / acceptedInDisplay)
            : 0;

       const acceptedTotal = receivedPkg > 0 ? totalPrice * (acceptedPkg / receivedPkg) : 0;

items.push({
    rawMaterialId: parseInt(materialSelect.value),
    rawMaterialName: selectedOption.text,
    receivedQty: receivedBase,
    acceptedQty: acceptedBase,
    rejectedQty: rejectedBase,
    unit: baseUnit,
    totalPrice: Math.round(totalPrice * 100) / 100,
    acceptedTotalPrice: Math.round(acceptedTotal * 100) / 100,
    disposition: "Waste",
    rejectionReason: reason,
    expiryDate: expiryDate,
    storeName: globalStoreName
});
    }

    if (items.length === 0) {
        await showAlert('Please add at least one item.', 'Required', '⚠️');
        return;
    }

   const data = {
    supplierId: supplierId ? parseInt(supplierId) : 0,
    batchNumber: document.getElementById('batchNumber').value, // Auto-generated (ipapasa sa InvoiceNumber)
    drNumber: document.getElementById('drNumberInput').value,  // Manual input (ipapasa sa DRNumber)
    invoiceNumber: null,
    dateReceived: document.getElementById('dateReceived').value,
    remarks: null,
    items: items
};

    if (!data.drNumber) {
        await showAlert('DR Number is required.', 'Required', '⚠️');
        return;
    }

    const submitBtn = this.querySelector('button[type="submit"]');
    const originalText = submitBtn.innerHTML;
    submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving...';
    submitBtn.disabled = true;

    fetch('/Owner/ReceiveDelivery', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
        },
        body: JSON.stringify(data)
    })
    .then(r => r.json())
    .then(async (result) => {
        if (result.success) {
            showDeliverySuccessModal(result.receivingId);
            resetReceivingForm();
            await refreshInventoryTableData();
