        })
        .catch(err => { alert('An error occurred. Please try again.'); });
    });

        async function adjustBatchStock(batchId, currentRemaining, materialName) {
        const newQuantity = prompt(`Adjust stock for ${materialName}\n\nCurrent remaining: ${currentRemaining} kg\nEnter new quantity:`, currentRemaining);

        if (newQuantity === null) return;

        const newQty = parseFloat(newQuantity);
        if (isNaN(newQty) || newQty < 0) {
            alert('Please enter a valid quantity (0 or positive number)');
            return;
        }

        if (newQty === currentRemaining) {
            alert('No changes made');
            return;
        }

        if (!confirm(`Adjust stock from ${currentRemaining} kg to ${newQty} kg?\n\nThis will create a waste log if stock is reduced.`)) {
            return;
        }

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

        try {
            const response = await fetch('/RawMaterial/AdjustBatchStock', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify({
                    batchId: batchId,
                    newQuantity: newQty,
                    reason: 'Manual adjustment'
                })
            });

            const result = await response.json();

            if (result.success) {
                alert('✅ Stock adjusted successfully');
                location.reload();
            } else {
                alert('❌ Error: ' + result.message);
            }
        } catch (error) {
            alert('❌ Error: ' + error.message);
        }
    }

    // Mark as Expired
    async function markBatchAsExpired(batchId, materialName) {
        if (!confirm(`Mark this batch of ${materialName} as EXPIRED?\n\nAll remaining stock will be moved to waste.`)) {
            return;
        }

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

        try {
            const response = await fetch('/RawMaterial/MarkBatchAsExpired', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify({ batchId: batchId })
            });

            const result = await response.json();

            if (result.success) {
                alert('✅ Batch marked as expired. Stock moved to waste.');
                location.reload();
            } else {
                alert('❌ Error: ' + result.message);
            }
        } catch (error) {
            alert('❌ Error: ' + error.message);
        }
    }

