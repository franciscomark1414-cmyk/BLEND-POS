                   function switchReturnTab(tabName, clickEvent) {
    // Update tabs
    const tabs = document.querySelectorAll('#returnsModule .nav-link');
    tabs.forEach(tab => tab.classList.remove('active'));
    if (clickEvent && clickEvent.target) {
        clickEvent.target.classList.add('active');
    }
    
    // Hide all tab contents
    document.getElementById('pendingTab').style.display = 'none';
    document.getElementById('refundHistoryTab').style.display = 'none';
    document.getElementById('voidHistoryTab').style.display = 'none';
    document.getElementById('supplierTab').style.display = 'none';
    
    // Show selected tab and load data
