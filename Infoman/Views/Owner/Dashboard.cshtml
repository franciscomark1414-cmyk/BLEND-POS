                    document.getElementById('perfTotalOrders').innerHTML = data.summary.totalOrders || 0;
                    document.getElementById('perfAvgRating').innerHTML = (data.summary.averageRating || 0).toFixed(1);

                    // Update table
                    let rows = '';
                    if (data.performances && data.performances.length > 0) {
                        data.performances.forEach(perf => {
                            const dateObj = new Date(perf.date);
                            const formattedDate = `${dateObj.getMonth() + 1}/${dateObj.getDate()}/${dateObj.getFullYear()}`;
                            rows += `
