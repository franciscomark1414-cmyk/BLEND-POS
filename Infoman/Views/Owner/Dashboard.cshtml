function updateNewIngredientUnitDropdown(selectElement) {
    const row = selectElement.closest('tr');
    const unitSelect = row.querySelector('.unit-select');
    const selectedOption = selectElement.options[selectElement.selectedIndex];
    const materialUnit = selectedOption.getAttribute('data-unit');
    
    if (!materialUnit) return;
    
    // Get unit category
    const weightUnits = ['kg', 'g'];
    const volumeUnits = ['L', 'mL'];
    
    let allowedUnits = [];
    if (weightUnits.includes(materialUnit)) {
        allowedUnits = ['kg', 'g'];
    } else if (volumeUnits.includes(materialUnit)) {
        allowedUnits = ['L', 'mL'];
    } else {
        allowedUnits = ['pcs'];
    }
    
    // Enable/disable options
    for (let i = 0; i < unitSelect.options.length; i++) {
        const opt = unitSelect.options[i];
        if (allowedUnits.includes(opt.value)) {
            opt.disabled = false;
        } else {
            opt.disabled = true;
            if (opt.selected) {
                // Find first enabled option
                for (let j = 0; j < unitSelect.options.length; j++) {
                    if (!unitSelect.options[j].disabled) {
                        unitSelect.selectedIndex = j;
                        break;
                    }
                }
            }
        }
    }
}

