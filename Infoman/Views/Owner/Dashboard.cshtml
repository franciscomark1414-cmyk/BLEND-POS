 function showUsageDetails(usageList) {
    if (!usageList || usageList.length === 0) {
        showAlert('No usage records found for this batch.', 'Notice');
        return;
    }
    
    const modal = new bootstrap.Modal(document.getElementById('usageDetailsModal'));
    const tbody = document.getElementById('usageDetailsTableBody');
    
    // Sort by date (newest first)
    const sorted = [...usageList].sort((a, b) => 
        new Date(b.dateUsed) - new Date(a.dateUsed)
    );
    
    // I-clear ang laman
    tbody.innerHTML = '';
    
    sorted.forEach((use, index) => {
        const dateUsed = use.dateUsed ? new Date(use.dateUsed).toLocaleString() : 'Unknown date';
        const quantity = use.quantityUsed || 0;
        
        let orderNumber = 'N/A';
        let productName = '';
        
        if (use.referenceNo) {
            if (use.referenceNo.startsWith('POS-')) {
                orderNumber = use.orderNumber || `#${use.orderId || '?'}`;
            } else {
                orderNumber = use.referenceNo;
            }
        }
        
        if (use.productName) {
            productName = use.productName;
        } else if (use.productSizeName) {
            productName = use.productSizeName;
        }
        
        const row = document.createElement('tr');
        row.className = 'text-center align-middle';
        row.innerHTML = `
            <td class="fw-bold">${index + 1}</td>
            <td>${escapeHtml(dateUsed)}</td>
            <td class="text-danger fw-bold">${quantity.toFixed(2)}</td>
            <td><span class="badge bg-primary" style="font-size: 13px; padding: 6px 12px;">${escapeHtml(orderNumber)}</span></td>
            <td>${escapeHtml(productName)}</td>
        `;
        tbody.appendChild(row);
    });
    
    // ✅ IDAGDAG ITO - I-update ang modal title na may count
    const modalTitle = document.querySelector('#usageDetailsModal .modal-title');
    if (modalTitle) {
        modalTitle.innerHTML = `<i class="fas fa-history"></i> Batch Usage History (${usageList.length} records)`;
    }
    
    modal.show();
}

