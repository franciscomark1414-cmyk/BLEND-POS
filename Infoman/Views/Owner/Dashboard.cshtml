let currentReceiptList = [];

function displayReceiptHistory(receipts) {
    const tbody = document.getElementById('receiptHistoryBody');
    currentReceiptList = receipts || [];

    if (currentReceiptList.length === 0) {
        tbody.innerHTML = `
            <tr>
                <td colspan="10" class="text-center text-muted">
                    📋 No receipts found.<br>
                    <small>Make a sale in POS to generate receipts.</small>
                </td>
            </tr>`;
        return;
    }

    tbody.innerHTML = currentReceiptList.map(receipt => {
        // ✅ 1. I-DETERMINE ANG STATUS BASE SA ORDER STATUS
        let statusBadge = '<span class="badge bg-success">✅ ACTIVE</span>';
        let exchangeIndicator = '';
        let displayTotal = receipt.total; // Default total

        // Check order status (REFUNDED, VOIDED, etc.)
        if (receipt.status === 'REFUNDED') {
            statusBadge = '<span class="badge bg-danger">💰 REFUNDED</span>';
            
            // ✅ UNANG COMPUTATION (Para sa REFUNDED)
            let computedTotal = receipt.subtotal - (receipt.discountAmount || 0) - (receipt.voucherDiscountAmount || 0);
            displayTotal = computedTotal > 0 ? computedTotal : 0;

        } else if (receipt.status === 'PARTIALLY_REFUNDED') {
            statusBadge = '<span class="badge bg-warning text-dark">⚠️ PARTIAL REFUND</span>';
        } else if (receipt.status === 'VOIDED') {
            statusBadge = '<span class="badge bg-dark">🚫 VOIDED</span>';
            
            // ✅ PANGALAWANG COMPUTATION (Nilagyan ng 'let' para iwas error)
            let computedTotal = receipt.subtotal - (receipt.discountAmount || 0) - (receipt.voucherDiscountAmount || 0);
            displayTotal = computedTotal > 0 ? computedTotal : 0;
        }
        // ✅ ITO YUNG NAWALA, IBINALIK KO
        else if (receipt.returnStatus === 'EXCHANGED') {
            statusBadge = '<span class="badge bg-warning text-dark">🔄 EXCHANGED</span>';
            if (receipt.originalOrderId) {
                exchangeIndicator = `<small class="text-muted">(replaces #${receipt.originalOrderId})</small>`;
            }
            
            // 👇 ✅ DITO ANG FIX: Kinocompute natin ang totoong total para lumabas ang ₱56.05
            let computedTotal = receipt.subtotal - (receipt.discountAmount || 0) - (receipt.voucherDiscountAmount || 0);
            displayTotal = computedTotal > 0 ? computedTotal : 0;

        } else if (receipt.returnStatus === 'RETURNED') {
            statusBadge = '<span class="badge bg-danger">↩️ RETURNED</span>';
        }

        // ✅ 2. DISCOUNT DISPLAY
        let discountDisplay = 'None';
        if (receipt.discountPercent > 0) {
            discountDisplay = `${receipt.discountType} (${receipt.discountPercent * 100}%)<br>-₱${receipt.discountAmount.toFixed(2)}`;
        }
        if (receipt.voucherCode) {
            discountDisplay += `<br><span class="text-success">Voucher (${escapeHtml(receipt.voucherCode)}) -₱${(receipt.voucherDiscountAmount || 0).toFixed(2)}</span>`;
        }

        return `
            <tr>
                <td><code>${escapeHtml(receipt.receiptNumber)}</code></td>
                <td class="fw-bold">#${receipt.orderId}<br>${exchangeIndicator}</td>
                <td>${receipt.date}</td>
                <td>${receipt.itemCount} item(s)</td>
                <td>₱${receipt.subtotal.toFixed(2)}</td>
                <td>${discountDisplay}</td>
                <td class="fw-bold text-primary">₱${displayTotal.toFixed(2)}</td>
                <td><span class="badge bg-success">${escapeHtml(receipt.paymentMethod)}</span></td>
                <td>${statusBadge}</td>
                <td>
                    <div class="d-flex flex-column gap-1" style="width: 80px;">
                        <button class="btn btn-sm btn-info w-100" onclick="viewReceiptDetail(${receipt.orderId})">View</button>
                        <button class="btn btn-sm btn-secondary w-100" onclick="printReceipt(${receipt.orderId})">Print</button>
                    </div>
                </td>
            </tr>`;
    }).join('');
}

// ========== RECEIPT PRINTING ==========

function buildReceiptPrintHtml(r) {
    const d = new Date(r.date);
    const dateStr = d.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' });
    const timeStr = d.toLocaleTimeString('en-US');

    const itemsHtml = (r.items || []).map(i => `
        <div class="row">
            <div>
                <b>${escapeHtml(i.name)}</b><br>
                <small>${escapeHtml(i.size)} x ${i.quantity}</small>
            </div>
            <div>₱${Number(i.subtotal).toFixed(2)}</div>
        </div>`).join('');

    let discountHtml = '';
    if (r.discountPercent > 0) {
        discountHtml += `
            <div class="row">
                <span>${escapeHtml(r.discountType)} (${r.discountPercent * 100}% OFF)</span>
                <span>-₱${Number(r.discountAmount).toFixed(2)}</span>
            </div>`;
    }
    if (r.voucherCode) {
        discountHtml += `
            <div class="row">
                <span>Voucher (${escapeHtml(r.voucherCode)})</span>
                <span>-₱${Number(r.voucherDiscountAmount || 0).toFixed(2)}</span>
            </div>`;
    }

    return `
        <div class="receipt">
            ${r.isVoided ? '<div class="void">⚠ VOIDED ORDER ⚠</div>' : ''}
            <div class="center">
                <div style="font-size:16px;font-weight:bold;">Andeng's Mango &amp; More</div>
                <div>Official Receipt</div>
                <div class="line"></div>
                <div>${dateStr}</div>
                <div>${timeStr}</div>
                <div>Receipt #: ${escapeHtml(r.receiptNumber)}</div>
                <div><b>Order #: ${r.orderId}</b></div>
            </div>
            <div class="line"></div>
            <div class="center"><b>Order Summary</b></div>
            ${itemsHtml}
            <div class="line"></div>
            <div class="row"><span>Subtotal</span><span>₱${Number(r.subtotal).toFixed(2)}</span></div>
            ${discountHtml}
            <div class="row total"><span>TOTAL</span><span>₱${Number(r.total).toFixed(2)}</span></div>
            <div class="line"></div>
            <div class="center">
                <div>Payment: <b>${escapeHtml(r.paymentMethod)}</b></div>
                <div style="margin-top:6px;">Thank you for your purchase!</div>
            </div>
        </div>`;
}

function printHtmlDocument(bodyHtml) {
    let frame = document.getElementById('receiptPrintFrame');
    if (!frame) {
        frame = document.createElement('iframe');
        frame.id = 'receiptPrintFrame';
        frame.style.cssText = 'position:fixed;right:0;bottom:0;width:0;height:0;border:0;';
        document.body.appendChild(frame);
    }

    const doc = frame.contentWindow.document;
    doc.open();
    doc.write(`<!DOCTYPE html>
<html>
<head>
        <meta charset="utf-8">
        <title>Receipt</title>
        <style>
            @@page { size: 80mm auto; margin: 4mm; }
            body {
                font-family: 'Courier New', monospace;
                font-size: 12px;
                color: #000;
                width: 72mm;
                margin: 0 auto;
            }
            .center { text-align: center; }
            .row { display: flex; justify-content: space-between; gap: 8px; margin: 4px 0; }
            .line { border-top: 1px dashed #000; margin: 6px 0; }
            .total { font-weight: bold; font-size: 14px; border-top: 2px solid #000; padding-top: 4px; }
            .void { background: #000; color: #fff; text-align: center; padding: 3px; font-weight: bold; margin-bottom: 6px; }
            .receipt { page-break-after: always; }
            .receipt:last-child { page-break-after: auto; }
        </style>
   </head>
<body>${bodyHtml}<\/body>
<\/html>`);
    doc.close();

    // Hintayin na ma-render bago mag-print
    setTimeout(() => {
        frame.contentWindow.focus();
        frame.contentWindow.print();
    }, 300);
}

async function printReceipt(orderId) {
    try {
        const res = await fetch(`/Owner/GetReceiptDetail?orderId=${orderId}`);
        const data = await res.json();

        if (!data.success || !data.receipt) {
            await showAlert('Unable to load receipt for printing.', 'Error', '❌');
            return;
        }

        printHtmlDocument(buildReceiptPrintHtml(data.receipt));
    } catch (error) {
        console.error('Print error:', error);
        await showAlert('Error printing receipt: ' + error.message, 'Error', '❌');
    }
}

async function printAllReceipts() {
    if (!currentReceiptList || currentReceiptList.length === 0) {
        await showAlert('No receipts to print.', 'Notice', 'ℹ️');
        return;
    }

    showLoading(`Preparing ${currentReceiptList.length} receipt(s)...`);

    try {
        const results = await Promise.all(
            currentReceiptList.map(r =>
                fetch(`/Owner/GetReceiptDetail?orderId=${r.orderId}`).then(res => res.json())
            )
        );

        const html = results
            .filter(d => d.success && d.receipt)
            .map(d => buildReceiptPrintHtml(d.receipt))
            .join('');

        hideLoading();

        if (!html) {
            await showAlert('No printable receipts found.', 'Notice', 'ℹ️');
            return;
        }

        printHtmlDocument(html);
    } catch (error) {
        hideLoading();
        console.error('Print all error:', error);
        await showAlert('Error preparing receipts: ' + error.message, 'Error', '❌');
    }
}

function viewReceiptDetail(orderId, isVoided = false) {
