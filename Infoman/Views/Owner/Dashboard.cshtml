        <div class="modal fade" id="restockModal" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header bg-success text-white">
                        <h5 class="modal-title">📦 Restock Raw Material</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <form id="restockForm">
                            @Html.AntiForgeryToken()
                            <input type="hidden" id="restockMaterialId">
                            <div class="mb-3">
                                <label class="form-label">Material Name</label>
                                <input type="text" id="restockMaterialName" class="form-control" readonly>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Current Stock</label>
                                <input type="text" id="restockCurrentStock" class="form-control" readonly>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Quantity to Add <span class="text-danger">*</span></label>
                                <input type="number" id="restockQuantity" class="form-control" step="0.01" min="0.01" required placeholder="Enter quantity">
                                <small class="text-muted">This will add stock using FIFO (new batch)</small>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Unit Price <span class="text-danger">*</span></label>
                                <input type="number" id="restockUnitPrice" class="form-control" step="0.01" min="0" required placeholder="Price per unit">
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Expiry Date (Optional)</label>
                                <input type="date" id="restockExpiryDate" class="form-control">
                                <small class="text-muted">Leave blank if no expiry date</small>
                            </div>
                        </form>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="button" class="btn btn-success" onclick="confirmRestock(event)">✅ Add Stock</button>
                    </div>
                </div>
            </div>
        </div>

   
        <div class="modal fade" id="addWasteModal" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header bg-warning">
                        <h5 class="modal-title">🗑️ Log Waste</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <form id="wasteForm">
                            @Html.AntiForgeryToken()
                            <div class="mb-3">
                                <label class="form-label">Raw Material <span class="text-danger">*</span></label>
                                <select class="form-control" id="wasteMaterialId" required>
                                    <option value="">Select Material</option>
                                    @if (ViewBag.RawMaterials != null)
                                    {
                                        foreach (var item in ViewBag.RawMaterials)
                                        {
                                            <option value="@item.RawMaterialId" data-unit="@item.Unit" data-price="@item.Price">
                                                @item.Name (@item.StockWithUnit in stock)
                                            </option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Quantity <span class="text-danger">*</span></label>
                                <input type="number" step="0.01" class="form-control" id="wasteQuantity" required>
                                <small class="text-muted" id="wasteUnitHint">Unit: </small>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Reason <span class="text-danger">*</span></label>
                                <select class="form-control" id="wasteReason" required>
                                    <option value="Expired">Expired</option>
                                    <option value="Damaged">Damaged</option>
                                    <option value="Spilled">Spilled</option>
                                    <option value="Overprepared">Overprepared</option>
                                    <option value="QualityIssue">Quality Issue</option>
                                    <option value="Other">Other</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Notes (Optional)</label>
                                <textarea class="form-control" id="wasteNotes" rows="2"></textarea>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Recorded By</label>
                                <input type="text" class="form-control" id="wasteRecordedBy" value="Owner">
                            </div>
                        </form>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="button" class="btn btn-warning" onclick="saveWasteLog()">Save Waste Log</button>
                    </div>
                </div>
            </div>
        </div>

