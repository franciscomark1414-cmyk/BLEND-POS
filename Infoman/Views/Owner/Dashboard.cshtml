   async function saveEmployee() {
    var id = parseInt(document.getElementById('employeeId').value);
    var username = document.getElementById('empUsername').value.trim();
    var password = document.getElementById('empPassword').value;
    var fullName = document.getElementById('empFullName').value.trim();
    var phone = document.getElementById('empPhone').value.trim();
    var email = document.getElementById('empEmail').value.trim();
    var status = document.getElementById('empStatus').value;

    // ========== VALIDATIONS ==========
    
    // 1. Full Name required
    if (!fullName) {
        await showAlert('Please enter full name', 'Required');
        return;
    }

    // 2. Username required for new employee
    if (id === 0 && !username) {
        await showAlert('Please enter username', 'Required');
        return;
    }

    // 3. Password required for new employee
    if (id === 0 && !password) {
        await showAlert('Please enter password', 'Required');
        return;
    }

   
    if (email && email !== '') {
        if (!email.toLowerCase().endsWith('@@gmail.com')) {
            await showAlert('Email must be a valid Gmail address (@@gmail.com)', 'Invalid Email');
            return;
        }
    }

    // 5. PHONE NUMBER VALIDATION - dapat exactly 11 digits, starting with 09 (optional pero kung meron dapat valid)
    if (phone && phone !== '') {
        // Remove any spaces or special characters
        const cleanPhone = phone.replace(/[^0-9]/g, '');
        
        if (cleanPhone.length !== 11) {
            await showAlert('Phone number must be exactly 11 digits (e.g., 09123456789)', 'Invalid Phone');
            return;
        }
        
        if (!cleanPhone.startsWith('09')) {
            await showAlert('Phone number must start with "09"', 'Invalid Phone');
            return;
        }
        
        var formattedPhone = cleanPhone;
    } else {
        var formattedPhone = phone;
    }

    // 6. PASSWORD VALIDATION (for new employee OR when password is changed/added)
    if (id === 0 || (password && password !== '')) {
        const passwordValidation = validatePassword(password);
        if (!passwordValidation.isValid) {
            await showAlert(passwordValidation.message, 'Invalid Password');
            return;
        }
    }

    // Proceed with save
    var url = id === 0 ? '/Employee/Create' : '/Employee/Edit';
    var data = id === 0 ? {
        username: username,
        password: password,
        fullName: fullName,
        phone: formattedPhone,
        email: email,
        status: status
    } : {
        id: id,
        fullName: fullName,
        phone: formattedPhone,
        email: email,
        status: status,
        password: password || null
    };

    fetch(url, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json'
        },
        body: JSON.stringify(data)
    })
    .then(res => res.json())
    .then(async (result) => {
        if (result.success) {
            await showAlert(result.message, 'Success');
            var modal = bootstrap.Modal.getInstance(document.getElementById('employeeModal'));
            if (modal) modal.hide();
            loadEmployees();
        } else {
            await showAlert('Error: ' + result.message, 'Error');
        }
    })
    .catch(async (err) => {
        console.error("Save error:", err);
        await showAlert('Error: ' + err.message, 'Error');
    });
}



