async function showModule(module) {
    sessionStorage.setItem('activeModule', module);

    var modules = ['dashboard', 'rawMaterials', 'inventory', 'products', 'inventoryAlerts', 'reports', 'employees', 'financials', 'suppliers', 'receiving', 'receivingHistory', 'returns', 'settings'];
    
    modules.forEach(function(m) {
        var el = document.getElementById(m + 'Module');
        if (el) el.classList.remove('active');
    });

    // Show selected module
    var selectedModule = document.getElementById(module + 'Module');
    if (selectedModule) selectedModule.classList.add('active');

    // Update sidebar active state
    var navItems = document.querySelectorAll('.sidebar .nav-item');
    navItems.forEach(function(item) {
        item.classList.remove('active');
    });


    var activeNavItem = document.querySelector('.sidebar .nav-item[onclick*="showModule(\'' + module + '\')"]');
    if (activeNavItem) {
        activeNavItem.classList.add('active');
    } else {
        var allNavItems = document.querySelectorAll('.sidebar .nav-item');
        for (var i = 0; i < allNavItems.length; i++) {
            var item = allNavItems[i];
            var onclickAttr = item.getAttribute('onclick');
            if (onclickAttr && onclickAttr.includes(module)) {
                item.classList.add('active');
                break;
            }
        }
    }

    // Load module-specific data
    if (module === 'inventoryAlerts') {
        loadInventoryAlerts();  
    }
    if (module === 'dashboard' && window.salesChart) {
        setTimeout(function () { window.salesChart.resize(); }, 50);
    }
    if (module === 'reports') {
        reportsDataLoaded = false;
        setTimeout(function() { loadReportsData(); }, 150);
    }
    if (module === 'employees') {
        setTimeout(function() { loadEmployees(); }, 100);
    }
    if (module === 'suppliers') {
        loadSuppliers();
    }
        if (module === 'receiving') {
        // ✅ I-load LANG KUNG WALANG LAMAN (para hindi mag-reset ang form)
        if (document.getElementById('receivingItemsBody').children.length === 0) {
            loadReceivingFormData();
        }
    }
    if (module === 'receivingHistory') {
        loadDeliveryHistory();
    }
    if (module === 'returns') {
        loadPendingRequests();
        loadRefundHistory(); 
        loadVoidHistory();  
       
    }

    if (module === 'settings') {
         switchSettingsTab('security');
    }
    if (module === 'rawMaterials') {
        loadCategoryDropdown('CategoryId', 'RawMaterial');
    }
    if (module === 'products') {
        loadCategoryDropdown('filterCategory', 'Product', {
            valueKey: 'name',
            placeholder: 'All Categories',
            selected: document.getElementById('filterCategory')?.value || null
        });
    }
    if (module === 'financials') {
   loadFinancials();
    loadExpenses();
}
}
