async function editMaterial(id) {
    var row = document.querySelector('tr[data-id="' + id + '"]');
    if (!row) {
        await showAlert('Material not found', 'Error');
        return;
    }

    var name = row.children[1]?.innerText || '';
    var categoryInt = row.children[2]?.getAttribute('data-value');
    var stockWithUnit = row.children[3]?.innerText || '';
    var minQtyWithUnit = row.children[4]?.innerText || '';

    var unit = extractUnit(stockWithUnit);
    var stockValue = parseFloat(stockWithUnit.split(' ')[0]) || 0; // ✅ Kunin ang stock value
    var minQty = parseFloat(minQtyWithUnit.split(' ')[0]);

    document.getElementById('RawMaterialId').value = id;
    document.getElementById('Name').value = name;
    
    await loadCategoryDropdown('CategoryId', 'RawMaterial', { 
        selected: categoryInt, 
        selectedLabel: row.children[2]?.innerText || '' 
    });

    // ✅ IMPORTANT: Set the dropdown value for Unit
    var unitDropdown = document.getElementById('Unit');
    if (unitDropdown && unit) {
        var optionExists = false;
        for (var i = 0; i < unitDropdown.options.length; i++) {
            if (unitDropdown.options[i].value === unit) {
                optionExists = true;
                break;
            }
        }
        if (optionExists) {
            unitDropdown.value = unit;
        } else {
            var opt = document.createElement('option');
            opt.value = unit;
            opt.textContent = unit + ' (inactive)';
            unitDropdown.appendChild(opt);
            unitDropdown.value = unit;
        }
    }

    // ✅ ANG FIX NATIN: I-disable ang Unit kung may stock
    if (stockValue > 0) {
        unitDropdown.disabled = true;
        unitDropdown.style.backgroundColor = '#e9ecef';
        unitDropdown.style.cursor = 'not-allowed';
        
        // Maglagay ng warning kung wala pa
        if (!document.getElementById('unitWarning')) {
            let warning = document.createElement('small');
            warning.id = 'unitWarning';
            warning.className = 'text-danger fw-bold mt-1 d-block';
            warning.innerHTML = '⚠️ Cannot change unit: This material already has stock.';
            unitDropdown.parentElement.appendChild(warning);
        }
    } else {
        // I-enable kung 0 stock
        unitDropdown.disabled = false;
        unitDropdown.style.backgroundColor = '#fff';
        unitDropdown.style.cursor = 'pointer';
        
        let warning = document.getElementById('unitWarning');
        if (warning) warning.remove();
    }

    document.getElementById('MinQty').value = isNaN(minQty) ? 0 : minQty;

    document.getElementById('formHeader').innerHTML = '<i class="fas fa-edit"></i> Edit Raw Material';
    document.getElementById('addRawMaterialBox').style.display = 'block';
}
    
