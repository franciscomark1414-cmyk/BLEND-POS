        const submitBtn = form.querySelector('button[type="submit"]');
        const originalText = submitBtn.innerHTML;
        
        // Show loading state
        submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving Product...';
        submitBtn.disabled = true;
        
        try {
            const unitsValid = await validateIngredientsUnits();
            if (!unitsValid) {
                submitBtn.innerHTML = originalText;
                submitBtn.disabled = false;
                return; // Stop submission
            }

            // Reindex all size rows bago mag-submit
            reindexSizeRows();       // ← nandito na ito
            reindexRecipeItems();
            
            const sizeRows = document.querySelectorAll('#sizesContainer .size-row');
            if (sizeRows.length === 0) {
                await showAlert('Please add at least one size', 'Error');
                submitBtn.innerHTML = originalText;
                submitBtn.disabled = false;
                return;
            }
            
            // Validate na may ingredients ang bawat size
            let hasValidIngredients = true;
