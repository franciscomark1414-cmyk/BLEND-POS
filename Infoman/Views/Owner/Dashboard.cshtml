function displayEditSizesTable(sizes) {
    const tbody = document.getElementById('editSizesList');
    
    if (!sizes || sizes.length === 0) {
        tbody.innerHTML = '<tr><td colspan="5" class="text-center text-muted">No sizes added yet. Click "Add Size" to add.</td></tr>';
        return;
    }
    
    let html = '';
    sizes.forEach(size => {
        // Check if this size is marked for deletion
        const isPendingDelete = pendingDeleteSizeIds.includes(size.productSizeId);
        const deleteClass = isPendingDelete ? 'table-danger' : '';
        const deleteBadge = isPendingDelete ? '<span class="badge bg-danger ms-2">Will be deleted</span>' : '';
        
        const posStatus = size.isAvailableInPOS ? 
            '<span class="badge bg-success">✅ Displayed</span>' : 
            '<span class="badge bg-secondary">⚫ Hidden</span>';
        
        html += `
            <tr data-size-id="${size.productSizeId}" class="${deleteClass}">
                <td><strong>${escapeHtml(size.sizeName)}</strong>${deleteBadge}</td>
                <td><code>${escapeHtml(size.sku)}</code></td>
                <td class="text-primary fw-bold">₱${size.price.toFixed(2)}</td>
                <td>${posStatus}</td>
                <td>
                    <button class="btn btn-sm btn-warning me-1" onclick="editSizeRecipe(${size.productSizeId})">
                        <i class="fas fa-edit"></i> Edit Recipe
                    </button>
                    ${!isPendingDelete ? 
                        `<button class="btn btn-sm btn-danger" onclick="markSizeForDeletion(${size.productSizeId}, '${escapeHtml(size.sizeName)}')">
                            <i class="fas fa-trash"></i> Delete
                        </button>` :
                        `<button class="btn btn-sm btn-secondary" onclick="unmarkSizeForDeletion(${size.productSizeId})">
                            <i class="fas fa-undo"></i> Undo
                        </button>`
                    }
                </td>
            </tr>
        `;
    });
    tbody.innerHTML = html;
}

function markSizeForDeletion(productSizeId, sizeName) {
    // Add to pending delete list
    if (!pendingDeleteSizeIds.includes(productSizeId)) {
        pendingDeleteSizeIds.push(productSizeId);
    }
    
    // Update display
    displayEditSizesTable(currentEditProductSizes);
}

function unmarkSizeForDeletion(productSizeId) {
    // Remove from pending delete list
    pendingDeleteSizeIds = pendingDeleteSizeIds.filter(id => id !== productSizeId);
    
    // Update display
    displayEditSizesTable(currentEditProductSizes);
}

function editSizeRecipe(productSizeId) {
    // Check if size is pending deletion
    if (pendingDeleteSizeIds.includes(productSizeId)) {
        showAlert('Cannot edit a size that is marked for deletion. Undo delete first.', 'Warning', '⚠️');
        return;
    }
    
    // Close edit product modal
    const modal = bootstrap.Modal.getInstance(document.getElementById('editProductModal'));
    if (modal) modal.hide();
    
    // Open edit recipe modal
    editRecipe(productSizeId);
}

