<script>
    let sizeCounter = 0;
    let currentProductSizeId = null;
    let currentViewProductSizeId = null;
    let ingredientCounter = 0;

    // Chart
    var labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.SalesLabels ?? new List<string>()));
    var data = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.SalesValues ?? new List<decimal>()));
    var ctx = document.getElementById('salesChart')?.getContext('2d');
    if (ctx) {
        new Chart(ctx, {
            type: 'line',
            data: { labels: labels, datasets: [{ label: 'Sales (₱)', data: data, borderWidth: 2, fill: false, tension: 0.3 }] },
            options: { responsive: true }
        });
    }

              function showModule(module) {
        // Hide all modules
        var modules = ['dashboard', 'inventory', 'products', 'inventoryAlerts', 'reports', 'employees', 'settings'];
        modules.forEach(function(m) {
            var el = document.getElementById(m + 'Module');
            if (el) el.classList.remove('active');
        });

        // Show selected module
        var selectedModule = document.getElementById(module + 'Module');
        if (selectedModule) selectedModule.classList.add('active');

        // ========== UPDATE SIDEBAR ACTIVE STATE ==========
        // Remove active class from all sidebar nav items
        var navItems = document.querySelectorAll('.sidebar .nav-item');
        navItems.forEach(function(item) {
            item.classList.remove('active');
        });

        // Add active class to the clicked nav item
        // Find which nav item corresponds to this module
        var activeNavItem = document.querySelector('.sidebar .nav-item[onclick*="showModule(\'' + module + '\')"]');
        if (activeNavItem) {
            activeNavItem.classList.add('active');
        } else {
            // Fallback: try to find by text or data attribute
            var allNavItems = document.querySelectorAll('.sidebar .nav-item');
            for (var i = 0; i < allNavItems.length; i++) {
                var item = allNavItems[i];
                var onclickAttr = item.getAttribute('onclick');
                if (onclickAttr && onclickAttr.includes(module)) {
                    item.classList.add('active');
                    break;
                }
            }
        }

        // Load module-specific data
        if (module === 'inventoryAlerts') {
            loadInventoryAlerts();
        }

        if (module === 'reports') {
            reportsDataLoaded = false;
            setTimeout(function() { loadReportsData(); }, 150);
        }

        if (module === 'employees') {
            setTimeout(function() { loadEmployees(); }, 100);
        }
    }
    // Add Delivery Form Functions
    function showAddDeliveryForm() {
        document.getElementById('addDeliveryBox').style.display = 'block';
        document.getElementById('addDeliveryForm').reset();
        // Scroll to the form
        document.getElementById('addDeliveryBox').scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    function closeAddDeliveryForm() {
        document.getElementById('addDeliveryBox').style.display = 'none';
    }

        function updateDeliveryMaterialId() {
        const select = document.getElementById('deliveryMaterialSelect');
        const selectedOption = select.options[select.selectedIndex];
        const hiddenField = document.getElementById('deliveryRawMaterialId');

        if (selectedOption && selectedOption.value) {
            hiddenField.value = selectedOption.value;
            console.log('Selected material ID:', hiddenField.value); // For debugging
        } else {
            hiddenField.value = '';
        }
    }

    // Submit delivery form
        // Submit delivery form - FIXED VERSION
    document.getElementById('addDeliveryForm')?.addEventListener('submit', async function(e) {
        e.preventDefault();

        // Kunin ang values diretso mula sa select, hindi sa hidden field
        const selectElement = document.getElementById('deliveryMaterialSelect');
        const rawMaterialId = selectElement.value;
        const quantity = document.getElementById('deliveryQuantity').value;
        const unitPrice = document.getElementById('deliveryUnitPrice').value;
        const expiryDate = document.getElementById('deliveryExpiryDate').value;

        // Debug: I-print ang values
        console.log('Raw Material ID:', rawMaterialId);
        console.log('Quantity:', quantity);
        console.log('Unit Price:', unitPrice);
        console.log('Expiry Date:', expiryDate);

        if (!rawMaterialId || rawMaterialId === '') {
            alert('Please select a raw material');
            return;
        }

        if (!quantity || quantity <= 0) {
            alert('Please enter a valid quantity');
            return;
        }

        if (!unitPrice || unitPrice <= 0) {
            alert('Please enter a valid unit price');
            return;
        }

        const submitBtn = this.querySelector('button[type="submit"]');
        const originalText = submitBtn.innerHTML;
        submitBtn.innerHTML = 'Saving...';
        submitBtn.disabled = true;

        try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

            const requestBody = {
                rawMaterialId: parseInt(rawMaterialId),
                quantity: parseFloat(quantity),
                unitPrice: parseFloat(unitPrice),
                expiryDate: expiryDate || null
            };

            console.log('Sending request:', requestBody);

            const response = await fetch('/RawMaterial/AddDelivery', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify(requestBody)
            });

            const result = await response.json();
            console.log('Response:', result);

            if (result.success) {
                alert('✅ ' + result.message);
                closeAddDeliveryForm();
                location.reload();
            } else {
                alert('❌ Error: ' + result.message);
            }
        } catch (error) {
            console.error('Error details:', error);
            alert('❌ Error adding delivery: ' + error.message);
        } finally {
            submitBtn.innerHTML = originalText;
            submitBtn.disabled = false;
        }
    });

    // Inventory Functions
    function toggleAddForm() {
        var box = document.getElementById('addRawMaterialBox');
        if (box.style.display === 'none') {
            box.style.display = 'block';
            document.getElementById('formHeader').innerText = 'Add Raw Material';
            document.getElementById('addRawMaterialForm').reset();
            document.getElementById('RawMaterialId').value = '';
            document.getElementById('ExpirationDate').value = '';
        } else {
            box.style.display = 'none';
        }
    }

    function filterTable() {
        var input = document.getElementById("searchRawMaterial").value.toLowerCase();
        var rows = document.getElementById("rawMaterialTable").getElementsByTagName("tbody")[0].getElementsByTagName("tr");
        for (var i = 0; i < rows.length; i++) {
            rows[i].style.display = rows[i].innerText.toLowerCase().includes(input) ? "" : "none";
        }
    }

        function editMaterial(id) {
        var row = document.querySelector('tr[data-id="' + id + '"]');
        if (!row) { alert('Material not found'); return; }

        // Adjusted indices because we removed Price and Expiry Date columns
        var name = row.children[0].innerText;           // Column 0: Name
        var categoryInt = row.children[1].getAttribute('data-value') || getCategoryValue(row.children[1].innerText);
