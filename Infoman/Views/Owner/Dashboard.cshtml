function toggleProductCard(headerElement) {
    const cardBody = headerElement.nextElementSibling;
    const icon = headerElement.querySelector('.toggle-icon');
    
    if (cardBody.style.display === 'none') {
        cardBody.style.display = 'block';
        icon.style.transform = 'rotate(0deg)';
        icon.classList.remove('fa-chevron-right');
        icon.classList.add('fa-chevron-down');
    } else {
        cardBody.style.display = 'none';
        icon.style.transform = 'rotate(-90deg)';
        icon.classList.remove('fa-chevron-down');
        icon.classList.add('fa-chevron-right');
    }
}


function filterProducts() {
    const searchTerm = document.getElementById('searchProduct').value.toLowerCase();
    const categoryFilter = document.getElementById('filterCategory').value;
    const products = document.querySelectorAll('.product-card');

    products.forEach(product => {
        const name = product.querySelector('h4')?.innerText.toLowerCase() || '';
        const category = product.getAttribute('data-category') || '';
        const skuCells = product.querySelectorAll('table tbody tr td:nth-child(2) code');
        let matchesSKU = false;
        skuCells.forEach(cell => {
            if (cell.innerText.toLowerCase().includes(searchTerm)) matchesSKU = true;
        });

        const matches = (name.includes(searchTerm) || matchesSKU) &&
                        (!categoryFilter || category === categoryFilter);
        
        product.style.display = matches ? '' : 'none';
        
        // Optional: Auto-expand kapag may nag-match sa filter (para makita agad)
        if (matches && searchTerm !== '') {
            const cardBody = product.querySelector('.product-card-body');
            const icon = product.querySelector('.toggle-icon');
            if (cardBody && cardBody.style.display === 'none') {
                cardBody.style.display = 'block';
                if (icon) {
                    icon.style.transform = 'rotate(0deg)';
                    icon.classList.remove('fa-chevron-right');
                    icon.classList.add('fa-chevron-down');
                }
            }
        }
    });
}




function showAlert(message, title = "Notice", icon = "ℹ️") {
    return new Promise((resolve) => {
        const modal = document.getElementById('customAlertModal');
        
        if (!modal) {
            console.error('customAlertModal not found!');
            alert(message);
            resolve(true);
            return;
        }
        
        const titleEl = document.getElementById('alertTitle');
        const messageEl = document.getElementById('alertMessage');
        const iconEl = document.getElementById('alertIcon');
        
        titleEl.textContent = title;
        messageEl.textContent = message;
        iconEl.textContent = icon;
        
        modal.style.display = 'flex';
        modal.style.position = 'fixed';
        modal.style.top = '0';
        modal.style.left = '0';
        modal.style.width = '100%';
        modal.style.height = '100%';
        modal.style.backgroundColor = 'rgba(0,0,0,0.5)';
        modal.style.alignItems = 'center';
        modal.style.justifyContent = 'center';
        modal.style.zIndex = '99999';
        
        const closeBtn = document.getElementById('alertCloseBtn');
        const newCloseBtn = closeBtn.cloneNode(true);
        closeBtn.parentNode.replaceChild(newCloseBtn, closeBtn);
        
        const closeHandler = () => {
            modal.style.display = 'none';
            resolve(true);
        };
        
        newCloseBtn.addEventListener('click', closeHandler);
        
        modal.onclick = (e) => {
            if (e.target === modal) {
                modal.style.display = 'none';
                resolve(true);
            }
        };
    });
}


function showConfirm(message, title = "Confirm Action") {
    return new Promise((resolve) => {
        const modal = document.getElementById('customConfirmModal');
        
        if (!modal) {
            console.error('customConfirmModal not found!');
            resolve(confirm(message));
            return;
        }
        
        const titleEl = document.getElementById('confirmTitle');
        const messageEl = document.getElementById('confirmMessage');
        const iconEl = document.getElementById('confirmIcon');
        
        titleEl.textContent = title;
        messageEl.textContent = message;
        iconEl.textContent = "❓";
        
        // I-set ang display at styling
        modal.style.display = 'flex';
        modal.style.position = 'fixed';
        modal.style.top = '0';
        modal.style.left = '0';
        modal.style.width = '100%';
        modal.style.height = '100%';
        modal.style.backgroundColor = 'rgba(0,0,0,0.5)';
        modal.style.alignItems = 'center';
        modal.style.justifyContent = 'center';
        modal.style.zIndex = '99999';
        
        const confirmBtn = document.getElementById('confirmOkBtn');
        const cancelBtn = document.getElementById('confirmCancelBtn');
        
        // I-remove ang lumang event listeners
        const newConfirmBtn = confirmBtn.cloneNode(true);
        const newCancelBtn = cancelBtn.cloneNode(true);
        confirmBtn.parentNode.replaceChild(newConfirmBtn, confirmBtn);
        cancelBtn.parentNode.replaceChild(newCancelBtn, cancelBtn);
        
        const cleanup = () => {
            modal.style.display = 'none';
        };
        
        const confirmHandler = () => {
            cleanup();
            resolve(true);
        };
        
        const cancelHandler = () => {
            cleanup();
            resolve(false);
        };
        
        newConfirmBtn.addEventListener('click', confirmHandler);
        newCancelBtn.addEventListener('click', cancelHandler);
        
        // I-close kapag nag-click sa labas ng modal content
        modal.onclick = (e) => {
            if (e.target === modal) {
                cleanup();
                resolve(false);
            }
        };
    });
}


function showLoading(message = "Processing...") {
    let loadingModal = document.getElementById('loadingModal');
    if (!loadingModal) {
        loadingModal = document.createElement('div');
        loadingModal.id = 'loadingModal';
        loadingModal.className = 'modal-qty';
        loadingModal.style.cssText = 'display: none;';
        loadingModal.innerHTML = `
            <div class="modal-qty-content" style="width: 280px; text-align: center;">
                <div class="spinner-border" style="width: 40px; height: 40px; margin: 20px;"></div>
                <p id="loadingMessage" style="margin: 10px 0 20px;">Processing...</p>
            </div>
        `;
        document.body.appendChild(loadingModal);
    }
    const loadingMsg = document.getElementById('loadingMessage');
    if (loadingMsg) loadingMsg.textContent = message;
    loadingModal.style.display = 'flex';
}

function hideLoading() {
    const loadingModal = document.getElementById('loadingModal');
    if (loadingModal) loadingModal.style.display = 'none';
}


function saveAndReload() {
    let currentModule = 'dashboard';
    const modules = ['dashboard', 'rawMaterials', 'inventory', 'products', 
                     'inventoryAlerts', 'reports', 'employees',  
                     'suppliers', 'receiving', 'receivingHistory', 'returns'];
    
    for (let i = 0; i < modules.length; i++) {
        const moduleEl = document.getElementById(modules[i] + 'Module');
        if (moduleEl && moduleEl.classList.contains('active')) {
            currentModule = modules[i];
            break;
        }
    }
    
    // sessionStorage ONLY — nawawala kapag nagsara ng tab o nag-logout
    sessionStorage.setItem('activeModule', currentModule);
    
    location.reload();
}

let currentBatchMaterialId = null; 

function showEditStockModal(batchId, currentRemainingInBaseUnit, materialName, unit, materialId) {
    // Store material ID for later refresh
    currentBatchMaterialId = materialId;
    
    // Store for later use
    currentEditBatchId = batchId;
    currentEditMaterialName = materialName;
    currentEditUnit = unit;
    
    // ✅ CONVERT FROM BASE UNIT TO DISPLAY UNIT
    let displayCurrentStock = currentRemainingInBaseUnit;
    if (unit === 'kg' || unit === 'L') {
        displayCurrentStock = currentRemainingInBaseUnit / 1000;
    }
    currentEditBatchRemaining = displayCurrentStock;  // Store in display unit
    
    // Set values in modal (use converted display value)
    document.getElementById('editBatchId').innerText = batchId;
    document.getElementById('editMaterialName').innerText = materialName;
    document.getElementById('editCurrentStock').innerText = `${displayCurrentStock.toFixed(2)} ${unit}`;
    document.getElementById('editUnit').innerText = unit;
    document.getElementById('editNewQuantity').value = displayCurrentStock;
    document.getElementById('editNewQuantity').placeholder = `Current: ${displayCurrentStock.toFixed(2)} ${unit}`;
    
    // Reset form
    document.getElementById('editReason').value = '';
    document.getElementById('editOtherReason').style.display = 'none';
    document.getElementById('editOtherReason').value = '';
    document.getElementById('editNotes').value = '';
    document.getElementById('wasteWarning').style.display = 'none';
    document.getElementById('correctionWarning').style.display = 'none';
    
    // Show modal
    const modal = new bootstrap.Modal(document.getElementById('editStockModal'));
    modal.show();
}

function toggleOtherReason() {
    const reasonSelect = document.getElementById('editReason');
    const otherInput = document.getElementById('editOtherReason');
    const wasteWarning = document.getElementById('wasteWarning');
    const correctionWarning = document.getElementById('correctionWarning');
    const selectedReason = reasonSelect.value;
    
    // Show/hide other reason input
    if (selectedReason === 'Other') {
        otherInput.style.display = 'block';
    } else {
        otherInput.style.display = 'none';
    }
    
    // Show appropriate warning based on reason
    const wasteReasons = ['Spoilage', 'Damage', 'Quality Issue', 'Overripe', 'Physical Count - Missing', 'Theft/Loss'];
    const correctionReasons = ['Typo Error - Correction', 'Physical Count - Excess'];
    
    if (wasteReasons.some(r => selectedReason.includes(r))) {
        wasteWarning.style.display = 'block';
        correctionWarning.style.display = 'none';
    } else if (correctionReasons.some(r => selectedReason.includes(r))) {
        wasteWarning.style.display = 'none';
        correctionWarning.style.display = 'block';
    } else {
        wasteWarning.style.display = 'none';
        correctionWarning.style.display = 'none';
    }
}

async function confirmStockAdjustment() {
    const newQuantityInDisplayUnit = parseFloat(document.getElementById('editNewQuantity').value);
    let reason = document.getElementById('editReason').value;
    const otherReason = document.getElementById('editOtherReason').value;
    const notes = document.getElementById('editNotes').value;
    
    // Validation
    if (isNaN(newQuantityInDisplayUnit) || newQuantityInDisplayUnit < 0) {
        await showAlert('Please enter a valid quantity (0 or positive number)', 'Invalid Input', '⚠️');
        return;
    }
    
    if (!reason) {
        await showAlert('Please select a reason for adjustment', 'Required', '⚠️');
        return;
    }
    
    if (reason === 'Other' && !otherReason) {
        await showAlert('Please specify the reason', 'Required', '⚠️');
        return;
    }
    
    if (reason === 'Other') {
        reason = otherReason;
    }
    
    // Compare using display unit values
    if (newQuantityInDisplayUnit === currentEditBatchRemaining) {
        await showAlert('No changes made. Quantity is the same as current stock.', 'Notice', 'ℹ️');
        return;
    }
    
    const adjustment = Math.abs(newQuantityInDisplayUnit - currentEditBatchRemaining);
    const isDecrease = newQuantityInDisplayUnit < currentEditBatchRemaining;
    
    const confirmed = await showConfirm(
        `Confirm Stock Adjustment\n\n` +
        `Batch #${currentEditBatchId}\n` +
        `Material: ${currentEditMaterialName}\n` +
        `Current: ${currentEditBatchRemaining.toFixed(2)} ${currentEditUnit}\n` +
        `New: ${newQuantityInDisplayUnit.toFixed(2)} ${currentEditUnit}\n` +
        `${isDecrease ? `Reduction: ${adjustment.toFixed(2)} ${currentEditUnit}` : `Increase: ${adjustment.toFixed(2)} ${currentEditUnit}`}\n\n` +
        `Reason: ${reason}\n` +
        `Notes: ${notes || 'None'}\n\n` +
        `This action will be logged for audit purposes.`,
        'Confirm Adjustment'
    );
    
    if (!confirmed) return;
    
    showLoading('Processing stock adjustment...');
    
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
    
    try {
        const response = await fetch('/RawMaterial/AdjustBatchStock', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token
            },
            body: JSON.stringify({
                batchId: currentEditBatchId,
                newQuantity: newQuantityInDisplayUnit,  // ✅ Send in display unit (kg/L)
                reason: reason,
                notes: notes
            })
        });
        
        const result = await response.json();
        hideLoading();
        
        if (result.success) {
            await showAlert(result.message, 'Success', '✅');
            
            // Close modal
            const modal = bootstrap.Modal.getInstance(document.getElementById('editStockModal'));
            if (modal) modal.hide();
            
            // ✅ Refresh the batch history modal to show updated data
            const materialName = document.getElementById('modalBatchMaterialName').innerText;
            // You need to store the materialId when showing batch history
            if (window.currentBatchMaterialId) {
                await viewBatchHistory(window.currentBatchMaterialId, materialName);
            }
            
            // Also refresh the alerts page if open
            const alertsModule = document.getElementById('inventoryAlertsModule');
            if (alertsModule && alertsModule.classList.contains('active')) {
                loadInventoryAlerts();
            }
            
            // Optional: reload the whole page to ensure all data is fresh
            setTimeout(() => {
                saveAndReload();
            }, 1000);
        } else {
            await showAlert('Error: ' + result.message, 'Error', '❌');
        }
    } catch (error) {
        hideLoading();
        console.error('Error:', error);
        await showAlert('Error: ' + error.message, 'Error', '❌');
    }
}

async function loadAdjustmentHistory() {
    const filterDate = document.getElementById('adjustmentFilterDate')?.value || '';
    
    showLoading('Loading adjustment history...');
    
    try {
        const response = await fetch(`/RawMaterial/GetAdjustmentHistory?date=${filterDate}`);
        const data = await response.json();
        hideLoading();
        
        const tbody = document.getElementById('adjustmentHistoryBody');
        
        if (!data.adjustments || data.adjustments.length === 0) {
            tbody.innerHTML = '<tr><td colspan="9" class="text-center text-muted">No adjustment records found</td></tr>';
            return;
        }
        
        let html = '';
        data.adjustments.forEach(adj => {
            const date = new Date(adj.adjustedAt);
            const formattedDate = date.toLocaleString();
            const diff = adj.newQuantity - adj.oldQuantity;
            const diffClass = diff > 0 ? 'text-success' : (diff < 0 ? 'text-danger' : 'text-muted');
            const diffSign = diff > 0 ? '+' : '';
            
            html += `
                <tr>
                    <td>${formattedDate}</td>
                    <td><code>#${adj.batchId}</code></td>
                    <td><strong>${escapeHtml(adj.materialName)}</strong></td>
                    <td>${adj.oldQuantity.toFixed(2)} ${adj.unit}</td>
                    <td class="${adj.newQuantity < adj.oldQuantity ? 'text-danger' : 'text-success'}">${adj.newQuantity.toFixed(2)} ${adj.unit}</td>
                    <td class="${diffClass}">${diffSign}${diff.toFixed(2)} ${adj.unit}</td>
                    <td><span class="badge ${adj.reason.includes('Typo') ? 'bg-info' : (adj.reason.includes('Spoilage') || adj.reason.includes('Damage') ? 'bg-warning' : 'bg-secondary')}">${escapeHtml(adj.reason)}</span></td>
                    <td>${escapeHtml(adj.adjustedByName || 'System')}</td>
                    <td>${escapeHtml(adj.notes || '-')}</td>
                </tr>
            `;
        });
        tbody.innerHTML = html;
        
    } catch (error) {
        hideLoading();
        console.error('Error loading adjustment history:', error);
        document.getElementById('adjustmentHistoryBody').innerHTML = '<tr><td colspan="9" class="text-center text-danger">Error loading adjustment history</td></tr>';
    }
}

