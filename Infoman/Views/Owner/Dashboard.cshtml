// ========== FINANCIALS: SUMMARY (lahat ng cards) ==========
function peso(n) {
    return '₱' + Number(n || 0).toLocaleString('en-PH', {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
    });
}

function setText(id, value) {
    const el = document.getElementById(id);
    if (el) el.innerText = value;
}

async function loadFinancials() {
    const period = document.getElementById('financialPeriod').value;
    const dateParam = document.getElementById('financialDate').value || todayLocalString();

    // Loading state
    ['finTotalSales', 'finPurchases', 'finOtherExpenses', 'finNetProfit',
     'finCashInflow', 'finCashExpenses', 'finCashWithdrawals', 'finCashOutflow',
     'finCashMovement', 'finProfitSales', 'finCOGS', 'finProfitExpenses', 'finProfit']
        .forEach(id => setText(id, '...'));

    try {
        const res = await fetch(`/Finance/GetSummary?periodType=${period}&startDate=${dateParam}`);
        if (!res.ok) throw new Error('HTTP ' + res.status);
        const d = await res.json();

        // Top cards
        setText('finTotalSales', peso(d.totalSales));
        setText('finPurchases', peso(d.rawMaterialPurchases));
        setText('finOtherExpenses', peso(d.otherExpenses));
        setText('finNetProfit', peso(d.profit));

        const count = d.deliveryCount || 0;
        const src = document.getElementById('finPurchasesSource');
        if (src) {
           src.innerHTML = `<i class="fas fa-truck"></i> From ${count} deliver${count === 1 ? 'y' : 'ies'}`;
        }
        const inflow = d.cashInflow;
        const otherExpenses = d.otherExpenses;
        const rawMaterials = d.rawMaterialPurchases;

// 2. Bagong formula
        const totalOutflow = otherExpenses + rawMaterials; 
        const cashMovement = inflow - totalOutflow;

        // Cash Flow card
         setText('finCashInflow', peso(d.cashInflow));
        setText('finCashExpenses', peso(d.otherExpenses));
        
        // Ito yung idinagdag natin na Raw Materials sa UI
        setText('finCashWithdrawals', peso(d.rawMaterialPurchases)); 
        
        // Galing na sa backend ang tamang computation
        setText('finCashOutflow', peso(d.cashOutflow)); 
        setText('finCashMovement', peso(d.cashMovement));   

        // Profit Summary card
        setText('finProfitSales', peso(d.totalSales));
        setText('finCOGS', peso(d.cogs));
        setText('finProfitExpenses', peso(d.otherExpenses));
        setText('finProfit', peso(d.profit));
    } catch (err) {
        console.error('Error loading financial summary:', err);
        ['finTotalSales', 'finPurchases', 'finOtherExpenses', 'finNetProfit',
         'finCashInflow', 'finCashExpenses', 'finCashWithdrawals', 'finCashOutflow',
         'finCashMovement', 'finProfitSales', 'finCOGS', 'finProfitExpenses', 'finProfit']
            .forEach(id => setText(id, peso(0)));
    }
}

