async function saveProductEdit() {
    const productId = document.getElementById('editProductId').value;
    const name = document.getElementById('editProductNameInput').value.trim();
    const category = document.getElementById('editProductCategory').value;
    const description = document.getElementById('editProductDescription').value.trim();
    const imagePath = document.getElementById('editProductImagePath').value.trim();
    
    if (!name) {
        await showAlert('Please enter a product name', 'Required', '⚠️');
        return;
    }
    
    showLoading('Saving changes...');
    
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
    
    try {
        // Update basic info
        const updateResponse = await fetch('/Owner/UpdateProduct', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token
            },
            body: JSON.stringify({
                productId: parseInt(productId),
                name: name,
                category: category,
                description: description,
                imagePath: imagePath
            })
        });
        
        const updateResult = await updateResponse.json();
        
        if (!updateResult.success) {
            hideLoading();
            await showAlert('Error updating product: ' + updateResult.message, 'Error', '❌');
            return;
        }
        
        // Delete pending sizes
        for (const sizeId of pendingDeleteSizeIds) {
            await fetch('/Owner/DeleteProductSize', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify({ productSizeId: sizeId })
            });
        }
        
        hideLoading();
        await showAlert('Product updated successfully!', 'Success', '✅');
        
        const modal = bootstrap.Modal.getInstance(document.getElementById('editProductModal'));
        if (modal) modal.hide();
        saveAndReload();
        
    } catch (error) {
        hideLoading();
        await showAlert('Error: ' + error.message, 'Error', '❌');
    }
}


