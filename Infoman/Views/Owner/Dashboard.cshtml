    try {
        const response = await fetch(`/RawMaterial/BatchHistory?rawMaterialId=${materialId}`);
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        
        const data = await response.json();
        const batches = data.batches;
        const unit = data.unit || 'kg';

        if (!batches || batches.length === 0) {
            tbody.innerHTML = `<tr><td colspan="7" class="text-center text-muted">No batches found</td></tr>`;
            return;
        }

        tbody.innerHTML = '';
        let totalRemaining = 0;

        batches.forEach((batch, index) => {
            // ✅ I-DECLARE ANG MGA VARIABLES
            const quantityReceived = batch.quantityReceived;
            const quantityRemaining = batch.quantityRemaining;
            
            let status = '';
            let statusClass = '';
            if (quantityRemaining <= 0) {
                status = '<span class="badge bg-secondary">❌ Depleted</span>';
                statusClass = 'table-secondary';
            } else if (index === 0 && quantityRemaining > 0) {
                status = '<span class="badge bg-success">✅ ACTIVE (Next to Use)</span>';
                statusClass = 'table-success';
            } else if (quantityRemaining > 0) {
                status = '<span class="badge bg-info">📦 In Stock</span>';
                statusClass = 'table-info';
            }
            
            totalRemaining += quantityRemaining;
            
            const formattedReceivedDate = batch.receivedDate ? new Date(batch.receivedDate).toLocaleString() : 'N/A';
            const formattedExpiryDate = batch.expiryDate ? new Date(batch.expiryDate).toLocaleDateString() : 'No Expiry';
            
            tbody.innerHTML += `
                <tr class="${statusClass}">
                    <td>
                        <strong>Batch #${batch.batchId}</strong><br/>
                        <small class="text-muted">Received: ${formattedReceivedDate}</small>
                    </td>
                    <td>${quantityReceived.toFixed(2)} ${unit}</td>
                    <td class="${quantityRemaining === 0 ? 'text-danger' : 'text-success'} fw-bold">
                        ${quantityRemaining.toFixed(2)} ${unit}
                    </td>
                    <td>${formattedExpiryDate}</td>
                    <td>₱${batch.unitPrice.toFixed(2)}</td>
                    <td>${status}</td>
                    <td>
                        <div class="d-flex gap-1">
                            ${batch.usage?.length > 0 ? 
                                `<button class="btn btn-sm btn-outline-info" onclick='showUsageDetails(${JSON.stringify(batch.usage)})'>
                                    📋 View Usage (${batch.usage.length})
                                </button>` : 
                                '<span class="text-muted">No usage</span>'}
                            <button class="btn btn-sm btn-outline-warning" onclick="showEditStockModal(${batch.batchId}, ${batch.quantityRemainingInBaseUnit}, '${materialName}', '${unit}', ${batch.rawMaterialId})">
    ✏️ Edit Stock
</button>
                        </div>
                    </td>
                </tr>
            `;
        });

        // Add total row
        tbody.innerHTML += `
            <tr class="table-dark fw-bold">
                <td colspan="2" class="text-end">TOTAL REMAINING STOCK:</td>
                <td colspan="5">${totalRemaining.toFixed(2)} ${unit}</td>
            </tr>
        `;

    } catch (error) {
        console.error('Error:', error);
        tbody.innerHTML = `<tr><td colspan="7" class="text-center text-danger">Error loading batches: ${error.message}</td></tr>`;
    }
}


async function displayInPOS(productSizeId, productName, sizeName) {
    const confirmed = await showConfirm(`Display "${productName} - ${sizeName}" in POS menu?`, 'Confirm');
    if (!confirmed) return;
    
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
    const btn = event.target;
    const originalText = btn.innerHTML;

    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
    btn.disabled = true;

    try {
        const response = await fetch('/Owner/TogglePOSVisibility', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token
            },
            body: JSON.stringify({
                productSizeId: productSizeId,
                isAvailable: true
            })
        });

        const data = await response.json();

        if (data.success) {
            await showAlert(` "${productName} - ${sizeName}" is now DISPLAYED in POS menu.`, 'Success');
            // ✅ Auto refresh after 1 second
            setTimeout(function() {
                saveAndReload();
            }, 1000);
        } else {
            await showAlert(' Error: ' + data.message, 'Error');
            btn.innerHTML = originalText;
            btn.disabled = false;
        }
    } catch (error) {
        await showAlert(' Error: ' + error.message, 'Error');
        btn.innerHTML = originalText;
        btn.disabled = false;
    }
}

