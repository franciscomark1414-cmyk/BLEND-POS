        <!-- Products Module -->
<div id="productsModule" class="module">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0"> PRODUCTS LISTING</h2>
        <button class="btn btn-primary" onclick="showAddProductModal()">
            <i class="fas fa-plus"></i> Add Product
        </button>
    </div>

    <!-- Search and Filter Bar -->
    <div class="row mb-4">
        <div class="col-md-6">
            <input type="text" id="searchProduct" class="form-control" placeholder="🔍 Search Products..." onkeyup="filterProducts()">
        </div>
        <div class="col-md-3">
            <select id="filterCategory" class="form-control" onchange="filterProducts()">
                <option value=""> All Categories ▼</option>
                <option value="Fruit Shake"> Fruit Shake ▼</option>
                <option value="Milk Shake"> Milk Shake ▼</option>
                        <option value="Specialty"> Specialty ▼</option>
            </select>
        </div>
        <div class="col-md-3 text-end">
            <button class="btn btn-outline-secondary" onclick="refreshProducts()">
                <i class="fas fa-sync-alt"></i> Refresh
            </button>
        </div>
    </div>

    <!-- Products List Container -->
    <div id="productsList">
        @if (Model.Products != null && Model.Products.Any())
        {
            foreach (var product in Model.Products)
            {
                <div class="product-card card mb-4" data-product-id="@product.ProductId" data-category="@product.Category">
                    <!-- CARD HEADER WITH DROPDOWN ARROW -->
                    <div class="card-header bg-white d-flex justify-content-between align-items-center" style="cursor: pointer;" onclick="toggleProductCard(this)">
                        <div>
                            <i class="fas fa-chevron-down me-2 toggle-icon" style="transition: transform 0.2s;"></i>
                            <h4 class="mb-0 d-inline-block">🥤 @product.Name</h4>
                            <br />
                            <small class="text-muted ms-4">SKU: @product.SKU | Category: @product.Category</small>
                        </div>
                        <div onclick="event.stopPropagation()">
                            <button class="btn btn-sm btn-outline-primary me-2" onclick="editProduct(@product.ProductId)">
                                <i class="fas fa-edit"></i> Edit
                            </button>
                            <button class="btn btn-sm btn-outline-danger" onclick="archiveProduct(@product.ProductId)">
                                <i class="fas fa-archive"></i> Archive
                            </button>
                        </div>
                    </div>
                    
                    <!-- CARD BODY (COLLAPSIBLE) -->
                    <div class="card-body product-card-body">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="mb-0">📊 Sizes & Inventory</h5>
                            <button class="btn btn-sm btn-success" onclick="addSize(@product.ProductId)">
                                <i class="fas fa-plus"></i> Add Size
                            </button>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-bordered table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th> Size</th>
                                        <th> SKU</th>
                                        <th> Price</th>
                                        <th> POS Status</th>
                                        <th> Recipe</th>
                                        <th> Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (product.Sizes != null && product.Sizes.Any())
                                    {
                                        foreach (var size in product.Sizes)
                                        {
                                            <tr data-size-id="@size.ProductSizeId">
                                                <td>
                                                    @{
                                                        string emoji = size.SizeName == "Small" ? "🟢" : (size.SizeName == "Medium" ? "🟡" : "🔴");
                                                    }
                                                    @emoji @size.SizeName
                                                </td>
                                                <td><code>@(string.IsNullOrEmpty(size.SKU) ? "—" : size.SKU)</code></td>
                                                <td>₱@((int)size.Price)</td>
                                                <td id="pos-status-@size.ProductSizeId">
                                                    @if (size.IsAvailableInPOS)
                                                    {
                                                        <span class="badge bg-success">✅ Displayed in POS</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary">⚫ Hidden from POS</span>
                                                    }
                                                </td>
                                                <td>
                                                    <button class="btn btn-sm btn-info me-1" onclick="viewRecipe(@size.ProductSizeId)">
                                                        👁️ View Recipe
                                                    </button>
                                                    <button class="btn btn-sm btn-warning" onclick="editRecipe(@size.ProductSizeId)">
                                                        ✏️ Edit Recipe
                                                    </button>
                                                </td>
                                                <td>
                                                    @if (size.IsAvailableInPOS)
                                                    {
                                                        <button class="btn btn-sm btn-warning" onclick="hideFromPOS(@size.ProductSizeId, '@product.Name', '@size.SizeName')">
                                                            🙈 Hide from POS
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <button class="btn btn-sm btn-success" onclick="displayInPOS(@size.ProductSizeId, '@product.Name', '@size.SizeName')">
                                                            🖥️ Display in POS
                                                        </button>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="6" class="text-center text-muted">➕ No sizes added yet. Click "Add Size" to add.</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="text-center py-5">
                <h4 class="text-muted">📭 No products yet</h4>
                <p>Click <strong>"Add Product"</strong> to get started</p>
            </div>
        }
    </div>
