    function confirmRestock() {
        const materialId = document.getElementById('restockMaterialId').value;
        const quantity = document.getElementById('restockQuantity').value;
        const unitPrice = document.getElementById('restockUnitPrice').value;
        const expiryDate = document.getElementById('restockExpiryDate').value;

        if (!quantity || quantity <= 0) {
            alert('Please enter a valid quantity');
            return;
        }

        if (!unitPrice || unitPrice <= 0) {
            alert('Please enter a valid unit price');
            return;
        }

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

        const submitBtn = event.target;
        const originalText = submitBtn.innerHTML;
        submitBtn.innerHTML = 'Adding...';
        submitBtn.disabled = true;

        fetch('/RawMaterial/AddDelivery', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token
            },
            body: JSON.stringify({
                rawMaterialId: parseInt(materialId),
                quantity: parseFloat(quantity),
                unitPrice: parseFloat(unitPrice),
                expiryDate: expiryDate || null
            })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                alert('✅ ' + data.message);
                bootstrap.Modal.getInstance(document.getElementById('restockModal')).hide();
                loadInventoryAlerts(); // I-refresh ang alerts
                location.reload(); // O i-reload ang page para mag-update ang inventory
            } else {
                alert('❌ Error: ' + data.message);
            }
        })
        .catch(error => {
            alert('❌ Error: ' + error.message);
        })
        .finally(() => {
            submitBtn.innerHTML = originalText;
            submitBtn.disabled = false;
        });
    }
    function useMaterialFirst(id) { alert(`Priority usage for material ID: ${id}`); }
    function logExpiredAsWaste(id) { if (confirm('Log this expired item as waste?')) { showAddWasteModal(); document.getElementById('wasteMaterialId').value = id; document.getElementById('wasteReason').value = 'Expired'; document.getElementById('wasteNotes').value = 'Auto-logged from expired items'; } }

    function saveWasteLog() {
        const materialId = document.getElementById('wasteMaterialId').value;
        const quantity = document.getElementById('wasteQuantity').value;
        const reason = document.getElementById('wasteReason').value;
        const notes = document.getElementById('wasteNotes').value;
        const recordedBy = document.getElementById('wasteRecordedBy').value;
        if (!materialId || !quantity || !reason) { alert('Please fill in all required fields'); return; }
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
        fetch('/Owner/AddWasteLog', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
            body: JSON.stringify({ rawMaterialId: parseInt(materialId), quantity: parseFloat(quantity), reason: reason, notes: notes, recordedBy: recordedBy })
        }).then(response => response.json()).then(data => {
            if (data.success) { bootstrap.Modal.getInstance(document.getElementById('addWasteModal')).hide(); loadInventoryAlerts(); alert('Waste logged successfully!'); }
            else { alert('Error: ' + data.message); }
        }).catch(error => { alert('An error occurred'); });
    }
    // PRODUCE FUNCTION - idagdag ito kasama ng ibang functions
function produceProduct(productSizeId, sizeName, currentStock) {
    let quantity = prompt(`🏭 Produce ${sizeName}\n\nCurrent stock: ${currentStock} pcs\nEnter quantity to produce:`, "1");
    
    if (!quantity || quantity <= 0) {
        return;
    }
    
    // Confirmation
    if (!confirm(`Produce ${quantity} pcs of ${sizeName}?\n\nThis will deduct raw materials from inventory using FIFO.`)) {
        return;
    }
    
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
    
    // Show loading
    const btn = event.target.closest('button');
    const originalText = btn.innerHTML;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Producing...';
    btn.disabled = true;
    
    fetch('/Owner/ProduceProduct', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'RequestVerificationToken': token
        },
        body: JSON.stringify({
            productSizeId: productSizeId,
            quantity: parseInt(quantity),
            referenceNo: null
        })
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            alert('✅ ' + data.message);
            location.reload(); // Refresh para makita ang bagong stock
        } else {
            alert('❌ Error: ' + data.message);
            btn.innerHTML = originalText;
            btn.disabled = false;
        }
    })
    .catch(error => {
        alert('❌ Network error: ' + error.message);
        btn.innerHTML = originalText;
        btn.disabled = false;
    });
}

        // Batch History Functions
             // Replace your existing viewBatchHistory function with this:
        // Replace the entire viewBatchHistory function with this:
    async function viewBatchHistory(materialId, materialName) {
        const container = document.getElementById('batchHistoryContainer');
        const materialNameSpan = document.getElementById('batchMaterialName');
        const tbody = document.getElementById('batchHistoryBody');

        if (!container) {
            console.error('Container not found');
            return;
        }

        // Show container and set loading state
        materialNameSpan.innerText = materialName;
        container.style.display = 'block';
        tbody.innerHTML = `
            <tr>
                <td colspan="7" class="text-center">
                    <div class="spinner-border text-primary spinner-border-sm" role="status"></div>
                    Loading batches for ${materialName}...
                </td>
            </tr>
        `;

        try {
            const response = await fetch(`/RawMaterial/BatchHistory?rawMaterialId=${materialId}`);

            if (!response.ok) {
                throw new Error(`HTTP ${response.status}: ${response.statusText}`);
            }

            const batches = await response.json();

            // Debug log to see what we got
            console.log('Batches received:', batches);

            // Check if we have data
            if (!batches || batches.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="7" class="text-center text-muted">
                            <div class="alert alert-info">
                                <strong>ℹ️ No batches found for ${escapeHtml(materialName)}</strong><br/>
                                Click the <strong>"📦 ADD DELIVERY (BATCH)"</strong> button above to add your first delivery.
                                <br/><br/>
                                <button class="btn btn-sm btn-primary" onclick="showAddDeliveryForm(); closeBatchHistory();">
                                    ➕ Add First Delivery
                                </button>
                            </div>
                        </td>
                    </tr>
                `;
                return;
            }

            // Clear the table body
            tbody.innerHTML = '';
            let totalRemaining = 0;

            // Loop through each batch and display
            batches.forEach((batch, index) => {
                // Extract data (these are camelCase from JSON)
                const batchId = batch.batchId;
                const receivedDate = batch.receivedDate;
                const quantityReceived = batch.quantityReceived;
                const quantityRemaining = batch.quantityRemaining;
                const expiryDate = batch.expiryDate;
                const unitPrice = batch.unitPrice;
                const usage = batch.usage || [];

                // Format dates
                const formattedReceivedDate = receivedDate ? new Date(receivedDate).toLocaleString() : 'N/A';
                const formattedExpiryDate = expiryDate ? new Date(expiryDate).toLocaleDateString() : 'No Expiry';

                // Determine status for FIFO
                let status = '';
                let statusClass = '';

                if (quantityRemaining <= 0) {
                    status = '<span class="badge bg-secondary">❌ Depleted</span>';
                    statusClass = 'table-secondary';
                } else if (index === 0 && quantityRemaining > 0) {
                    status = '<span class="badge bg-success">✅ ACTIVE (Next to Use - FIFO)</span>';
                    statusClass = 'table-success fw-bold';
                } else if (quantityRemaining > 0) {
                    status = '<span class="badge bg-info">📦 In Stock</span>';
                    statusClass = 'table-info';
                }

                totalRemaining += quantityRemaining;

                // Usage button
                let usageButton = '';
                if (usage.length > 0) {
                    const usageJson = JSON.stringify(usage).replace(/"/g, '&quot;');
                    usageButton = `<button class="btn btn-sm btn-outline-info" onclick="showUsageDetails(${usageJson})">
                        📋 View Usage (${usage.length})
                    </button>`;
                } else {
                    usageButton = '<span class="text-muted">No usage yet</span>';
                }

                // Add row to table
                tbody.innerHTML += `
                    <tr class="${statusClass}">
                        <td>
                            <strong>Batch #${batchId}</strong><br/>
                            <small class="text-muted">Received: ${formattedReceivedDate}</small>
                        </td>
                        <td>${quantityReceived.toFixed(2)} kg</td>
                        <td class="${quantityRemaining === 0 ? 'text-danger' : 'text-success'} fw-bold">
                            ${quantityRemaining.toFixed(2)} kg
                            ${quantityRemaining > 0 && quantityRemaining < quantityReceived ? '<br/><small class="text-muted">(Partially used)</small>' : ''}
                        </td>
                        <td>${formattedExpiryDate}</td>
                        <td>₱${unitPrice.toFixed(2)}</td>
                        <td>${status}</td>
                        <td>${usageButton}</td>
                    </tr>
                `;
            });

            // Add total row
            tbody.innerHTML += `
                <tr class="table-dark fw-bold">
                    <td colspan="2" class="text-end">TOTAL REMAINING STOCK:</td>
                    <td colspan="5">${totalRemaining.toFixed(2)} kg</td>
                </tr>
            `;

            // Scroll to the container
            container.scrollIntoView({ behavior: 'smooth', block: 'start' });

        } catch (error) {
            console.error('Error loading batch history:', error);
            tbody.innerHTML = `
                <tr>
                    <td colspan="7" class="text-center text-danger">
                        <strong>Error loading batch history:</strong><br/>
                        ${error.message}<br/>
                        <button class="btn btn-sm btn-warning mt-2" onclick="viewBatchHistory(${materialId}, '${escapeHtml(materialName)}')">
                            🔄 Click to Retry
                        </button>
                    </td>
                </tr>
            `;
        }
    }

    // Helper function to show usage details
    function showUsageDetails(usageList) {
        if (!usageList || usageList.length === 0) {
            alert('No usage records found for this batch.');
            return;
        }

        let message = '📋 USAGE HISTORY:\n\n';
        usageList.forEach((use, index) => {
            const dateUsed = use.dateUsed ? new Date(use.dateUsed).toLocaleString() : 'Unknown date';
            const quantity = use.quantityUsed || 0;
            const reference = use.referenceNo || 'N/A';
            message += `${index + 1}. Date: ${dateUsed}\n`;
            message += `   Quantity: ${quantity.toFixed(2)} kg\n`;
            message += `   Reference: ${reference}\n\n`;
        });

        alert(message);
    }

    // Make sure closeBatchHistory exists
    function closeBatchHistory() {
        const container = document.getElementById('batchHistoryContainer');
        if (container) {
            container.style.display = 'none';
        }
    }
    function closeBatchHistory() {
        document.getElementById('batchHistoryContainer').style.display = 'none';
    }

    function showUsageDetails(usageList) {
        if (!usageList || usageList.length === 0) return;

        let message = 'Usage History:\n';
        usageList.forEach(use => {
            message += `- ${new Date(use.dateUsed).toLocaleDateString()}: ${use.quantityUsed} kg (Ref: ${use.referenceNo || 'N/A'})\n`;
        });
        alert(message);
    }

    function escapeHtml(str) { if (!str) return ''; return str.replace(/[&<>]/g, function(m) { if (m === '&') return '&amp;'; if (m === '<') return '&lt;'; if (m === '>') return '&gt;'; return m; }); }
</script>