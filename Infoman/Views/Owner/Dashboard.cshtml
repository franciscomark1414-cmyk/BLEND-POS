     function addIngredientRowToTable(ingredient, index) {
    const tbody = document.getElementById('ingredientsBody');
    
    const unitOptions = `
        <option value="kg">📦 kilogram (kg)</option>
        <option value="g">⚖️ gram (g)</option>
        <option value="L">💧 liter (L)</option>
        <option value="mL">🧪 milliliter (mL)</option>
        <option value="pcs">🔢 pieces (pcs)</option>
    `;
    
    const rowHtml = `
        <tr data-ingredient-index="${index}">
            <td>
                <select class="form-control ingredient-select" onchange="updateUnitDropdown(this)">
                    <option value="">-- Select Ingredient --</option>
                </select>
            </td>
            <td>
                <input type="number" class="form-control quantity-input" 
                       onchange="calculateIngredientTotal(this)" 
                       placeholder="Quantity" step="0.01" min="0.01" value="1">
            </td>
            <td>
                <select class="form-control unit-select" onchange="calculateIngredientTotal(this)">
                    ${unitOptions}
                </select>
            </td>
            <td class="cost-per-unit">₱0.00</td>
            <td class="total-cost">₱0.00</td>
            <td>
                <button type="button" class="btn btn-sm btn-danger" 
                        onclick="removeIngredientRow(this)">✕</button>
            </td>
        </tr>
    `;
    
    tbody.insertAdjacentHTML('beforeend', rowHtml);
    const row = tbody.lastElementChild;
    const select = row.querySelector('.ingredient-select');
    
    fetch('/RawMaterial/GetAllWithLatestPrice')
        .then(response => response.json())
        .then(materials => {
            let newOptions = '<option value="">Select Ingredient</option>';
            materials.forEach(m => {
                const price = m.latestBatchPrice > 0 ? m.latestBatchPrice : m.defaultPrice;
                newOptions += `<option value="${m.id}" data-price="${price}" data-unit="${m.unit}">${m.name} (${m.unit} - ₱${price})</option>`;
            });
            select.innerHTML = newOptions;
            
            if (ingredient) {
                select.value = ingredient.rawMaterialId;
                row.querySelector('.quantity-input').value = ingredient.quantity;
                
                const unitSelect = row.querySelector('.unit-select');
                for (let i = 0; i < unitSelect.options.length; i++) {
                    if (unitSelect.options[i].value === ingredient.unitUsed) {
                        unitSelect.selectedIndex = i;
                        break;
                    }
                }
                
                if (ingredient.price > 0) {
                    const selectedOption = select.options[select.selectedIndex];
                    if (selectedOption) selectedOption.setAttribute('data-price', ingredient.price);
                }
                
                // Trigger unit compatibility check
                updateUnitDropdown(select);
                calculateIngredientTotal(select);
            }
        })
        .catch(err => {
            console.error('Error loading materials:', err);
            select.innerHTML = '<option value="">Error loading ingredients</option>';
        });
}
  function calculateIngredientTotal(element) {
    const row = element.closest('tr');
    const select = row.querySelector('.ingredient-select');
    const selectedOption = select.options[select.selectedIndex];
    let price = parseFloat(selectedOption?.getAttribute('data-price') || 0);
    
    // Get selected unit from dropdown (HINDI galing sa material)
    const unitSelect = row.querySelector('.unit-select');
    const selectedUnit = unitSelect ? unitSelect.value : 'g';
    
    const quantity = parseFloat(row.querySelector('.quantity-input').value || 0);
    
    // Convert to base unit (kg or L) for costing
    let quantityForCost = quantity;
    
    switch(selectedUnit) {
        case 'g': quantityForCost = quantity / 1000; break;
        case 'kg': quantityForCost = quantity; break;
        case 'mL': quantityForCost = quantity / 1000; break;
        case 'L': quantityForCost = quantity; break;
        case 'pcs': quantityForCost = quantity; break;
        default: quantityForCost = quantity;
    }
    
    if (price === 0 && select.value) {
        fetch(`/RawMaterial/GetPrice/${select.value}`)
            .then(response => response.json())
            .then(data => {
                if (data.price > 0) {
                    price = data.price;
                    const total = price * quantityForCost;
                    row.querySelector('.cost-per-unit').innerText = `₱${price.toFixed(2)}`;
                    row.querySelector('.total-cost').innerText = `₱${total.toFixed(2)}`;
                    updateTotals();
                }
            });
        return;
    }
    
    const total = price * quantityForCost;
    row.querySelector('.cost-per-unit').innerText = `₱${price.toFixed(2)}`;
    row.querySelector('.total-cost').innerText = `₱${total.toFixed(2)}`;
    updateTotals();
}
    function removeIngredientRow(button) { button.closest('tr').remove(); updateTotals(); }
    function updateSellingPrice() {
        let totalCostText = document.getElementById('totalCostDisplay').innerText;
        let totalCost = parseFloat(totalCostText.replace('₱', '')) || 0;
        let margin = parseFloat(document.getElementById('marginSelect')?.value || 0.3);
        let sellingPrice = totalCost / (1 - margin);
        document.getElementById('recipeSellingPrice').value = `₱${sellingPrice.toFixed(2)}`;
        updateTotals();
    }

       function updateTotals() {
        let totalCost = 0;
        document.querySelectorAll('#ingredientsBody tr').forEach(row => {
            const totalText = row.querySelector('.total-cost')?.innerText || '₱0.00';
            const totalValue = parseFloat(totalText.replace('₱', '')) || 0;
            totalCost += totalValue;
        });

        // I-update ang display
        document.getElementById('totalCostDisplay').innerHTML = `₱${totalCost.toFixed(2)}`;
        document.getElementById('recipeTotalCost').value = `₱${totalCost.toFixed(2)}`;

        const margin = parseFloat(document.getElementById('marginSelect')?.value || 0.3);
        const sellingPrice = totalCost / (1 - margin);

        document.getElementById('sellingPriceDisplay').innerHTML = `₱${sellingPrice.toFixed(2)}`;
        document.getElementById('recipeSellingPrice').value = `₱${sellingPrice.toFixed(2)}`;

        const profitLoss = sellingPrice - totalCost;
        const profitLossDisplay = document.getElementById('profitLossDisplay');
        profitLossDisplay.innerHTML = `₱${profitLoss.toFixed(2)}`;
        profitLossDisplay.className = profitLoss >= 0 ? 'fw-bold text-success' : 'fw-bold text-danger';
    }

    function saveRecipe() {
    const ingredients = [];
    document.querySelectorAll('#ingredientsBody tr').forEach(row => {
        const select = row.querySelector('.ingredient-select');
        const unitSelect = row.querySelector('.unit-select');
        const quantity = row.querySelector('.quantity-input').value;
        
        if (select.value && quantity) {
            ingredients.push({
                rawMaterialId: parseInt(select.value),
                quantity: parseFloat(quantity),
                unitUsed: unitSelect ? unitSelect.value : 'g'  // ← Kunin ang napiling unit
            });
        }
    });
    
    const margin = parseFloat(document.getElementById('marginSelect').value);
    
    fetch('/Owner/SaveRecipe', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
        },
        body: JSON.stringify({
            productSizeId: currentProductSizeId,
            margin: margin,
            ingredients: ingredients
        })
    })
    .then(response => response.json())
    .then(async (data) => {
        if (data.success) {
            await showAlert('Recipe saved successfully!', 'Success');
            bootstrap.Modal.getInstance(document.getElementById('editRecipeModal')).hide();
            saveAndReload();
        } else {
            await showAlert('Error saving recipe: ' + data.message, 'Error');
        }
    })
    .catch(async (err) => {
        await showAlert('An error occurred. Please try again.', 'Error');
    });
}

