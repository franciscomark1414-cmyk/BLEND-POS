@model List<Infoman.Models.RawMaterial>

@{
    ViewBag.Title = "Low Stock RawMaterial";
}

<h2>Low Stock RawMaterial</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Stock</th>
            <th>Min Qty</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Count == 0)
        {
            <tr>
                <td colspan="4" class="text-center">No low stock materials.</td>
            </tr>
        }
        else
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.StockWithUnit</td>
                    <td>@item.MinQty</td>
                    <td>@item.Status</td>
                </tr>
            }
        }
    </tbody>
</table>