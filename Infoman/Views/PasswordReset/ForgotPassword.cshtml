@model Infoman.Controllers.ForgotPasswordVM
@{ Layout = null; }
<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Forgot Password</title><link rel="stylesheet" href="~/css/recovery.css" /></head>
<body><div class="wrap"><div class="card">
  <h3>Forgot Password</h3>
  <p class="sub">Owner account only. Enter your registered email to receive a verification code.</p>
  <form asp-action="ForgotPassword" method="post">
    @if (!ViewData.ModelState.IsValid) { <div class="err" asp-validation-summary="All"></div> }
    <div class="fg"><label>Registered Email</label>
      <input asp-for="Email" type="email" autocomplete="email" placeholder="owner@example.com" /></div>
    <button type="submit" class="btn">Send Code</button>
  </form>
  <a class="back" asp-controller="Account" asp-action="Login">← Back to Login</a>
</div></div></body></html>