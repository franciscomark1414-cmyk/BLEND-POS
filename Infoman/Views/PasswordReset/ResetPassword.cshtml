@model Infoman.Controllers.ResetPasswordVM
@{ Layout = null; }
<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Reset Password</title><link rel="stylesheet" href="~/css/recovery.css" /></head>
<body><div class="wrap"><div class="card">
  <h3>Create New Password</h3>
  <p class="sub">Minimum 8 characters.</p>
  <form asp-action="ResetPassword" method="post">
    @if (!ViewData.ModelState.IsValid) { <div class="err" asp-validation-summary="All"></div> }
    <div class="fg"><label>New Password</label><input asp-for="NewPassword" type="password" autocomplete="new-password" /></div>
    <div class="fg"><label>Confirm Password</label><input asp-for="ConfirmPassword" type="password" autocomplete="new-password" /></div>
    <button type="submit" class="btn">Reset Password</button>
  </form>
</div></div></body></html>