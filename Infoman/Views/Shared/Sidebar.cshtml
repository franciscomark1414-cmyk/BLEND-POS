<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Neldie's Mango & More</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        body {
            background: linear-gradient(to bottom, #f5f1e6, #e8dcc7);
            font-family: 'Segoe UI', sans-serif;
            margin: 0;
            padding: 0;
        }

        /* Sidebar - DARK BLUE DESIGN */
        .sidebar {
            width: 260px;
            background: #1e293b;
            color: white;
            position: fixed;
            height: 100vh;
            left: 0;
            top: 0;
            padding: 20px 0;
            z-index: 100;
        }

            .sidebar .logo-area {
                text-align: center;
                padding: 20px;
                border-bottom: 1px solid #334155;
                margin-bottom: 20px;
            }

                .sidebar .logo-area .logo-icon {
                    background: linear-gradient(135deg, #f59e0b, #d97706);
                    width: 50px;
                    height: 50px;
                    line-height: 50px;
                    border-radius: 12px;
                    font-size: 24px;
                    margin: 0 auto 10px;
                }

            .sidebar .nav-item {
                padding: 12px 24px;
                cursor: pointer;
                transition: all 0.3s;
                color: #94a3b8;
            }

                .sidebar .nav-item:hover, .sidebar .nav-item.active {
                    background: #334155;
                    color: #f59e0b;
                }

                .sidebar .nav-item i {
                    width: 24px;
                    margin-right: 12px;
                }

        /* Main Content */
        .main-content {
            margin-left: 260px;
            padding: 20px 30px;
            min-height: 100vh;
        }

        /* Header */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            padding-bottom: 15px;
            border-bottom: 1px solid #e2e8f0;
        }

        .user-info {
            text-align: right;
        }

            .user-info .user-name {
                font-weight: bold;
                font-size: 16px;
            }

            .user-info .user-role {
                font-size: 12px;
                color: #f59e0b;
            }

        .logout-btn {
            background: none;
            border: none;
            color: #ef4444;
            cursor: pointer;
            font-size: 14px;
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <!-- Sidebar -->
    <div class="sidebar">
        <div class="logo-area">
            <div class="logo-icon mx-auto">🍹</div>
            <h5 class="mt-2 mb-0">Neldie's Mango</h5>
            <small>Owner Portal</small>
        </div>
        <div class="nav-item @(ViewBag.ActivePage == "Dashboard" ? "active" : "")" onclick="window.location.href='/Owner/Dashboard'">
            <i class="fas fa-tachometer-alt"></i> Dashboard
        </div>
        <div class="nav-item @(ViewBag.ActivePage == "Inventory" ? "active" : "")" onclick="window.location.href='/Owner/Dashboard#inventoryModule'">
            <i class="fas fa-boxes"></i> Inventory
        </div>
        <div class="nav-item @(ViewBag.ActivePage == "Products" ? "active" : "")" onclick="window.location.href='/Owner/Dashboard#productsModule'">
            <i class="fas fa-cube"></i> Products
        </div>
        <div class="nav-item @(ViewBag.ActivePage == "Alerts" ? "active" : "")" onclick="window.location.href='/Owner/Dashboard#inventoryAlertsModule'">
            <i class="fas fa-bell"></i> Alerts
        </div>
        <div class="nav-item @(ViewBag.ActivePage == "Reports" ? "active" : "")" onclick="window.location.href='/Owner/Dashboard#reportsModule'">
            <i class="fas fa-chart-line"></i> Reports
        </div>
        <div class="nav-item @(ViewBag.ActivePage == "Employees" ? "active" : "")" onclick="window.location.href='/Employee'">
            <i class="fas fa-users"></i> Employees
        </div>
        <div class="nav-item @(ViewBag.ActivePage == "Settings" ? "active" : "")" onclick="window.location.href='/Owner/Dashboard#settingsModule'">
            <i class="fas fa-cog"></i> Settings
        </div>
    </div>

    <!-- Main Content -->
    <div class="main-content">
        <!-- Header -->
        <div class="header">
            <h3 class="mb-0">@ViewBag.Title</h3>
            <div class="user-info">
                <div class="user-name">John Doe</div>
                <div class="user-role">Owner</div>
                <button class="logout-btn mt-1" onclick="window.location.href='/Account/Logout'">
                    <i class="fas fa-sign-out-alt"></i> Logout
                </button>
            </div>
        </div>

        <!-- Page Content -->
        @RenderBody()
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>