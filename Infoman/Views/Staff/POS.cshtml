    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        let cart = [];
        let modalQuantity = 1;
        let currentMaxOrders = 0;
        let currentDiscountType = 'None';
        let currentDiscountPercent = 0;
        let currentCartTotal = 0;
        let currentDiscountedTotal = 0;
        let tempSelectedSize = null;
        let pendingPaymentMethod = null;
        let currentVoidOrderId = null;
        let currentRefundOrderId = null;
        let pendingOwnerAction = null;
        let pendingOwnerData = null;
        let isEditingMode = false;
        let editingOrderId = null;
        let exchangeReturnItems = [];
        let exchangeReplaceItems = [];
        let currentExchangeOrderId = null;
        let exchangeProducts = [];

        // ============================================================
        // ORDER QUEUE
        // ============================================================
        async function loadOrderQueue() {
    try {
        const response = await fetch('/Staff/GetActiveOrders');
        const orders = await response.json();
        const container = document.getElementById('orderQueueList');
        const countSpan = document.getElementById('queueCount');
        if (!container) return;
        
        // PENDING PAYMENT LANG ang ipapakita (hindi pa na-start ang blending)
        const pendingOrders = orders.filter(o => o.status === 'PENDING_PAYMENT');
        
        if (countSpan) countSpan.innerText = pendingOrders.length;
        
        if (pendingOrders.length === 0) {
            container.innerHTML = '<div class="text-center text-muted small">No pending orders to blend</div>';
            return;
        }
        
        let html = '';
        pendingOrders.forEach(order => {
            let itemsHtml = '';
            order.items.forEach(item => {
                itemsHtml += `<div>• ${item.quantity}x ${item.productName} (${item.sizeName})</div>`;
            });
            // Kunin ang huling 6 na character ng order number
            const shortOrderNum = order.orderNumber.substring(order.orderNumber.length - 6);
            html += `
                <div class="queue-item" data-order-id="${order.orderId}" style="border-left: 3px solid #ffc107; margin-bottom: 8px; background: white; border-radius: 8px; padding: 8px;">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="queue-order-number" style="font-size: 12px; font-weight: bold;" title="${order.orderNumber}">#${shortOrderNum}</span>
                        <span class="badge bg-warning" style="font-size: 9px;">PENDING</span>
                    </div>
                    <div class="queue-items" style="font-size: 11px; color: #666; margin: 5px 0;">${itemsHtml}</div>
                    <div class="d-flex justify-content-between align-items-center mt-1">
                        <span class="queue-total" style="font-size: 12px; font-weight: bold; color: #28a745;">₱${order.totalAmount.toFixed(2)}</span>
                        <div>
