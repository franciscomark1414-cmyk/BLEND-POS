        function checkAttendanceStatus() {
            fetch('/Staff/GetTodayAttendance').then(res => res.json()).then(data => {
                const timeInBtn = document.getElementById('timeInBtn');
                const timeOutBtn = document.getElementById('timeOutBtn');
                const statusBadge = document.getElementById('attendanceStatusBadge');
                const hoursDisplay = document.getElementById('todayHoursDisplay');
                if (data.isClockedIn) {
                    timeInBtn.style.display = 'none'; timeOutBtn.style.display = 'inline-block';
                    statusBadge.className = 'badge bg-success ms-2'; statusBadge.innerText = '🟢 Clocked In';
                    if (hoursDisplay) hoursDisplay.innerText = data.hoursToday;
                } else if (data.hasClockedOut) {
                    timeInBtn.style.display = 'none'; timeOutBtn.style.display = 'none';
                    statusBadge.className = 'badge bg-secondary ms-2'; statusBadge.innerText = '🔴 Completed';
                    if (hoursDisplay) hoursDisplay.innerText = data.hoursToday;
                } else {
                    timeInBtn.style.display = 'inline-block'; timeOutBtn.style.display = 'none';
                    statusBadge.className = 'badge bg-secondary ms-2'; statusBadge.innerText = '⭕ Not Clocked In';
                    if (hoursDisplay) hoursDisplay.innerText = '0.0';
                    showAttendanceReminder();
                }
            });
        }

