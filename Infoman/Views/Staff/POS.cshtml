async function loadExchangeOrderItems() {
    const orderId = document.getElementById('exchangeOrderSelect').value;
    if (!orderId) return;
    
    currentExchangeOrderId = parseInt(orderId);
    exchangeReturnItems = [];
    exchangeReplaceItems = [];
    
    try {
        const response = await fetch(`/VoidRefund/GetOrderDetails?orderId=${orderId}`);
        const data = await response.json();
        
        if (!data.success) {
            await showAlert(data.message, 'Error', '❌');
            return;
        }
        
        // Display return items
        const returnContainer = document.getElementById('exchangeReturnItems');
        let returnHtml = '<table class="table table-sm">';
        returnHtml += '<thead><tr><th>Select</th><th>Product</th><th>Qty</th><th>Price</th></tr></thead><tbody>';
        
        data.order.items.forEach(item => {
            if (!item.isVoided && !item.isRefunded) {
                returnHtml += `
                    <tr>
                        <td><input type="checkbox" class="return-item-checkbox" data-id="${item.orderItemId}" data-price="${item.price}" data-name="${item.productName}" data-size="${item.sizeName}" data-max="${item.quantity}"></td>
                        <td><strong>${escapeHtml(item.productName)}</strong><br><small>${item.sizeName}</small></td>
                        <td><input type="number" class="form-control form-control-sm return-qty" data-id="${item.orderItemId}" style="width: 70px;" min="0" max="${item.quantity}" value="0" disabled></td>
                        <td>₱${item.price.toFixed(2)}</td>
                    </tr>
                `;
            }
        });
        returnHtml += '</tbody></table>';
        returnContainer.innerHTML = returnHtml;
        
        // Attach event listeners
        document.querySelectorAll('.return-item-checkbox').forEach(cb => {
            cb.addEventListener('change', function() {
                const qtyInput = this.closest('tr').querySelector('.return-qty');
                qtyInput.disabled = !this.checked;
                if (!this.checked) qtyInput.value = 0;
                updateExchangeTotals();
            });
        });
        
        document.querySelectorAll('.return-qty').forEach(qty => {
            qty.addEventListener('change', updateExchangeTotals);
        });
        
        // Load available products for replacement
        await loadAvailableProductsForExchange();
        
        updateExchangeTotals();
        
    } catch (error) {
        console.error('Error:', error);
        await showAlert('Error loading order details', 'Error', '❌');
    }
}

async function loadAvailableProductsForExchange() {
