        </label>
        <select id="exchangeReason" class="reason-select" style="width: 100%; padding: 12px; border-radius: 10px;" onchange="toggleExchangeOtherReason()">
            <option value="">-- Select Reason --</option>
            <option value="Damaged product">🔧 Damaged product</option>
