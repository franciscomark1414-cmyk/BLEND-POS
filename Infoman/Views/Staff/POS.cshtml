    <div id="reviewOrderModal" class="modal-qty" style="display: none;">
        <div class="modal-qty-content" style="width: 450px; max-width: 90%;">
            <h4 style="text-align: center; margin-bottom: 20px;"> Review Your Order</h4>
            <div id="reviewOrderContent" style="margin-bottom: 20px; max-height: 400px; overflow-y: auto;"></div>
            <div style="display: flex; gap: 10px; margin-top: 20px;">
                <button class="btn-cancel" onclick="closeReviewModal()" style="flex: 1; padding: 10px;">✕ Cancel</button>
                <button class="btn-confirm" onclick="processFinalOrder()" style="flex: 1; padding: 10px;">✅ Confirm Order</button>
            </div>
        </div>
    </div>

  
<!-- Receipt Modal - Ilagay ito AFTER reviewOrderModal at BEFORE paymentModal -->
<div id="receiptModal" class="modal-qty" style="display: none;">
    <div class="modal-qty-content" style="width: 380px; max-width: 90%;">
        <div style="text-align: center; margin-bottom: 16px;">
            <h3 style="margin: 5px 0; font-size: 18px;">Neldie's Mango & More</h3>
            <small style="color: #888;">Official Receipt</small>
            <hr style="margin: 10px 0;">
        </div>

        <div id="receiptContent">
            <!-- Dynamic receipt content injected here -->
        </div>

        <hr style="margin: 10px 0;">
        <div style="text-align: center;">
            <small style="color: #aaa;">Thank you for your purchase!</small>
        </div>

        <!-- Action area -->
        <div class="receipt-action-area" id="receiptActionArea">
            <!-- GCash Pay Button - lalabas lang kapag PENDING_PAYMENT -->
            <button id="gcashPayBtnInside" class="btn-start-blending" style="background: #007bff; color: white; display: none;" onclick="payWithGCashFromReceipt(window.currentOrderId)">
                💳 Pay with GCash
            </button>
            
            <!-- Start Blending Button -->
            <button id="startBlendingBtn" class="btn-start-blending" style="display: none;" onclick="startBlending(window.currentOrderId)">
                 START BLENDING (Deduct Ingredients)
            </button>
            
            <p class="blending-warning" id="blendingWarningMsg" style="display: none;">
                ⚠️ Click only when you start preparing/blending.<br>
                Ingredients will be deducted and cannot be undone without Owner approval.
            </p>
            
            <!-- VOID ITEM — before blending, remove specific item -->
            <button id="voidItemReceiptBtn" class="btn-void-item-receipt" style="display: none;" onclick="voidItemFromReceipt()">
                ✕ Void Item
            </button>
            
            <!-- VOID TRANSACTION — visible before blending, hidden after -->
            <button id="voidReceiptBtn" class="btn-void-receipt" style="display: none;" onclick="voidFromReceipt()">
                ✕ Void Transaction
            </button>
        </div>

        <!-- Close button — always visible -->
        <div style="margin-top: 10px;">
            <button onclick="closeReceiptModal()" style="width:100%; padding: 8px; background: #f5f5f5; color: #555; border: none; border-radius: 8px; cursor: pointer; font-size: 13px;">
                Close
            </button>
        </div>
    </div>
</div>

    <!-- Payment Method Modal -->
    <div id="paymentModal" class="modal-qty" style="display: none;">
        <div class="modal-qty-content" style="width: 350px;">
            <h4>💳 Select Payment Method</h4>
            <div style="margin: 20px 0;">
                <button class="btn btn-success w-100 mb-2" onclick="processPayment('Cash')" style="padding: 12px;">💵 Cash</button>
                <button class="btn btn-primary w-100 mb-2" onclick="processPayment('GCash')" style="padding: 12px;">📱 GCash</button>
            </div>
            <div class="modal-buttons">
                <button class="btn-cancel" onclick="closePaymentModal()">Cancel</button>
            </div>
        </div>
    </div>

    <!-- Size Selection Modal -->
    <div id="sizeModal" class="modal-qty" style="display: none;">
        <div class="modal-qty-content" style="width: 400px;">
            <h4 id="sizeModalProductName">Select Size</h4>
            <div id="sizeOptionsList" style="margin: 20px 0;"></div>
            <div class="modal-buttons">
                <button class="btn-cancel" onclick="closeSizeModal()">Cancel</button>
            </div>
        </div>
    </div>

    <!-- Quantity Modal -->
    <div id="quantityModal" class="modal-qty" style="display: none;">
        <div class="modal-qty-content">
            <h4 id="modalProductName">Product Name</h4>
            <div class="qty-selector">
                <button onclick="decrementModalQty()">-</button>
                <span id="modalQty">1</span>
                <button onclick="incrementModalQty()">+</button>
            </div>
            <div class="modal-buttons">
                <button class="btn-cancel" onclick="closeQuantityModal()">Cancel</button>
                <button class="btn-confirm" onclick="confirmAddToCart()">Add to Order</button>
            </div>
        </div>
    </div>

    <!-- Attendance Reminder Modal -->
    <div class="modal fade" id="attendanceReminderModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-warning">
                    <h5 class="modal-title"> Attendance Reminder</h5>
                </div>  .
                <div class="modal-body text-center">
                    <p>You are logged in but not yet timed in.</p>
                    <p><strong>Start your shift now?</strong></p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" data-bs-dismiss="modal">Remind Me Later</button>
                    <button class="btn btn-success" onclick="timeInFromReminder()"> Time In Now</button>
                </div>
            </div>
        </div>
