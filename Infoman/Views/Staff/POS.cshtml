                </div>
            </div>
        </div>
    `;
    
    // Remove existing modal if any
    const existingModal = document.getElementById('voidTransactionModal');
    if (existingModal) existingModal.remove();
    
    document.body.insertAdjacentHTML('beforeend', modalHtml);
    
    // Handle reason dropdown
    const reasonSelect = document.getElementById('voidTransReason');
    const otherReasonInput = document.getElementById('voidTransOtherReason');
    
    reasonSelect.addEventListener('change', function() {
        otherReasonInput.style.display = this.value === 'Other' ? 'block' : 'none';
    });
    
    // Cancel button
    document.getElementById('cancelVoidTransBtn').onclick = () => {
        document.getElementById('voidTransactionModal').remove();
    };
    
    // Confirm button
    document.getElementById('confirmVoidTransBtn').onclick = async () => {
        let reason = reasonSelect.value;
        if (reason === 'Other') {
            reason = otherReasonInput.value;
            if (!reason) {
                await showAlert('Please specify the reason', 'Required', '⚠️');
                return;
            }
        }
        
        if (!reason) {
            await showAlert('Please select a reason', 'Required', '⚠️');
            return;
        }
        
        document.getElementById('voidTransactionModal').remove();
        
        showLoading('Processing void...');
        
        const token = getToken();
        
        try {
            const response = await fetch('/VoidRefund/VoidTransaction', {
                method: 'POST',
                headers: { 
                    'Content-Type': 'application/json', 
                    'RequestVerificationToken': token 
                },
                body: JSON.stringify({ 
                    orderId: orderId, 
                    reason: reason 
                })
            });
            
            const data = await response.json();
            hideLoading();
            
            if (data.requiresOwner) {
                await showAlert(data.message, 'Owner Approval Required', '⚠️');
                return;
            }
            
            if (data.success) {
                // ✅ Use the detailed receipt with refund display
                await showUpdatedReceiptAfterVoid(
                    orderId,
                    data.refundAmount,
                    0,
                    false,
                    true
                );
                
                await showAlert(
                    `✅ Transaction voided!\n\n💰 Full Refund: ₱${data.refundAmount.toFixed(2)}`,
                    'Void Successful',
                    '✅'
                );
                
                // Refresh order queue
                await loadOrderQueue();
                
                // Close the void/refund modal if open
                closeVoidRefundModal();
                
            } else {
                await showAlert('Error: ' + data.message, 'Error', '❌');
            }
        } catch (error) {
            hideLoading();
            await showAlert('Error: ' + error.message, 'Error', '❌');
        }
    };
}



