async function createOrderForQRPh() {
    try {
        if (cart.length === 0) {
            await showAlert('Cart is empty', 'Cannot proceed');
            return;
        }

        const discountPercent = currentDiscountPercent;
        const discountType = currentDiscountType;
        const paymentMethod = 'QRPh';
        
        // Kunin ang unang item (gaya ng ginagawa sa cash flow)
        const firstItem = cart[0];
        
        const orderNumber = `POS-${Date.now()}`;
        
        const response = await fetch('/Staff/PlaceOrder', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': getToken()
            },
            body: JSON.stringify({
                productSizeId: firstItem.productSizeId,
                quantity: firstItem.quantity,
                orderNumber: orderNumber,
                paymentMethod: paymentMethod,
                discountType: discountType,
                discountPercent: discountPercent
            })
        });
        
        const result = await response.json();
        
        if (result.success) {
            // Save order info for payment
            window.currentOrderId = result.orderId;
            window.currentOrderTotal = result.totalAmount;
            
            // Build order details for receipt
            const orderDetails = cart.map(item => ({
                name: item.productName,
                size: item.sizeName,
                quantity: item.quantity,
                price: item.price,
                subtotal: item.price * item.quantity
            }));
            
            const discountSavings = currentCartTotal - currentDiscountedTotal;
            
            // Show receipt modal
            showReceiptModal(
                orderDetails, 
                'QRPh', 
                currentDiscountType, 
                currentDiscountPercent, 
                discountSavings, 
                currentDiscountedTotal, 
                result.orderId, 
                'PENDING_PAYMENT'
            );
            
            // Show QRPh pay button
            const qrphPayBtn = document.getElementById('qrphPayBtn');
            if (qrphPayBtn) {
                qrphPayBtn.style.display = 'block';
            }
            
            // Clear cart
            cart = [];
            currentDiscountType = 'None';
            currentDiscountPercent = 0;
            updateCartDisplay();
            updateDiscountBtnHighlight();
            
            await showAlert('Order created! Click "Pay with GCash (Scan QR)" to generate QR code.', 'Order Ready', '✅');
            
        } else {
            throw new Error(result.message || 'Failed to create order');
        }
    } catch (error) {
        console.error('Create QRPh order error:', error);
        throw error;
    }
}

