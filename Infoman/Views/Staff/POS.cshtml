async function loadOrderReceipt(orderId) {
    try {
        const response = await fetch(`/VoidRefund/GetOrderDetails?orderId=${orderId}`);
        const data = await response.json();
        
        if (data.success && data.order) {
            const orderDetails = [];
            let total = 0;
            
            data.order.items.forEach(item => {
                if (!item.isVoided && !item.isRefunded) {
                    orderDetails.push({
                        name: item.productName,
                        size: item.sizeName,
                        quantity: item.quantity,
                        price: item.price,
                        subtotal: item.subtotal
                    });
                    total += item.subtotal;
                }
            });
            
            showReceiptModal(orderDetails, data.order.paymentMethod || 'Cash', 
                data.order.discountType, data.order.discountPercent, 0, total, orderId, 'PENDING_PAYMENT');
        }
    } catch (error) {
        console.error('Error loading receipt:', error);
    }
}

