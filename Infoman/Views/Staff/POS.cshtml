      async function startBlending(orderId) {
    if (!orderId) {
        await showAlert('No order found.', 'Error', '❌');
        return;
    }
    
    const receiptModal = document.getElementById('receiptModal');
    if (receiptModal && receiptModal.style.display === 'flex') {
        receiptModal.style.display = 'none';
    }
    
    await new Promise(resolve => setTimeout(resolve, 100));
    
    const confirmed = await showConfirm(
        '⚠️ START BLENDING?\n\nOnce you click OK:\n• Ingredients will be DEDUCTED from inventory\n• This action cannot be undone without Owner approval\n\nContinue?',
        'Start Blending Confirmation'
    );
    
    if (!confirmed) return;

    showLoading('Starting blending process...');
    
    try {
        const response = await fetch('/Staff/StartBlending', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getToken() },
            body: JSON.stringify({ orderId: orderId })
        });
        const data = await response.json();
        hideLoading();

        if (data.success) {
            await showAlert('✅ ' + data.message, 'Success', '✅');
            
            // ✅ Refresh order queue
            await loadOrderQueue();
            
            // ✅ Close any open receipt modal
            closeReceiptModal();
            
            // ✅ Clear edit mode if active
            if (window.isEditingMode) {
                const banner = document.getElementById('editModeBanner');
                if (banner) banner.remove();
                window.isEditingMode = false;
                window.originalOrderId = null;
                
                const checkoutBtn = document.getElementById('checkoutBtn');
                checkoutBtn.innerHTML = '💳 Confirm Order';
                checkoutBtn.style.background = '#28a745';
            }
            
        } else {
            await showAlert('❌ Error: ' + data.message, 'Error', '❌');
        }
    } catch (error) {
        hideLoading();
        await showAlert('❌ Error: ' + error.message, 'Error', '❌');
    }
}



