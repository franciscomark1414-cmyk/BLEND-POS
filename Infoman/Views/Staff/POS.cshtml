}

function renderReturnItems(items) {
    const container = document.getElementById('exchangeReturnItems');
    
    if (!items || items.length === 0) {
        container.innerHTML = '<div class="text-muted text-center" style="padding: 20px;">No items to return</div>';
        return;
    }
    
    let html = '<div style="display: flex; flex-direction: column; gap: 10px;">';
    
    items.forEach((item, idx) => {
        html += `
            <div class="return-item-div" data-order-item-id="${item.orderItemId}" data-price="${item.price}" data-max-qty="${item.quantity}" style="background: white; border: 1px solid #ffc107; border-radius: 10px; padding: 10px;">
                <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
                    <div style="width: 40px; text-align: center;">
                        <input type="checkbox" class="return-item-checkbox" data-id="${item.orderItemId}" data-price="${item.price}" data-name="${escapeHtml(item.productName)}" data-size="${escapeHtml(item.sizeName)}" onchange="toggleReturnItem(this)">
                    </div>
                    <div style="flex: 1;">
                        <div><strong>${escapeHtml(item.productName)}</strong> <span style="color: #666; font-size: 12px;">(${escapeHtml(item.sizeName)})</span></div>
                        <div style="font-size: 12px; color: #28a745;">₱${item.price.toFixed(2)} each</div>
                    </div>
                    <div>
                        <input type="number" class="form-control return-qty" data-id="${item.orderItemId}" style="width: 80px; border-radius: 8px;" min="0" max="${item.quantity}" value="0" disabled placeholder="Qty" onchange="updateExchangeSummary()" onkeyup="updateExchangeSummary()">
                    </div>
                </div>
            </div>
        `;
    });
    
    html += '</div>';
