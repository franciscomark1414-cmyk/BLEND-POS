<body>
    @Html.AntiForgeryToken()

    <div style="display: flex; flex-direction: column; height: 100vh; overflow: hidden;">

       <!-- ATTENDANCE BAR - REDESIGNED WITH LOGOUT -->
<div class="attendance-bar">
    <div class="attendance-info">
        <div class="staff-info">
            <i class="fas fa-user-circle"></i>
            <span class="staff-name">@ViewBag.StaffUsername</span>
            <span class="staff-status" id="attendanceStatusBadge">Not Clocked In</span>
        </div>
        <div class="hours-info">
            <i class="fas fa-clock"></i>
            <span id="todayHoursDisplay">0.0</span> <span>hrs today</span>
        </div>
    </div>
    <div class="attendance-buttons">
        <button id="timeInBtn" class="time-btn time-in-btn" onclick="timeIn()">
            <i class="fas fa-fingerprint"></i> TIME IN
        </button>
        <button id="timeOutBtn" class="time-btn time-out-btn" style="display:none;" onclick="timeOut()">
            <i class="fas fa-sign-out-alt"></i> TIME OUT
        </button>
        <!-- ✅ LOGOUT BUTTON - nasa tabi ng Time In/Out buttons -->
        <button id="logoutBtn" class="time-btn logout-btn" onclick="showLogoutConfirm()">
            <i class="fas fa-power-off"></i> LOGOUT
        </button>
    </div>
</div>

        <!-- POS LAYOUT -->
        <div class="pos-container" style="display: flex; flex: 1; overflow: hidden;">

            <!-- LEFT: Categories -->
            <div class="pos-categories">
                <div class="store-info">
                    <h3> Neldie's Mango & More</h3>
                    <p>Point of Sale System</p>
                </div>
                <div class="category-list">
                    <div class="category-item active" data-category="all" onclick="filterByCategory('all')">
                         All Products
                    </div>
                    @if (ViewBag.Categories != null)
                    {
                        foreach (var cat in ViewBag.Categories)
                        {
                            <div class="category-item" data-category="@cat" onclick="filterByCategory('@cat')">
                                 @cat
                            </div>
                        }
                    }
                </div>
                <!-- ORDER QUEUE -->
                <div class="order-queue">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <strong style="font-size: 12px;">
    Orders Queue
    <span id="queueCount" class="badge bg-warning">0</span>
</strong>
                        <button class="btn btn-sm btn-outline-warning p-0 px-1" onclick="refreshQueue()" style="font-size: 10px;">
                            <i class="fas fa-sync-alt"></i>
                        </button>
                    </div>
                    <div id="orderQueueList" style="max-height: 260px; overflow-y: auto;">
                        <div class="text-center text-muted small">No pending orders to blend</div>
                    </div>
                </div>
            </div>

            <!-- MIDDLE: Products -->
            <div class="pos-products">
                <div class="pos-header">
    <h2><i class="fas fa-utensils"></i> Menu</h2>
    <div class="datetime">
        <div id="currentTime">--:--:--</div>
        <div id="currentDate">--, --- --, ----</div>
    </div>
    <!-- Void/Refund button — for RETURN only after blending -->
    <button id="voidRefundBtn" class="btn btn-outline-danger btn-sm" onclick="showVoidRefundPanel()" style="font-size: 12px; border-radius: 20px; padding: 6px 14px;">
        <i class="fas fa-undo-alt"></i> Return / Refund
    </button>
</div>
<div class="products-grid" id="productsGrid">
    @if (((System.Collections.IEnumerable)Model).Cast<dynamic>().Any())
    {
        @foreach (var product in Model)
        {
            <div class="product-card" data-product-id="@product.ProductId" data-category="@product.Category" onclick="showSizeModal(@product.ProductId, '@product.Name')">
                <!-- IMAGE SECTION - MALAKI -->
                <div class="product-image-section">
                    @if (!string.IsNullOrEmpty(product.ImagePath))
                    {
                        <img src="@product.ImagePath" class="product-img" alt="@product.Name"
                             onerror="this.style.display='none'; this.parentElement.querySelector('.product-emoji').style.display='flex';">
                        <div class="product-emoji" style="display: none;">🥤</div>
                    }
                    else
                    {
                        <div class="product-emoji">🥤</div>
                    }
                </div>
                
                <!-- TEXT SECTION - MABABA LANG -->
                <div class="product-info">
                    <div class="product-name">@product.Name</div>
                    <div class="product-price">
                        ₱@GetMinPrice(product.Sizes).ToString("N2")
                        @if (GetMinPrice(product.Sizes) != GetMaxPrice(product.Sizes))
                        {
                            <small> - ₱@GetMaxPrice(product.Sizes).ToString("N2")</small>
                        }
                    </div>
                    <div class="product-hint">
                        <i class="fas fa-hand-pointer"></i> Tap to order
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div style="grid-column: 1/-1; text-align: center; padding: 50px;">
            <h4>⚠️ No products displayed in POS</h4>
            <p>Go to Owner Dashboard → Products → Click "Display in POS" to add products here.</p>
        </div>
    }
</div>          

</div>

            <!-- RIGHT: Redesigned Order Summary -->
            <div class="pos-cart">
                <div class="cart-header">
                   <h4>Order Summary</h4>
                </div>

                <!-- Cart Items -->
                <div class="cart-items" id="cartItems">
                    <div class="empty-cart">
                        <p>No items in cart</p>
                    </div>
                </div>

                <!-- Footer -->
                <div class="cart-footer">

                    <!-- Total -->
                    <div class="total-section">
                        <div class="total-row">
                            <span class="total-label">Total:</span>
                            <span class="total-amount" id="cartTotal">₱0.00</span>
                        </div>
                        <div id="discountLine" class="discount-line" style="display:none;"></div>
                    </div>

                    <!-- Discount -->
                    <div class="discount-section">
                        <div class="section-label"> Discount (Optional)</div>
                        <div class="discount-btns">
                            <button class="discount-btn-pill" id="discBtn_senior" data-discount-type="Senior Citizen" data-discount-percent="0.20" onclick="selectDiscount('Senior Citizen', 0.20)">
                                 Senior (20%)
                            </button>
                            <button class="discount-btn-pill" id="discBtn_pwd" data-discount-type="PWD" data-discount-percent="0.20" onclick="selectDiscount('PWD', 0.20)">
                                 PWD (20%)
                            </button>
                        </div>
                        <div id="selectedDiscountDisplay"></div>
                    </div>

                    <!-- Payment Section -->
<!-- Payment Section -->
<div class="payment-section">
    <div class="section-label"> Payment Method</div>
    <div class="payment-btns">
        <button class="payment-btn cash" onclick="selectPaymentMethod('Cash', this)">💵 Cash</button>
        <button class="payment-btn gcash" onclick="selectPaymentMethod('GCash', this)">📱 GCash (Redirect)</button>
        <button class="payment-btn qrph" onclick="selectPaymentMethod('QRPh', this)">📲 GCash (Scan QR)</button>
    </div>
    
    <!-- GCash Redirect Pay Button (hidden until order is created) -->
    <button id="gcashPayBtn" class="btn-refund mt-2" style="display: none; background: #007bff; color: white;" onclick="payWithGCash()">
        💳 Pay with GCash (Redirect)
    </button>
    
    <!-- QRPh Pay Button (hidden until order is created) -->
    <button id="qrphPayBtn" class="btn-refund mt-2" style="display: none; background: #28a745; color: white;" onclick="payWithQRPh()">
        📲 Pay with GCash (Scan QR)
    </button>
</div>

                    <!-- Confirm + Clear -->
                    <button class="checkout-btn" id="checkoutBtn" onclick="confirmOrder()">
                         Confirm Order
                    </button>
                    <button class="clear-cart" onclick="clearCart()">
                         Clear Cart
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- ============================================================
         MODALS (unchanged logic, only receipt modal updated)
    ============================================================ -->

