    updateExchangeSummary();
}

function toggleReturnItem(checkbox) {
    const itemDiv = checkbox.closest('.return-item-div');
    const qtyInput = itemDiv ? itemDiv.querySelector('.return-qty') : null;
    
    if (qtyInput) {
        qtyInput.disabled = !checkbox.checked;
        if (!checkbox.checked) {
            qtyInput.value = 0;
        } else {
            qtyInput.value = 1;
            qtyInput.max = parseInt(itemDiv.getAttribute('data-max-qty') || '1');
        }
        updateExchangeSummary();
    }
}

function updateReplaceQty(index, newQty) {
    if (newQty <= 0) {
        removeReplaceItem(index);
        return;
    }
    exchangeReplaceItemsData[index].quantity = newQty;
    renderReplacementItems();
    updateExchangeSummary();
}

function selectExchangePayment(method) {
    selectedExchangePayment = method;
    document.querySelectorAll('#exchangeTabContent .exchange-payment-btn').forEach(btn => {
        if (btn.getAttribute('data-method') === method) {
            btn.style.background = '#28a745';
            btn.style.color = 'white';
        } else {
            btn.style.background = 'white';
            btn.style.color = '#333';
        }
    });
    console.log('Exchange payment selected:', method);
}

// Update function to show/hide payment section based on difference
function updateExchangeSummary() {
    let returnTotal = 0;
    const returnItems = document.querySelectorAll('#exchangeReturnItems .return-item-checkbox:checked');
    
    returnItems.forEach(cb => {
        const itemDiv = cb.closest('.return-item-div');
        const qtyInput = itemDiv ? itemDiv.querySelector('.return-qty') : null;
        if (qtyInput) {
            let quantity = parseInt(qtyInput.value) || 0;
            const price = parseFloat(cb.getAttribute('data-price')) || 0;
            returnTotal += price * quantity;
        }
    });
    
    let replaceTotal = 0;
    if (typeof exchangeReplaceItemsData !== 'undefined') {
        exchangeReplaceItemsData.forEach(item => {
            replaceTotal += item.price * item.quantity;
        });
    }
    
    const priceDiff = replaceTotal - returnTotal;
    
    const returnEl = document.getElementById('exchangeTotalReturn');
    const replaceEl = document.getElementById('exchangeTotalReplace');
    const diffEl = document.getElementById('exchangePriceDiff');
    const diffTypeEl = document.getElementById('exchangeDiffType');
    const paymentSection = document.getElementById('exchangePaymentSection');
    
    if (returnEl) returnEl.innerHTML = `₱${returnTotal.toFixed(2)}`;
    if (replaceEl) replaceEl.innerHTML = `₱${replaceTotal.toFixed(2)}`;
    if (diffEl) diffEl.innerHTML = `₱${Math.abs(priceDiff).toFixed(2)}`;
    
    if (diffTypeEl) {
        if (priceDiff > 0) {
            diffTypeEl.innerHTML = '<span style="color: #dc3545;">(Customer needs to pay ₱' + priceDiff.toFixed(2) + ')</span>';
            if (paymentSection) paymentSection.style.display = 'block';
        } else if (priceDiff < 0) {
            diffTypeEl.innerHTML = '<span style="color: #28a745;">(Customer gets ₱' + Math.abs(priceDiff).toFixed(2) + ' back)</span>';
            if (paymentSection) paymentSection.style.display = 'none';
        } else {
            diffTypeEl.innerHTML = '<span style="color: #6c757d;">(No price difference)</span>';
            if (paymentSection) paymentSection.style.display = 'none';
        }
    }
}

function removeReplaceItem(index) {
    exchangeReplaceItemsData.splice(index, 1);
    renderReplacementItems();
    updateExchangeSummary();
}

function updateExchangeTotals() {
    let returnTotal = 0;
    
    // ✅ I-update ang selector para sa bagong UI structure
    const returnItems = document.querySelectorAll('#exchangeReturnItems .return-item-checkbox:checked');
    
    returnItems.forEach(cb => {
        // Hanapin ang parent div na naglalaman ng qty input
        const itemDiv = cb.closest('div[style*="background: white"]') || cb.closest('.return-item-div');
        let qtyInput = null;
        
        if (itemDiv) {
            qtyInput = itemDiv.querySelector('.return-qty');
        } else {
            // Fallback: hanapin sa parent elements
            qtyInput = cb.closest('div')?.querySelector('.return-qty');
        }
        
        if (qtyInput) {
            let quantity = parseInt(qtyInput.value) || 0;
            const price = parseFloat(cb.getAttribute('data-price')) || 0;
            if (quantity > 0) {
                returnTotal += price * quantity;
            }
        }
    });
    
    let replaceTotal = 0;
    exchangeReplaceItems.forEach(item => {
        replaceTotal += item.price * item.quantity;
    });
    
    const priceDiff = replaceTotal - returnTotal;
    const diffElement = document.getElementById('exchangePriceDiff');
    const diffTypeElement = document.getElementById('exchangeDiffType');
    const returnTotalElement = document.getElementById('exchangeTotalReturn');
    const replaceTotalElement = document.getElementById('exchangeTotalReplace');
    
    if (diffElement) diffElement.innerHTML = `₱${Math.abs(priceDiff).toFixed(2)}`;
    if (returnTotalElement) returnTotalElement.innerHTML = `₱${returnTotal.toFixed(2)}`;
    if (replaceTotalElement) replaceTotalElement.innerHTML = `₱${replaceTotal.toFixed(2)}`;
    
    if (diffTypeElement) {
        if (priceDiff > 0) {
            diffTypeElement.innerHTML = '<span class="text-danger">(Customer needs to pay ₱' + priceDiff.toFixed(2) + ')</span>';
        } else if (priceDiff < 0) {
            diffTypeElement.innerHTML = '<span class="text-success">(Customer gets ₱' + Math.abs(priceDiff).toFixed(2) + ' back)</span>';
        } else {
            diffTypeElement.innerHTML = '<span class="text-secondary">(No price difference)</span>';
        }
    }
}

async function processExchange() {
    // Collect items to return
    const itemsToReturn = [];
    const returnCheckboxes = document.querySelectorAll('#exchangeReturnItems .return-item-checkbox:checked');
    
    returnCheckboxes.forEach(cb => {
        const itemDiv = cb.closest('.return-item-div');
        const qtyInput = itemDiv ? itemDiv.querySelector('.return-qty') : null;
        const quantity = qtyInput ? parseInt(qtyInput.value) || 0 : 0;
        
        if (quantity > 0) {
            itemsToReturn.push({
                orderItemId: parseInt(cb.getAttribute('data-id')),
                productSizeId: 0,
                quantity: quantity,
                productName: cb.getAttribute('data-name'),
                sizeName: cb.getAttribute('data-size'),
                price: parseFloat(cb.getAttribute('data-price'))
            });
        }
    });
    
    if (itemsToReturn.length === 0) {
        await showAlert('Please select at least one item to return', 'No Selection', '⚠️');
        return;
    }
    
    if (exchangeReplaceItemsData.length === 0) {
        await showAlert('Please add at least one replacement item', 'No Replacement', '⚠️');
        return;
    }
    
    // Get reason
    let reason = document.getElementById('exchangeReason').value;
    if (reason === 'Other') {
        reason = document.getElementById('exchangeOtherReason').value;
        if (!reason) {
            await showAlert('Please specify the reason', 'Required', '⚠️');
            return;
        }
    }
    
    if (!reason) {
        await showAlert('Please select a reason', 'Required', '⚠️');
        return;
    }
    
    // Compute price difference
    let returnTotal = itemsToReturn.reduce((sum, i) => sum + (i.price * i.quantity), 0);
    let replaceTotal = exchangeReplaceItemsData.reduce((sum, i) => sum + (i.price * i.quantity), 0);
    const priceDiff = replaceTotal - returnTotal;
    
    // Validate payment if positive difference
    if (priceDiff > 0 && !selectedExchangePayment) {
        await showAlert('Please select a payment method for the price difference (Cash or GCash)', 'Payment Required', '⚠️');
        return;
    }
    
    const exchangePaymentMethod = (priceDiff > 0) ? selectedExchangePayment : null;
    
    // Prepare request data
    const itemsToReplace = exchangeReplaceItemsData.map(item => ({
        orderItemId: 0,
        productSizeId: item.productSizeId,
        quantity: item.quantity
    }));
    
    const requestData = {
        orderId: currentExchangeOrderId,
        itemsToReturn: itemsToReturn.map(i => ({ orderItemId: i.orderItemId, productSizeId: 0, quantity: i.quantity })),
        itemsToReplace: itemsToReplace,
        reason: reason,
        useStoreCredit: false,
        paymentForDifference: exchangePaymentMethod  // ✅ ADD PAYMENT METHOD
    };
    
    showLoading('Processing exchange...');
    
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
    
    try {
        const response = await fetch('/ReturnExchange/ProcessExchange', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token
            },
            body: JSON.stringify(requestData)
        });
        
        const data = await response.json();
        hideLoading();
        
        if (data.success) {
            // ✅ SET FLAGS FOR EXCHANGE INFO IN RECEIPT
            window.isExchangeReplacement = true;
            window.exchangeOriginalOrderId = currentExchangeOrderId;
            window.exchangeStoreCreditApplied = returnTotal;
            window.exchangeAdjustmentAmount = priceDiff;
            window.exchangeNewOrderId = data.newOrderId;
            
            // ✅ SHOW EXCHANGE SUMMARY MODAL
            await showExchangeSummaryModal({
                originalOrderId: currentExchangeOrderId,
                newOrderId: data.newOrderId,
                itemsReturned: itemsToReturn,
                itemsReplaced: exchangeReplaceItemsData,
                returnTotal: returnTotal,
                replaceTotal: replaceTotal,
                priceDiff: priceDiff,
                paymentMethod: exchangePaymentMethod,
                reason: reason,
                exchangeMessage: data.message
            });
            
            // ✅ SHOW RECEIPT FOR THE NEW ORDER
            if (data.newOrderId) {
                await showReceiptPopup(data.newOrderId);
            }
            
            // ✅ RESET CART
            cart = [];
            currentCartTotal = 0;
            currentDiscountedTotal = 0;
            updateCartDisplay();
            
            // Close the exchange modal
            closeVoidRefundModal();
            
            // Reset exchange data
            exchangeReplaceItemsData = [];
            selectedExchangePayment = null;
            document.getElementById('exchangeOrderSelect').value = '';
            document.getElementById('exchangeReturnItems').innerHTML = '<div class="text-muted text-center" style="padding: 20px;">Select an order first</div>';
            renderReplacementItems();
            updateExchangeSummary();
            
            // Reset payment button highlights
            document.querySelectorAll('#exchangeTabContent .exchange-payment-btn').forEach(btn => {
                btn.style.background = 'white';
                btn.style.color = '#333';
            });
            
            // Refresh orders queue
            await loadOrderQueue();
            
        } else {
            await showAlert('❌ ' + data.message, 'Exchange Failed', '❌');
        }
    } catch (error) {
        hideLoading();
        console.error('Exchange error:', error);
        await showAlert('❌ Error: ' + error.message, 'Error', '❌');
    }
}
