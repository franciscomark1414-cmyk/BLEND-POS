@{
    ViewBag.Title = "Point of Sale";
    Layout = null;
}

@functions {
    private decimal GetMinPrice(object sizes)
    {
        if (sizes == null) return 0;
        var sizesList = sizes as IEnumerable<dynamic>;
        if (sizesList == null || !sizesList.Any()) return 0;
        decimal min = decimal.MaxValue;
        foreach (var size in sizesList)
        {
            decimal price = Convert.ToDecimal(size.Price);
            if (price < min) min = price;
        }
        return min;
    }

    private decimal GetMaxPrice(object sizes)
    {
        if (sizes == null) return 0;
        var sizesList = sizes as IEnumerable<dynamic>;
        if (sizesList == null || !sizesList.Any()) return 0;
        decimal max = 0;
        foreach (var size in sizesList)
        {
            decimal price = Convert.ToDecimal(size.Price);
            if (price > max) max = price;
        }
        return max;
    }

    private int GetTotalStock(object sizes)
    {
        if (sizes == null) return 0;
        var sizesList = sizes as IEnumerable<dynamic>;
        if (sizesList == null || !sizesList.Any()) return 0;
        int total = 0;
        foreach (var size in sizesList)
        {
            total += Convert.ToInt32(size.Stock);
        }
        return total;
    }
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
    <meta http-equiv="Pragma" content="no-cache">
    <meta http-equiv="Expires" content="0">
    <title>Neldie's Mango & More - POS</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            background: #f5f5f5;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            height: 100vh;
            overflow: hidden;
        }

        .pos-container {
            display: flex;
            height: 100vh;
            width: 100%;
        }

        .pos-categories {
            width: 220px;
            background: white;
            border-right: 1px solid #e0e0e0;
            display: flex;
            flex-direction: column;
            box-shadow: 2px 0 5px rgba(0,0,0,0.05);
            flex-shrink: 0;
        }

        .store-info {
            padding: 16px;
            background: #ff6b35;
            color: white;
            text-align: center;
        }
        .store-info h3 { font-size: 16px; margin-bottom: 3px; }
        .store-info p { font-size: 11px; opacity: 0.9; }

        .category-list { flex: 1; padding: 8px 0; overflow-y: auto; }

        .category-item {
