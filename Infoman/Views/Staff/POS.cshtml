    <script>
                // Cart array
        let cart = [];

        // Variables for modal
        let modalQuantity = 1;
        let currentMaxOrders = 0;
        let currentDiscountType = 'None';
        let currentDiscountPercent = 0;
        let currentCartTotal = 0;
        let currentDiscountedTotal = 0;
        let tempSelectedSize = null;
        let pendingPaymentMethod = null;
        let currentVoidOrderId = null;
        let currentRefundOrderId = null;
        let pendingOwnerAction = null;
        let pendingOwnerData = null;
    let queueRefreshInterval = null;

        // Show Size Modal
              // Show Size Modal

    // ========== ORDER QUEUE FUNCTIONS ==========

        async function loadOrderQueue() {
        try {
        const response = await fetch('/Staff/GetActiveOrders');
        const orders = await response.json();
        
        const container = document.getElementById('orderQueueList');
        const countSpan = document.getElementById('queueCount');
        
        if (!container) return;
        
        // ✅ FILTER: Ipakita lang ang mga PENDING_PAYMENT (hindi pa nabe-blend)
        const pendingOrders = orders.filter(o => o.status === 'PENDING_PAYMENT');
        
        if (countSpan) countSpan.innerText = pendingOrders.length;
        
        if (pendingOrders.length === 0) {
        container.innerHTML = '<div class="text-center text-muted small">No pending orders to blend</div>';
        return;
        }
        
        let html = '';
        
        pendingOrders.forEach(order => {
        let itemsHtml = '';
        order.items.forEach(item => {
        itemsHtml += `<div>• ${item.quantity}x ${item.productName} (${item.sizeName})</div>`;
        });
            
        html += `
        <div class="queue-item" data-order-id="${order.orderId}" style="background: #fff8e7; border-left-color: #ffc107;">
        <div class="d-flex justify-content-between align-items-center">
        <span class="queue-order-number">#${order.orderNumber}</span>
        <span class="badge bg-warning" style="font-size: 9px;">PENDING</span>
        </div>
        <div class="queue-items">
        ${itemsHtml}
        </div>
        <div class="d-flex justify-content-between align-items-center mt-1">
        <span class="queue-total">₱${order.totalAmount.toFixed(2)}</span>
        <button class="btn btn-warning btn-sm queue-btn" onclick="startBlendingFromQueue(${order.orderId})">
        <i class="fas fa-blender"></i> Start Blending
        </button>
        </div>
        </div>
        `;
        });
        
        container.innerHTML = html;
        
        } catch (error) {
        console.error('Error loading queue:', error);
        const container = document.getElementById('orderQueueList');
        if (container) container.innerHTML = '<div class="text-center text-danger small">Error loading orders</div>';
        }
        }

    async function startBlendingFromQueue(orderId) {
    if (!confirm(`Start blending order #${orderId}?\n\nIngredients will be deducted from inventory.`)) {
    return;
    }
    
    const btn = event.target.closest('button');
    const originalText = btn.innerHTML;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';
    btn.disabled = true;
    
    try {
    const response = await fetch('/Staff/StartBlending', {
    method: 'POST',
    headers: {
    'Content-Type': 'application/json',
    'RequestVerificationToken': getToken()
    },
    body: JSON.stringify({ orderId: orderId })
    });
        
    const data = await response.json();
        
    if (data.success) {
    alert('✅ ' + data.message);
    await loadOrderQueue(); // Refresh the queue
    // Also refresh the counter in cart footer if exists
    const countSpan = document.getElementById('pendingOrderCount');
    if (countSpan) {
    const queueResponse = await fetch('/Staff/GetActiveOrders');
    const orders = await queueResponse.json();
    const pendingCount = orders.filter(o => o.status === 'PENDING_PAYMENT').length;
    countSpan.innerText = pendingCount;
    }
    } else {
    alert('❌ Error: ' + data.message);
    btn.innerHTML = originalText;
    btn.disabled = false;
    }
    } catch (error) {
    alert('❌ Error: ' + error.message);
    btn.innerHTML = originalText;
    btn.disabled = false;
    }
    }

    function refreshQueue() {
    loadOrderQueue();
    }

    // Start auto-refresh queue every 5 seconds
    if (document.getElementById('orderQueueList')) {
    loadOrderQueue();
    setInterval(loadOrderQueue, 5000);
    }

              async function showSizeModal(productId, productName) {
            const response = await fetch(`/Staff/GetProductWithSizes?productId=${productId}`);
            const data = await response.json();

            console.log('API Response:', data);

            if (!data.success) {
                alert('Error loading product sizes');
                return;
            }

            document.getElementById('sizeModalProductName').innerText = data.productName;

            let sizesHtml = '';
            for (const size of data.sizes) {
                const stockValue = size.stock;
                const stockStatus = stockValue > 0 ? `✅ Stock: ${stockValue}` : '❌ Out of Stock';
                const disabledClass = stockValue <= 0 ? 'opacity-50' : '';

                sizesHtml += `
                    <div class="size-option ${disabledClass}" style="border: 1px solid #ddd; border-radius: 12px; padding: 15px; margin-bottom: 10px; cursor: ${stockValue > 0 ? 'pointer' : 'not-allowed'};"
                         onclick="${stockValue > 0 ? `selectSize(${size.productSizeId}, '${size.sizeName}', ${size.price}, ${stockValue})` : ''}">
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <div>
                                <strong style="font-size: 16px;">${size.sizeName}</strong>
                                <div style="font-size: 12px; color: #666;">${stockStatus}</div>
                            </div>
                            <div style="font-size: 20px; font-weight: bold; color: #ff6b35;">₱${size.price.toFixed(2)}</div>
                        </div>
                    </div>
                `;
            }

            document.getElementById('sizeOptionsList').innerHTML = sizesHtml;
            document.getElementById('sizeModal').style.display = 'flex';
        }

        function closeSizeModal() {
            document.getElementById('sizeModal').style.display = 'none';
        }

        function selectSize(productSizeId, sizeName, price, stock) {
            tempSelectedSize = {
                productSizeId: productSizeId,
                sizeName: sizeName,
                price: price,
                stock: stock
            };
            modalQuantity = 1;
            document.getElementById('modalProductName').innerHTML = `${sizeName} - ₱${price.toFixed(2)}`;
            document.getElementById('modalQty').innerHTML = '1';
            document.getElementById('quantityModal').style.display = 'flex';
            closeSizeModal();
            checkMaxAvailability();
        }

        async function checkMaxAvailability() {
            if (!tempSelectedSize) return;
            const response = await fetch(`/Staff/CheckAvailability?productSizeId=${tempSelectedSize.productSizeId}&quantity=1`);
            const data = await response.json();
            currentMaxOrders = data.maxPossibleOrders || 0;
        }

        function decrementModalQty() {
            if (modalQuantity > 1) {
                modalQuantity--;
                document.getElementById('modalQty').innerHTML = modalQuantity;
            }
        }

        function incrementModalQty() {
            if (modalQuantity < currentMaxOrders) {
                modalQuantity++;
                document.getElementById('modalQty').innerHTML = modalQuantity;
            } else if (currentMaxOrders > 0) {
                alert(`Maximum available is ${currentMaxOrders} order(s).`);
            }
        }

        function closeQuantityModal() {
            document.getElementById('quantityModal').style.display = 'none';
            tempSelectedSize = null;
        }

        async function confirmAddToCart() {
            if (!tempSelectedSize) return;

            const response = await fetch(`/Staff/CheckAvailability?productSizeId=${tempSelectedSize.productSizeId}&quantity=${modalQuantity}`);
            const data = await response.json();

            if (!data.available) {
                alert(`❌ Cannot add to cart:\n${data.message}`);
                closeQuantityModal();
                tempSelectedSize = null;
                return;
            }

            const existingIndex = cart.findIndex(item => item.productSizeId === tempSelectedSize.productSizeId);
            if (existingIndex !== -1) {
                cart[existingIndex].quantity += modalQuantity;
            } else {
                cart.push({
                    productSizeId: tempSelectedSize.productSizeId,
                    productName: document.getElementById('sizeModalProductName').innerText,
                    sizeName: tempSelectedSize.sizeName,
                    price: tempSelectedSize.price,
                    quantity: modalQuantity
                });
            }

            updateCartDisplay();
            closeQuantityModal();
            tempSelectedSize = null;
        }

                       function updateCartDisplay() {
            const cartDiv = document.getElementById('cartItems');
            const totalSpan = document.getElementById('cartTotal');

            if (cart.length === 0) {
                cartDiv.innerHTML = '<div class="empty-cart"><div style="font-size: 48px; margin-bottom: 10px;">🛍️</div><p>No items in cart</p></div>';
                totalSpan.innerHTML = '₱0.00';
        currentDiscountType = 'None';
        currentDiscountPercent = 0;
        currentDiscountedTotal = 0;
        document.getElementById('selectedDiscountDisplay').innerHTML = '';
        updateDiscountPanelHighlight();
        return;
            }

            let html = '';
            let total = 0;

            cart.forEach((item, index) => {
                const itemTotal = item.price * item.quantity;
                total += itemTotal;
                html += `
                    <div class="cart-item">
                        <div class="cart-item-info">
                            <div class="cart-item-name">${escapeHtml(item.productName)}</div>
                            <div class="cart-item-size">${item.sizeName}</div>
                            <div class="cart-item-price">₱${item.price.toFixed(2)}</div>
                        </div>
                        <div class="cart-item-qty">
                            <button class="qty-btn" onclick="updateCartItemQty(${index}, ${item.quantity - 1})">-</button>
                            <span>${item.quantity}</span>
                            <button class="qty-btn" onclick="updateCartItemQty(${index}, ${item.quantity + 1})">+</button>
                        </div>
                        <div class="cart-item-total">
                            ₱${itemTotal.toFixed(2)}
                        </div>
                        <div class="remove-item" onclick="removeFromCart(${index})">✕</div>
                    </div>
                `;
            });

            currentCartTotal = total;
            currentDiscountedTotal = total * (1 - currentDiscountPercent);

            cartDiv.innerHTML = html;

            let discountText = '';
            if (currentDiscountPercent > 0) {
                discountText = `<small style="font-size: 11px; color: #dc3545;"> (${currentDiscountPercent * 100}% off - ${currentDiscountType})</small>`;
            }
            totalSpan.innerHTML = `₱${currentDiscountedTotal.toFixed(2)}${discountText}`;
        }

                function updateDiscountPanelHighlight() {
            const discountBtns = document.querySelectorAll('#discountPanel .discount-btn');
            discountBtns.forEach(btn => {
                btn.classList.remove('btn-warning');
                btn.classList.add('btn-outline-primary');

                const btnType = btn.getAttribute('data-discount-type');
                const btnPercent = parseFloat(btn.getAttribute('data-discount-percent') || 0);

                if (currentDiscountType === btnType && currentDiscountPercent === btnPercent) {
                    btn.classList.remove('btn-outline-primary');
                    btn.classList.add('btn-warning');
                }
            });

            const displayDiv = document.getElementById('selectedDiscountDisplay');
            if (currentDiscountPercent > 0) {
                displayDiv.innerHTML = `<span class="text-success">✓ ${currentDiscountType} (${currentDiscountPercent * 100}% discount applied)</span>`;
            } else {
                displayDiv.innerHTML = '';
            }
        }

        async function updateCartItemQty(index, newQty) {
            if (newQty <= 0) {
                removeFromCart(index);
                return;
            }

            const item = cart[index];
            const response = await fetch(`/Staff/CheckAvailability?productSizeId=${item.productSizeId}&quantity=${newQty}`);
            const data = await response.json();

            if (!data.available) {
                alert(`❌ Cannot update quantity:\n${data.message}`);
                return;
            }

            cart[index].quantity = newQty;
            updateCartDisplay();
        }

        function removeFromCart(index) {
            cart.splice(index, 1);
            updateCartDisplay();
        }

                function clearCart() {
            if (cart.length === 0) return;
            if (confirm('Clear all items from cart?')) {
                cart = [];
                currentDiscountType = 'None';
                currentDiscountPercent = 0;
                pendingPaymentMethod = null;
                updateCartDisplay();
            }
        }
        
        function confirmOrder() {
            // This function is now handled by prepareCheckout() and showReviewModal()
            // Keep this as a fallback
            if (cart.length === 0) {
                alert('Cart is empty!');
                return;
            }
            prepareCheckout();
        }


        function getToken() {
            const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            return tokenInput ? tokenInput.value : '';
        }

        function updateDateTime() {
            const now = new Date();
            const timeEl = document.getElementById('currentTime');
            const dateEl = document.getElementById('currentDate');
            if (timeEl) timeEl.innerHTML = now.toLocaleTimeString();
            if (dateEl) {
                dateEl.innerHTML = now.toLocaleDateString('en-US', {
                    weekday: 'short',
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric'
                });
            }
        }
        setInterval(updateDateTime, 1000);
        updateDateTime();

        // Attendance Functions
        function checkAttendanceStatus() {
            fetch('/Staff/GetTodayAttendance')
                .then(res => res.json())
                .then(data => {
                    const timeInBtn = document.getElementById('timeInBtn');
                    const timeOutBtn = document.getElementById('timeOutBtn');
                    const statusBadge = document.getElementById('attendanceStatusBadge');
                    const hoursDisplay = document.getElementById('todayHoursDisplay');
                    if (data.isClockedIn) {
                        timeInBtn.style.display = 'none';
                        timeOutBtn.style.display = 'inline-block';
                        statusBadge.className = 'badge bg-success ms-2';
                        statusBadge.innerText = '🟢 Clocked In';
                        if (hoursDisplay) hoursDisplay.innerText = data.hoursToday;
                    } else if (data.hasClockedOut) {
                        timeInBtn.style.display = 'none';
                        timeOutBtn.style.display = 'none';
                        statusBadge.className = 'badge bg-secondary ms-2';
                        statusBadge.innerText = '🔴 Completed';
                        if (hoursDisplay) hoursDisplay.innerText = data.hoursToday;
                    } else {
                        timeInBtn.style.display = 'inline-block';
                        timeOutBtn.style.display = 'none';
                        statusBadge.className = 'badge bg-secondary ms-2';
                        statusBadge.innerText = '⭕ Not Clocked In';
                        if (hoursDisplay) hoursDisplay.innerText = '0.0';
                        showAttendanceReminder();
                    }
                });
        }

        let reminderShown = false;
        function showAttendanceReminder() {
            if (reminderShown) return;
            reminderShown = true;
            const modal = new bootstrap.Modal(document.getElementById('attendanceReminderModal'));
            modal.show();
            setTimeout(() => { reminderShown = false; checkAttendanceStatus(); }, 300000);
        }

        function timeInFromReminder() {
            const modal = bootstrap.Modal.getInstance(document.getElementById('attendanceReminderModal'));
            modal.hide();
            timeIn();
        }

        function timeIn() {
            fetch('/Staff/TimeIn', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getToken() }
            })
            .then(res => res.json())
            .then(data => { if (data.success) { alert(data.message); checkAttendanceStatus(); } else { alert('❌ ' + data.message); } });
        }

        function timeOut() {
            if (!confirm('End your shift?')) return;
            fetch('/Staff/TimeOut', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getToken() }
            })
            .then(res => res.json())
            .then(data => { if (data.success) { alert(data.message); checkAttendanceStatus(); } else { alert('❌ ' + data.message); } });
        }

        function filterByCategory(category) {
            document.querySelectorAll('.category-item').forEach(item => item.classList.remove('active'));
            event.target.classList.add('active');
            document.querySelectorAll('.product-card').forEach(product => {
                const productCategory = product.getAttribute('data-category');
                product.style.display = (category === 'all' || productCategory === category) ? '' : 'none';
            });
        }
                // ========== NEW FUNCTIONS ==========

               function selectDiscount(type, percent) {
            // Kung same discount ang pinili, i-remove (toggle off)
            if (currentDiscountType === type && currentDiscountPercent === percent) {
                currentDiscountType = 'None';
                currentDiscountPercent = 0;
            } else {
                currentDiscountType = type;
                currentDiscountPercent = percent;
            }

            currentDiscountedTotal = currentCartTotal * (1 - currentDiscountPercent);
            updateCartDisplay();
            updateDiscountPanelHighlight();
        }

                function prepareCheckout() {
            if (cart.length === 0) {
                alert('Cart is empty!');
                return;
            }

            // I-store ang napiling payment method
            const btn = event.target;
            if (btn.innerText.includes('Cash')) {
                pendingPaymentMethod = 'Cash';
            } else if (btn.innerText.includes('GCash')) {
                pendingPaymentMethod = 'GCash';
            }

            // Ipakita ang review modal para i-double check
            showReviewModal();
        }
                         async function processFinalOrder() {
    const paymentMethod = pendingPaymentMethod;
    closeReviewModal();

    const checkoutBtn = document.getElementById('checkoutBtn');
    const originalText = checkoutBtn.innerHTML;
    checkoutBtn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Processing...';
    checkoutBtn.disabled = true;

    const token = getToken();
    let orderDetails = [];
    let lastOrderId = null;
    let allSuccessful = true;

    try {
        for (const item of cart) {
            const response = await fetch('/Staff/PlaceOrder', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify({
                    productSizeId: item.productSizeId,
                    quantity: item.quantity,
                    orderNumber: `POS-${Date.now()}`,
                    paymentMethod: paymentMethod,
                    discountType: currentDiscountType,
                    discountPercent: currentDiscountPercent
                })
            });

            const data = await response.json();
            if (!data.success) {
                allSuccessful = false;
                alert(`❌ Error with ${item.productName}: ${data.message}`);
                break;
            }
            lastOrderId = data.orderId;  // ← Kunin ang orderId
            orderDetails.push({
                name: item.productName,
                size: item.sizeName,
                quantity: item.quantity,
                price: item.price,
                subtotal: item.price * item.quantity
            });
        }

        if (allSuccessful && orderDetails.length > 0) {
            const discountSavings = currentCartTotal - currentDiscountedTotal;
            
            // ✅ Pass the orderId to receipt modal
            showReceiptModal(
                orderDetails, 
                paymentMethod, 
                currentDiscountType, 
                currentDiscountPercent, 
                discountSavings, 
                currentDiscountedTotal,
                lastOrderId,      // ← ORDER ID
                'PENDING_PAYMENT'
            );

            cart = [];
            currentDiscountType = 'None';
            currentDiscountPercent = 0;
            pendingPaymentMethod = null;
            updateCartDisplay();
        }
    } catch (error) {
        alert('❌ Error processing order: ' + error.message);
    } finally {
        checkoutBtn.innerHTML = originalText;
        checkoutBtn.disabled = false;
    }
}

        async function startBlending(orderId) {
            if (!confirm('⚠️ START BLENDING?\n\nOnce you click OK:\n• Ingredients will be DEDUCTED from inventory\n• This action cannot be undone without Owner approval\n\nContinue?')) {
                return;
            }

            const btn = document.getElementById('startBlendingBtn');
            const originalText = btn.innerHTML;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Processing...';
            btn.disabled = true;

            try {
                const response = await fetch('/Staff/StartBlending', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': getToken()
                    },
                    body: JSON.stringify({ orderId: orderId })
                });

                const data = await response.json();

                if (data.success) {
                    alert('✅ ' + data.message);
                    btn.innerHTML = '✅ Blending Started!';
                    btn.classList.remove('btn-warning');
                    btn.classList.add('btn-success');
                    btn.disabled = true;

                    // Update receipt status
                    const statusBadge = document.querySelector('#receiptContent .badge');
                    if (statusBadge) {
                        statusBadge.innerText = 'COMPLETED';
                        statusBadge.classList.remove('bg-warning');
                        statusBadge.classList.add('bg-success');
                    }

                    // Auto-close after 3 seconds
                    setTimeout(() => {
                        closeReceiptModal();
                    }, 3000);
                } else {
                    alert('❌ Error: ' + data.message);
                    btn.innerHTML = originalText;
                    btn.disabled = false;
                }
            } catch (error) {
                alert('❌ Error: ' + error.message);
                btn.innerHTML = originalText;
                btn.disabled = false;
            }
        }

async function processOrder(paymentMethod) {
            if (cart.length === 0) {
                alert('Cart is empty!');
                return;
            }

            const checkoutBtn = document.getElementById('checkoutBtn');
            const originalText = checkoutBtn.innerHTML;
            checkoutBtn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Processing...';
            checkoutBtn.disabled = true;

            const token = getToken();
            let orderDetails = [];
            let allSuccessful = true;

            try {
                for (const item of cart) {
                    const response = await fetch('/Staff/PlaceOrder', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': token
                        },
                        body: JSON.stringify({
                            productSizeId: item.productSizeId,
                            quantity: item.quantity,
                            orderNumber: `POS-${Date.now()}`
                        })
                    });

                    const data = await response.json();
                    if (!data.success) {
                        allSuccessful = false;
                        showConfirmationPanel(null, null, null, null, 0, 0, `❌ Error: ${data.message}`);
                        break;
                    }
                    orderDetails.push({
                        name: item.productName,
                        size: item.sizeName,
                        quantity: item.quantity,
                        price: item.price,
                        subtotal: item.price * item.quantity
                    });
                }

                if (allSuccessful && orderDetails.length > 0) {
                    const discountSavings = currentCartTotal - currentDiscountedTotal;

                    // Show confirmation panel
                    showConfirmationPanel(orderDetails, paymentMethod, currentDiscountType, currentDiscountPercent, discountSavings, currentDiscountedTotal);

                    // Show receipt popup
                    showReceiptModal(orderDetails, paymentMethod, currentDiscountType, currentDiscountPercent, discountSavings, currentDiscountedTotal);

                    // Clear cart and reset discount
                    cart = [];
                    currentDiscountType = 'None';
                    currentDiscountPercent = 0;
                    updateCartDisplay();
                }
            } catch (error) {
                showConfirmationPanel(null, null, null, null, 0, 0, `❌ Error: ${error.message}`);
            } finally {
                checkoutBtn.innerHTML = originalText;
                checkoutBtn.disabled = false;
            }
        }

        function showConfirmationPanel(orderDetails, paymentMethod, discountType, discountPercent, discountSavings, total, errorMessage) {
            const panel = document.getElementById('confirmationPanel');
            const detailsDiv = document.getElementById('confirmationDetails');

            if (!panel || !detailsDiv) return;

            if (errorMessage) {
                detailsDiv.innerHTML = `
                    <div style="color: #721c24;">
                        <strong>${escapeHtml(errorMessage)}</strong>
                    </div>
                `;
            } else {
                let itemsHtml = '';
                orderDetails.forEach(item => {
                    itemsHtml += `
                        <div class="confirmation-item">
                            <div>
                                <strong>${escapeHtml(item.name)}</strong>
                                <small>(${item.size})</small>
                                <div style="font-size: 11px; color: #666;">x${item.quantity}</div>
                            </div>
                            <div>₱${item.subtotal.toFixed(2)}</div>
                        </div>
                    `;
                });

                let discountHtml = '';
                if (discountPercent > 0) {
                    discountHtml = `
                        <div style="display: flex; justify-content: space-between; font-size: 13px; color: #dc3545; margin-top: 8px;">
                            <span>Discount (${discountType} ${discountPercent * 100}%):</span>
                            <span>-₱${discountSavings.toFixed(2)}</span>
                        </div>
                    `;
                }

                detailsDiv.innerHTML = `
                    <div style="margin-bottom: 8px;">
                        <small>💰 Payment: ${paymentMethod}</small>
                        <small class="float-end">${new Date().toLocaleTimeString()}</small>
                    </div>
                    ${itemsHtml}
                    <div style="margin-top: 8px; padding-top: 8px; border-top: 1px solid #c3e6cb;">
                        <div style="display: flex; justify-content: space-between;">
                            <strong>Subtotal:</strong>
                            <strong>₱${currentCartTotal.toFixed(2)}</strong>
                        </div>
                        ${discountHtml}
                        <div style="display: flex; justify-content: space-between; margin-top: 8px;">
                            <strong style="font-size: 14px;">TOTAL PAID:</strong>
                            <strong style="font-size: 14px; color: #155724;">₱${total.toFixed(2)}</strong>
                        </div>
                    </div>
                    <div style="margin-top: 10px; text-align: center;">
                        <small class="text-muted">📱 Receipt has been generated</small>
                    </div>
                `;
            }

            panel.style.display = 'block';

            // Auto-hide after 8 seconds
            setTimeout(() => {
                if (panel && panel.style.display === 'block') {
                    panel.style.display = 'none';
                }
            }, 8000);
        }

        function hideConfirmationPanel() {
            const panel = document.getElementById('confirmationPanel');
            if (panel) panel.style.display = 'none';
        }

                    function showReceiptModal(orderDetails, paymentMethod, discountType, discountPercent, discountSavings, total, orderId, orderStatus) {
            const receiptDiv = document.getElementById('receiptContent');
            const now = new Date();

            // Store order ID for actions
            if (orderId) {
                window.currentOrderId = orderId;
            }

            let itemsHtml = '';
            orderDetails.forEach(item => {
                itemsHtml += `
                    <div class="receipt-item">
                        <div>
                            <strong>${escapeHtml(item.name)}</strong><br>
                            <small>${item.size} × ${item.quantity}</small>
                        </div>
                        <div>₱${item.subtotal.toFixed(2)}</div>
                    </div>
                `;
            });

            let discountHtml = '';
            if (discountPercent > 0) {
                discountHtml = `
                    <div class="receipt-discount">
                        <span>${discountType} (${discountPercent * 100}% OFF)</span>
                        <span>-₱${discountSavings.toFixed(2)}</span>
                    </div>
                `;
            }

            receiptDiv.innerHTML = `
                <div class="receipt-header">
                    <div><strong>${now.toLocaleDateString()}</strong></div>
                    <div>${now.toLocaleTimeString()}</div>
                    <div><small>Order #: ${orderId || 'N/A'}</small></div>
                </div>
                <div style="margin-bottom: 10px;">
                    <strong>Order Summary</strong>
                    <span class="badge bg-warning ms-2">PENDING BLENDING</span>
                </div>
                ${itemsHtml}
                <div class="receipt-subtotal">
                    <span>Subtotal</span>
                    <span>₱${currentCartTotal.toFixed(2)}</span>
                </div>
                ${discountHtml}
                <div class="receipt-total">
                    <span>TOTAL PAID</span>
                    <span>₱${total.toFixed(2)}</span>
                </div>
                <div style="margin-top: 15px; text-align: center; padding-top: 10px; border-top: 1px dashed #ccc;">
                    <div>Payment: <strong>${paymentMethod}</strong></div>
                    <div style="margin-top: 5px;">✅ Payment Received: ₱${total.toFixed(2)}</div>
                    <hr>
                    <button id="startBlendingBtn" class="btn btn-warning btn-sm w-100" onclick="startBlending(${orderId})">
                        🥤 START BLENDING (Deduct Ingredients)
                    </button>
                    <small class="text-muted d-block mt-1">⚠️ Click this ONLY when you start preparing/blending the order.<br>Once clicked, ingredients will be deducted and cannot be undone without Owner approval.</small>
                </div>
            `;

            document.getElementById('receiptModal').style.display = 'flex';
        }
                function closeReceiptModal() {
            document.getElementById('receiptModal').style.display = 'none';
        }

        function escapeHtml(str) {
            if (!str) return '';
            return String(str).replace(/[&<>]/g, function(m) {
                if (m === '&') return '&amp;';
                if (m === '<') return '&lt;';
                if (m === '>') return '&gt;';
                return m;
            });
        }

                function showReviewModal() {
            const reviewDiv = document.getElementById('reviewOrderContent');
            const now = new Date();

            let itemsHtml = '';
            cart.forEach((item, index) => {
                itemsHtml += `
                    <div style="display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid #eee;">
                        <div>
                            <strong>${escapeHtml(item.productName)}</strong><br>
                            <small>${item.sizeName} × ${item.quantity}</small>
                        </div>
                        <div>₱${(item.price * item.quantity).toFixed(2)}</div>
                    </div>
                `;
            });

            let discountHtml = '';
            let discountSavings = 0;
            if (currentDiscountPercent > 0) {
                discountSavings = currentCartTotal - currentDiscountedTotal;
                discountHtml = `
                    <div style="display: flex; justify-content: space-between; padding: 8px 0; color: #dc3545;">
                        <span>Discount (${currentDiscountType} ${currentDiscountPercent * 100}%):</span>
                        <span>-₱${discountSavings.toFixed(2)}</span>
                    </div>
                `;
            }

            reviewDiv.innerHTML = `
                <div style="margin-bottom: 15px; padding-bottom: 10px; border-bottom: 1px solid #ddd;">
                    <small>${now.toLocaleDateString()} ${now.toLocaleTimeString()}</small>
                    <div><strong>Payment Method:</strong> ${pendingPaymentMethod}</div>
                </div>
                ${itemsHtml}
                <div style="margin-top: 10px; padding-top: 10px; border-top: 2px solid #ddd;">
                    <div style="display: flex; justify-content: space-between;">
                        <strong>Subtotal:</strong>
                        <strong>₱${currentCartTotal.toFixed(2)}</strong>
                    </div>
                    ${discountHtml}
                    <div style="display: flex; justify-content: space-between; margin-top: 10px; padding-top: 10px; border-top: 2px solid #333;">
                        <strong style="font-size: 16px;">TOTAL:</strong>
                        <strong style="font-size: 16px; color: #28a745;">₱${currentDiscountedTotal.toFixed(2)}</strong>
                    </div>
                </div>
            `;

            document.getElementById('reviewOrderModal').style.display = 'flex';
        }

                        function closeReviewModal() {
            document.getElementById('reviewOrderModal').style.display = 'none';
            // pendingPaymentMethod = null;  
        }

        // Initialize
        document.addEventListener('DOMContentLoaded', function() {
            checkAttendanceStatus();
        });

                function showVoidRefundPanel() {
            document.getElementById('voidRefundModal').style.display = 'flex';
            loadPendingOrdersForVoid();
        }

        function closeVoidRefundModal() {
            document.getElementById('voidRefundModal').style.display = 'none';
            document.getElementById('ownerApprovalModal').style.display = 'none';
        }

        function closeOwnerApprovalModal() {
            document.getElementById('ownerApprovalModal').style.display = 'none';
        }

        function switchVoidTab(tab) {
            const voidTab = document.getElementById('voidTabContent');
            const refundTab = document.getElementById('refundTabContent');
            const voidBtn = document.getElementById('voidTabBtn');
            const refundBtn = document.getElementById('refundTabBtn');

            if (tab === 'void') {
                voidTab.style.display = 'block';
                refundTab.style.display = 'none';
                voidBtn.classList.add('active');
                refundBtn.classList.remove('active');
                loadPendingOrdersForVoid();
            } else {
                voidTab.style.display = 'none';
                refundTab.style.display = 'block';
                voidBtn.classList.remove('active');
                refundBtn.classList.add('active');
                loadCompletedOrdersForRefund();
            }
        }

        // Event listeners
        document.addEventListener('DOMContentLoaded', function() {
            const voidReason = document.getElementById('voidReason');
            if (voidReason) {
                voidReason.addEventListener('change', function() {
                    const otherInput = document.getElementById('voidOtherReason');
                    otherInput.style.display = this.value === 'Other' ? 'block' : 'none';
                });
            }

            const refundReason = document.getElementById('refundReason');
            if (refundReason) {
                refundReason.addEventListener('change', function() {
                    const otherInput = document.getElementById('refundOtherReason');
                    otherInput.style.display = this.value === 'Other' ? 'block' : 'none';
                });
            }

            // Add Void/Refund button
            const header = document.querySelector('.pos-header');
            if (header && !document.getElementById('voidRefundBtn')) {
                const btn = document.createElement('button');
                btn.id = 'voidRefundBtn';
                btn.className = 'btn btn-outline-danger ms-2';
                btn.innerHTML = '<i class="fas fa-ban"></i> Void / Refund';
                btn.onclick = showVoidRefundPanel;
                header.appendChild(btn);
            }
        });

        function getToken() {
            return document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        }

        async function loadPendingOrdersForVoid() {
            try {
                const response = await fetch('/VoidRefund/GetPendingOrders');
                const orders = await response.json();
                const select = document.getElementById('voidOrderSelect');
                select.innerHTML = '<option value="">-- Select Order --</option>';
                orders.forEach(order => {
                    select.innerHTML += `<option value="${order.orderId}">#${order.orderNumber} - ${order.status} - ₱${order.totalAmount.toFixed(2)}</option>`;
                });
            } catch (error) {
                console.error('Error:', error);
            }
        }

        async function loadCompletedOrdersForRefund() {
            try {
                const response = await fetch('/VoidRefund/GetCompletedOrders');
                const orders = await response.json();
                const select = document.getElementById('refundOrderSelect');
                select.innerHTML = '<option value="">-- Select Order --</option>';
                orders.forEach(order => {
                    select.innerHTML += `<option value="${order.orderId}">#${order.orderNumber} - ₱${order.totalAmount.toFixed(2)}</option>`;
                });
            } catch (error) {
                console.error('Error:', error);
            }
        }

        async function loadVoidOrderItems() {
            const orderId = document.getElementById('voidOrderSelect').value;
            if (!orderId) return;
            currentVoidOrderId = parseInt(orderId);

            try {
                const response = await fetch(`/VoidRefund/GetOrderDetails?orderId=${orderId}`);
                const data = await response.json();
                if (!data.success) { alert(data.message); return; }

                const container = document.getElementById('voidOrderItems');
                let html = '<table class="table table-sm table-bordered"><thead><tr><th>Select</th><th>Product</th><th>Qty</th><th>Price</th><th>Status</th></tr></thead><tbody>';

                data.order.items.forEach(item => {
                    if (!item.isVoided && !item.isRefunded) {
                        let statusText = data.order.status === 'PREPARING' ? 'PREPARING' : (data.order.status === 'COMPLETED' ? 'COMPLETED' : 'PENDING');
                        html += `<tr>
                            <td class="text-center"><input type="checkbox" class="void-item-checkbox" value="${item.orderItemId}"></td>
                            <td><strong>${escapeHtml(item.productName)}</strong><br><small>${item.sizeName}</small></td>
                            <td>${item.quantity}</td>
                            <td>₱${item.price.toFixed(2)}</td>
                            <td><span class="badge ${data.order.status === 'PREPARING' ? 'bg-warning' : 'bg-secondary'}">${statusText}</span></td>
                        </tr>`;
                    }
                });
                html += `</tbody></table>`;
                container.innerHTML = html;
            } catch (error) {
                console.error('Error:', error);
            }
        }

        async function loadRefundOrderItems() {
            const orderId = document.getElementById('refundOrderSelect').value;
            if (!orderId) return;
            currentRefundOrderId = parseInt(orderId);

            try {
                const response = await fetch(`/VoidRefund/GetOrderDetails?orderId=${orderId}`);
                const data = await response.json();
                if (!data.success) { alert(data.message); return; }

                const container = document.getElementById('refundOrderItems');
                let html = '<table class="table table-sm table-bordered"><thead><tr><th>Select</th><th>Product</th><th>Qty</th><th>Price</th><th>Subtotal</th></tr></thead><tbody>';

                data.order.items.forEach(item => {
                    if (!item.isRefunded && !item.isVoided) {
                        html += `<tr>
                            <td class="text-center"><input type="checkbox" class="refund-item-checkbox" value="${item.orderItemId}"></td>
                            <td><strong>${escapeHtml(item.productName)}</strong><br><small>${item.sizeName}</small></td>
                            <td>${item.quantity}</td>
                            <td>₱${item.price.toFixed(2)}</td>
                            <td>₱${item.subtotal.toFixed(2)}</td>
                        </tr>`;
                    }
                });
                html += `</tbody></table>`;
                container.innerHTML = html;
            } catch (error) {
                console.error('Error:', error);
            }
        }

        function getSelectedVoidReason() {
            const select = document.getElementById('voidReason');
            let reason = select.value;
            if (reason === 'Other') reason = document.getElementById('voidOtherReason').value;
            return reason;
        }

        function getSelectedRefundReason() {
            const select = document.getElementById('refundReason');
            let reason = select.value;
            if (reason === 'Other') reason = document.getElementById('refundOtherReason').value;
            return reason;
        }

        function showOwnerApprovalModal(message) {
            const modal = document.getElementById('ownerApprovalModal');
            const msgDiv = document.getElementById('approvalMessage');
            msgDiv.innerHTML = message;
            modal.style.display = 'block';
        }

        async function processVoidItem() {
            const selectedItems = document.querySelectorAll('.void-item-checkbox:checked');
            if (selectedItems.length === 0) { alert('Please select an item to void'); return; }

            const reason = getSelectedVoidReason();
            if (!reason) { alert('Please select a reason'); return; }

            for (let checkbox of selectedItems) {
                const response = await fetch('/VoidRefund/VoidItem', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getToken() },
                    body: JSON.stringify({ orderItemId: parseInt(checkbox.value), reason: reason })
                });
                const data = await response.json();
                if (data.requiresOwner) {
                    showOwnerApprovalModal(data.message);
                    return;
                }
                if (!data.success) { alert(data.message); return; }
            }
            alert('✅ Item(s) voided successfully');
            loadVoidOrderItems();
            loadPendingOrdersForVoid();
        }

        async function processVoidTransaction() {
            if (!currentVoidOrderId) { alert('Please select an order'); return; }
            const reason = getSelectedVoidReason();
            if (!reason) { alert('Please select a reason'); return; }

            const response = await fetch('/VoidRefund/VoidTransaction', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getToken() },
                body: JSON.stringify({ orderId: currentVoidOrderId, reason: reason })
            });
            const data = await response.json();
            if (data.requiresOwner) {
                showOwnerApprovalModal(data.message);
                return;
            }
            if (data.success) {
                alert(data.message);
                loadPendingOrdersForVoid();
                document.getElementById('voidOrderSelect').value = '';
                document.getElementById('voidOrderItems').innerHTML = '';
            } else {
                alert(data.message);
            }
        }

        async function processRefund() {
            const selectedItems = document.querySelectorAll('.refund-item-checkbox:checked');
            if (selectedItems.length === 0) { alert('Please select items to refund'); return; }
            const reason = getSelectedRefundReason();
            if (!reason) { alert('Please select a reason'); return; }

            const itemIds = Array.from(selectedItems).map(cb => parseInt(cb.value));
            const response = await fetch('/VoidRefund/ProcessRefund', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getToken() },
                body: JSON.stringify({ orderId: currentRefundOrderId, itemIds: itemIds, reason: reason })
            });
            const data = await response.json();
            if (data.requiresOwner) {
                showOwnerApprovalModal(data.message);
                return;
            }
            if (data.success) {
                alert(data.message);
                loadCompletedOrdersForRefund();
                document.getElementById('refundOrderSelect').value = '';
                document.getElementById('refundOrderItems').innerHTML = '';
            } else {
                alert(data.message);
            }
        }

    </script>
</body>
</html>