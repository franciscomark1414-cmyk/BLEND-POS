async function voidItemFromReceipt() {
    const orderId = window.currentOrderId;
    if (!orderId) {
        await showAlert('No order found.', 'Error', '❌');
        return;
    }
    
    try {
        const response = await fetch(`/VoidRefund/GetOrderDetails?orderId=${orderId}`);
        const data = await response.json();
        
        if (!data.success || !data.order) {
            await showAlert('Unable to load order details', 'Error', '❌');
            return;
        }
        
        console.log('All items from server:', data.order.items);
        
        closeReceiptModal();
        cart = [];
        let hasItems = false;
        
        for (const item of data.order.items) {
            console.log(`Item: ${item.productName}, isVoided=${item.isVoided}, isRefunded=${item.isRefunded}`);
            
            if (!item.isVoided && !item.isRefunded) {
                cart.push({
                    productSizeId: item.productSizeId,
                    productName: item.productName,
                    sizeName: item.sizeName,
                    price: item.price,
                    quantity: item.quantity
                });
                hasItems = true;
                console.log(`✅ Added to edit list: ${item.productName}`);
            } else {
                console.log(`❌ Skipped: ${item.productName} (already voided/refunded)`);
            }
        }
        
        if (!hasItems) {
            await showAlert('No active items to edit or void.', 'Error', '❌');
            return;
        }
        
        window.originalOrderId = orderId;
        window.originalOrderTotal = data.order.totalAmount;
        window.isEditingMode = true;
        window.currentDiscountType = data.order.discountType || 'None';
        window.currentDiscountPercent = data.order.discountPercent || 0;
        window.pendingPaymentMethod = data.order.paymentMethod || 'Cash';
        
        currentDiscountType = window.currentDiscountType;
        currentDiscountPercent = window.currentDiscountPercent;
        
        updateCartDisplay();
        updateDiscountBtnHighlight();
        
        document.querySelectorAll('.payment-btn').forEach(btn => {
            btn.classList.remove('active');
            if ((window.pendingPaymentMethod === 'Cash' && btn.innerText.includes('Cash')) ||
                (window.pendingPaymentMethod === 'GCash' && btn.innerText.includes('GCash'))) {
                btn.classList.add('active');
            }
        });
        
        showEditModeBanner();
        
        const checkoutBtn = document.getElementById('checkoutBtn');
        checkoutBtn.innerHTML = '✏️ UPDATE ORDER';
        checkoutBtn.style.background = '#17a2b8';
        
        await showAlert('✏️ EDIT MODE: You can now remove items from this order.\n\nClick "UPDATE ORDER" when done.', 'Edit Mode', '✏️');
        
    } catch (error) {
        console.error('Error in voidItemFromReceipt:', error);
        await showAlert('❌ Error loading order for editing: ' + error.message, 'Error', '❌');
    }
}
async function submitVoidItem(itemId, reason, orderId) {
    try {
        const response = await fetch('/VoidRefund/VoidItem', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getToken() },
            body: JSON.stringify({ orderItemId: itemId, reason: reason })
        });
        
        const data = await response.json();
        
        if (data.requiresOwner) {
            alert('⚠️ ' + data.message);
            return;
        }
        
        if (data.success) {
            alert('✅ Item removed from order. Inventory returned.');
            // Refresh the receipt
            await loadOrderReceipt(orderId);
        } else {
            alert('❌ Error: ' + data.message);
        }
    } catch (error) {
        alert('❌ Error: ' + error.message);
    }
}

function showEditModeBanner() {
    // Remove existing banner if any
    const existingBanner = document.getElementById('editModeBanner');
    if (existingBanner) existingBanner.remove();
    
    // Create banner
