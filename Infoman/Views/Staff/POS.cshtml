// PROCESS FINAL ORDER (Supports both New Order and Edit Mode)
// ============================================================
async function processFinalOrder() {
    const paymentMethod = pendingPaymentMethod;
    
    if (!paymentMethod) {
        await showAlert('Please select a payment method (Cash or GCash)', 'Payment Required');
        return;
    }
    
    closeReviewModal();

    const checkoutBtn = document.getElementById('checkoutBtn');
    const originalText = checkoutBtn.innerHTML;
    checkoutBtn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Processing...';
    checkoutBtn.disabled = true;

    const token = getToken();
    
    try {
        if (paymentMethod === 'GCash') {
            // For GCash, create order first without marking as paid
            await createOrderForGCash();
        } else if (paymentMethod === 'Cash') {
            // Normal order creation for Cash
            await createNewOrder();
        }
    } catch (error) {
        console.error('Error:', error);
        await showAlert('❌ Error processing order: ' + error.message, 'Error', '❌');
    } finally {
        checkoutBtn.innerHTML = originalText;
        checkoutBtn.disabled = false;
    }
}

async function createNewOrder() {
    const paymentMethod = pendingPaymentMethod;
    const token = getToken();
    let orderDetails = [];
    let lastOrderId = null;
    let allSuccessful = true;

    for (const item of cart) {
        const response = await fetch('/Staff/PlaceOrder', {
            method: 'POST',
            headers: { 
                'Content-Type': 'application/json', 
                'RequestVerificationToken': token 
            },
            body: JSON.stringify({
                productSizeId: item.productSizeId,
                quantity: item.quantity,
                orderNumber: `POS-${Date.now()}`,
                paymentMethod: paymentMethod,
                discountType: currentDiscountType,
                discountPercent: currentDiscountPercent
            })
        });
        
        const data = await response.json();
        
        if (!data.success) {
            allSuccessful = false;
            await showAlert(`❌ Error with ${item.productName}: ${data.message}`, 'Order Failed', '❌');
            break;
        }
        
        lastOrderId = data.orderId;
        orderDetails.push({
            name: item.productName,
            size: item.sizeName,
            quantity: item.quantity,
            price: item.price,
            subtotal: item.price * item.quantity
        });
    }

    if (allSuccessful && orderDetails.length > 0) {
        const discountSavings = currentCartTotal - currentDiscountedTotal;
        
        showReceiptModal(
            orderDetails, 
            paymentMethod, 
            currentDiscountType, 
            currentDiscountPercent, 
            discountSavings, 
            currentDiscountedTotal, 
            lastOrderId, 
            'PENDING_PAYMENT'
        );
        
        window.lastClosedOrderId = lastOrderId;
        
        cart = [];
        currentDiscountType = 'None';
        currentDiscountPercent = 0;
        pendingPaymentMethod = null;
        window.isEditingMode = false;
        
        document.querySelectorAll('.payment-btn').forEach(b => b.classList.remove('active'));
        updateCartDisplay();
        updateDiscountBtnHighlight();
        await loadOrderQueue();
        
    } else if (!allSuccessful) {
        await showAlert('❌ Order failed. Please try again.', 'Order Failed', '❌');
    }
}

