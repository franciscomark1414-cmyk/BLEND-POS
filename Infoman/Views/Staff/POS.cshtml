async function createOrderForGCash() {
    if (cart.length === 0) {
        await showAlert('Cart is empty!', 'Cannot Create Order', '⚠️');
        return;
    }
    
    showLoading('Creating order...');
    
    const token = getToken();
    let lastOrderId = null;
    let allSuccessful = true;
    let orderDetails = [];

    for (const item of cart) {
        const response = await fetch('/Staff/PlaceOrder', {
            method: 'POST',
            headers: { 
                'Content-Type': 'application/json', 
                'RequestVerificationToken': token 
            },
            body: JSON.stringify({
                productSizeId: item.productSizeId,
                quantity: item.quantity,
                orderNumber: `POS-${Date.now()}`,
                paymentMethod: 'GCash',  // ✅ Explicitly set to GCash
                discountType: currentDiscountType,
                discountPercent: currentDiscountPercent
            })
        });
        
        const data = await response.json();
        
        if (!data.success) {
            allSuccessful = false;
            hideLoading();
            await showAlert(`❌ Error: ${data.message}`, 'Order Failed', '❌');
            break;
        }
        
        lastOrderId = data.orderId;
        orderDetails.push({
            name: item.productName,
            size: item.sizeName,
            quantity: item.quantity,
            price: item.price,
            subtotal: item.price * item.quantity
        });
    }

    if (allSuccessful && lastOrderId) {
        window.currentOrderId = lastOrderId;
        window.currentOrderTotal = currentDiscountedTotal;
        
        // Show receipt modal with GCash
        const discountSavings = currentCartTotal - currentDiscountedTotal;
        showReceiptModal(
            orderDetails, 
            'GCash',  // ✅ Explicitly set to GCash
            currentDiscountType, 
            currentDiscountPercent, 
            discountSavings, 
            currentDiscountedTotal, 
            lastOrderId, 
            'PENDING_PAYMENT'
        );
        
        document.getElementById('gcashPayBtn').style.display = 'block';

        hideLoading();
        await showAlert('Order created! Click "Pay with GCash" to complete payment.', 'Order Ready', '✅');
        
        // Clear cart
        cart = [];
        currentDiscountType = 'None';
        currentDiscountPercent = 0;
        updateCartDisplay();
        updateDiscountBtnHighlight();
        await loadOrderQueue();
    }
}

async function payWithGCash() {
    const orderId = window.currentOrderId;
    const amount = window.currentOrderTotal;
    
    console.log('payWithGCash called with orderId:', orderId, 'amount:', amount);
    
    if (!orderId) {
        await showAlert('No order found. Please create order first.', 'Error', '❌');
        return;
    }
    
    showLoading('Initializing GCash payment...');
    
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
    
    try {
        const response = await fetch('/Payment/InitiateGCashPayment', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token
            },
            body: JSON.stringify({
                orderId: orderId,
                amount: amount
            })
        });
        
        const data = await response.json();
        hideLoading();
        
        console.log('Payment response:', data);
        
        if (data.success) {
            // Redirect to PayMongo checkout page
            window.location.href = data.checkoutUrl;
        } else {
            await showAlert(data.message || 'Payment initialization failed', 'Payment Error', '❌');
        }
    } catch (error) {
        hideLoading();
        console.error('Payment error:', error);
        await showAlert('Error: ' + error.message, 'Payment Error', '❌');
    }
}

