        function checkAttendanceStatus() {
    fetch('/Staff/GetTodayAttendance')
        .then(res => res.json())
        .then(data => {
            const timeInBtn = document.getElementById('timeInBtn');
            const timeOutBtn = document.getElementById('timeOutBtn');
            const statusBadge = document.getElementById('attendanceStatusBadge');
            const hoursDisplay = document.getElementById('todayHoursDisplay');
            
            console.log('Attendance data:', data); // For debugging
            
            // ✅ FIX: Check both isClockedIn and hasClockedOut properly
            if (data.isClockedIn === true) {
                // Currently clocked in
                timeInBtn.style.display = 'none';
                timeOutBtn.style.display = 'inline-block';
                if (statusBadge) {
                    statusBadge.innerHTML = '🟢 Clocked In';
                    statusBadge.style.background = '#10b981';
                    statusBadge.style.color = 'white';
                }
                if (hoursDisplay) hoursDisplay.innerText = data.hoursToday || '0';
                
                // Enable POS
                enablePOSPage();
                
            } else if (data.hasClockedOut === true) {
                // Already clocked out for the day
                timeInBtn.style.display = 'none';
                timeOutBtn.style.display = 'none';
                if (statusBadge) {
                    statusBadge.innerHTML = '🔴 Shift Ended';
                    statusBadge.style.background = '#6b7280';
                    statusBadge.style.color = 'white';
                }
                if (hoursDisplay) hoursDisplay.innerText = data.hoursToday || '0';
                
                // Disable POS
                disablePOSPage();
                
            } else {
                // Not clocked in yet
                timeInBtn.style.display = 'inline-block';
                timeOutBtn.style.display = 'none';
                if (statusBadge) {
                    statusBadge.innerHTML = '⭕ Not Clocked In';
                    statusBadge.style.background = '#6b7280';
                    statusBadge.style.color = 'white';
                }
                if (hoursDisplay) hoursDisplay.innerText = '0.0';
                
                // Disable POS
                disablePOSPage();
                
                // Show reminder (optional)
                // showAttendanceReminder();
            }
        })
        .catch(error => console.error('Error checking attendance:', error));
}

