        }

        #voidTabBtn.active {
            background: #dc3545 !important;
            color: white !important;
        }

        #refundTabBtn.active {
            background: #007bff !important;
            color: white !important;
        }

        #voidRefundModal .modal-qty-content {
            width: 700px;
            max-width: 95%;
            border-radius: 20px;
            padding: 0;
            max-height: 85vh;
            overflow-y: auto;
        }

