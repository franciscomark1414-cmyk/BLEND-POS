<body>
    @Html.AntiForgeryToken()

    <div style="display: flex; flex-direction: column; height: 100vh; overflow: hidden;">

        <!-- ATTENDANCE BAR -->
        <div class="attendance-bar" style="background: #1e293b; color: white; padding: 10px 20px; display: flex; justify-content: space-between; align-items: center; flex-shrink: 0;">
            <div>
                <strong><i class="fas fa-user-circle"></i> Staff: @ViewBag.StaffUsername</strong>
                <span id="attendanceStatusBadge" class="badge bg-secondary ms-2">Not Clocked In</span>
            </div>
            <div>
                <span id="todayHoursDisplay">0.0</span> hrs today
            </div>
            <div>
                <button id="timeInBtn" class="btn btn-success btn-sm" onclick="timeIn()"> TIME IN</button>
                <button id="timeOutBtn" class="btn btn-danger btn-sm" style="display:none;" onclick="timeOut()"> TIME OUT</button>
            </div>
        </div>

        <!-- POS LAYOUT -->
        <div class="pos-container" style="display: flex; flex: 1; overflow: hidden;">

            <!-- LEFT: Categories -->
            <div class="pos-categories">
                <div class="store-info">
                    <h3> Neldie's Mango & More</h3>
                    <p>Point of Sale System</p>
                </div>
                <div class="category-list">
                    <div class="category-item active" data-category="all" onclick="filterByCategory('all')">
                         All Products
                    </div>
                    @if (ViewBag.Categories != null)
                    {
                        foreach (var cat in ViewBag.Categories)
                        {
                            <div class="category-item" data-category="@cat" onclick="filterByCategory('@cat')">
                                 @cat
                            </div>
                        }
                    }
                </div>
                <!-- ORDER QUEUE -->
                <div class="order-queue">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <strong style="font-size: 12px;">
