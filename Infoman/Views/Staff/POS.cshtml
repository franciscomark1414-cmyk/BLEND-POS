function filterProductSearch() {
    const searchTerm = document.getElementById('productSearchInput').value.toLowerCase();
    const items = document.querySelectorAll('.product-search-item');
    items.forEach(item => {
        const text = item.innerText.toLowerCase();
        item.style.display = text.includes(searchTerm) ? '' : 'none';
    });
}

function selectProductForExchange(productSizeId, productName, sizeName, price) {
    const existingIndex = exchangeReplaceItems.findIndex(i => i.productSizeId === productSizeId);
    
    if (existingIndex !== -1) {
        exchangeReplaceItems[existingIndex].quantity++;
    } else {
        exchangeReplaceItems.push({
            productSizeId: productSizeId,
            productName: productName,
            sizeName: sizeName,
            price: price,
            quantity: 1
        });
    }
    
    closeModal('productSearchModal');
    renderReplacementItems();
    updateExchangeTotals();
}

function renderReplacementItems() {
    const container = document.getElementById('replaceItemsList');
    
    if (exchangeReplaceItems.length === 0) {
        container.innerHTML = '<div class="text-muted text-center">No replacement items added yet. Click "Add Replacement Item" to start.</div>';
    } else {
        let html = '';
        exchangeReplaceItems.forEach((item, index) => {
            html += `
                <div class="border p-2 mb-2 rounded bg-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <strong>${escapeHtml(item.productName)}</strong> - ${escapeHtml(item.sizeName)}
                            <div class="small">₱${item.price.toFixed(2)} each</div>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <button class="btn btn-sm btn-outline-secondary" onclick="updateReplaceQty(${index}, ${item.quantity - 1})">-</button>
                            <span style="min-width: 30px; text-align: center;">${item.quantity}</span>
                            <button class="btn btn-sm btn-outline-secondary" onclick="updateReplaceQty(${index}, ${item.quantity + 1})">+</button>
                            <button class="btn btn-sm btn-danger ms-2" onclick="removeReplaceItem(${index})">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </div>
                    <div class="text-end mt-1">
                        <small>Subtotal: ₱${(item.price * item.quantity).toFixed(2)}</small>
                    </div>
                </div>
            `;
        });
        container.innerHTML = html;
    }
    
    // ✅ FORCE SHOW THE PROCESS EXCHANGE BUTTON
    const processBtn = document.querySelector('#exchangeTabContent .btn-primary');
    if (processBtn) {
        processBtn.style.display = 'block';
        processBtn.style.visibility = 'visible';
        console.log('Process Exchange button forced to be visible');
    }
}
function updateReplaceQty(index, newQty) {
    if (newQty <= 0) {
        removeReplaceItem(index);
        return;
    }
    exchangeReplaceItems[index].quantity = newQty;
    renderReplacementItems();
    updateExchangeTotals();
    
    // ✅ FORCE SHOW BUTTON AGAIN
    const processBtn = document.querySelector('#exchangeTabContent .btn-primary');
    if (processBtn) processBtn.style.display = 'block';
}

function removeReplaceItem(index) {
    exchangeReplaceItems.splice(index, 1);
    renderReplacementItems();
    updateExchangeTotals();
    
    // ✅ FORCE SHOW BUTTON AGAIN
    const processBtn = document.querySelector('#exchangeTabContent .btn-primary');
    if (processBtn) processBtn.style.display = 'block';
}

function updateExchangeTotals() {
    let returnTotal = 0;
    
    document.querySelectorAll('.return-item-checkbox:checked').forEach(cb => {
        const row = cb.closest('tr');
        const price = parseFloat(cb.getAttribute('data-price'));
        const qtyInput = row.querySelector('.return-qty');
        let quantity = parseInt(qtyInput.value) || 0;
        if (quantity > 0) {
            returnTotal += price * quantity;
        }
    });
    
    let replaceTotal = 0;
    exchangeReplaceItems.forEach(item => {
        replaceTotal += item.price * item.quantity;
    });
    
    const priceDiff = replaceTotal - returnTotal;
    const diffElement = document.getElementById('exchangePriceDiff');
    const diffTypeElement = document.getElementById('exchangeDiffType');
    
    diffElement.innerHTML = `₱${Math.abs(priceDiff).toFixed(2)}`;
    
    if (priceDiff > 0) {
        diffTypeElement.innerHTML = '<span class="text-danger">(Customer needs to pay ₱' + priceDiff.toFixed(2) + ')</span>';
    } else if (priceDiff < 0) {
        diffTypeElement.innerHTML = '<span class="text-success">(Customer gets ₱' + Math.abs(priceDiff).toFixed(2) + ' back)</span>';
    } else {
        diffTypeElement.innerHTML = '<span class="text-secondary">(No price difference)</span>';
    }
    
    document.getElementById('exchangeTotalReturn').innerHTML = `₱${returnTotal.toFixed(2)}`;
    document.getElementById('exchangeTotalReplace').innerHTML = `₱${replaceTotal.toFixed(2)}`;
}

async function processExchange() {
    const itemsToReturn = [];
    document.querySelectorAll('.return-item-checkbox:checked').forEach(cb => {
        const orderItemId = parseInt(cb.getAttribute('data-id'));
        const qtyInput = cb.closest('tr').querySelector('.return-qty');
        const quantity = parseInt(qtyInput.value) || 0;
        if (quantity > 0) {
            itemsToReturn.push({ orderItemId: orderItemId, quantity: quantity });
        }
    });
    
    if (itemsToReturn.length === 0) {
        await showAlert('Please select at least one item to return', 'No Selection', '⚠️');
        return;
    }
    
    if (exchangeReplaceItems.length === 0) {
        await showAlert('Please add at least one replacement item', 'No Replacement', '⚠️');
        return;
    }
    
    const reasonSelect = document.getElementById('exchangeReason');
    let reason = reasonSelect.value;
    if (reason === 'Other') {
        reason = document.getElementById('exchangeOtherReason').value;
        if (!reason) {
            await showAlert('Please specify the reason', 'Required', '⚠️');
            return;
        }
    }
    
    if (!reason) {
        await showAlert('Please select a reason', 'Required', '⚠️');
        return;
    }
    
    const requestData = {
        orderId: currentExchangeOrderId,
        itemsToReturn: itemsToReturn,
        itemsToReplace: exchangeReplaceItems.map(item => ({
            productSizeId: item.productSizeId,
            quantity: item.quantity
        })),
        reason: reason,
        useStoreCredit: false
    };
    
    showLoading('Processing exchange...');
    
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
    
    try {
        const response = await fetch('/ReturnExchange/ProcessExchange', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token
            },
            body: JSON.stringify(requestData)
        });
        
        const data = await response.json();
        hideLoading();
        
        if (data.success) {
            // ✅ SHOW EXCHANGE RECEIPT
            showExchangeReceiptModal(requestData, data.message);
            
            // Close the void/refund modal
            closeVoidRefundModal();
            
            // Refresh order queue
            await loadOrderQueue();
        } else {
            await showAlert('❌ ' + data.message, 'Exchange Failed', '❌');
        }
    } catch (error) {
        hideLoading();
        await showAlert('❌ Error: ' + error.message, 'Error', '❌');
    }
}

