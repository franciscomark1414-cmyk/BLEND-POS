       // Function para mag-pop-up ng receipt ng kahit anong order
async function showReceiptPopup(orderId) {
    if (!orderId) {
        await showAlert('No order selected.', 'Error', '❌');
        return;
    }
    
    showLoading('Loading receipt...');
    
    try {
        const response = await fetch(`/VoidRefund/GetOrderDetails?orderId=${orderId}`);
        const data = await response.json();
        hideLoading();
        
        if (!data.success || !data.order) {
            await showAlert('Unable to load receipt', 'Error', '❌');
            return;
        }
        
        const orderDetails = [];
        let subtotal = 0;
        
        data.order.items.forEach(item => {
            if (!item.isVoided && !item.isRefunded) {
                const itemSubtotal = item.price * item.quantity;
                orderDetails.push({
                    name: item.productName,
                    size: item.sizeName,
                    quantity: item.quantity,
                    price: item.price,
                    subtotal: itemSubtotal
                });
                subtotal += itemSubtotal;
            }
        });
        
        // I-compute ang discounted total
        const discountPercent = data.order.discountPercent || 0;
        const discountedTotal = subtotal * (1 - discountPercent);
        const discountSavings = subtotal - discountedTotal;
        
        // I-store ang order ID para magamit ng start blending at void buttons
        window.currentOrderId = orderId;
        
        // I-save ang original subtotal para sa receipt display
        const originalSubtotal = subtotal;
        
        // Ipakita ang receipt modal - gamitin ang computed values
        showReceiptModalWithValues(
            orderDetails, 
            data.order.paymentMethod || 'Cash', 
            data.order.discountType || 'None', 
            discountPercent, 
            discountSavings, 
            discountedTotal, 
            originalSubtotal,
            orderId, 
            data.order.status
        );
        
    } catch (error) {
        hideLoading();
        console.error('Error loading receipt:', error);
        await showAlert('Error loading receipt: ' + error.message, 'Error', '❌');
    }
}

