async function payWithGCashFromReceipt(orderId) {
    // Kunin ang total amount mula sa receipt display
    const totalElement = document.querySelector('#receiptContent .receipt-total span:last-child');
    let amount = 0;
    
    if (totalElement) {
        const amountText = totalElement.innerText.replace('₱', '');
        amount = parseFloat(amountText);
    }
    
    console.log(`payWithGCashFromReceipt called - OrderId: ${orderId}, Amount: ${amount}`);
    
    if (!orderId) {
        await showAlert('No order found.', 'Error', '❌');
        return;
    }
    
    showLoading('Initializing GCash payment...');
    
    const token = getToken();
    
    try {
        const response = await fetch('/Payment/InitiateGCashPayment', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token
            },
            body: JSON.stringify({
                orderId: orderId,
                amount: amount
            })
        });
        
        const data = await response.json();
        hideLoading();
        
        console.log('InitiateGCashPayment response:', data);
        
        if (data.success) {
            // ✅ I-save sa session storage na may pending payment
            sessionStorage.setItem('pendingPaymentOrderId', orderId);
            sessionStorage.setItem('pendingPaymentAmount', amount);
            
            // ✅ I-redirect sa GCash payment page
            window.location.href = data.checkoutUrl;
        } else {
            await showAlert(data.message || 'Payment initialization failed', 'Payment Error', '❌');
        }
    } catch (error) {
        hideLoading();
        console.error('Payment error:', error);
        await showAlert('Error: ' + error.message, 'Payment Error', '❌');
    }
}

