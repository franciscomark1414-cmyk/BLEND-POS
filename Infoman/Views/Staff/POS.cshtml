       async function processVoidItem() {
    // ✅ CHECK MUNA KUNG MAY NAPILING ORDER
    const orderSelect = document.getElementById('voidOrderSelect');
    const selectedOrderId = orderSelect ? orderSelect.value : null;
    
    if (!selectedOrderId || selectedOrderId === '') {
        await showAlert('Please select an order first.', 'No Order Selected', '⚠️');
        return;
    }
    
    currentVoidOrderId = parseInt(selectedOrderId);
    
    // ✅ CHECK KUNG MAY NAPILING ITEMS
    const selectedItems = document.querySelectorAll('.void-item-checkbox:checked');
    if (selectedItems.length === 0) { 
        await showAlert('Please select at least one item to void', 'No Selection', '⚠️');
        return; 
    }
    
    const reason = getSelectedVoidReason();
    if (!reason) { 
        await showAlert('Please select a reason', 'Required', '⚠️');
        return; 
    }
    
    // ✅ CONFIRMATION DIALOG WITH REFUND INFO
    let confirmMessage = `⚠️ VOID SELECTED ITEMS\n\n`;
    confirmMessage += `You selected ${selectedItems.length} item(s) to void.\n\n`;
    confirmMessage += `📌 CASH REFUND will be given to customer.\n\n`;
    confirmMessage += `This action cannot be undone.\n\nContinue?`;
    
    const confirmed = await showConfirm(confirmMessage, 'Confirm Void Items');
    if (!confirmed) return;
    
    showLoading('Processing void request...');
    
    const token = getToken();
    let totalRefund = 0;
    let lastOrderId = null;
    let lastNewTotal = 0;
    let lastIsPartialRefund = false;
    let lastIsFullRefund = false;
    
    try {
        // Process each selected item
        for (let checkbox of selectedItems) {
            const response = await fetch('/VoidRefund/VoidItem', {
                method: 'POST',
                headers: { 
                    'Content-Type': 'application/json', 
                    'RequestVerificationToken': token 
                },
                body: JSON.stringify({ 
                    orderItemId: parseInt(checkbox.value), 
                    reason: reason 
                })
            });
            
            const data = await response.json();
            
            if (data.requiresOwner) { 
                hideLoading();
                await showAlert(data.message, 'Owner Approval Required', '⚠️');
                return; 
            }
            
            if (!data.success) { 
                hideLoading();
                await showAlert(data.message, 'Error', '❌');
                return; 
            }
            
            totalRefund += data.refundAmount;
            lastOrderId = currentVoidOrderId;
            lastNewTotal = data.newOrderTotal;
            lastIsPartialRefund = data.isPartialRefund;
            lastIsFullRefund = data.isFullRefund;
        }
        
        hideLoading();
        
        // ✅ Show updated receipt ONCE after all items are processed
        if (totalRefund > 0 && lastOrderId) {
            await showUpdatedReceiptAfterVoid(
                lastOrderId,
                totalRefund,
                lastNewTotal,
                lastIsPartialRefund,
                lastIsFullRefund
            );
        }
        
        // Show refund summary
        await showAlert(
            `✅ ${selectedItems.length} item(s) voided successfully!\n\n` +
            `💰 Cash Refund to Customer: ₱${totalRefund.toFixed(2)}\n\n` +
            `The receipt has been updated.`,
            'Void Successful',
            '✅'
        );
        
        // RELOAD THE ORDER ITEMS
        await loadVoidOrderItems();
        
        // REFRESH PENDING ORDERS
        await loadPendingOrdersForVoid();
        
        // REFRESH ORDER QUEUE
        await loadOrderQueue();
        
    } catch (error) {
        hideLoading();
        console.error('Error voiding items:', error);
        await showAlert('Error: ' + error.message, 'Error', '❌');
    }
}

async function processVoidTransaction() {
    // ✅ CHECK MUNA KUNG MAY NAPILING ORDER
    const orderSelect = document.getElementById('voidOrderSelect');
    const selectedOrderId = orderSelect ? orderSelect.value : null;
    
    if (!selectedOrderId || selectedOrderId === '') {
        await showAlert('Please select an order first before voiding.', 'No Order Selected', '⚠️');
        return;
    }
    
    currentVoidOrderId = parseInt(selectedOrderId);
    
    if (!currentVoidOrderId) { 
        await showAlert('Please select a valid order', 'No Selection', '⚠️');
        return; 
    }
    
    const reason = getSelectedVoidReason();
    if (!reason) { 
        await showAlert('Please select a reason', 'Required', '⚠️');
        return; 
    }
    
    // ✅ Get order details first to show refund amount
    let orderTotal = 0;
    try {
        const orderResponse = await fetch(`/VoidRefund/GetOrderDetails?orderId=${currentVoidOrderId}`);
        const orderData = await orderResponse.json();
        if (orderData.success && orderData.order) {
            orderTotal = orderData.order.totalAmount || 0;
        }
    } catch (e) {
        console.error('Error getting order details:', e);
    }
    
    // ✅ CONFIRMATION DIALOG WITH REFUND AMOUNT
    const confirmed = await showConfirm(
        `⚠️ VOID ENTIRE TRANSACTION\n\n` +
        `Order #${currentVoidOrderId}\n` +
        `Total Amount: ₱${orderTotal.toFixed(2)}\n\n` +
        `💰 FULL CASH REFUND of ₱${orderTotal.toFixed(2)} will be given to customer.\n\n` +
        `This action cannot be undone.\n\n` +
        `Continue?`,
        'Confirm Void Transaction'
    );
    
    if (!confirmed) return;
    
    showLoading('Voiding transaction...');
    
    const token = getToken();
    
    try {
        const response = await fetch('/VoidRefund/VoidTransaction', {
            method: 'POST',
            headers: { 
                'Content-Type': 'application/json', 
                'RequestVerificationToken': token 
            },
            body: JSON.stringify({ 
                orderId: currentVoidOrderId, 
                reason: reason 
            })
        });
        
        const data = await response.json();
        hideLoading();
        
        if (data.requiresOwner) { 
            await showAlert(data.message, 'Owner Approval Required', '⚠️');
            return;
        }
        
        if (data.success) {
            // ✅ Show updated receipt with full refund
            await showUpdatedReceiptAfterVoid(
                currentVoidOrderId,
                data.refundAmount,
                0,
                false,
                true
            );
            
            await showAlert(
                `✅ Transaction voided successfully!\n\n` +
                `💰 Cash Refund to Customer: ₱${data.refundAmount.toFixed(2)}\n\n` +
                `The receipt has been updated.`,
                'Void Successful',
                '✅'
            );
            
            // ✅ RESET THE SELECT DROPDOWN
            if (orderSelect) {
                orderSelect.value = '';
            }
            
            // ✅ CLEAR THE ORDER ITEMS DISPLAY
            const orderItemsContainer = document.getElementById('voidOrderItems');
            if (orderItemsContainer) {
                orderItemsContainer.innerHTML = '';
            }
            
            // ✅ RELOAD PENDING ORDERS
            await loadPendingOrdersForVoid();
            
            // ✅ REFRESH ORDER QUEUE SA POS
            await loadOrderQueue();
            
            // ✅ Close the void/refund modal
            closeVoidRefundModal();
            
        } else {
            await showAlert('Error: ' + data.message, 'Error', '❌');
        }
    } catch (error) {
        hideLoading();
        console.error('Error voiding transaction:', error);
        await showAlert('Error: ' + error.message, 'Error', '❌');
    }
}

async function showUpdatedReceiptAfterVoid(orderId, refundAmount, newTotal, isPartialRefund, isFullRefund) {
    try {
        const response = await fetch(`/VoidRefund/GetOrderDetails?orderId=${orderId}`);
        const data = await response.json();
        
        if (!data.success || !data.order) {
            console.error('Failed to load updated order details');
            return;
        }
        
        const order = data.order;
        const now = new Date();
        
        // ✅ FORCE status to PENDING_BLENDING if there are active items
        const hasActiveItems = order.items.some(item => !item.isVoided && !item.isRefunded);
        const displayStatus = hasActiveItems ? 'PENDING_BLENDING' : 'VOIDED';
        
        // Get active items only (not voided)
        const activeItems = order.items.filter(item => !item.isVoided && !item.isRefunded);
        
        // Get voided items
        const voidedItems = order.items.filter(item => item.isVoided);
        
        // Compute original total (sum of all items including voided)
        let originalTotal = 0;
        order.items.forEach(item => {
            originalTotal += item.price * item.quantity;
        });
        
        // Build active items HTML
        let activeItemsHtml = '';
        activeItems.forEach(item => {
            const subtotal = item.price * item.quantity;
            activeItemsHtml += `
                <div style="display: flex; justify-content: space-between; margin-bottom: 5px;">
                    <div>
                        <strong>${escapeHtml(item.productName)}</strong><br>
                        <small>${item.sizeName} × ${item.quantity}</small>
                    </div>
                    <div>₱${subtotal.toFixed(2)}</div>
                </div>`;
        });
        
        // Build voided items HTML
        let voidedItemsHtml = '';
        if (voidedItems.length > 0 && !isFullRefund) {
            voidedItems.forEach(item => {
                const subtotal = item.price * item.quantity;
                voidedItemsHtml += `
                    <div style="display: flex; justify-content: space-between; margin-bottom: 5px; color: #dc3545;">
                        <div>
                            <strong>✕ ${escapeHtml(item.productName)}</strong><br>
                            <small>${item.sizeName} × ${item.quantity}</small>
                        </div>
                        <div>-₱${subtotal.toFixed(2)}</div>
                    </div>`;
            });
        }
        
        // Build refund section HTML
        let refundHtml = '';
        if (isFullRefund) {
            refundHtml = `
                <div style="background: #fff3cd; padding: 12px; border-radius: 8px; margin: 10px 0;">
                    <div style="display: flex; justify-content: space-between; color: #856404;">
                        <span><strong>💰 FULL REFUND</strong></span>
                        <span><strong>₱${refundAmount.toFixed(2)}</strong></span>
                    </div>
                    <div style="font-size: 13px; margin-top: 8px; font-weight: bold;">
                        Cash Back to Customer: ₱${refundAmount.toFixed(2)}
                    </div>
                </div>`;
        } else if (refundAmount > 0 && newTotal > 0) {
            refundHtml = `
                <div style="background: #e8f5e9; padding: 12px; border-radius: 8px; margin: 10px 0;">
                    <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                        <span>Previous Payment:</span>
                        <span>₱${originalTotal.toFixed(2)}</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; color: #dc3545; margin-bottom: 8px;">
                        <span>Refund:</span>
                        <span>-₱${refundAmount.toFixed(2)}</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; font-weight: bold; border-top: 1px dashed #ccc; padding-top: 8px; color: #28a745;">
                        <span>Cash Back to Customer:</span>
                        <span>₱${refundAmount.toFixed(2)}</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; margin-top: 8px;">
                        <span>New Total Payable:</span>
                        <span>₱${newTotal.toFixed(2)}</span>
                    </div>
                </div>`;
        }
        
        // Determine status badge
        let badgeClass = 'bg-warning';
        let statusText = '⏳ PAID - WAITING BLENDING';
        
        if (isFullRefund) {
            badgeClass = 'bg-danger';
