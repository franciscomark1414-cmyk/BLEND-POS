async function resetToOriginalOrder() {
    if (!window.originalOrderId) return;
    
    const confirmed = await showConfirm('Reset to original order? All changes will be discarded.', 'Reset Order');
    if (confirmed) {
        await loadOrderForEditing(window.originalOrderId);
    }
}

async function loadOrderForEditing(orderId) {
    try {
        const response = await fetch(`/VoidRefund/GetOrderDetails?orderId=${orderId}`);
        const data = await response.json();
        
        if (!data.success || !data.order) {
            await showAlert('Unable to load order details', 'Error', '❌');
            return;
        }
        
        // Reset cart with original items - MAKE SURE productSizeId is included
        cart = [];
        for (const item of data.order.items) {
            if (!item.isVoided && !item.isRefunded) {
                // CRITICAL: Verify productSizeId exists
                if (!item.productSizeId || item.productSizeId === 0) {
                    console.warn('Item missing productSizeId:', item);
                    await showAlert(`Warning: ${item.productName} (${item.sizeName}) may not be editable because product ID is missing.`, 'Warning', '⚠️');
                }
                
                cart.push({
                    productSizeId: item.productSizeId,
                    productName: item.productName,
                    sizeName: item.sizeName,
                    price: item.price,
                    quantity: item.quantity
                });
            }
        }

        console.log('=== AFTER LOADING ORDER FOR EDITING ===');
        console.log('Order data from server:', data.order);
        debugCart(); 
        
        if (cart.length === 0) {
            await showAlert('No active items to edit.', 'Error', '❌');
            return;
        }
        
        // Store original order info
        window.originalOrderId = orderId;
        window.originalOrderTotal = data.order.totalAmount;
        window.isEditingMode = true;
        
        // Apply original discount and payment
        currentDiscountType = data.order.discountType || 'None';
        currentDiscountPercent = data.order.discountPercent || 0;
        pendingPaymentMethod = data.order.paymentMethod || 'Cash';
        
        // Update displays
        updateCartDisplay();
        updateDiscountBtnHighlight();
        
        // Highlight correct payment method
        document.querySelectorAll('.payment-btn').forEach(btn => {
            btn.classList.remove('active');
            if ((pendingPaymentMethod === 'Cash' && btn.innerText.includes('Cash')) ||
                (pendingPaymentMethod === 'GCash' && btn.innerText.includes('GCash'))) {
                btn.classList.add('active');
            }
        });
        
        // Show edit mode banner
        showEditModeBanner();
        
        // Change button text
        const checkoutBtn = document.getElementById('checkoutBtn');
        checkoutBtn.innerHTML = '✏️ UPDATE ORDER';
        checkoutBtn.style.background = '#17a2b8';
        
        await showAlert('✏️ EDIT MODE: You can now modify this order.\nClick "UPDATE ORDER" when done.', 'Edit Mode', '✏️');
        
    } catch (error) {
        console.error('Error loading order:', error);
        await showAlert('❌ Error loading order for editing: ' + error.message, 'Error', '❌');
    }
}

async function cancelEditMode() {
    const confirmed = await showConfirm('Cancel editing? Changes will be discarded.', 'Cancel Edit');
    if (confirmed) {
        // ✅ CLEAR CART
        cart = [];
        updateCartDisplay();
        
        // ✅ REMOVE BANNER
        const banner = document.getElementById('editModeBanner');
        if (banner) banner.remove();
        
        // ✅ RESET CHECKOUT BUTTON
        const checkoutBtn = document.getElementById('checkoutBtn');
        checkoutBtn.innerHTML = '💳 Confirm Order';
        checkoutBtn.style.background = '#28a745';
        
        // ✅ RESET PAYMENT BUTTON HIGHLIGHTS
        document.querySelectorAll('.payment-btn').forEach(b => b.classList.remove('active'));
        
        // ✅ RESET ALL FLAGS
        window.isEditingMode = false;
        window.originalOrderId = null;
        window.originalOrderTotal = null;
        currentDiscountType = 'None';
        currentDiscountPercent = 0;
        pendingPaymentMethod = null;
        
        updateDiscountBtnHighlight();
        
        // ✅ CLOSE RECEIPT MODAL KUNG BUKAS
        if (window.lastClosedOrderId) {
            loadOrderReceipt(window.lastClosedOrderId);
