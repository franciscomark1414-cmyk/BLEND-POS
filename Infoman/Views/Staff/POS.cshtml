async function updateExistingOrder() {
    const orderId = window.originalOrderId;
    const paymentMethod = pendingPaymentMethod;
    
    if (cart.length === 0) {
        await showAlert('Cart is empty! Cannot update order.', 'Error', '❌');
        return false;
    }
    
    if (!paymentMethod) {
        await showAlert('Please select a payment method', 'Required', '⚠️');
        return false;
    }
    
    const confirmed = await showConfirm('Update this order? The original order will be voided and replaced with your changes.', 'Confirm Update');
    if (!confirmed) return false;
    
    showLoading('Updating order...');
    
    const updateBtn = document.getElementById('checkoutBtn');
    const originalText = updateBtn.innerHTML;
    updateBtn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Updating Order...';
    updateBtn.disabled = true;
    
    try {
        // STEP 1: Get original order details to mark as voided
        const getOrderResponse = await fetch(`/VoidRefund/GetOrderDetails?orderId=${orderId}`);
        const orderData = await getOrderResponse.json();
        
        console.log('Original order data:', orderData);
        
        if (!orderData.success) {
            throw new Error('Cannot load original order details');
        }
        
        // STEP 2: Void all original items (mark as voided, not delete)
        if (orderData.success && orderData.order && orderData.order.items) {
            for (const oldItem of orderData.order.items) {
                if (!oldItem.isVoided && !oldItem.isRefunded) {
                    console.log('Voiding old item:', oldItem.orderItemId);
                    const voidResponse = await fetch('/VoidRefund/VoidItem', {
                        method: 'POST',
                        headers: { 
                            'Content-Type': 'application/json', 
                            'RequestVerificationToken': getToken() 
                        },
                        body: JSON.stringify({ 
                            orderItemId: oldItem.orderItemId, 
                            reason: 'Order modification - replaced with updated order' 
                        })
                    });
                    const voidData = await voidResponse.json();
                    console.log('Void response:', voidData);
                }
            }
        }
        
        // STEP 3: Create a NEW order for the updated items
        const newOrderNumber = `POS-${Date.now()}`;
        let newOrderIds = [];
        let allSuccessful = true;
        let errorMessage = '';
        
        for (const item of cart) {
            if (!item.productSizeId || item.productSizeId === 0) {
                errorMessage = `Invalid product ID for ${item.productName}`;
                allSuccessful = false;
                break;
            }
            
            console.log('Creating order item:', {
                productSizeId: item.productSizeId,
                quantity: item.quantity,
                productName: item.productName,
                sizeName: item.sizeName
            });
            
            const response = await fetch('/Staff/PlaceOrder', {
                method: 'POST',
                headers: { 
                    'Content-Type': 'application/json', 
                    'RequestVerificationToken': getToken() 
                },
                body: JSON.stringify({
                    productSizeId: item.productSizeId,
                    quantity: item.quantity,
                    orderNumber: newOrderNumber,
                    paymentMethod: paymentMethod,
                    discountType: currentDiscountType,
                    discountPercent: currentDiscountPercent
                })
            });
            
            const responseData = await response.json();
            
            console.log('PlaceOrder response:', responseData);
            
            if (!responseData.success) {
                allSuccessful = false;
                errorMessage = responseData.message;
                break;
            }
            
            if (responseData.orderId) {
                newOrderIds.push(responseData.orderId);
            }
        }
        
        if (!allSuccessful) {
            throw new Error(errorMessage || 'Failed to create updated order');
        }
        
        // STEP 4: Mark original order as completed/voided
        if (orderId) {
            await fetch('/Staff/CloseOrder', {
                method: 'POST',
                headers: { 
                    'Content-Type': 'application/json', 
                    'RequestVerificationToken': getToken() 
                },
                body: JSON.stringify({ orderId: orderId })
            });
        }
        
        hideLoading();
        
        // STEP 5: Show receipt for the new order
        const newOrderId = newOrderIds[0];
        const discountSavings = currentCartTotal - currentDiscountedTotal;
        
        const orderDetails = cart.map(item => ({
            name: item.productName,
            size: item.sizeName,
            quantity: item.quantity,
            price: item.price,
            subtotal: item.price * item.quantity
        }));
        
        showReceiptModal(
            orderDetails,
            paymentMethod,
            currentDiscountType,
            currentDiscountPercent,
            discountSavings,
            currentDiscountedTotal,
            newOrderId,
            'PENDING_PAYMENT'
        );
        
        await showAlert('✅ Order updated successfully! New order #' + newOrderId, 'Success', '✅');
        
        // Clean up edit mode UI
        const banner = document.getElementById('editModeBanner');
        if (banner) banner.remove();
        
        // Reset checkout button
        const checkoutBtn = document.getElementById('checkoutBtn');
        checkoutBtn.innerHTML = '💳 Confirm Order';
        checkoutBtn.style.background = '#28a745';
        
        // Clear cart and reset all flags
        cart = [];
        currentDiscountType = 'None';
        currentDiscountPercent = 0;
        pendingPaymentMethod = null;
        window.isEditingMode = false;
        window.originalOrderId = null;
        window.originalOrderTotal = null;
        
        // Clear payment button highlights
        document.querySelectorAll('.payment-btn').forEach(b => b.classList.remove('active'));
        
        // Update displays
        updateCartDisplay();
        updateDiscountBtnHighlight();
        
        // Refresh the order queue
        await loadOrderQueue();
        
        return true;
        
    } catch (error) {
        hideLoading();
        console.error('Update error details:', error);
        await showAlert('❌ Error updating order: ' + error.message, 'Error', '❌');
        return false;
    } finally {
        updateBtn.innerHTML = originalText;
        updateBtn.disabled = false;
    }
}

