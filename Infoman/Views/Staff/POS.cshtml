async function processRefund() {
    // ✅ PREVENT DUPLICATE SUBMISSION
    if (window.isProcessingRefund) {
        await showAlert('Please wait, still processing previous request...', 'Processing', '⏳');
        return;
    }
    
    const selectedItems = document.querySelectorAll('.refund-item-checkbox:checked');
    if (selectedItems.length === 0) { 
        await showAlert('Please select items to refund', 'No Selection', '⚠️');
        return; 
    }
    
    const reason = getSelectedRefundReason();
    if (!reason) { 
        await showAlert('Please select a reason', 'Required', '⚠️');
        return; 
    }
    
    // ✅ DISABLE BUTTON PARA IWAS DUPLICATE
    const refundBtn = document.querySelector('#refundTabContent .btn-refund');
    const originalText = refundBtn.innerHTML;
    refundBtn.disabled = true;
    refundBtn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Processing...';
    
    // ✅ SET PROCESSING FLAG
    window.isProcessingRefund = true;
    
    showLoading('Processing refund...');
    
    const itemIds = Array.from(selectedItems).map(cb => parseInt(cb.value));
    
    try {
        const response = await fetch('/VoidRefund/RequestRefund', {
            method: 'POST',
            headers: { 
                'Content-Type': 'application/json', 
                'RequestVerificationToken': getToken() 
            },
            body: JSON.stringify({ 
                orderId: currentRefundOrderId, 
                itemIds: itemIds, 
                reason: reason 
            })
        });
        
        const data = await response.json();
        hideLoading();
        
        if (data.requiresOwner) { 
            await showAlert(data.message, 'Owner Approval Required', '⚠️');
            // ✅ CLEAR SELECTION PARA HINDI NA MA-REFUND ULIT
            document.querySelectorAll('.refund-item-checkbox').forEach(cb => cb.checked = false);
            // ✅ RESET SELECT DROPDOWN
            document.getElementById('refundOrderSelect').value = '';
            document.getElementById('refundOrderItems').innerHTML = '';
        } else if (data.success) {
            await showAlert(data.message, 'Success', '✅');
            // ✅ REFRESH ORDERS LIST
            await loadCompletedOrdersForRefund();
            // ✅ CLEAR SELECTION AND DISPLAY
            document.getElementById('refundOrderSelect').value = '';
            document.getElementById('refundOrderItems').innerHTML = '';
        } else {    
            await showAlert('❌ ' + data.message, 'Error', '❌');
        }
    } catch (error) {
        hideLoading();
        console.error('Refund error:', error);
        await showAlert('❌ Error: ' + error.message, 'Error', '❌');
    } finally {
        // ✅ RE-ENABLE BUTTON
        refundBtn.disabled = false;
        refundBtn.innerHTML = originalText;
        // ✅ RESET PROCESSING FLAG
        window.isProcessingRefund = false;
        
        // ✅ REMOVE CHECKED ITEMS PARA IWAS DUPLICATE SA SUSUNOD
        document.querySelectorAll('.refund-item-checkbox:checked').forEach(cb => cb.checked = false);
        
        // ✅ RESET REASON SELECTORS
        const reasonSelect = document.getElementById('refundReason');
        if (reasonSelect) reasonSelect.value = '';
        const otherReason = document.getElementById('refundOtherReason');
        if (otherReason) {
            otherReason.style.display = 'none';
            otherReason.value = '';
        }
    }
}

