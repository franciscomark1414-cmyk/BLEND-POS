       async function loadPendingOrdersForVoid() {
    try {
        console.log('Loading pending orders for void...');
        const today = new Date().toLocaleDateString('en-CA');  // YYYY-MM-DD format
        const response = await fetch(`/VoidRefund/GetPendingOrders?date=${today}`);
        const orders = await response.json();
        
        const select = document.getElementById('voidOrderSelect');
        if (!select) {
            console.error('voidOrderSelect element not found');
            return;
        }
        
        // ✅ SAVE CURRENT SELECTION PARA MA-RESTORE KUNG SAME ORDER
        const currentSelection = select.value;
        
        select.innerHTML = '<option value="">-- Select Order --</option>';
        
        if (!orders || orders.length === 0) {
            select.innerHTML = '<option value="">-- No pending orders today --</option>';
            // ✅ CLEAR ITEMS CONTAINER
            const container = document.getElementById('voidOrderItems');
            if (container) container.innerHTML = '';
            return;
        }
        
        for (const order of orders) {
            const shortOrderNum = order.orderNumber ? order.orderNumber.substring(order.orderNumber.length - 8) : order.orderId;
            const orderTotal = order.totalAmount || 0;
            select.innerHTML += `<option value="${order.orderId}">
                #${shortOrderNum} - ₱${orderTotal.toFixed(2)} - ${new Date(order.date).toLocaleTimeString()}
            </option>`;
        }
        
        // ✅ RESTORE PREVIOUS SELECTION KUNG EXIST PA
        if (currentSelection && Array.from(select.options).some(opt => opt.value === currentSelection)) {
            select.value = currentSelection;
            await loadVoidOrderItems();
        } else {
            // ✅ CLEAR ITEMS CONTAINER KUNG WALANG SELECTION
            const container = document.getElementById('voidOrderItems');
            if (container) container.innerHTML = '';
        }
        
    } catch (error) { 
        console.error('Error loading pending orders:', error); 
        const select = document.getElementById('voidOrderSelect');
        if (select) select.innerHTML = '<option value="">-- Error loading orders --</option>';
    }
}

