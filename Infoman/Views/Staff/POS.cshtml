async function updateExistingOrder() {
    const orderId = window.originalOrderId;
    const paymentMethod = pendingPaymentMethod;
    
    if (cart.length === 0) {
        await showAlert('Cart is empty! Cannot update order.', 'Error', '❌');
        return false;
    }
    
    if (!paymentMethod) {
        await showAlert('Please select a payment method', 'Required', '⚠️');
        return false;
    }
    
    const confirmed = await showConfirm(
        'Update this order?\n\n' +
        'Items removed will be VOIDED and refunded.\n' +
        'Items added will be ADDED to this order.\n\n' +
        'Price difference will be adjusted accordingly.\n\n' +
        'Continue?',
        'Confirm Update'
    );
    
    if (!confirmed) return false;
    
    showLoading('Updating order...');
    
    try {
        // ✅ STEP 1: Get current items from server (BEFORE update)
        const getOrderResponse = await fetch(`/VoidRefund/GetOrderDetails?orderId=${orderId}`);
        const orderData = await getOrderResponse.json();
        
        if (!orderData.success) {
            throw new Error('Cannot load original order details');
        }
        
        const serverItems = orderData.order.items || [];
        const originalTotal = orderData.order.totalAmount || 0;
        
        // Track amounts
        let totalVoidedAmount = 0;
        let totalAddedAmount = 0;
        const voidedItemsList = [];
        const addedItemsList = [];
        
        // ✅ STEP 2: VOID items that are in server but NOT in cart
        for (const serverItem of serverItems) {
            if (!serverItem.isVoided && !serverItem.isRefunded) {
                const stillInCart = cart.some(cartItem => 
                    cartItem.productSizeId === serverItem.productSizeId && 
                    cartItem.sizeName === serverItem.sizeName
                );
                
                if (!stillInCart) {
                    const itemAmount = serverItem.price * serverItem.quantity;
                    totalVoidedAmount += itemAmount;
                    voidedItemsList.push({
                        name: serverItem.productName,
                        size: serverItem.sizeName,
                        quantity: serverItem.quantity,
                        price: serverItem.price,
                        subtotal: itemAmount
                    });
                    
                    console.log(`Voiding item: ${serverItem.productName} - ₱${itemAmount}`);
                    await fetch('/VoidRefund/VoidItem', {
                        method: 'POST',
                        headers: { 
                            'Content-Type': 'application/json', 
                            'RequestVerificationToken': getToken() 
                        },
                        body: JSON.stringify({ 
                            orderItemId: serverItem.orderItemId, 
                            reason: 'Removed from order - Customer requested removal' 
                        })
                    });
                }
            }
        }
        
        // ✅ STEP 3: UPDATE quantities for items that changed
        for (const cartItem of cart) {
            const serverItem = serverItems.find(s => 
                s.productSizeId === cartItem.productSizeId && 
                s.sizeName === cartItem.sizeName &&
                !s.isVoided
            );
            
            if (serverItem && serverItem.quantity !== cartItem.quantity) {
                const oldAmount = serverItem.price * serverItem.quantity;
                const newAmount = serverItem.price * cartItem.quantity;
                
                if (newAmount > oldAmount) {
                    const addedAmount = newAmount - oldAmount;
                    totalAddedAmount += addedAmount;
                    addedItemsList.push({
                        name: cartItem.productName,
                        size: cartItem.sizeName,
                        quantity: cartItem.quantity - serverItem.quantity,
                        price: serverItem.price,
                        subtotal: addedAmount,
                        type: 'quantity_increased'
                    });
                } else if (newAmount < oldAmount) {
                    const voidedAmount = oldAmount - newAmount;
                    totalVoidedAmount += voidedAmount;
                    voidedItemsList.push({
                        name: cartItem.productName,
                        size: cartItem.sizeName,
                        quantity: serverItem.quantity - cartItem.quantity,
                        price: serverItem.price,
                        subtotal: voidedAmount,
                        type: 'quantity_decreased'
                    });
                }
                
                console.log(`Updating quantity for: ${cartItem.productName} from ${serverItem.quantity} to ${cartItem.quantity}`);
                await fetch('/Staff/UpdateOrderItemQuantity', {
                    method: 'POST',
                    headers: { 
                        'Content-Type': 'application/json', 
                        'RequestVerificationToken': getToken() 
                    },
                    body: JSON.stringify({
                        orderItemId: serverItem.orderItemId,
                        quantity: cartItem.quantity
                    })
                });
            }
        }
        
        // ✅ STEP 4: ADD new items that are in cart but NOT in server
        for (const cartItem of cart) {
            const existsInServer = serverItems.some(serverItem => 
                serverItem.productSizeId === cartItem.productSizeId && 
                serverItem.sizeName === cartItem.sizeName &&
                !serverItem.isVoided
            );
            
            if (!existsInServer) {
                const itemAmount = cartItem.price * cartItem.quantity;
                totalAddedAmount += itemAmount;
                addedItemsList.push({
                    name: cartItem.productName,
                    size: cartItem.sizeName,
                    quantity: cartItem.quantity,
                    price: cartItem.price,
                    subtotal: itemAmount,
                    type: 'new_item'
                });
                
                console.log(`Adding new item: ${cartItem.productName} - ₱${itemAmount}`);
                await fetch('/Staff/AddItemToExistingOrder', {
                    method: 'POST',
                    headers: { 
                        'Content-Type': 'application/json', 
                        'RequestVerificationToken': getToken() 
                    },
                    body: JSON.stringify({
                        orderId: orderId,
                        productSizeId: cartItem.productSizeId,
                        quantity: cartItem.quantity,
                        paymentMethod: paymentMethod,
                        discountType: currentDiscountType,
                        discountPercent: currentDiscountPercent
                    })
                });
            }
        }
        
        // ✅ STEP 5: Update order totals
        await fetch('/Staff/UpdateOrderTotals', {
            method: 'POST',
            headers: { 
                'Content-Type': 'application/json', 
                'RequestVerificationToken': getToken() 
            },
            body: JSON.stringify({
                orderId: orderId,
                paymentMethod: paymentMethod,
                discountType: currentDiscountType,
                discountPercent: currentDiscountPercent
            })
        });
        
        // ✅ STEP 6: Get final order details
        const finalOrderResponse = await fetch(`/VoidRefund/GetOrderDetails?orderId=${orderId}`);
        const finalOrderData = await finalOrderResponse.json();
        
        const newTotal = finalOrderData.order.totalAmount || 0;
        const priceDifference = newTotal - originalTotal;
        
        // Determine if customer pays more or gets refund
        const needsAdditionalPayment = priceDifference > 0;
        const refundAmount = priceDifference < 0 ? Math.abs(priceDifference) : 0;
        const additionalPayment = priceDifference > 0 ? priceDifference : 0;
        
        hideLoading();
        
        // ✅ STEP 7: Show UPDATED receipt with COMPLETE details
        await showUpdatedReceiptAfterVoidWithDifference(
            orderId,
            originalTotal,
            voidedItemsList,
            addedItemsList,
            totalVoidedAmount,
            totalAddedAmount,
            newTotal,
            refundAmount,
            additionalPayment,
            needsAdditionalPayment
        );
        
        await showAlert('✅ Order updated successfully!', 'Success', '✅');
        
        // ✅ STEP 8: Refresh order queue
        await loadOrderQueue();
        
        // ✅ STEP 9: Clean up edit mode
        const banner = document.getElementById('editModeBanner');
        if (banner) banner.remove();
        
        const checkoutBtn = document.getElementById('checkoutBtn');
        checkoutBtn.innerHTML = '💳 Confirm Order';
        checkoutBtn.style.background = '#28a745';
        
        cart = [];
        currentDiscountType = 'None';
        currentDiscountPercent = 0;
        pendingPaymentMethod = null;
        window.isEditingMode = false;
        window.originalOrderId = null;
        
        document.querySelectorAll('.payment-btn').forEach(b => b.classList.remove('active'));
        updateCartDisplay();
        updateDiscountBtnHighlight();
        
        return true;
        
    } catch (error) {
        hideLoading();
        console.error('Update error:', error);
        await showAlert('❌ Error updating order: ' + error.message, 'Error', '❌');
        return false;
    }
}

