        </label>
        <div style="display: flex; gap: 12px;">
            <button type="button" class="exchange-payment-btn" data-method="Cash" onclick="selectExchangePayment('Cash')" style="flex: 1; padding: 10px; border-radius: 10px; border: 2px solid #28a745; background: white; cursor: pointer; font-weight: 600; transition: all 0.2s;">
                💵 Cash
            </button>
            <button type="button" class="exchange-payment-btn" data-method="GCash" onclick="selectExchangePayment('GCash')" style="flex: 1; padding: 10px; border-radius: 10px; border: 2px solid #28a745; background: white; cursor: pointer; font-weight: 600; transition: all 0.2s;">
                📱 GCash
            </button>
        </div>
    </div>

    </div>

    <!-- Reason Section -->
