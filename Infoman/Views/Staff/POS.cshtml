@{
    ViewBag.Title = "Point of Sale";
    Layout = null;
}

@functions {
    private decimal GetMinPrice(object sizes)
    {
        if (sizes == null) return 0;

        // I-convert sa IEnumerable para magamit ang LINQ
        var sizesList = sizes as IEnumerable<dynamic>;
        if (sizesList == null || !sizesList.Any()) return 0;

        decimal min = decimal.MaxValue;
        foreach (var size in sizesList)
        {
            decimal price = Convert.ToDecimal(size.Price);
            if (price < min) min = price;
        }
        return min;
    }

    private decimal GetMaxPrice(object sizes)
    {
        if (sizes == null) return 0;

        var sizesList = sizes as IEnumerable<dynamic>;
        if (sizesList == null || !sizesList.Any()) return 0;

        decimal max = 0;
        foreach (var size in sizesList)
        {
            decimal price = Convert.ToDecimal(size.Price);
            if (price > max) max = price;
        }
        return max;
    }

    private int GetTotalStock(object sizes)
    {
        if (sizes == null) return 0;

        var sizesList = sizes as IEnumerable<dynamic>;
        if (sizesList == null || !sizesList.Any()) return 0;

        int total = 0;
        foreach (var size in sizesList)
        {
            total += Convert.ToInt32(size.Stock);
        }
        return total;
    }
}

<!DOCTYPE html>
<html>
