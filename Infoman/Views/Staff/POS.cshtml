async function createExchangeOrderFromSummary(exchangeData) {
    if (!exchangeData.itemsReplaced || exchangeData.itemsReplaced.length === 0) return;
    
    showLoading('Creating replacement order...');
    
    const token = getToken();
    let lastOrderId = null;
    let allSuccessful = true;
    let orderDetails = [];
    
    // ✅ Compute customer payable
    const returnTotal = exchangeData.returnTotal || 0;
    const replaceTotal = exchangeData.replaceTotal || 0;
    const priceDiff = replaceTotal - returnTotal;
    const customerPayable = priceDiff > 0 ? priceDiff : 0;
    
    for (const item of exchangeData.itemsReplaced) {
        const response = await fetch('/Staff/PlaceOrder', {
            method: 'POST',
            headers: { 
                'Content-Type': 'application/json', 
                'RequestVerificationToken': token 
            },
            body: JSON.stringify({
                productSizeId: item.productSizeId,
                quantity: item.quantity,
                orderNumber: `EX-${Date.now()}`,
                paymentMethod: exchangeData.paymentMethod || 'Cash',
                discountType: 'None',
                discountPercent: 0
            })
        });
        
        const data = await response.json();
        
        if (!data.success) {
            allSuccessful = false;
            console.error('Failed to create order item:', data.message);
            break;
        }
        
        lastOrderId = data.orderId;
        orderDetails.push({
            name: item.productName,
            size: item.sizeName,
            quantity: item.quantity,
            price: item.price,
            subtotal: item.price * item.quantity
        });
    }
    
    hideLoading();
    
    if (allSuccessful && orderDetails.length > 0 && lastOrderId) {
        // ✅ Show receipt with CORRECT total (customer payable only)
        showReceiptModal(
            orderDetails,
            exchangeData.paymentMethod || 'Cash',
            'None',
            0,
            0,
            customerPayable,  // ✅ TAMANG TOTAL (₱19, hindi ₱57)
            lastOrderId,
            'PENDING_PAYMENT'
        );
        
        // Set exchange flags para sa receipt display
        window.isExchangeReplacement = true;
        window.exchangeOriginalOrderId = exchangeData.originalOrderId;
        window.exchangeStoreCreditApplied = returnTotal;
        window.exchangeAdjustmentAmount = priceDiff;
        
        await showAlert(`✅ New order #${lastOrderId} created! Click "START BLENDING" to prepare.`, 'Order Created', '✅');
        
        // Refresh orders queue
        await loadOrderQueue();
        
    } else if (!allSuccessful) {
        await showAlert('⚠️ Exchange recorded but failed to create replacement order. Please check manually.', 'Partial Success', '⚠️');
    }
}

