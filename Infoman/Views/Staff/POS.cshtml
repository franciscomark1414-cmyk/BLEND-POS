        // ============================================================
        // ORDER QUEUE
        // ============================================================
        async function loadOrderQueue() {
    try {
        const response = await fetch('/Staff/GetActiveOrders');
        const orders = await response.json();
        const container = document.getElementById('orderQueueList');
        const countSpan = document.getElementById('queueCount');
        if (!container) return;
        
        // ✅ Include BOTH PENDING_BLENDING and PREPARING
        const activeOrders = orders.filter(o => 
            (o.status === 'PENDING_BLENDING' || o.status === 'PREPARING') && 
            o.items && o.items.length > 0
        );
        
        if (countSpan) countSpan.innerText = activeOrders.length;
        
        if (activeOrders.length === 0) {
            container.innerHTML = '<div class="text-center text-muted small">No pending orders to blend</div>';
            return;
        }
        
        let html = '';
        for (const order of activeOrders) {
            let itemsHtml = '';
            let totalAmount = 0;
            
            order.items.forEach(item => {
                const itemTotal = item.price * item.quantity;
                totalAmount += itemTotal;
                itemsHtml += `<div>• ${item.quantity}x ${item.productName} (${item.sizeName}) - ₱${itemTotal.toFixed(2)}</div>`;
            });
            
            const shortOrderNum = order.orderNumber ? order.orderNumber.substring(order.orderNumber.length - 6) : `#${order.orderId}`;
            
            // Determine status badge text
            let statusText = order.status === 'PENDING_BLENDING' ? 'PAID - WAITING' : 'PREPARING';
            
            html += `
                <div class="queue-item" data-order-id="${order.orderId}" style="border-left: 3px solid #ffc107; margin-bottom: 8px; background: white; border-radius: 8px; padding: 8px;">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="queue-order-number" style="font-size: 12px; font-weight: bold;" title="${order.orderNumber}">${shortOrderNum}</span>
                        <span class="badge ${order.status === 'PENDING_BLENDING' ? 'bg-info' : 'bg-warning'}" style="font-size: 9px;">${statusText}</span>
                    </div>
                    <div class="queue-items" style="font-size: 11px; color: #666; margin: 5px 0;">${itemsHtml}</div>
                    <div class="d-flex justify-content-between align-items-center mt-1">
                        <span class="queue-total" style="font-size: 12px; font-weight: bold; color: #28a745;">₱${totalAmount.toFixed(2)}</span>
                        <div class="d-flex gap-1">
                            <button class="btn btn-sm btn-outline-info" style="font-size: 10px; padding: 2px 8px;" onclick="event.stopPropagation(); showReceiptPopup(${order.orderId})">
                                 View
                            </button>
                            <button class="btn btn-sm btn-warning" style="font-size: 10px; padding: 2px 8px;" onclick="event.stopPropagation(); startBlendingFromQueue(${order.orderId})">
                                 Start Blending
                            </button>
                        </div>
                    </div>
                </div>`;
        }
        container.innerHTML = html;
    } catch (error) {
        const container = document.getElementById('orderQueueList');
        if (container) container.innerHTML = '<div class="text-center text-danger small">Error loading orders</div>';
    }
}

      async function startBlendingFromQueue(orderId) {
    const receiptModal = document.getElementById('receiptModal');
    if (receiptModal && receiptModal.style.display === 'flex') {
        receiptModal.style.display = 'none';
    }
    
    await new Promise(resolve => setTimeout(resolve, 100));
    
    const confirmed = await showConfirm(
        `⚠️ START BLENDING?\n\nOrder #${orderId}\n\nOnce you click OK:\n• Ingredients will be DEDUCTED from inventory\n• This action cannot be undone without Owner approval\n\nContinue?`,
        'Start Blending Confirmation'
    );
    
    if (!confirmed) return;
    
    showLoading('Starting blending process...');
    
    try {
        const response = await fetch('/Staff/StartBlending', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getToken() },
            body: JSON.stringify({ orderId: orderId })
        });
        const data = await response.json();
        hideLoading();
        
        if (data.success) {
            await showAlert('✅ ' + data.message, 'Success', '✅');
            
            // ✅ Refresh order queue
            await loadOrderQueue();
            
            // ✅ Clear edit mode if active
            if (window.isEditingMode) {
                const banner = document.getElementById('editModeBanner');
                if (banner) banner.remove();
                window.isEditingMode = false;
                window.originalOrderId = null;
                
                const checkoutBtn = document.getElementById('checkoutBtn');
                checkoutBtn.innerHTML = '💳 Confirm Order';
                checkoutBtn.style.background = '#28a745';
                cart = [];
                updateCartDisplay();
            }
            
        } else {
            await showAlert('❌ Error: ' + data.message, 'Error', '❌');
        }
    } catch (error) {
        hideLoading();
        await showAlert('❌ Error: ' + error.message, 'Error', '❌');
    }
}
        function refreshQueue() { loadOrderQueue(); }

        if (document.getElementById('orderQueueList')) {
            loadOrderQueue();
            setInterval(loadOrderQueue, 5000);
        }

        // ============================================================
        // SIZE / QTY MODALS
        // ============================================================
       async function showSizeModal(productId, productName) {
    const response = await fetch(`/Staff/GetProductWithSizes?productId=${productId}`);
    const data = await response.json();
    if (!data.success) { 
        await showAlert('Error loading product sizes', 'Error', '❌');
        return; 
    }
    document.getElementById('sizeModalProductName').innerText = data.productName;
    let sizesHtml = '';
    for (const size of data.sizes) {
        const stockValue = size.stock;
        const stockStatus = stockValue > 0 ? `✅ Stock: ${stockValue}` : '❌ Out of Stock';
        const disabledClass = stockValue <= 0 ? 'opacity-50' : '';
        const isAvailable = stockValue > 0;
        
        // IMPORTANT: I-escape ang mga special characters sa sizeName
        const safeSizeName = size.sizeName.replace(/'/g, "\\'");
        
        sizesHtml += `
            <div class="size-option ${disabledClass}" style="border: 1px solid #ddd; border-radius: 12px; padding: 15px; margin-bottom: 10px; cursor: ${isAvailable ? 'pointer' : 'not-allowed'};"
                 ${isAvailable ? `onclick="selectSize(${size.productSizeId}, '${safeSizeName}', ${size.price}, ${stockValue})"` : ''}>
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <div>
                        <strong style="font-size: 16px;">${escapeHtml(size.sizeName)}</strong>
                        <div style="font-size: 12px; color: #666;">${stockStatus}</div>
                    </div>
                    <div style="font-size: 20px; font-weight: bold; color: #ff6b35;">₱${size.price.toFixed(2)}</div>
                </div>
            </div>`;
    }
    document.getElementById('sizeOptionsList').innerHTML = sizesHtml;
    document.getElementById('sizeModal').style.display = 'flex';
}
        function closeSizeModal() { document.getElementById('sizeModal').style.display = 'none'; }

        function selectSize(productSizeId, sizeName, price, stock) {
            tempSelectedSize = { productSizeId, sizeName, price, stock };
            modalQuantity = 1;
            document.getElementById('modalProductName').innerHTML = `${sizeName} - ₱${price.toFixed(2)}`;
            document.getElementById('modalQty').innerHTML = '1';
            document.getElementById('quantityModal').style.display = 'flex';
            closeSizeModal();
            checkMaxAvailability();
        }

        async function checkMaxAvailability() {
            if (!tempSelectedSize) return;
            const response = await fetch(`/Staff/CheckAvailability?productSizeId=${tempSelectedSize.productSizeId}&quantity=1`);
            const data = await response.json();
            currentMaxOrders = data.maxPossibleOrders || 0;
        }

        function decrementModalQty() {
            if (modalQuantity > 1) { modalQuantity--; document.getElementById('modalQty').innerHTML = modalQuantity; }
        }
        function incrementModalQty() {
    if (modalQuantity < currentMaxOrders) { 
        modalQuantity++; 
        document.getElementById('modalQty').innerHTML = modalQuantity; 
    } else if (currentMaxOrders > 0) {
        showAlert(`Maximum available is ${currentMaxOrders} order(s).`, 'Limit Reached', '⚠️');
    }
}
        function closeQuantityModal() { document.getElementById('quantityModal').style.display = 'none'; tempSelectedSize = null; }

        async function confirmAddToCart() {
           if (!tempSelectedSize) return;

            const timeInCheck = await checkTimeInBeforeOrder();
    if (!timeInCheck) return;

    const response = await fetch(`/Staff/CheckAvailability?productSizeId=${tempSelectedSize.productSizeId}&quantity=${modalQuantity}`);
    const data = await response.json();
    if (!data.available) { 
        await showAlert(`❌ Cannot add to cart:\n${data.message}`, 'Not Available', '❌');
        closeQuantityModal(); 
        tempSelectedSize = null; 
        return; 
    }
            const existingIndex = cart.findIndex(item => item.productSizeId === tempSelectedSize.productSizeId);
            if (existingIndex !== -1) {
                cart[existingIndex].quantity += modalQuantity;
            } else {
                cart.push({
                    productSizeId: tempSelectedSize.productSizeId,
                    productName: document.getElementById('sizeModalProductName').innerText,
                    sizeName: tempSelectedSize.sizeName,
                    price: tempSelectedSize.price,
                    quantity: modalQuantity
                });
            }
            updateCartDisplay();
            closeQuantityModal();
            tempSelectedSize = null;
        }

        // ============================================================
        // CART DISPLAY — redesigned
        // ============================================================
        function updateCartDisplay() {
            const cartDiv = document.getElementById('cartItems');
            const totalSpan = document.getElementById('cartTotal');
            const discountLine = document.getElementById('discountLine');

            if (cart.length === 0) {
                cartDiv.innerHTML = '<div class="empty-cart"><div class="empty-icon">🛍️</div><p>No items in cart</p></div>';
                totalSpan.innerHTML = '₱0.00';
                if (discountLine) discountLine.style.display = 'none';
                currentDiscountType = 'None';
                currentDiscountPercent = 0;
                currentDiscountedTotal = 0;
                document.getElementById('selectedDiscountDisplay').innerHTML = '';
                updateDiscountBtnHighlight();
                return;
            }

            let html = '';
            let total = 0;
            cart.forEach((item, index) => {
                const itemTotal = item.price * item.quantity;
                total += itemTotal;
                html += `
                    <div class="cart-item">
                        <div class="cart-item-info">
                            <div class="cart-item-name">${escapeHtml(item.productName)}</div>
                            <div class="cart-item-size">${item.sizeName}</div>
                            <div class="cart-item-unitprice">₱${item.price.toFixed(2)} each</div>
                        </div>
                        <div class="cart-item-right">
                            <span class="cart-item-total">₱${itemTotal.toFixed(2)}</span>
                            <div class="cart-item-qty">
                                <button class="qty-btn" onclick="updateCartItemQty(${index}, ${item.quantity - 1})">−</button>
                                <span class="qty-display">${item.quantity}</span>
                                <button class="qty-btn" onclick="updateCartItemQty(${index}, ${item.quantity + 1})">+</button>
                            </div>
                            <span class="remove-item" onclick="removeFromCart(${index})" title="Remove">✕</span>
                        </div>
                    </div>`;
            });

            currentCartTotal = total;
            currentDiscountedTotal = total * (1 - currentDiscountPercent);

            cartDiv.innerHTML = html;

            // Update total display
            if (currentDiscountPercent > 0) {
                totalSpan.innerHTML = `₱${currentDiscountedTotal.toFixed(2)}`;
                if (discountLine) {
                    discountLine.style.display = 'flex';
                    discountLine.innerHTML = `<span>${currentDiscountType} (${currentDiscountPercent * 100}% off)</span><span>−₱${(currentCartTotal - currentDiscountedTotal).toFixed(2)}</span>`;
                }
            } else {
                totalSpan.innerHTML = `₱${total.toFixed(2)}`;
                if (discountLine) discountLine.style.display = 'none';
            }
        }

        function updateDiscountBtnHighlight() {
            document.querySelectorAll('.discount-btn-pill').forEach(btn => {
                const btnType = btn.getAttribute('data-discount-type');
                const btnPercent = parseFloat(btn.getAttribute('data-discount-percent') || 0);
                btn.classList.toggle('active', currentDiscountType === btnType && currentDiscountPercent === btnPercent);
            });
            const displayDiv = document.getElementById('selectedDiscountDisplay');
            if (currentDiscountPercent > 0) {
                displayDiv.innerHTML = `<div class="discount-applied">✓ ${currentDiscountType} discount applied</div>`;
            } else {
                displayDiv.innerHTML = '';
            }
        }

        function selectDiscount(type, percent) {
            if (currentDiscountType === type && currentDiscountPercent === percent) {
                currentDiscountType = 'None';
                currentDiscountPercent = 0;
            } else {
                currentDiscountType = type;
                currentDiscountPercent = percent;
            }
            currentDiscountedTotal = currentCartTotal * (1 - currentDiscountPercent);
            updateCartDisplay();
            updateDiscountBtnHighlight();
        }

        async function updateCartItemQty(index, newQty) {
    if (newQty <= 0) { removeFromCart(index); return; }
    const item = cart[index];
    const response = await fetch(`/Staff/CheckAvailability?productSizeId=${item.productSizeId}&quantity=${newQty}`);
    const data = await response.json();
    if (!data.available) { 
        await showAlert(`❌ Cannot update quantity:\n${data.message}`, 'Not Available', '❌');
        return; 
    }
    cart[index].quantity = newQty;
    updateCartDisplay();
}

        function removeFromCart(index) { cart.splice(index, 1); updateCartDisplay(); }

        async function clearCart() {
    if (cart.length === 0) return;
    const confirmed = await showConfirm('Clear all items from cart?', 'Clear Cart');
    if (confirmed) {
        cart = [];
        currentDiscountType = 'None';
        currentDiscountPercent = 0;
        pendingPaymentMethod = null;
        updateCartDisplay();
    }
}

async function confirmOrder() {
    console.log('=== confirmOrder called ===');
    console.log('cart.length:', cart.length);
    console.log('window.pendingPaymentMethod:', window.pendingPaymentMethod);
    
    if (cart.length === 0) { 
        await showAlert('Cart is empty!', 'Cannot Confirm');
        return; 
    }
    
    if (!window.pendingPaymentMethod) { 
        await showAlert('Please select a payment method first!', 'Payment Required', '⚠️');
        return; 
    }

    const timeInCheck = await checkTimeInBeforeOrder();
    if (!timeInCheck) return;

    if (window.isEditingMode === true) {
        await updateExistingOrder();
    } else {
        showReviewModal();
    }
}

async function checkTimeInBeforeOrder() {
    try {
        const response = await fetch('/Staff/CheckTimeInStatus');
        const data = await response.json();
        
        if (!data.isClockedIn) {
            const confirmTimeIn = await showConfirm(
                '⚠️ You are not clocked in yet!\n\nYou must TIME IN before you can take orders.\n\nWould you like to TIME IN now?',
                'Time In Required'
            );
            
            if (confirmTimeIn) {
                await timeIn();
                // Wait a bit then check again
                await new Promise(resolve => setTimeout(resolve, 1000));
                const secondCheck = await fetch('/Staff/CheckTimeInStatus');
                const secondData = await secondCheck.json();
                if (secondData.isClockedIn) {
                    await showAlert('✅ Time in successful! You can now take orders.', 'Success', '✅');
                    return true;
                } else {
                    await showAlert('❌ Time in failed. Please try again.', 'Error', '❌');
                    return false;
                }
            }
            return false;
        }
        return true;
    } catch (error) {
        console.error('Error checking time in status:', error);
        await showAlert('Error checking attendance status.', 'Error', '❌');
        return false;
    }
}

     async function prepareCheckout(btn) {
    if (cart.length === 0) { 
        await showAlert('Cart is empty!', 'Cannot Select Payment', '⚠️');
        return; 
    }

    // Highlight active payment button
    document.querySelectorAll('.payment-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');

    // Check which button was clicked
    if (btn.classList.contains('gcash') || btn.id === 'gcashPaymentBtn') {
        pendingPaymentMethod = 'GCash';
        document.getElementById('gcashPayBtn').style.display = 'none';
        document.getElementById('checkoutBtn').style.display = 'block';
        
        await showAlert('GCash selected. Click "Confirm Order" to create order, then "Pay with GCash" to complete payment.', 'Payment Method Selected', '✅');
    } else {
        pendingPaymentMethod = 'Cash';
        document.getElementById('gcashPayBtn').style.display = 'none';
        document.getElementById('checkoutBtn').style.display = 'block';
    }
}
    
async function processFinalOrder() {
    // ✅ Kunin ang payment method mula sa window.pendingPaymentMethod
    const paymentMethod = window.pendingPaymentMethod;
    
    console.log('processFinalOrder called with paymentMethod:', paymentMethod);
    
    if (!paymentMethod) {
        await showAlert('Please select a payment method first!', 'Payment Required', '⚠️');
        return;
    }
    
    closeReviewModal();

    const checkoutBtn = document.getElementById('checkoutBtn');
    const originalText = checkoutBtn.innerHTML;
    checkoutBtn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Processing...';
    checkoutBtn.disabled = true;

    try {
        if (window.isEditingMode === true) {
            await updateExistingOrder();
        } 
        else if (paymentMethod === 'GCash') {
            await createOrderForGCash();
        } 
        else if (paymentMethod === 'QRPh') {
            await createOrderForQRPh();
        }
        else if (paymentMethod === 'Cash') {
            await createNewOrder();
        }
        else {
            await showAlert(`Unknown payment method: ${paymentMethod}`, 'Error', '❌');
        }

    } catch (error) {
        console.error('Error:', error);
        await showAlert('❌ Error processing order: ' + error.message, 'Error', '❌');
    } finally {
        checkoutBtn.innerHTML = originalText;
        checkoutBtn.disabled = false;
    }
}

async function createNewOrder() {
    const paymentMethod = window.pendingPaymentMethod;
    
    console.log('=== createNewOrder ===');
    console.log('paymentMethod:', paymentMethod);
    
    if (!paymentMethod) {
        await showAlert('No payment method selected!', 'Error', '❌');
        return;
    }
    
    const token = getToken();
    let orderDetails = [];
    let lastOrderId = null;
    let allSuccessful = true;
    
    const sharedOrderNumber = `POS-${Date.now()}`;
    
    for (const item of cart) {
        const response = await fetch('/Staff/PlaceOrder', {
            method: 'POST',
            headers: { 
                'Content-Type': 'application/json', 
                'RequestVerificationToken': token 
            },
            body: JSON.stringify({
                productSizeId: item.productSizeId,
                quantity: item.quantity,
                orderNumber: sharedOrderNumber,
                paymentMethod: paymentMethod,
                discountType: currentDiscountType,
                discountPercent: currentDiscountPercent
            })
        });
        
        const data = await response.json();
        
        if (!data.success) {
            allSuccessful = false;
            await showAlert(`❌ Error with ${item.productName}: ${data.message}`, 'Order Failed', '❌');
            break;
        }
        
        lastOrderId = data.orderId;
        orderDetails.push({
            name: item.productName,
            size: item.sizeName,
            quantity: item.quantity,
            price: item.price,
            subtotal: item.price * item.quantity
        });
    }

    if (allSuccessful && orderDetails.length > 0) {
        const discountSavings = currentCartTotal - currentDiscountedTotal;
        
        // ✅ SIMPLE: I-HARDCODE ANG STATUS PARA SA CASH
        showReceiptModal(
            orderDetails, 
            paymentMethod, 
            currentDiscountType, 
            currentDiscountPercent, 
            discountSavings, 
            currentDiscountedTotal, 
            lastOrderId, 
            'PENDING_BLENDING'  // ✅ HARDCODED
        );
        
        window.lastClosedOrderId = lastOrderId;
        
        cart = [];
        currentDiscountType = 'None';
        currentDiscountPercent = 0;
        window.pendingPaymentMethod = null;
        window.isEditingMode = false;
        
        document.querySelectorAll('.payment-btn').forEach(b => b.classList.remove('active'));
        updateCartDisplay();
        updateDiscountBtnHighlight();
        await loadOrderQueue();
        
    } else if (!allSuccessful) {
        await showAlert('❌ Order failed. Please try again.', 'Order Failed', '❌');
    }
}


