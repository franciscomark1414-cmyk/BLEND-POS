       async function loadPendingOrdersForVoid() {
    try {
        const response = await fetch('/VoidRefund/GetPendingOrders');
        const orders = await response.json();
        const select = document.getElementById('voidOrderSelect');
        select.innerHTML = '<option value="">-- Select Order --</option>';
        
        // I-filter lang ang mga PENDING_PAYMENT orders (hindi pa nabe-blend)
        const pendingOrders = orders.filter(o => o.status === 'PENDING_PAYMENT' || o.status === 'PENDING');
        
        if (pendingOrders.length === 0) {
            select.innerHTML = '<option value="">-- No pending orders to void --</option>';
            return;
        }
        
        for (const order of pendingOrders) {
            try {
                const orderDetailsResponse = await fetch(`/VoidRefund/GetOrderDetails?orderId=${order.orderId}`);
                const orderDetails = await orderDetailsResponse.json();
                
                let productNames = '';
                if (orderDetails.success && orderDetails.order && orderDetails.order.items) {
                    const items = orderDetails.order.items.map(item => `${item.quantity}x ${item.productName} (${item.sizeName})`);
                    productNames = items.join(', ');
                }
                
                const shortOrderNum = order.orderNumber.substring(order.orderNumber.length - 8);
                const displayText = productNames.length > 35 ? productNames.substring(0, 32) + '...' : productNames;
                
                select.innerHTML += `<option value="${order.orderId}">
                    #${shortOrderNum} - ${displayText} - ₱${order.totalAmount.toFixed(2)}
                </option>`;
            } catch (err) {
                console.error('Error loading order details:', err);
                const shortOrderNum = order.orderNumber.substring(order.orderNumber.length - 8);
                select.innerHTML += `<option value="${order.orderId}">
                    #${shortOrderNum} - ₱${order.totalAmount.toFixed(2)}
                </option>`;
            }
        }
    } catch (error) { 
        console.error('Error:', error); 
        const select = document.getElementById('voidOrderSelect');
        if (select) select.innerHTML = '<option value="">-- Error loading orders --</option>';
    }
}

