    const returnItems = [];
    document.querySelectorAll('#exchangeReturnItems .return-item-checkbox:checked').forEach(cb => {
        const itemDiv = cb.closest('.return-item-div');
        if (itemDiv) {
            const productName = cb.getAttribute('data-name');
            const sizeName = cb.getAttribute('data-size');
            if (productName && sizeName) {
                returnItems.push({ productName, sizeName });
            }
        }
    });
    
    // If no items selected, show all products
    const hasReturnItems = returnItems.length > 0;
    
    // ✅ Filter products - cannot select same product and size as returned items
    let filteredProducts = exchangeProductsList;
    
    if (hasReturnItems) {
        filteredProducts = exchangeProductsList.filter(product => {
            // Skip if product is undefined or null
            if (!product) return false;
            // Check if this product matches any returned item
            const isMatching = returnItems.some(returnItem => {
                return returnItem.productName === product.ProductName && 
                       returnItem.sizeName === product.SizeName;
            });
            // Exclude if it matches (cannot replace with same product)
            return !isMatching;
        });
    }
    
    if (filteredProducts.length === 0) {
        showAlert('No available replacement products. Please select different items to return.', 'No Options', '⚠️');
        return;
    }
    
    // Remove existing modal if any
    const existingModal = document.getElementById('productSearchModal');
    if (existingModal) existingModal.remove();
    
    // ✅ SAFELY escape product name and size name
    const productsHtml = filteredProducts.map(p => {
        // Skip if product is undefined
        if (!p) return '';
        
        // Safely escape strings
        const productName = (p.ProductName || '').replace(/'/g, "\\'");
        const sizeName = (p.SizeName || '').replace(/'/g, "\\'");
        const sku = (p.SKU || '');
        
        return `
            <div class="product-search-item" 
                 data-id="${p.productSizeId}" 
                 data-name="${productName}" 
                 data-size="${sizeName}" 
                 data-price="${p.Price || 0}" 
                 onclick="selectProductForExchange(${p.productSizeId}, '${productName}', '${sizeName}', ${p.Price || 0})" 
                 style="background: #f8f9fa; border: 1px solid #dee2e6; border-radius: 10px; padding: 12px; cursor: pointer; transition: all 0.2s;">
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <div>
                        <strong style="font-size: 14px;">${escapeHtml(productName)}</strong>
                        <span style="color: #666; font-size: 12px;">(${escapeHtml(sizeName)})</span>
                        <br><small class="text-muted">SKU: ${escapeHtml(sku)}</small>
                    </div>
                    <div class="text-end">
                        <span class="text-success fw-bold" style="font-size: 16px;">₱${(p.Price || 0).toFixed(2)}</span>
                    </div>
                </div>
            </div>
        `;
    }).filter(html => html !== '').join('');
    
    const modalHtml = `
        <div id="productSearchModal" class="modal-qty" style="display: flex; z-index: 10002;">
            <div class="modal-qty-content" style="width: 550px; max-width: 90%; border-radius: 16px; overflow: hidden;">
                <div style="background: linear-gradient(135deg, #17a2b8, #0d6efd); color: white; padding: 15px 20px;">
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <h4 class="mb-0" style="font-size: 18px;">
                            <i class="fas fa-search"></i> Select Replacement Product
                            ${hasReturnItems ? `<span style="font-size: 12px; margin-left: 10px;">(Cannot select returned items)</span>` : ''}
                        </h4>
                        <button onclick="closeModal('productSearchModal')" style="background: none; border: none; color: white; font-size: 24px; cursor: pointer;">&times;</button>
                    </div>
                </div>
                <div style="padding: 20px;">
                    <input type="text" id="productSearchInput" class="form-control" placeholder="🔍 Search product by name..." onkeyup="filterProductSearch()" style="border-radius: 10px; padding: 12px;">
                    <div id="productSearchResults" style="max-height: 400px; overflow-y: auto; margin-top: 15px;">
                        <div style="display: flex; flex-direction: column; gap: 8px;">
                            ${productsHtml}
                        </div>
                    </div>
                    <div class="text-end mt-3">
                        <button class="btn btn-secondary" onclick="closeModal('productSearchModal')" style="border-radius: 8px; padding: 8px 20px;">Cancel</button>
                    </div>
                </div>
            </div>
        </div>
    `;
    
    document.body.insertAdjacentHTML('beforeend', modalHtml);
    }


function selectProductForExchange(productSizeId, productName, sizeName, price) {
    // ✅ Check if this product is being returned
    const returnItems = [];
    document.querySelectorAll('#exchangeReturnItems .return-item-checkbox:checked').forEach(cb => {
        const itemDiv = cb.closest('.return-item-div');
        if (itemDiv) {
            const returnProductName = cb.getAttribute('data-name');
            const returnSizeName = cb.getAttribute('data-size');
            returnItems.push({ productName: returnProductName, sizeName: returnSizeName });
        }
    });
    
    // Check for match
    const isMatching = returnItems.some(returnItem => {
        return returnItem.productName === productName && returnItem.sizeName === sizeName;
    });
    
    if (isMatching) {
        showAlert(`Cannot replace "${productName} (${sizeName})" with the same product. Please choose a different product or size.`, 'Invalid Replacement', '⚠️');
        return;
    }
    
    const existingIndex = exchangeReplaceItemsData.findIndex(i => i.productSizeId === productSizeId);
    
    if (existingIndex !== -1) {
        exchangeReplaceItemsData[existingIndex].quantity++;
    } else {
        exchangeReplaceItemsData.push({
            productSizeId: productSizeId,
            productName: productName,
            sizeName: sizeName,
            price: price,
            quantity: 1
        });
    }
    
    closeModal('productSearchModal');
    renderReplacementItems();
    updateExchangeSummary();
}


function filterProductSearch() {
    const searchTerm = document.getElementById('productSearchInput').value.toLowerCase();
    const items = document.querySelectorAll('.product-search-item');
    items.forEach(item => {
        const text = item.innerText.toLowerCase();
        item.style.display = text.includes(searchTerm) ? '' : 'none';
    });
}


function renderReplacementItems() {
    const container = document.getElementById('replaceItemsList');
    
    if (exchangeReplaceItemsData.length === 0) {
        container.innerHTML = '<div class="text-muted text-center" style="padding: 30px;"><i class="fas fa-box-open" style="font-size: 30px; margin-bottom: 10px; display: block;"></i>No replacement items added yet.<br>Click "Add Replacement Item" to start.</div>';
        return;
    }
    
    let html = '<div style="display: flex; flex-direction: column; gap: 10px;">';
    exchangeReplaceItemsData.forEach((item, index) => {
        html += `
            <div style="background: white; border: 1px solid #28a745; border-radius: 10px; padding: 10px;">
                <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
                    <div style="flex: 1;">
                        <div><strong>${escapeHtml(item.productName)}</strong> <span style="color: #666; font-size: 12px;">(${escapeHtml(item.sizeName)})</span></div>
                        <div style="font-size: 12px; color: #28a745;">₱${item.price.toFixed(2)} each</div>
                    </div>
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <button class="btn btn-sm btn-outline-secondary" onclick="updateReplaceQty(${index}, ${item.quantity - 1})" style="border-radius: 50%; width: 30px; height: 30px;">-</button>
                        <span style="min-width: 30px; text-align: center; font-weight: bold;">${item.quantity}</span>
                        <button class="btn btn-sm btn-outline-secondary" onclick="updateReplaceQty(${index}, ${item.quantity + 1})" style="border-radius: 50%; width: 30px; height: 30px;">+</button>
                        <button class="btn btn-sm btn-danger" onclick="removeReplaceItem(${index})" style="border-radius: 8px;">
                            <i class="fas fa-trash"></i>
                        </button>
                    </div>
                </div>
                <div class="text-end mt-1" style="font-size: 12px;">
                    <strong>Subtotal:</strong> ₱${(item.price * item.quantity).toFixed(2)}
                </div>
